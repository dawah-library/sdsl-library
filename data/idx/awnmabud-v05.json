{"q":[["وإن أسأتم فلها","الإسراء: ٧",17],["فمن تمتع بالعمرة إلى الحج فما استيسر من الهدي","البقرة: ١٩٦",157],["يحفظونه من أمر الله","الرعد: ١١",166],["ثم ارجع البصر كرتين","الملك: ٤",175],["إنا كنا من قبل ندعوه إنه هو البر الرحيم","الطور: ٢٨",177],["فإن ربي غني كريم","النمل: ٤٠",178],["وإن ربك لهو العزيز الرحيم","الشعراء: ٩",178],["وكان الله عفوا غفورا","النساء: ٩٩",178],["والله عليم حليم","النساء: ١٢",178],["والله قدير والله غفور رحيم","الممتحنة: ٧",178],["شهد الله أنه لا إله إلا هو والملائكة وأولو العلم قائما بالقسط لا إله إلا هو العزيز الحكيم","آل عمران: ١٨",179],["فلا تحل له من بعد حتى تنكح زوجا غيره","البقرة: ٢٣٠",221],["فما استيسر من الهدي فمن لم يجد فصيام ثلاثة أيام في الحج وسبعة إذا رجعتم","البقرة: ١٩٦",242]],"h":[],"a":[["أحمد",[149]],["إسحاق",[92]],["أم باجتهاد عمر",[111]],["البراء بن عازب",[330,331]],["أبو بكر",[121]],["أبو بكر الصديق",[291]],["جابر",[273,281,334]],["الحسين",[228]],["أبو حنيفة",[149,220,307]],["حنيفة",[183]],["الدهلوي",[56]],["الدين بن القيم",[16,17,40,42,85,96,111,112,117,120,126,134,136,139,141,146,147,148,149,150,154,161,163,166,167,168,171,173,191,197,205,211,218,220,229,240,241,243,244,280,290,291,296,305,310,323,324,330,333,335,345,347]],["أم سلمة",[231]],["أبو سليم فالبخاري",[198]],["أبو طلحة",[160]],["الطيبي",[124,263,310,312,336]],["عائشة",[53,80,140,247]],["العباس",[17,47,72,303]],["عباس",[25,80,211,218]],["عبد الله",[239]],["عثمان",[27,209,305,306]],["العسقلاني",[227]],["علي",[17,266,300]],["عمر بن الخطاب",[62,72,80,95,111]],["فاطمة",[93,269]],["مالك",[220]],["مذهب بن عباس",[305]],["معاوية",[7]],["ميمونة",[73]],["نحو بن عباس",[234]],["النووي",[50,265]]]}