{"q":[],"h":[["أطفأها الله",240],["ألا من قال لا إله إلا الله فهو آمن، ومن وضع السلاح فهو آمن، ومن أغلق بابه فهو آمن",60],["إني لم أبعث باليهودية ولا النصرانية ولكني بعثت بالحنيفية السمحة والذي نفس محمد بيده لغدوة «4» أو روحة في سبيل الله خير من الدنيا وما فيها…",261],["بأن منهم صديقين ورهبانا",257],["رب أرني كيف تحي الموتى",365],["ما جاء بك",244],["ما من مولود إلا وقد ذر عليه من تراب حفرته",388],["من حلف على يمين فرأى غيرها خيرا منها فليأت الذي هو خير وليكفر عن يمينه",267],["هل تستطيع ربك",365],["والعين بالعين",193],["يا عماه «1» إن الله قد عصمني من الجن والإنس فلا أحتاج إلى من يحرسني",244]],"a":[["أحمد",[94]],["أحمد بن حنبل",[261]],["أبي أمامة الباهلي",[261]],["أنس بن مالك وعائشة",[144]],["أبي الدرداء",[60]],["ابن المبارك",[3]],["بعمر",[228]],["أبي بكر",[172,221]],["أبو بكر",[172]],["أبو بكر الصديق",[206,342]],["أبو بكر بن العربي",[85]],["أبي حنيفة",[304]],["أبو حنيفة",[316,338]],["الدارقطني",[225]],["سلمان",[279]],["سيبويه",[166]],["الشافعي",[96]],["الصديق",[225,284]],["عائشة",[14,31,40,105,160,288,365,374]],["ابن عباس",[223,233]],["عباس",[299]],["عثمان",[136]],["عثمان بن عفان",[325]],["علي بن أبي طالب",[52,155,221,277,414]],["أبو عمر",[325]],["عمر بن الخطاب",[153,183,294,332]],["كتابه",[346]],["مالك",[77,97]],["محسنا",[438]],["أبو محمد الدارمي",[102]],["محمد بن علي",[52]],["أبي منصور الماتريدي",[38]],["أبي هريرة وعائشة",[93]],["هشام بن عامر",[143]],["وعائشة",[284]],["وعمر بن الخطاب",[225]],["وفاطمة",[340]],["ابن وهب",[313]]]}