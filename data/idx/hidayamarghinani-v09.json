{"q":[["ولا يأب الشهداء إذا ما دعوا","البقرة: 282",98],["ولا تكتموا الشهادة ومن يكتمها فإنه آثم قلبه","البقرة: 283",98],["واللاتي يأتين الفاحشة من نسائكم فاستشهدوا عليهن أربعة منكم","النساء: 15",102],["ثم لم يأتوا بأربعة شهداء","النور: 4",102],["واستشهدوا شهيدين من رجالكم","البقرة: 282",104],["ممن ترضون من الشهداء","البقرة: 282",110],["وأشهدوا ذوي عدل منكم","الطلاق: 2",110],["إلا من شهد بالحق وهم يعلمون","الزخرف: 86",120],["ولا تقبلوا لهم شهادة أبدا","النور: 4",134],["إلا الذين تابوا","النور: 5",135],["وأولئك هم الفاسقون","النور: 4",135],["والكافرون هم الظالمون","البقرة: 254",150],["ولئن سألتهم من خلق السماوات والأرض ليقولن الله","لقمان: 25",342],["فادخلي في عبادي","الفجر: 29",442]],"h":[],"a":[]}