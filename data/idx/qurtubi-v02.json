{"q":[],"h":[["إن دماءكم وأموالكم وأعراضكم عليكم حرام",341],["إنكم تختصمون إلي ولعل بعضكم أن يكون ألحن بحجته من بعض فأقضي له على نحو مما أسمع فمن قطعت له من حق أخيه شيئا فلا يأخذه فإنما أقطع له قطعة من…",338],["الإضرار في الوصية من الكبائر (. وروى أبو داود عن أبي هريرة رضي الله عنه أن رسول الله صلى الله عليه وسلم قال: (إن الرجل أو المرأة ليعمل…",271],["اللهم منزل الكتاب سريع الحساب",435],["حولها «2» ندندن",433],["قل انظروا ماذا في السماوات والأرض «1»",202],["كل مسجد له مؤذن وإمام فالاعتكاف فيه يصلح",333],["لا اعتكاف إلا بصيام",334],["للصائم فرحتان يفرحهما إذا أفطر فرح بفطره وإذا لقي ربه فرح بصومه",331],["من صام رمضان ثم أتبعه ستا من شوال كان له كصيام الدهر",331]],"a":[["أبا أيوب",[102]],["أسامة بن زيد",[429]],["أبو العالية",[264]],["ابن العربي",[408]],["البخاري",[279,299]],["البراء بن عازب",[187]],["أبي بكر",[328]],["أبي بكر الصديق",[38,256,260]],["أبو بكر الصديق",[348]],["أبي بن كعب وعائشة",[63]],["جابر",[218]],["ابن جبير",[176]],["أبي حنيفة",[152]],["الخطابي",[133]],["أبي ذر",[167]],["سعيد بن جبير",[83]],["أم سلمة",[219]],["سمرة بن جندب",[318]],["الشافعي",[104,115,167,183,277]],["الشبلي",[191]],["الصديق",[66]],["أبي طالب",[122]],["عائشة",[39,46,48,58,59,123,166,222,224,281,282,319,326,357,391]],["ابن عباس",[39,59,62,97,159,165,191,393]],["ابن عباس وابن مسعود",[95]],["عبد الله بن الزبير",[124]],["عبد الله بن عباس",[295]],["عبد الله بن عمر",[323]],["عثمان",[6]],["علي بن أبي طالب",[61,224,365,382,385,432,435]],["أبو عمر",[226,248]],["ابن عمر",[263]],["عمر بن الخطاب",[59,73,87,95,114,257]],["عمران بن حصين",[271]],["عمرو بن العاص",[261]],["ابن ماجه",[225]],["مالك",[242,261,263,296,343,366,385]],["المصري",[171]],["معاذ بن جبل",[172]],["أبي هريرة",[35,140,145,165,175,198,200,215,225,235,271]],["أبو هريرة",[185]],["وعمر بن عبد العزيز",[195]]]}