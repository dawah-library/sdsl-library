{"q":[["لا يكلف الله نفسا إلا وسعها","",101],[": كل من عند الله","",101],["ما أصابك من حسنة فمن الله وما أصابك من سيئة فمن نفسك","",101],["اقرأ باسم ربك","",101],["ألم يعلم بأن الله يرى","",101],["وقفوهم إنهم مسؤولون","",775],["ذلك فضل الله يؤتيه من يشاء","",1143],["ائتيا طوعا أو كرها","",1207],["وأن تقولوا على الله ما لا تعلمون","",1329],["ولآمرنهم فليغيرن خلق الله","",1338],["وإنك لعلى خلق عظيم","",1760],["أفمن شرح الله صدره للإسلام فهو على نور من ربه فويل للقاسية قلوبهم من ذكر الله أولئك في ضلال مبين","",1761],["سعى في الأرض","",1761],["إن الله يأمر بالعدل والإحسان","",1761],["فاتقوا الله ما استطعتم","",1777],["ووجدوا ما عملوا حاضرا","",1924],["إنا فتحنا لك فتحا مبينا","",1937]],"h":[["إياكم والظن؛ فإن الظن أكذب الحديث",1329],["بعثت بالحنيفية السمحة",101],["من طلب الشهادة صادقا من قلبه أعطيها ولو لم تصبه",775]],"a":[["أجزاء",[2408]],["الأوس",[1679]],["ابن البرزالي",[2249]],["توفي",[575,1689]],["جعفر بن أبي طالب",[1754]],["الجمعة",[2439]],["الحجة",[1878]],["حذيفة",[101]],["الحرمين",[781]],["الحسين",[809,1404]],["حكيم بن حزام",[775]],["الدين",[813,1398,1694]],["السبعين",[1884]],["شابا",[665]],["الشاطبي",[41]],["الشافعي",[447]],["الشافعية",[1522]],["أبو شامة",[6]],["شعبان",[443,465,946]],["ابن شمامة",[1675]],["شهيدا",[968]],["شوال",[1240]],["شيخنا",[775]],["الشيوخ",[1859]],["عثمان",[326,1043]],["عثمان بن السكاكيني",[290]],["عثمان بن عفان",[326]],["عليا",[1329]],["الغزالي",[347]],["فاستشهد",[2477]],["فجاءة",[1377]],["فمات",[1209,2357]],["قاسيون",[1791,2280,2311]],["القرآن",[1918]],["كهلا",[2306]],["ابن مالك",[510]],["مالك بن أنس",[292]],["محمد بن أبي الفتح",[1143]],["النواوي",[1048]],["والعمل",[1488]],["والقاضي",[1760]],["وتوفي",[1476]],["ومات",[416]],["ومحبون",[276]],["ياسين بن يوسف المراكشي",[775]],["يوسف",[1374]]]}