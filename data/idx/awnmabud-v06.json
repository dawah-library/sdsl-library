{"q":[["وما كان لكم أن تؤذوا رسول الله","",53],["وكان أبوهما صالحا","",53],["حرمت عليكم أمهاتكم","",56],["محصنين غير مسافحين","",56],["الذين يرثون الفردوس","",78],["نساؤكم حرث لكم فأتوا حرثكم أنى شئتم","",140],["فاعتزلوا النساء في المحيض","",141],["ولا تنكحوا المشركات حتى يؤمن","",152],["فإن تنازعتم في شيء فردوه إلى الله والرسول إن كنتم تؤمنون بالله واليوم الآخر ذلك خير وأحسن تأويلا","",170],["وبعولتهن أحق بردهن في ذلك","",170],["الطلاق مرتان فإمساك بمعروف أو تسريح بإحسان","",170],["أقم الصلاة لدلوك الشمس","",178],["فطلقوهن لعدتهن","",178],["الطلاق مرتان","",200],["ولا تمسكوا بعصم الكوافر","",230],["يوسف أعرض عن هذا","",260],["أسكنوهن من حيث سكنتم من وجدكم","",276],["وإن كن أولات حمل فأنفقوا عليهن حتى يضعن حملهن","",276],["لا تخرجوهن من بيوتهن ولا يخرجن","",276],["لا تدري لعل الله يحدث بعد ذلك أمرا","",276],["فإذا بلغن أجلهن فأمسكوهن بمعروف أو فارقوهن بمعروف","",276],["لا تخرجوهن من بيوتهن","",277],["وإن تعاسرتم فسترضع له أخرى","",277],["فإن خرجن فلا جناح عليكم","",289],["وأولات الأحمال أجلهن أن يضعن حملهن","",289],["يتربصن بأنفسهن","",296],["وكلوا واشربوا حتى يتبين لكم الخيط الأبيض من الخيط الأسود من الفجر","",339],["الزانية والزاني فاجلدوا كل واحد منهما","",362],["والسارق والسارقة فاقطعوا أيديهما","",362],["واللاتي يأتين الفاحشة","",362]],"h":[],"a":[["أباه",[170]],["أحمد",[354]],["أحمد بن حنبل",[352]],["أسامة",[2]],["إسحاق",[354]],["اجتهاده",[170]],["البخاري",[120]],["بخبر بن عمر",[331]],["بعمر",[170]],["بلال",[2]],["تيمية",[20]],["أبي جهل لعلي",[53]],["الحبر بن مسعود",[41]],["حنيفة",[9]],["أبو حنيفة",[26,224,233,235]],["الدين بن القيم",[20,42,53,56,59,61,64,66,67,70,72,77,83,87,99,102,103,107,109,115,116,123,133,138,141,147,149,151,153,158,163,181,182,185,186,187,189,195,204,206,210,211,220,222,226,228,232,234,250,256,259,275,288,289,297,305,312,315,316,317,321,325,327,332,338,344,349,352,354]],["أبي سفيان أم المؤمنين",[284]],["أم سلمة",[328]],["سهل بن سعد",[342]],["السيوطي",[253]],["الشافعي",[9,141,148,153,166]],["شيخنا",[335]],["صحبة",[3]],["الصديق",[196]],["ا