{"q":[["وأولات الأحمال أجلهن أن يضعن حملهن","",40],["والمطلقات يتربصن","",40],["قل أي شيء أكبر شهادة","",44],["إن الذين أوتوا العلم من قبله إذا يتلى عليهم يخرون للأذقان سجدا","",49],["إذا تتلى عليهم آيات الرحمن خروا سجدا وبكيا","",49],["فلا تحل له من بعد حتى تنكح زوجا غيره","",66],["والذين يبتغون الكتاب","",66],["وما كان الله ليضل قوما بعد إذ هداهم حتى يبين لهم ما يتقون","",66],["وقد فصل لكم ما حرم عليكم","",66],["لا تأكلوا الربا أضعافا مضاعفة","",66]],"h":[],"a":[["أحمد بن حنبل",[88,101,236,277]],["أمر بن عباس",[306]],["أنس بن مالك",[149]],["البخاري",[137]],["أبو بكر الصديق",[149]],["أبي بكر الصديق",[155,291]],["أبي بكر وعمر",[149]],["تشهد بن مسعود",[45]],["جابر",[201,223]],["الحسنين",[115,116]],["الحسين بن علي",[158]],["حنبل",[213]],["أبي حنيفة",[42]],["الخطابي",[240]],["الدين بن القيم",[6,161,179,277]],["أم سلمة",[317]],["أم سليم",[247]],["الشافعي",[171,188,212,214,218,236,302,324]],["عائشة",[81,95,100,216,227,232,240,253,255,264,272,302]],["عباس",[114,116,124,189,274,277]],["عثمان",[104,106,245]],["علي بن أبي طالب",[159]],["عليا",[117]],["عمر بن الخطاب",[175,205]],["عمران بن حصين",[210]],["فاطمة",[217]],["فجعل بن عباس",[295]],["فعل بن عباس",[259]],["القيم",[158,293,297,331]],["الله بن عمر",[245]],["الله بن عمرو",[85]],["المؤلف",[218,284,309]],["مالك",[151,242]],["مالكا",[250]],["محمد بن إسماعيل",[252]],["مولى بن عباس",[259]],["ميمونة",[257]],["أبي هريرة",[31,243]],["وعثمان",[244]],["وعدله",[165]]]}