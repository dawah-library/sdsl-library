{"q":[["وأولات الأحمال أجلهن أن يضعن حملهن","الطلاق: ٤",40],["والمطلقات يتربصن","البقرة: ٢٢٨",40],["قل أي شيء أكبر شهادة","الأنعام: ١٩",44],["إن الذين أوتوا العلم من قبله إذا يتلى عليهم يخرون للأذقان سجدا","الإسراء: ١٠٧",49],["إذا تتلى عليهم آيات الرحمن خروا سجدا وبكيا","مريم: ٥٨",49],["فلا تحل له من بعد حتى تنكح زوجا غيره","البقرة: ٢٣٠",66],["والذين يبتغون الكتاب","النور: ٣٣",66],["وما كان الله ليضل قوما بعد إذ هداهم حتى يبين لهم ما يتقون","التوبة: ١١٥",66],["وقد فصل لكم ما حرم عليكم","الأنعام: ١١٩",66],["لا تأكلوا الربا أضعافا مضاعفة","آل عمران: ١٣٠",66]],"h":[],"a":[["أحمد بن حنبل",[88,101,236,277]],["أمر بن عباس",[306]],["أنس بن مالك",[149]],["البخاري",[137]],["أبو بكر الصديق",[149,155,291]],["أبو بكر وعمر",[149]],["تشهد بن مسعود",[45]],["جابر",[201,223]],["جعل بن عباس",[295]],["الحسين بن علي",[158]],["حنبل",[213]],["أبو حنيفة",[42]],["الخطابي",[240]],["الدين بن القيم",[6,161,179,277]],["أم سلمة",[317]],["أم سليم",[247]],["الشافعي",[171,188,212,214,218,236,302,324]],["عائشة",[81,95,100,216,227,232,240,253,255,264,272,302]],["عباس",[114,116,124,189,274,277]],["عبد الله بن عمر",[245]],["عبد الله بن عمرو",[85]],["عثمان",[104,106,244,245]],["علي بن أبي طالب",[159]],["عمر بن الخطاب",[175,205]],["عمران بن حصين",[210]],["فاطمة",[217]],["فعل بن عباس",[259]],["مالك",[151,242]],["محمد بن إسماعيل",[252]],["مولى بن عباس",[259]],["ميمونة",[257]],["أبو هريرة",[31,243]]]}