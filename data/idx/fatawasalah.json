{"q":[["إنا سنلقي عليك قولا ثقيلا","المزمل: ٥",10],["وخذ بيدك ضغثا فاضرب به ولا تحنث","ص: ٤٤",42],["سبحانك لا علم لنا إلا ما علمتنا إنك أنت العليم الحكيم","البقرة: ٣٢",69],["ففهمناها سليمان","الأنبياء: ٧٩",69],["رب اشرح لي صدري ويسر لي أمري واحلل عقدة من لساني يفقهوا قولي","طه: ٢٥-٢٨",69],["واللائي يئسن من المحيض من نسائكم إن ارتبتم فعدتهن ثلاثة أشهر","الطلاق: ٤",75],["وربائبكم اللاتي في حجوركم من نسائكم","النساء: ٢٣",92],["أفلا يعلم إذا بعثر ما في القبور وحصل ما في الصدور إن ربهم بهم يومئذ لخبير","العاديات: ٩-١١",93],["بل كذبوا بما لم يحيطوا بعلمه","يونس: ٣٩",94],["والشمس وضحاها","الشمس: ١",111],["الله يتوفى الأنفس حين موتها والتي لم تمت في منامها فيمسك التي قضى عليها الموت","الزمر: ٤٢",123],["قالوا أضغاث أحلام","",123],["الله يتوفى الأنفس","الزمر: ٤٢",123],["إن في ذلك لآيات لقوم يتفكرون","الرعد: ٣",124],["قل الروح من أمر ربي وما أوتيتم من العلم إلا قليلا","الإسراء: ٨٥",126],["اتقوا الله حق تقاته","آل عمران: ١٠٢",130],["فاتقوا الله ما استطعتم","التغابن: ١٦",130],["وأن ليس للإنسان إلا ما سعى","النجم: ٣٩",133],["من جاء بالحسنة فله عشر أمثالها","الأنعام: ١٦٠",134],["عوان بين ذلك","البقرة: ٦٨",138],["صفراء فاقع لونها","البقرة: ٦٩",138],["فسبحان الله حين تمسون وحين تصبحون وله الحمد في السماوات والأرض وعشيا وحين تظهرون","الروم: ١٧-١٨",150],["لم يكن الذين كفروا","البينة: ١",154],["ذلك فضل الله يؤتيه من يشاء","المائدة: ٥٤",163],["إن الأبرار لفي نعيم وإن الفجار لفي جحيم","الانفطار: ١٣-١٤",166],["ورفع أبويه على العرش","يوسف: ١٠٠",170],["يا أيها الذين آمنوا قاتلوا الذين يلونكم من الكفار","التوبة: ١٢٣",180],["إنا أرسلنا نوحا إلى قومه","نوح: ١",180],["لو كان فيهما آلهة إلا الله لفسدتا","الأنبياء: ٢٢",187],["ورضيت لكم الإسلام دينا","المائدة: ٣",197],["فلا تموتن إلا وأنتم مسلمون","البقرة: ١٣٢",197],["ولا يرضى لعباده الكفر","الزمر: ٧",197],["والشفع والوتر","الفجر: ٣",218],["وحب الحصيد","ق: ٩",223],["قل تعالوا","",230],["وأعدوا لهم ما استطعتم من قوة","الأنفال: ٦٠",455],["ومن يشاقق الرسول من بعد ما تبين له الهدى ويتبع غير سبيل المؤمنين نوله ما تولى ونصله جهنم وساءت مصيرا","النساء: ١