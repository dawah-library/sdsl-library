{"q":[["إنا سنلقي عليك قولا ثقيلا","",10],["وخذ بيدك ضغثا فاضرب به ولا تحنث","",42],["سبحانك لا علم لنا إلا ما علمتنا إنك أنت العليم الحكيم","",69],["ففهمناها سليمان","",69],["رب اشرح لي صدري ويسر لي أمري واحلل عقدة من لساني يفقهوا قولي","",69],["واللائي يئسن من المحيض من نسائكم إن ارتبتم فعدتهن ثلاثة أشهر","",75],["ربائبكم اللاتي في حجوركم من نسائكم","",92],["أفلا يعلم إذا بعثر ما في القبور وحصل ما في الصدور إن ربهم بهم يومئذ لخبير","",93],["بل كذبوا بما لم يحيطوا بعلمه","",94],["والشمس وضحاها","",111],["الله يتوفى الأنفس حين موتها والتي لم تمت في منامها فيمسك التي قضى عليها الموت","",123],["قالوا أضغاث أحلام","",123],["الله يتوفى الأنفس","",123],["إن في ذلك لآيات لقوم يتفكرون","",124],["قل الروح من أمر ربي وما أوتيتم من العلم إلا قليلا","",126],["اتقوا الله حق تقاته","",130],["فاتقوا الله ما استطعتم","",130],["وأن ليس للإنسان إلا ما سعى","",133],["من جاء بالحسنة فله عشر أمثالها","",134],["عوان بين ذلك","",138],["صفراء فاقع لونها","",138],["فسبحان الله حين تمسون وحين تصبحون وله الحمد في السماوات والأرض وعشيا وحين تظهرون","",150],["لم يكن الذين كفروا","",154],["ذلك فضل الله يؤتيه من يشاء","",163],["إن الأبرار لفي نعيم وإن الفجار لفي جحيم","",166],["ورفع أبويه على العرش","",170],["يا أيها الذين آمنوا قاتلوا الذين يلونكم من الكفار","",180],["إنا أرسلنا نوحا إلى قومه","",180],["لو كان فيهما آلهة إلا الله لفسدتا","",187],["ورضيت لكم الإسلام دينا","",197],["فلا تموتن إلا وأنتم مسلمون","",197],["ولا يرضى لعباده الكفر","",197],["والشفع والوتر","",218],["وحب الحصيد","",223],["قل تعالوا","",230],["وأعدوا لهم ما استطعتم من قوة","",455],["ومن يشاقق الرسول من بعد ما تبين له الهدى ويتبع غير سبيل المؤمنين نوله ما تولى ونصله جهنم وساءت مصيرا","",480],["كونوا قوامين بالقسط شهداء لله ولو على أنفسكم","",488],["ولا تكتموا الشهادة ومن يكتمها فإنه آثم قلبه","",488],["ولا تكتموا الشهادة","",488],["ما كان للمشركين أن يعمروا مساجد الله","",611],["إن علمتم فيهم خيرا","",624]],"h":[],"a":[["أبا المعالي بن الجويني",[206]],["أبا حامد الإسفرائيني",[260]],["أجاب",[118,123,130,131,133,134,135,136