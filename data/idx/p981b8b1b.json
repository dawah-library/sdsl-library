{"q":[["والشمس وضحاها (١) والقمر إذا تلاها (٢) والنهار إذا جلاها (٣) والليل إذا يغشاها (٤) والسماء وما بناها (٥) والأرض وما طحاها (٦) ونفس وما سواها (٧) فألهمها فجورها…","",8],["إذا تلاها","",8],["إذا جلاها","",8],["إذا يغشاها","",8],["وما بناها","",8],["وما طحاها","",8],["وما سواها","",8],["والأرض وما طحاها","",10],["ونفس وما سواها","",10],["قد أفلح من زكاها","",10],["وقد خاب من دساها","",10],["إذ ٱنۢبعث","",12],["رسول ٱلله","",12],["ناقة ٱلله وسقيها","",12],["ولا يخاف عقبها","",13],["كذبت ثمود بطغوىها","",13],["إذ ٱنۢبعث أشقىها","",13],["فقال لهم رسول ٱلله","",13],["فعقروها فدمدم عليهم ربهم بذنۢبهم","",13],["لا أقسم بهذا البلد","",16],["وأنت حل بهذا البلد","",16],["ووالد وما ولد","",16],["في كبد","",16],["لن يقدر عليه أحد","",16],["أيحسب أن لن يقدر عليه أحد","",17],["أهلكت مالا لبدا","",17],["أيحسب أن لم يره أحد","",17],["وهدينه النجدين","",17],["بهذا البلد","",17],["لقد خلقنا الإنسان في كبد","",17],["يقول أهلكت مالا لبدا","",17],["ألم نجعل له عينين","",18],["ولسانا وشفتين","",18],["فلا اقتحم","",20],["فك رقبة","",20],["في يوم ذي مسغبة","",20],["يتيما ذا مقربة","",20],["مسكينا ذا متربة","",20],["وتواصوا بالصبر","",20]],"h":[],"a":[["ابن القيم",[53]]]}