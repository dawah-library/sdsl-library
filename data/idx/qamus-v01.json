تنا به من آية","",1330],["متى نصر الله","",1330],["فأنجيناه وأصحاب السفينة","",1330],["ولقد أرسلنا نوحا وإبراهيم","",1330],["كذلك يوحي إليك وإلى الذين من قبلك","",1330],["إنا رادوه إليك، وجاعلوه من المرسلين","",1330],["يا ليتنا نرد ولا نكذب","",1330],["والقرآن الحكيم","",1330],["والتين والزيتون","",1330],["سبعة وثامنهم كلبهم","",1331],["وإليه النشور وأمنتم","",1331],["قال فرعون وآمنتم","",1331],["قال له صاحبه وهو يحاوره","",1331],["هاؤم اقرؤوا","",1331],["فألهمها فجورها وتقواها","",1331],["ها أنتم أولاء","",1332],["أيه الثقلان","",1332],["يوسف أعرض عن هذا","",1332],["ألا يا اسجدوا","",1332],["يا ليتني كنت معهم","",1332],["يا حسرة على العباد","",1332],["يا ويلتا أألد وأنا عجوز","",1332]],"h":[["أما أنا فلا آكل متكئا",32],["أنت نبيي وأنا ولدتك",303],["إذا رأيت أمتي تهاب الظالم أن تقول إنك ظالم فقد تودع منهم",746],["إن الله قد أبدله بيديه جناحين يطير بهما في الجنة حيث يشاء",192],["إن الله ليؤيد هذا الدين بالرجل الفاجر",1125],["إن لك في الجنة بيتا ويروى: كنزا وإنك لذو قرنيها أي: ذو طرفي الجنة وملكها الأعظم، تسلك ملك جميع الجنة، كما سلك ذو القرنين جميع الأرض",1199],["إن وسادك لعريض",301],["ارجعن مأزورات غير مأجورات",468],["الخراج بالضمان",162],["المهجر إلى الجمعة، كالمهدي بدنة",471],["تتبعوني أفنادا أفنادا يهلك بعضكم بعضا",283],["تمعددوا واخشوشنوا",274],["فذلكم الرباط",643],["كان يتنفس في الإناء",554],["لا توسدوا القرآن",302],["من منع صدقة فإنا آخذوها وشطر ماله",392],["ومن راح في الساعة الثانية ...",197],["يا أم الربيع كتاب الله القصاص",695],["يكره تعطر النساء، وتشبههن بالرجال",418]],"a":[["أبي بكر",[434]],["الجوهري",[4]],["علي بن أبي طالب",[37]]]}