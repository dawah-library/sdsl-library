{"q":[["فهزموهم بإذن الله وقتل","البقرة: ٢٥١",4],["يا أيها النبي قل لمن في أيديكم من الأسرى إن يعلم الله في قلوبكم خيرا يؤتكم خيرا مما أخذ منكم ويغفر لكم والله غفور رحيم","الأنفال: 70",162],["ومن الناس من يشري نفسه ابتغاء","البقرة: ٢٠٧",209],["ومن يخرج من بيته مهاجرا إلى الله ورسوله ثم يدركه الموت فقد وقع أجره على الله","النساء: 100",295]],"h":[["آخر زادك من الدنيا ضيح من لبن",198],["آخى بين المقداد وجبر بن عتيك",175],["أبا يحيى ربح البيع",209],["أعلم بإسلامك، فإن يكن كما تقول فالله يجزيك، فافد نفسك وابني أخويك: نوفل بن الحارث بن عبد المطلب، وعقيل بن أبي طالب بن عبد المطلب، وحليفك…",162],["أما إنه نعم الغلام",223],["إنه لمسقي",470],["إني سألت ربي عز وجل فقلت: اللهم إنك أخرجتني من أحب أرضك إلي فأنزلني أحب الأرض إليك، فأنزلني المدينة",127],["الحمد لله الذي هداك",308],["الصدقة في السر تطفئ غضب الرب",376],["بعث أبا بكر إلى خيبر فسار بالناس وانهزم حتى رجع",5],["تشهد أني رسول الله؟",9],["تقتلك الفئة الباغية",199],["دعه عنك فإنه قد جاء تائبا نازعا",392],["شرار أمتي قوم ولدوا في النعيم وغذوا به، يأكلون من الطعام ألوانا، ويلبسون من الثياب ألوانا، ويركبون من الدواب ألوانا يتشدقون في الكلام",377],["غفر الله لك ولأمك يا حذيفة",193],["لئن كان سعد لم يشهدها لقد كان عليها حريصا",112],["لا تلبسوا الديباج والحرير، ولا تشربوا في آنية الفضة والذهب، فإنها لهم في الدنيا، ولنا في الآخرة",16],["لقد سألني هذا عن الذي سألني عنه، ولا علم لي بشيء منه حتى أتاني الله تعالى به",289],["لولا إنك رسول لقتلتك",9],["من أحب أن ينظر إلى امرأة من الحور العين فلينظر إلى أم رومان",280],["من رمى بسهم في سبيل الله فهو عدل محرر، ومن شاب شيبة في الإسلام كانت له نورا يوم القيامة، وأيما رجل مسلم أعتق رجلا مسلما، فإن الله جاعل كل…",8],["من كانت عنده نصيحة لذي سلطان فلا يكلمه بها علانية، وليأخذ بيده، وليخل به، فإن قبلها قبلها، وإلا كان قد أدى الذي عليه والذي له",142],["من كنت مولاه فعلي مولاه",25],["من لكعب بن الأشرف؟ فإنه قد آذى الله ورسوله",247],["من له علم بسلاح هذا الغلام؟",223],["نبلوا سهلا فإنه سهل",212],["هل تتهمون به من أحد؟",214],["وقد فعلوها؟ والذي نفسي بيده لا يؤمن أحدهم حتى يحبكم لحبي، أترجون أن تدخلوا الجنة بشفاعتي فلا يرجوها بنو عبد المطلب",378],["يا أبا رقاد نمت حتى ذهب سلاحك",223],["يتعوذ من عذاب القبر",108]],"a":[["الأحنف بن قيس",[424,425]],["أسد بن عبد العزى",[48]],["أسماء بن حارثة الأنصاري",[345]],["الأسود بن سريع",[426]],["أبو أسيد الساعدي",[330]],["أسيد بن حضير الأنصاري",[140]],["الأشعث بن قيس الكندي",[340]],["ابن أم مكتوم المؤذن",[462]],["أبو أمامة الباهلي",[473]],["أبو أمية الأزدي",[418]],["أنس بن مالك",[3,6]],["أنس بن مالك الأنصاري",[383]],["أبو أوفى الأسلمي",[380]],["أويس بن عامر القرني",[210]],["أبو أيوب الأنصاري",[267]],["إياس بن معاذ الأشهلي",[46]],["إيماء بن رحضة",[404]],["ابصة بن معبد الأسدي",[437]],["أبو ابن سلول",[396]],["اثلة بن الأسقع",[379]],["أبو الأرقم المخزومي",[317]],["ابن البرصاء الليثي",[448]],["أبو الجعد الضمري",[443]],["أبو العاص الثقفي",[256,433]],["أبو العاص بن الربيع",[468]],["أبو المليح",[439]],["أبو اليسر الأنصاري",[321]],["بابة بن عبد المنذر",[458]],["بديل بن ورقاء",[201]],["أبو بردة بن نيار",[456]],["بسر بن أبي أرطأة",[402]],["بشر بن وقش الأشهلي",[84]],["بشير بن سعد الأنصاري",[349]],["بصرة بن أبي بصرة",[406]],["أبو بكر",[12,93,103]],["أبو بكر الصديق",[98,128,279,282]],["بكر بن أبي قحافة",[11]],["أبو بكر وعمر",[135]],["بلال بن الحارث المزني",[331,332]],["أبو بلتعة اللخمي",[153]],["أبي بن كعب",[154]],["ابن بيضاء",[453]],["أبو ثابت",[211]],["ثعلبة بن صعير العدوي",[129]],["ثعلبة بن عنمة الأنصاري",[86]],["جابر",[2,134]],["جابر بن سمرة السوائي",[431]],["جابر بن عبد الله",[372]],["جارية بن قدامة التميمي",[427]],["جبار بن صخر",[75]],["أبو جحيفة السوائي",[432]],["جعدة بن هبيرة المخزومي",[55]],["جميل بن بصرة الغفاري",[405]],["الحارث بن جزء الزبيدي",[461]],["الحارث بن عبد المطلب",[106,113]],["الحارث بن هشام المخزومي",[126]],["أبو حبة البدري",[459]],["حبيب بن مسلمة الفهري",[172,241]],["حبيب بن وهب الجمحي",[190]],["حجر بن عدي",[276]],["أبو حدرد الأسلمي",[382]],["أبو حذيفة",[79]],["حذيفة بن أسيد الغفاري",[408]],["حذيفة بن اليمان",[192]],["حرب بن أمية",[60]],["حسان بن ثابت الأنصاري",[297]],["الحسن بن علي",[21]],["الحسين بن علي الشهيد",[45]