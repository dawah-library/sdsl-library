{"q":[],"h":[["أفلح وأبيه إن صدق",17],["أما إن كل بناء وبال على صاحبه إلا ما لا إلا ما لا",63],["أما بعد فإني أحمد إليك الله",435],["أنه جعل في جف طلعة ذكر",276],["أنه كان أنور المتجرد",254],["أنه كان مبخوص العقبين",100],["أنه كان يتكلم بجوامع الكلم",293],["احثوا في وجوه المداحين التراب",182],["بين يدي الساعة تقاتلون قوما نعالهم الشعر وهو هذا البارز",122],["دامغ جيشات الأباطيل",322],["شهيدك يوم الدين وبعيثك نعمة",136],["عاري الثندوتين",221],["عليكم بسنتي وسنة الخلفاء الراشدين من بعدي",105],["غر محجلون",433],["فأبد بصره إلى السواك",103],["فاعترضهم إبليس في صورة شيخ جليل عليه بت",90],["فلما رآه أجوف عرف أنه خلق لا يتمالك",314],["فما زال جسمه يحري",373],["فمضغ تمرا وحنكه به",449],["فوجد من نفسه خفة فاجتنح على أسامة حتى دخل المسجد",303],["فوجدت ليده بردا وريحا كأنما أخرجها من جونة عطار",316],["فيه فص حبشى",328],["قال العباس لعلي رضي الله عنه: كيف أصبح رسول الله صلى الله عليه وسلم؟ فقال: اصبح بحمد الله بارئا",109],["قال بعضهم إذا أصبح فأثبتوه بالوثاق",203],["قال: إن لي أسماء وعد فيها: وأنا الحاشر",386],["قالت لعائشة رضي الله عنها: إني إذن لبذرة",108],["قالت: وقد وفت لي جميمة",298],["كان أسيل الخد",47],["لا إيمان لمن لا أمانة له",67],["لا تؤبن فيه الحرم",15],["لا حلف في الإسلام",422],["ليس بالجافي ولا المهين",279],["ليس بالطويل البائن",174],["ليس بالطويل المتثنى",223],["من رآه بديهة هابه",106],["من رآه جهره",318],["نبي ضيعه قومه",103],["وأيما حلف كان في الجاهلية لم يزده الإسلام إلا شدة",422],["وبارك على محمد وعلى آل محمد",118],["وكانت ناقة مجرسة",258],["وللعاهر الحجر",182],["ويفتر عن مثل حب الغمام",324],["يتحدر منه العرق مثل الجمان",299],["يمشي الهوينا يبذ القوم",108]],"a":[["أبا بكر وعمر",[66,216]],["أبا ذر",[308]],["أباها",[77,203,214,239,319,388]],["أبيها",[81]],["أسماء",[195]],["أبي أيوب",[200]],["إبراهيم بن إسحاق الحربي",[4]],["أبي الدرداء",[193,214,271,310,340]],["ابن الزبير",[212,251,296,325,357]],["البراء",[62,246]],["البستي",[5]],["البغدادي",[8]],["أبي بكر",[78,115,199,243,255,260,288,361,421,460]],["أبي بكر الصديق",[122]],["أبي بكرة ومعاوية",[147]],["بلال",[70,2