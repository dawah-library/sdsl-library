{"q":[["وكذلك نولي بعض الظالمين بعضا بما كانوا يكسبون","الأنعام: 129",9],["وإذ غدوت من أهلك تبوئ المؤمنين مقاعد للقتال والله سميع عليم","آل عمران: 121",22],["تلك أمة قد خلت لها ما كسبت ولكم ما كسبتم ولا تسألون عما كانوا يعملون","البقرة: 134",24],["بل الساعة موعدهم والساعة أدهى وأمر","القمر: 46",27],["ومن يهن الله فما له من مكرم","الحج: 18",42],["أو صديقكم","النور: 61",51],["إنما يخشى الله من عباده العلماء","فاطر: 28",54],["ذلك فضل الله يؤتيه من يشاء والله ذو الفضل العظيم","الحديد: 21",81],["إن الله يأمر بالعدل والإحسان وإيتاء ذي القربى وينهى عن الفحشاء والمنكر والبغي يعظكم لعلكم تذكرون","النحل: 90",87],["فلما تراءى الجمعان قال أصحاب موسى إنا لمدركون","الشعراء: 61",88],["ولينصرن الله من ينصره","الحج: 40",103],["يا أيها الذين آمنوا لا ترفعوا أصواتكم فوق صوت النبي","الحجرات: 2",106],["الرحمن على العرش استوى","طه: 5",109],["ولنبلونكم حتى نعلم المجاهدين منكم والصابرين","محمد: 31",110],["أولما أصابتكم مصيبة قد أصبتم مثليها قلتم أنى هذا قل هو من عند أنفسكم","آل عمران: 165",110],["وما أصابكم من مصيبة فبما كسبت أيديكم ويعفوا عن كثير","الشورى: 30",110],["ثم أتموا الصيام إلى الليل","البقرة: 187",131],["سينالهم غضب من ربهم وذلة في الحياة الدنيا وكذلك نجزي المفترين","الأعراف: 152",138],["تلك الدار الآخرة نجعلها للذين لا يريدون علوا في الأرض ولا فسادا والعاقبة للمتقين","القصص: 83",140],["ويحبون أن يحمدوا بما لم يفعلوا","آل عمران: 188",146],["لا ترفعوا أصواتكم فوق صوت النبي","الحجرات: 2",150],["فلولا نفر من كل فرقة منهم طائفة ليتفقهوا في الدين","التوبة: 122",150],["وليخش الذين لو تركوا من خلفهم ذرية ضعافا خافوا عليهم فليتقوا الله","النساء: 9",166],["واتقوا يوما ترجعون فيه إلى الله","البقرة: 281",166],["ما أصاب من مصيبة في الأرض ولا في أنفسكم إلا في كتاب من قبل أن نبرأها","الحديد: 22",168],["فأينما تولوا فثم وجه الله","البقرة: 115",168],["قالت إني أعوذ بالرحمن منك إن كنت تقيا","مريم: 18",168],["يا عبادي الذين آمنوا إن أرضي واسعة","العنكبوت: 56",169],["فاذكروني أذكركم","البقرة: 152",169],["ونكتب ما قدموا وآثارهم","يس: 12",169],["وقد كانوا يدعون إلى السجود وهم سالمون","القلم: 43",169