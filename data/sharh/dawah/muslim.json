{"8":[{"w":"burhami","pj":"muslim","a":"a2","an":"الشيخ ياسر برهامي","t":"شرح صحيح مسلم — الشيخ ياسر برهامي","sb":"p1f08a935","p":15,"pz":81,"segs":[[94,126],[341,342],[343,347],[348,349],[350,355],[356,357],[358,361],[382,382],[407,408],[424,431],[635,640]],"f":[{"k":"faida","m":"الرجوع إلى الصحابة وأهل العلم عند ظهور الشبهات","q":"فهذه جزئية هامة في هذا المنهج العظيم الذي ينبغي عند ورود الشبهات سؤال أهل العلم، وأهل العلم هم أصحاب رسول الله ﷺ، وهذا هو المنهج السلفي الذي لا محيد عنه وهو الرجوع إلى أقوال الصحابة وفهمهم عند ورود الشبهات."},{"k":"faida","m":"حكم غلاة القدرية الأوائل المنكرين للعلم والقدر","q":"أما مسألة تكفير القدرية: فالأوائل الغلاة كمعبد الجهني وغيره الذين يُصرحون بنفي القدر صراحةً، مع تصريح القرآن ﴿إِنَّا كُلَّ شَيْءٍ خَلَقْنَاهُ بِقَدَرٍ﴾ فلفظ القدر نفسه موجود في القرآن، فعندما ينفي القدر كلية وينفي علم الله ﷻ وهو معلوم من الدين بالضرورة، فلا شك في كفرهم"},{"k":"tarjih","m":"حقيقة الإيمان واشتراط الحب والتعظيم فيه","q":"والصحيح أنه لا يطلق على التصديق المجرد إيمان إذا لم يكن معه حب وتعظيم، ولذلك لا يقال: آمنت أن الشمس قد طلعت، ولكن يقال مثل: سل فلانًا أطلعت الشمس يقول: نعم، فتقول: صدقته؛ لأن هذا الأمر ليس فيه حب ولا تعظيم"},{"k":"tarjih","m":"المراد بالأعراب في آية سورة الحجرات","q":"كالأعراب على أرجح الأقوال في قوله ﴿قَالَتِ الأَعْرَابُ آمَنَّا قُلْ لَمْ تُؤْمِنُوا وَلَكِنْ قُولُوا أَسْلَمْنَا وَلَمَّا يَدْخُلِ الإِيمَانُ فِي قُلُوبِكُمْ﴾."}],"fst":"draft","at":"2026-11-20"}],"9":[{"w":"burhami","pj":"muslim","a":"a2","an":"الشيخ ياسر برهامي","t":"شرح صحيح مسلم — الشيخ ياسر برهامي","sb":"p1f08a935","p":60,"pz":67,"segs":[[440,440],[510,513]]}],"10":[{"w":"burhami","pj":"muslim","a":"a2","an":"الشيخ ياسر برهامي","t":"شرح صحيح مسلم — الشيخ ياسر برهامي","sb":"p1f08a935","p":69,"pz":69,"segs":[[527,527],[533,536]]}],"11":[{"w":"burhami","pj":"muslim","a":"a2","an":"الشيخ ياسر برهامي","t":"شرح صحيح مسلم — الشيخ ياسر برهامي","sb":"p1f08a935","p":73,"pz":78,"segs":[[560,560],[561,561],[570,573],[574,579],[580,604],[605,623]]}],"12":[{"w":"burhami","pj":"