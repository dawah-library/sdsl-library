{"1":[["سَبَّحَ لِلَّهِ","نَزَّهَ اللَّهَ عَمَّا لَا يَلِيقُ بِجَلَالِهِ سُبْحَانَهُ."]],"3":[["كَبُرَ مَقْتاً","عَظُمَ بُغْضًا."]],"4":[["صَفّاً","صَافِّينَ صَفًّا."],["مَرْصُوصٌ","مُتَرَاصٌّ مُحْكَمٌ لَا فُرْجَةَ فِيهِ، وَلَا يَنْفُذُ فِيهِ العَدُوُّ."]],"5":[["زَاغُوا","عَدَلُوا عَنِ الحَقِّ، مَعَ عِلْمِهِمْ بِهِ."],["أَزَاغَ اللَّهُ قُلُوبَهُمْ","صَرَفَهَا عَنْ قَبُولِ الحَقِّ؛ جَزَاءً عَلَى زَيْغِهِمْ."]],"6":[["لِمَا بَيْنَ يَدَيَّ","لِمَا جَاءَ قَبْلِي."],["بِالْبَيِّنَاتِ","بِالآيَاتِ الوَاضِحَاتِ."]],"7":[["وَمَنْ أَظْلَمُ","لَا أَحَدَ أَشَدُّ ظُلْمًا، وَعُدْوَانًا."],["افْتَرَى","اخْتَلَقَ."],["يُدْعَى إِلَى الْإِسْلَامِ","يُدْعَى إِلَى الدُّخُولِ فِي الإِسْلَامِ."]],"8":[["نُورَ اللَّهِ","الحَقَّ الَّذِي جَاءَ بِهِ الرَّسُولُ ﷺ."],["بِأَفْوَاهِهِمْ","بِأَقْوَالِهِمُ الكَاذِبَةِ."],["مُتِمُّ نُورِهِ","مُظْهِرُ الحَقِّ بِإِتْمَامِ دِينِهِ."]],"9":[["لِيُظْهِرَهُ","لِيُعْلِيَهُ."],["الدِّينِ كُلِّهِ","الأَدْيَانِ المُخَالِفَةِ كُلِّهَا."]],"13":[["وَأُخْرَى","وَنِعْمَةٌ أُخْرَى لَكُمْ."]],"14":[["لِلْحَوَارِيِّينَ","أَصْفِيَاءِ عِيسَى ﷺ، وَخَوَاصِّهِ."],["فَأَيَّدْنَا","قَوَّيْنَا، وَنَصَرْنَا."],["ظَاهِرِينَ","غَالِبِينَ."]]}