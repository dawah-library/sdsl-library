{"1":[["لِلْمُطَفِّفِينَ","الَّذِينَ يُبْخِسُونَ الْمِكْيَالَ، وَالْمِيزَانَ."]],"3":[["يُخْسِرُونَ","يُنْقِصُونَ فِي الْمِكْيَالَ، وَالْمِيزَانِ."]],"7":[["كِتَابُ الْفُجَّارِ","كِتَابُ أَعْمَالِهِمْ، أَوْ مَصِيرُهُمْ."],["سِجِّينٍ","سِجْنٍ، وَضِيقٍ."]],"9":[["رَقُومٌ","مَكْتُوبٌ كَالرَّقْمِ فِي الثَّوْبِ لَا يُمْحَى."]],"12":[["مُعْتَدٍ","ظَالِمٍ مُتَجَاوِزٍ لِلْحَدِّ."],["أَثِيمٍ","كَثِيرِ الْإِثْمِ."]],"13":[["أَسَاطِيرُ","أَبَاطِيلُ."]],"14":[["رَانَ","غَطَّى."]],"15":[["لَمَحْجُوبُونَ","مَحْرُومُونَ مِنْ رُؤْيَةِ رَبِّهِمْ."]],"16":[["لَصَالُوا الْجَحِيمِ","لَدَاخِلُو النَّارِ يُقَاسُونَ حَرَّهَا."]],"18":[["لَفِي عِلِّيِّينَ","لَفِي مَرْتَبَةٍ، وَمَكَانٍ عَالٍ."]],"23":[["الْأَرَائِكِ","الْأَسِرَّةُ الْمُزَيِّنَةُ بِالسُّتُورِ، وَالثِّيَابِ."]],"24":[["نَضْرَةَ","بَهْجَةً."]],"25":[["رَحِيقٍ","خَمْرٍ صَافِيَةٍ."]],"26":[["خِتَامُهُ مِسْكٌ","آخِرُهُ رَائِحَةُ الْمِسْكِ."]],"27":[["وَمِزَاجُهُ","خَلْطُهُ."],["تَسْنِيمٍ","عَيْنٌ فِي أَعْلَى الْجَنَّةِ."]],"28":[["يَشْرَبُ بِهَا","يَشْرَبُونَ مُتَلَذِّذِينَ بِهَا."]],"31":[["انْقَلَبُوا","رَجَعُوا."],["فَكِهِينَ","مُتَلَذِّذِينَ بِسُخْرِيَّتِهِمْ مِنَ الْمُؤْمِنِينَ."]],"33":[["حَفِيظِينَ","رُقَبَاءُ يُحْصُونَ أَعْمَالَهُمْ."]],"36":[["ثُوِّبَ","جُوزِيَ."]]}