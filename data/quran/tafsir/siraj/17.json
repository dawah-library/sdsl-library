{"64":[["وَأَجْلِبْ","اجْمَعْ، وَصِحْ عَلَيْهِمْ."],["بِخَيْلِكَ وَرَجِلِكَ","بِجُنُودِكَ الرَّاكِبِينَ، وَالرَّاجِلِينَ فِي مَعْصِيَةِ اللَّهِ."],["غُرُورًا","بَاطِلًا وَخِدَاعًا."]],"66":[["يُزْجِي","يُسَيِّرُ، وَيُجْرِي."],["الْفُلْكَ","السُّفُنَ."]],"67":[["ضَلَّ","غَابَ."]],"68":[["حَاصِبًا","رِيحًا شَدِيدَةً تَرْمِيكُمْ بِالْحَصْبَاءِ."],["وَكِيلًا","حَافِظًا يَحْفَظُكُمْ."]],"69":[["قَاصِفًا مِنَ الرِّيحِ","رِيحًا شَدِيدَةً لَا تَمُرُّ عَلَى شَيْءٍ إِلَّا كَسَرَتْهُ."],["تَبِيعًا","تَابِعًا، وَمُطَالِبًا يُطَالِبُ بِالثَّأْرِ مِنَّا."]],"71":[["بِإِمَامِهِمْ","بِمَنْ كَانُوا يَقْتَدُونَ بِهِ فِي الدُّنْيَا."],["وَلَا يُظْلَمُونَ","لَا يُنْقَصُونَ."],["فَتِيلًا","قَدْرَ الْخَيْطِ الَّذِي يَكُونُ فِي شَقِّ النَّوَاةِ."]],"73":[["كَادُوا","قَارَبُوا."],["لَيَفْتِنُونَكَ","لَيَصْرِفُونَكَ، وَيُوقِعُونَكَ فِي الْفِتْنَةِ."],["لِتَفْتَرِيَ","لِتَخْتَلِقَ، وَتَكْذِبَ."],["خَلِيلًا","حَبِيبًا خَالِصًا."]],"75":[["ضِعْفَ الْحَيَوةِ","عَذَابًا مُضَاعَفًا فِي الدُّنْيَا."],["وَضِعْفَ الْمَمَاتِ","عَذَابًا مُضَاعَفًا فِي الْآخِرَةِ."]],"76":[["كَادُوا","قَارَبُوا."],["لَيَسْتَفِزُّونَكَ","أَنْ يُخْرِجُوكَ مِنْ مَكَّةَ؛ بِإِزْعَاجِهِمْ إِيَّاكَ."]],"77":[["تَحْوِيلًا","تَغْيِيرًا."]],"78":[["لِدُلوكِ الشَّمْسِ","مِنْ وَقْتِ زَوَالِ الشَّمْسِ عِنْدَ الظَّهِيرَةِ."],["غَسَقِ الَّيْلِ","ظُلْمَتِهِ."],["مَشْهُودًا","تَحْضُرُهَا مَلَائِكَةُ اللَّيْلِ وَالنَّهَارِ."]],"79":[["فَتَهَجَّدْ","قُمْ مِنْ نَوْمِكَ فِي اللَّيْلِ لِلصَّلَاةِ."],["نَافِلَةً لَكَ","زِيَادَةً لَكَ فِي عُلُوِّ الْقَدْرِ، وَرَفْعِ الدَّرَجَاتِ."],["مَقَامًا مَحْمُودًا","مَقَامَ الشَّفَاعَةِ الْعُظْمَى لِفَصْلِ الْقَضَاءِ يَوْمَ الْقِيَامَةِ."]],"80":[["مُدْخَلَ صِدْقٍ","أَيْ: إِدْخَالًا مَرْضِيًّا."],["سُلْطَانًا","حُجَّةً، وَقُوَّةً."]],"81":[["وَزَهَقَ","بَطَلَ، وَاضْمَحَلَّ."],["زَهُوقًا","لَا بَقَاءَ لَهُ، وَلَا ثَبَاتَ."]],"83":[["وَنَأَى بِجَانِبِهِ","تَبَاعَدَ عَنْ طَاعَةِ رَبِّهِ كِبْرًا، وَعَنَادًا."],["يُئُوسًا","قَنُوطًا مِنْ رَحْمَةِ اللَّهِ."]],"84":[["شَاكِلَتِهِ","طَرِيقَتِهِ، وَمَا يَلِيقُ بِهِ."]],"89":[["صَرَّفْنَا","نَوَّعْنَا وَبَيَّنَّا."]],"90":[["يَنْبُوعًا","عَيْنًا جَارِيَةً."]],"92":[["كِسَفًا","قِطَعًا."],["قَبِيلًا","نُشَاهِدُهُمْ مُقَابَلَةً وَعِيَانًا."]],"93":[["زُخْرُفٍ","ذَهَبٍ."]],"97":[["وَبُكْمًا","لَا يَنْطِقُونَ."],["خَبَتْ","سَكَنَ لَهِيبُهَا."]],"100":[["قَتُورًا","مُبَالِغًا فِي الْبُخْلِ."]],"101":[["مَسْحُورًا","مَغْلُوبًا عَلَى عَقْلِكَ بِالسِّحْرِ."]],"102":[["بَصَائِرَ","دَلَائِلُ تَدُلُّ أَهْلَ الْبَصِيرَةِ عَلَى وَحْدَانِيَّةِ اللَّهِ، وَعَلَى صِدْقِي."],["لَأَظُنُّكَ","لَأُوقِنُ أَنَّكَ."],["مَثْبُورًا","هَالِكًا مَغْلُوبًا مَلْعُونًا."]],"103":[["يَسْتَفِزَّهُمْ","يُخْرِجْهُمْ."],["مِنَ الْأَرْضِ","أَرْضِ مِصْرَ."]],"104":[["اسْكُنُوا الْأَرْضَ","اسْكُنُوا أَرْضَ الشَّامِ."],["لَفِيفًا","جَمِيعًا."]],"106":[["فَرَقْنٰهُ","بَيَّنَاهُ، وَفَصَلْنَاهُ فَارِقًا بَيْنَ الْهُدَى، وَالضَّلَالِ."],["مُكْثٍ","تُؤْدَةٍ، وَتَمَهُّلٍ."],["وَنَزَّلْنُهُ تَنْزِيلًا","أَنْزَلْنَاهُ شَيْئًا بَعْدَ شَيْءٍ عَلَى حَسَبِ الْمَصَالِحِ."]],"107":[["يَخِرُّونَ لِلْأَذْقَانِ","يَسْجُدُونَ عَلَى وُجُوهِهِمْ."]],"110":[["وَلَا تُخَافِتْ بِهَا","وَلَا تُسِرَّ بِهَا."],["وَابْتَغِ بَيْنَ ذَلِكَ سَبِيلًا","كُنْ وَسَطًا فِي الْقِرَاءَةِ بَيْنَ الْجَهْرِ، وَالْمُخَافَتَةِ."]]}