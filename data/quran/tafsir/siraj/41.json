{"3":[["فُصِّلَتْ","بُيِّنَتْ آيَاتُهُ، وَوُضِّحَتْ مَعَانِيهِ."]],"5":[["أَكِنَّةٍ","أَغْطِيَةٍ مَانِعَةٍ مِنْ فَهْمِ مَا تَدْعُونَا إِلَيْهِ."],["وِقْرٌ","صَمَمٌ، وَثِقْلٌ."]],"6":[["فَاسْتَقِيمُوا إِلَيْهِ","اسْلُكُوا الطَّرِيقَ الْمُوَصِلَ إِلَيْهِ."],["وَيْلٌ","هَلَاكٌ، وَعَذَابٌ."]],"8":[["غَيْرِ مَمْنُونٍ","غَيْرِ مَقْطُوعٍ، وَلَا مَمْنُوعٍ."]],"9":[["أَنْدَاداً","شُرَكَاءَ، وَنَظَرَاءَ."]],"10":[["رَوَاسِيَ","جِبَالًا ثَوَابِتَ."],["أَقْوَاتَهَا","أَرْزَاقَ أَهْلِهَا."],["فِي أَرْبَعَةِ أَيَّامٍ","يَوْمَانِ لِخَلْقِ الْأَرْضِ، وَيَوْمَانِ لِخَلْقِ الرَّوَاسِيِ، وَتَقْدِيرِ الْأَقْوَاتِ."],["سَوَاءً","فِي تَمَامِ أَرْبَعَةِ أَيَّامٍ مُسْتَوِيَةٍ؛ بِلَا زِيَادَةٍ، وَلَا نُقْصَانٍ."]],"11":[["اسْتَوَى","قَصَدَ."]],"12":[["فَقَضَاهُنَّ","فَخَلَقَهُنَّ، وَأَبْدَعَهُنَّ."],["بِمَصَابِيحَ","بِنُجُومٍ مُضِيئَةٍ."],["وَحِفْظاً","حَرَسًا مِنَ الشَّيَاطِينِ."]],"13":[["أَنْذَرْتُكُمْ","خَوَّفْتُكُمْ."],["صَاعِقَةً","عَذَابًا هَائِلًا."]],"16":[["صَرْصَراً","شَدِيدَةَ الْبُرُودَةِ، عَالِيَةَ الصَّوْتِ."],["نَحِسَاتٍ","مَشْؤُومَاتٍ."],["الْخِزْيِ","الذُّلِّ وَالْهَوَانِ."]],"17":[["فَهَدَيْنَاهُمْ","فَبَيَّنَّا لَهُمْ سَبِيلَ الْحَقِّ."],["فَاسْتَحَبُّوا","فَاخْتَارُوا."],["الْهُونِ","الْمُهِينِ."]],"19":[["يُوزَعُونَ","يُرَدُّ أَوَّلُهُمْ عَلَى آخِرِهِمْ."]],"22":[["تَسْتَتِرُونَ","تَسْتَخْفُونَ عِنْدَ ارْتِكَابِكُمُ الْمَعَاصِيَ."],["أَنْ يَشْهَدَ","خَوْفًا مِنْ أَنْ يَشْهَدَ."]],"23":[["أَرْدَاكُمْ","أَهْلَكَكُمْ."]],"24":[["مَثْوَىً","مَأْوَىً وَمَسْكَنٌ."],["يَسْتَعْتِبُوا","يَطْلُبُوا الْعُتْبَى وَهِيَ الْمَغْفِرَةُ."],["فَمَا هُمْ مِنَ الْمُعْتَبِينَ","مَا هُمْ مِنَ الْمُجَابِينَ إِلَى مَا طَلَبُوا."]],"25":[["وَقَيَّضْنَا","هَيَّأْنَا."],["قُرَنَاءَ","مُصَاحِبِينَ مِنْ شَيَاطِينِ الْإِنْسِ وَالْجِنِّ."],["وَحَقَّ عَلَيْهِمُ الْقَوْلُ","وَجَبَ عَلَيْهِمُ الْوَعِيدُ بِالْعَذَابِ."],["خَلَتْ","مَضَتْ."]],"26":[["وَالْغَوْا فِيهِ","ائْتُوا بِاللَّغْوِ؛ مِنَ الصَّفِيرِ، وَالصِّيَاحِ، وَالْجَلَبَةِ، عِنْدَ قِرَاءَتِهِ."]],"29":[["الْأَسْفَلِينَ","فِي الدَّرْكِ الْأَسْفَلِ مِنَ النَّارِ."]],"30":[["اسْتَقَامُوا","ثَبَتُوا عَلَى الْحَقِّ عِلْمًا، وَعَمَلًا."]],"31":[["أَوْلِيَاؤُكُمْ","أَنْصَارُكُمْ."],["تَدَّعُونَ","تَطْلُبُونَ."]],"32":[["نُزُلاً","ضِيَافَةً، وَإِنْعَامًا."]],"33":[["وَمَنْ أَحْسَنُ","لَا أَحَدَ أَفْضَلُ."]],"34":[["وَلِيٌّ حَمِيمٌ","قَرِيبٌ لَكَ، شَفِيقٌ عَلَيْكَ."]],"35":[["وَمَا يُلَقَّاهَا","مَا يُوفَّقُ لَهَا."],["ذُو حَظٍّ عَظِيمٍ","صَاحِبُ نَصِيبٍ وَافِرٍ؛ مِنَ السَّعَادَةِ، وَالْخُلُقِ، وَالْخَيْرِ."]],"36":[["يَنْزَغَنَّكَ","يُلْقِيَنَّ فِي نَفْسِكَ وَسْوَسَةً، وَيَصْرِفَنَّكَ عَنِ الْخَيْرِ."],["فَاسْتَعِذْ بِاللَّهِ","اسْتَجِرْ، وَاعْتَصِمْ بِاللَّهِ قَائِلًا: أَعُوذُ بِاللَّهِ مِنَ الشَّيْطَانِ الرَّجِيمِ."]],"39":[["خَاشِعَةً","يَابِسَةً لَا نَبَاتَ فِيهَا."],["اهْتَزَّتْ","دَبَّتْ فِيهَا الْحَيَاةُ، وَتَحَرَّكَتْ بِالنَّبَاتِ."],["رَبَتْ","انْتَفَخَتْ، وَعَلَتْ."]],"40":[["يُلْحِدُونَ","يَمِيلُونَ عَنِ الْحَقِّ."]],"41":[["بِالذِّكْرِ","بِالْقُرْآنِ."],["عَزِيزٌ","مُمْتَنِعٌ عَلَى كُلِّ مَنْ أَرَادَهُ بِتَحْرِيفٍ، أَوْ سُوءٍ."]]}