{"1":[["وَالذَّارِيَاتِ","قَسَمٌ بِالرِّيَاحِ، المُثِيرَاتِ لِلتُّرَابِ."]],"2":[["فَالْحَامِلَاتِ وِقْرًا","فَالسُّحُبِ الحَامِلَاتِ ثِقْلًا عَظِيمًا مِنَ المَاءِ."]],"3":[["فَالْجَارِيَاتِ يُسْرًا","فَالسُّفُنِ الَّتِي تَجْرِي فِي البِحَارِ بيُسْرٍ."]],"4":[["فَالْمُقَسِّمَاتِ أَمْرًا","فَالمَلَائِكَةِ الَّتِي تَقْسِمُ أَمْرَ اللَّهِ فِي خَلْقِهِ."]],"7":[["ذَاتِ الْحُبُكِ","ذَاتِ الخَلْقِ الحَسَنِ، وَذَاتِ الطُّرُقِ الَّتِي تَسِيرُ فِيهَا الكَوَاكِبُ."]],"8":[["قَوْلٍ مُّخْتَلِفٍ","مُتَنَاقِضٍ، مُضْطَرِبٍ فِي القُرْآنِ وَالرَّسُولِ ﷺ."]],"9":[["يُؤْفَكُ عَنْهُ","يُصْرَفُ عَنِ القُرْآنِ وَالرَّسُولِ ﷺ."]],"10":[["قُتِلَ الْخَرَّاصُونَ","قُتِلَ، وَلُعِنَ الكَذَّابُونَ، الظَّانُونَ غَيْرَ الحَقِّ."]],"11":[["غَمْرَةٍ","جَهْلٍ يَغْمُرُهُمْ."],["سَاهُونَ","غَافِلُونَ عَنْ أَمْرِ الآخِرَةِ."]],"12":[["يَسْأَلُونَ","سُؤَالَ اسْتِبْعَادٍ وَإِنْكَارٍ."],["أَيَّانَ يَوْمُ الدِّينِ","مَتَى يَوْمُ الجَزَاءِ؟!"]],"13":[["يُفْتَنُونَ","يُحْرَقُونَ، وَيُعذَّبُونَ."]],"17":[["يَهْجَعُونَ","يَنَامُونَ."]],"18":[["وَبِالْأَسْحَارِ","آخِرَ اللَّيْلِ، قُبَيْلَ الفَجْرِ."]],"19":[["لِلسَّائِلِ","لِلْمُحْتَاجِ الَّذِي يَسْأَلُ النَّاسَ."],["وَالْمَحْرُومِ","الَّذِي لَا يَسْأَلُ النَّاسَ حَيَاءً."]],"23":[["إِنَّهُ لَحَقٌّ","إِنَّ مَا وَعَدَكُمْ بِهِ مِنَ الجَزَاءِ لَحَقٌّ ثَابِتٌ."]],"24":[["ضَيْفِ إِبْرَاهِيمَ","أَضْيَافِهِ مِنَ المَلَائِكَةِ."]],"25":[["مُنكَرُونَ","غُرَبَاءُ لَا تُعْرَفُونَ."]],"28":[["فَأَوْجَسَ مِنْهُمْ","أَحَسَّ فِي نَفْسِهِ مِنْهُمْ."],["بِغُلَامٍ","هُوَ: إِسْحَاقُ ﷺ."]],"29":[["امْرَأَتُهُ","هِيَ: سَارَةُ."],["صَرَّةٍ","صَيْحَةٍ، وَضَجَّةٍ."],["فَصَكَّتْ وَجْهَهَا","لَطَمَتْهُ بِيَدِهَا تَعَجُّبًا."],["عَقِيمٌ","لَا يُولَدُ لِي وَلَدٌ."]],"31":[["فَمَا خَطْبُكُمْ","مَا شَأْنُكُمْ؟"]],"34":[["مُسَوَّمَةً","مُعَلَّمَةً بِأَنَّهَا لِعَذَابِ المُسْرِفِينَ."]],"37":[["فِيهَا آيَةً","فِي قَرْيَتِهِمْ أَثَرًا مِنَ العَذَابِ بَاقِيًا؛ عَلَامَةً عَلَى قُدْرَةِ اللَّهِ."]],"38":[["وَفِي مُوسَى","فِي إِرْسَالِنَا مُوسَى ﷺ: آيَةً لِلَّذِينَ يَخَافُونَ العَذَابَ."],["بِسُلْطَانٍ مُّبِينٍ","بِآيَاتٍ، وَمُعجِزَاتٍ ظَاهِرَةٍ."]],"39":[["فَتَوَلَّى بِرُكْنِهِ","أَعْرَضَ فِرْعَوْنُ؛ مُعْتَرًّا بِقُوَّتِهِ وَجَانِبِهِ."]],"40":[["مُلِيمٌ","آتٍ بِمَا يُلَامُ عَلَيْهِ."]],"41":[["الْعَقِيمِ","الَّتِي لَا بَرَكَةَ فِيهَا، وَلَا تَأْتِي بِخَيْرٍ."]],"42":[["مَا تَذَرُ","مَا تَدَعُ."],["كَالرَّمِيمِ","كَالشَّيْءِ البَالِي."]],"43":[["وَتَمَتَّعُوا حَتَّى حِينٍ","انْتَفِعُوا بِحَيَاتِكُمْ حَتَّى تَنْتَهِيَ آجَالُكُمْ."]],"44":[["فَعَتَوْا","تَكَبَّرُوا، وَعَصَوْا."],["الصَّاعِقَةُ","الصَّيْحَةُ المُهْلِكَةُ."]],"45":[["مِن قِيَامٍ","مِنْ نُهُوضٍ، وَلَا هَرَبٍ."]],"47":[["بِأَيْدٍ","بِقُوَّةٍ، وَقُدْرَةٍ عَظِيمَةٍ."]],"48":[["فَرَشْنَهَا","مَهَّدْنَاهَا، وَبَسَطْنَاهَا."]],"49":[["زَوْجَيْنِ","صِنْفَيْنِ، وَنَوْعَيْنِ مُخْتَلِفَيْنِ."]],"53":[["أَتَوَاصَوْا بِهِ","هَلْ وَصَّى بَعْضُهُمْ بَعْضًا بِالتَّكْذِيبِ؟"],["طَاغُونَ","مُتَجَاوِزُونَ الحَدَّ فِي الكُفْرِ."]],"59":[["ذَنُوبًا","نَصِيبًا مِنَ العَذَابِ سَيَنْزِلُ بِهِمْ."]]}