{"1":[["انْفَطَرَتْ","انْشَقَّتْ."],["وَيْلٌ","عَذَابٌ شَدِيدٌ."]],"2":[["انْتَثَرَتْ","تَسَاقَطَتْ."]],"3":[["فُجِّرَتْ","امْتَلَأَتْ، وَفَاضَتْ، فَانْفَجَرَتْ، وَسَالَتْ مِيَاهُهَا."]],"4":[["بُعْثِرَتْ","قُلِبَتْ بِبَعْثِ مَنْ كَانَ مَقْبُورًا فِيهَا."]],"6":[["مَا غَرَّكَ بِرَبِّكَ","مَا خَدَعَكَ، وَجَرَّأَكَ عَلَى الْكُفْرِ بِهِ، وَعِصْيَانِهِ؟"]],"7":[["فَسَوَّاكَ","جَعَلَكَ مُسْتَوِيَ الْخِلْقَةِ سَالِمَ الْأَعْضَاءِ."],["فَعَدَلَكَ","جَعَلَكَ مُعْتَدِلَ الْخَلْقِ مُتَنَاسِبَ الْأَعْضَاءِ."]],"9":[["بِالدِّينِ","يَوْمِ الْجَزَاءِ، وَالْحِسَابِ."]],"10":[["لَحَافِظِينَ","لَمَلَائِكَةً رُقَبَاءَ يَكْتُبُونَ أَعْمَالَكُمْ."]],"16":[["بِغَائِبِينَ","فَلَا يَخْرُجُونَ مِنْ جَهَنَّمَ، وَلَا يَمُوتُونَ."]]}