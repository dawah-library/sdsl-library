{"1":[["فَاطِرٍ","خَالِقٍ، وَمُبْدِعٍ."],["أُولِي","أَصْحَابِ."]],"3":[["فَأَنَّى تُؤْفَكُونَ","كَيْفَ تُصْرَفُونَ عَنْ تَوْحِيدِهِ؟!"]],"5":[["فَلَا تَغُرَّنَّكُمُ","لَا تَخْدَعَنَّكُمْ، وَلَا تُلْهِيَنَّكُمْ."],["الْغَرُورُ","الشَّيْطَانُ."]],"6":[["حِزْبُهُ","أَتْبَاعُهُ."]],"8":[["فَلَا تَذْهَبْ نَفْسُكَ","فَلَا تُهْلِكْهَا."],["حَسَرَاتٍ","حُزْنًا عَلَى كُفْرِ هَؤُلَاءِ الضَّالِّينَ."]],"9":[["فَتُثِيرُ","تُحَرِّكُ."],["مَيِّتٍ","مُجْدِبٍ."]],"10":[["الْعِزَّةُ","الشَّرَفُ، وَالْمَنَعَةُ."],["الْكَلِمُ الطَّيِّبُ","الكَلَامُ الحَسَنُ؛ وَهُوَ ذِكْرُ اللَّهِ."],["يُبُورُ","يَفْسُدُ، وَيَبْطُلُ."]],"11":[["أَزْوَاجًا","ذُكُورًا وَإِنَاثًا."],["مُعَمَّرٍ","طَوِيلِ الْعُمُرِ."],["فِي كِتَابٍ","هُوَ: اللَّوْحُ المَحْفُوظُ."]],"12":[["فُرَاتٌ","شَدِيدُ العُذُوبَةِ."],["سَائِغٌ","سَهْلُ مُرُورُهُ فِي الحَلْقِ."],["أُجَاجٌ","شَدِيدُ المُلُوحَةِ."],["لَحْمًا طَرِيًّا","هُوَ: السَّمَكُ."],["حِلْيَةً","هِيَ: اللُّؤْلُؤُ، وَالْمَرْجَانُ."],["الْفُلْكَ","السُّفُنَ."],["مَوَاخِرَ","تَشُقُّ المِيَاهَ."]],"13":[["يُولِجُ","يُدْخِلُ مِنْ سَاعَاتِ اللَّيْلِ فِي النَّهَارِ، وَالعَكْسُ، فَتَحْدُثُ الزِّيَادَةُ وَالنَّقْصُ فِيهِمَا."],["وَسَخَّرَ","ذَلَّلَ."],["لِأَجْلٍ مُسَمًّى","لِوَقْتٍ مَعْلُومٍ مُقَدَّرٍ."],["قِطْمِيرٍ","هِيَ: القِشْرَةُ الرَّقِيقَةُ البَيْضَاءُ عَلَى النَّوَاةِ."]],"14":[["يَكْفُرُونَ بِشِرْكِكُمْ","يَتَبَرَّؤُونَ مِنْكُمْ."]],"18":[["وَلَا تَزِرُ","لَا تَحْمِلُ."],["وَازِرَةٌ","نَفْسٌ مُذْنِبَةٌ."],["وِزْرُ أُخْرَى","ذَنْبَ نَفْسٍ أُخْرَى."],["تَدْعُ","تَسْأَلُ."],["مُثْقَلَةٌ","نَفْسٌ مُثْقَلَةٌ بِالْخَطَايَا."],["حِمْلُهَا","ذُنُوبُهَا الَّتِي أَنْثَلَتْهَا."],["تَزَكَّى","تَطَهَّرَ مِنَ الشِّرْكِ وَالمَعَاصِي."],["المَصِيرُ","المَالُ وَالمَرْجِعُ."]],"21":[["الحَرُورُ","الرِّيحُ الحَارَّةُ."]],"25":[["وَبِالزُّبُرِ","الكُتُبِ المَجْمُوعِ فِيهَا كَثِيرٌ مِنَ الْأَحْكَامِ."]],"26":[["نَكِيرِ","إِنْكَارِي عَلَيْهِمْ، وَعُقُوبَتِي لَهُمْ."]],"27":[["جُدَدٌ","ذَاتُ طَرَائِقَ وَخُطُوطٍ مُخْتَلِفَةِ الْأَلْوَانِ."],["وَغَرَابِيبُ سُودٌ","شَدِيدَةُ السَّوَادِ؛ كَالْأَغْرِبَةِ."]],"29":[["لَنْ تَبُورَ","لَنْ تَكْسُدَ، وَتَهْلِكَ."]],"31":[["لِمَا بَيْنَ يَدَيْهِ","مِنَ الكُتُبِ السَّابِقَةِ."]],"32":[["أَوْرَثْنَا","أَعْطَيْنَا."],["ظَالِمٌ لِنَفْسِهِ","بِفِعْلِ بَعْضِ المَعَاصِي."],["مُقْتَصِدٌ","يُؤَدِّي الوَاجِبَاتِ، وَيَجْتَنِبُ المُحَرَّمَاتِ."],["سَابِقٌ بِالْخَيْرَاتِ","مُجْتَهِدٌ فِي عَمَلِ الصَّالِحَاتِ: فَرْضُهَا وَنَفْلُهَا."]],"33":[["عَدْنٍ","إِقَامَةٍ."]],"35":[["أَحَلَّنَا","أَنْزَلْنَا."],["دَارَ المُقَامَةِ","دَارَ الإِقَامَةِ الدَّائِمَةِ."],["نَصَبٌ","تَعَبٌ، وَمَشَقَّةٌ."],["لُغُوبٌ","إِعْيَاءٌ وَتَعَبٌ."]],"37":[["يَصْطَرِخُونَ","يَصِيحُونَ بِشِدَّةٍ، وَيَسْتَغِيثُونَ."],["النَّذِيرُ","نَبِيُّنَا مُحَمَّدٌ ﷺ."]],"39":[["خَلَائِفَ","يَخْلُفُ بَعْضُكُمْ بَعْضًا فِي الْأَرْضِ."],["مَقْتًا","بُغْضًا وَغَضَبًا."]],"40":[["أَرَأَيْتُمْ","أَخْبِرُونِي."],["غُرُورًا","خِدَاعًا وَبَاطِلًا."]],"42":[["جَهَدَ أَيْمَانَهُمْ","مُجْتَهِدِينَ فِي الحَلِفِ بِأَغْلَظِ الْأَيْمَانِ."],["نَذِيرٌ","رَسُولٌ مِنْ عِنْدِ اللَّهِ تَعَالَى."]],"43":[["يَحِيقُ","يُحِيطُ، وَيَنْزِلُ."],["سُنَّتَ الْأَوَّلِينَ","العَذَابَ الَّذِي نَزَلَ بِأَمْثَالِهِمْ."]]}