{"3":[["وَكِيلًا","حَافِظًا."]],"4":[["تُظَاهِرُونَ مِنْهُنَّ","الظِّهَارُ: أَنْ يَقُولَ الرَّجُلُ لِامْرَأَتِهِ: أَنْتِ عَلَيَّ كَظَهْرِ أُمِّي."],["أَدْعِيَآءِكُمْ","مَنْ تَبَنَّيْتُمُوهُ مِنْ أَوْلَادِ غَيْرِكُمْ."],["ٱلسَّبِيلَ","طَرِيقُ الحَقِّ وَالرَّشَادِ."]],"5":[["أَقْسَطُ","أَعْدَلُ وَأَقْوَمُ."],["وَمَوَلِيكُمْ","أَوْلِيَاؤُكُمْ فِي الدِّينِ."],["جُنَاحَ","إِثْمٌ."]],"6":[["أَوْلَىٰ بِٱلْمُؤْمِنِينَ","أَنْفَعُ، وَأَرْأَفُ، وَأَقْرَبُ لَهُمْ مِنْ أَنْفُسِهِمْ فِي الدِّينِ وَالدُّنْيَا."],["وَأَزْوَٰجُهُۥ أُمَّهَٰتُهُمْ","مِثْلُ أُمَّهَاتِهِمْ؛ فِي تَحْرِيمِ نِكَاحِهِنَّ، وَتَعْظِيمِ حَقِّهِنَّ."],["وَأُوْلُواْ ٱلأَرْحَامِ","ذَوُو القَرَابَةِ."]],"7":[["مِيثَٰقَهُمْ","العَهْدَ المُؤَكَّدَ بِتَبْلِيغِ الرِّسَالَةِ."]],"9":[["جُنُوداً","هُمُ: الأَحْزَابُ حِينَ اجْتَمَعُوا فِي غَزْوَةِ الخَنْدَقِ."]],"10":[["زَاغَتِ ٱلأَبْصَٰرُ","شَخَصَتِ الأَبْصَارُ؛ حَيْرَةً وَدَهْشَةً."],["ٱلظُّنُونَ","تَظُنُّونَ أَنَّ اللَّهَ لَا يَنْصُرُ دِينَهُ وَنَبِيَّهُ."]],"11":[["ابْتُلِيَ","امْتُحِنَ."],["وَزُلْزِلُواْ","اضْطُرِبُوا."]],"12":[["مَّرَضٌ","شَكٌّ، وَضَعْفُ إِيمَانٍ."],["غُرُوراً","بَاطِلًا خَادِعًا."]],"13":[["يَثْرِبَ","هُوَ: الِاسْمُ الجَاهِلِيُّ لِلْمَدِينَةِ."],["لَّا مُقَامَ لَكُمْ","لَا إِقَامَةَ لَكُمْ فِي مَعْرَكَةٍ خَاسِرَةٍ."],["عَوْرَةٌ","غَيْرُ مُحَصَّنَةٍ."]],"14":[["أَقْطَارِهَا","جَوَانِبِ المَدِينَةِ."],["ٱلْفِتْنَةَ","الشِّرْكَ بِاللَّهِ، وَالرُّجُوعَ عَنِ الإِسْلَامِ."],["لَأَتَوْهَا","لَأَجَابُوا إِلَى ذَلِكَ مُبَادِرِينَ."],["تَلَبَّثُواْ","تَأَخَّرُوا."]],"15":[["لَا يُوَلُّونَ ٱلأَدْبَرَ","لَا يَفِرُّونَ مِنَ المَعْرَكَةِ."]],"17":[["يَعْصِمُكُمْ","يَمْنَعُكُمْ."]],"18":[["ٱلْمُعَوِّقِينَ","المُثَبِّطِينَ عَنِ الجِهَادِ."],["هَلُمَّ إِلَيْنَا","تَعَالَوْا إِلَيْنَا."],["ٱلْبَأْسَ","القِتَالَ."]],"19":[["أَشِحَّةً","بُخَلَاءَ بِأَمْوَالِهِمْ وَأَنْفُسِهِمْ وَجُهُودِهِمْ."],["جَاءَ ٱلْخَوْفُ","حَضَرَ القِتَالَ."],["تَدُورُ أَعْيُنُهُمْ","خَوْفًا، وَهَلَعًا."],["سَلَقُوكُم","رَمَوْكُمْ."],["حِدَادٍ","ذَرِبَةٍ، سَلِيطَةٍ، مُؤْذِيَةٍ."],["أَشِحَّةً عَلَى ٱلْخَيْرِ","بُخَلَاءَ، وَحَسَدَةً عِنْدَ قِسْمَةِ الغَنَائِمِ."]],"20":[["بَادُونَ","فِي البَادِيَةِ."],["أَنبَآئِكُمْ","أَخْبَارِكُمْ."]],"21":[["أُسْوَةٌ","قُدْوَةٌ."]],"23":[["قَضَى نَحْبَهُ","وَفَى بِنَذْرِهِ فِي نُصْرَةِ دِينِهِ، أَوْ مَاتَ شَهِيدًا."]],"25":[["بِغَيْظِهِمْ لَمْ يَنَالُواْ خَيْراً","مُغْتَاظِينَ لَمْ يَنَالُوا مَا أَرَادُوا."]],"26":[["ظَٰهَرُوهُمْ","عَاوَنُوا الأَحْزَابَ."],["مِنْ أَهْلِ ٱلْكِتَابِ","هُمْ: يَهُودُ بَنِي قُرَيْظَةَ."],["صَيَاصِيهِمْ","حُصُونِهِمْ."],["ٱلرُّعْبَ","الخَوْفَ الشَّدِيدَ."]],"28":[["أُمِّتِعْكُنَّ","أُعْطِيكُنَّ مُتْعَةَ الطَّلَاقِ؛ وَهِيَ مَالٌ يُعْطِيهِ الزَّوْجُ لِمُطَلَّقَتِهِ."],["وَأُسَرِّحْكُنَّ","أُطَلِّقُنَّ."],["جَمِيلاً","بِلَا أَذًى، أَوْ ضَرَرٍ."]],"30":[["بِفَٰحِشَةٍ مُّبَيِّنَةٍ","مَعْصِيَةٍ ظَاهِرَةٍ."],["ضِعْفَيْنِ","مَرَّتَيْنِ."]],"31":[["يَقْنُتْ مِنكُنَّ","تُطِعْ مِنْكُنَّ اللَّهَ وَرَسُولَهُ."],["وَأَعْتَدْنَا","أَعْدَدْنَا."]],"32":[["اتَّقَيْتُنَّ","خَفْتُنَّ اللَّهَ."],["فَلَا تَخْضَعْنَ بِٱلْقَوْلِ","فَلَا تَتَحَدَّثْنَ مَعَ الأَجَانِبِ بِصَوْتٍ لَيِّنٍ."],["مَرَضٌ","شَهْوَةٌ، وَمَيْلٌ إِلَى النِّسَاءِ."],["فُولاَ مَعْرُوفاً","قَوْلًا بَعِيدًا عَنِ الرِّيبَةِ."]],"33":[["وَقَرْنَ","اِلْزَمْنَ."],["وَلَا تَبَرَّجْنَ","لَا تُظْهِرْنَ مَحَاسِنَكُنَّ."],["ٱلْجَٰهِلِيَّةِ ٱلأُولَىٰ","الَّتِي قَبْلَ الإِسْلَامِ."],["ٱلرِّجْسَ","الأَذَى، وَالسُّوءَ، وَالإِثْمَ."]],"34":[["وَٱلْحِكْمَةِ","أَحَادِيثَ الرَّسُولِ ﷺ."]],"35":[["وَٱلْقَٰنِتِينَ","المُطِيعِينَ، الخَاشِعِينَ لِلَّهِ."],["وَٱلْخَٰشِعِينَ","الخَائِفِينَ مِنَ اللَّهِ، المُتَوَاضِعِينَ."],["وَٱلْحَٰفِظِينَ فُرُوجَهُمْ","أَيْ: عَنِ الزِّنَى، وَمُقَدِّمَاتِهِ، وَعَنْ كَشْفِ العَوْرَةِ وَمَسِّهَا لِمَنْ لَا يَحِلُّ لَهُمْ."]],"36":[["وَمَا كَانَ","لَا يَنْبَغِي."],["قَضَىٰ","حَكَمَ."],["ٱلْخِيَرَةُ","الِاخْتِيَارُ."]],"37":[["أَنْعَمَ ٱللَّهُ عَلَيْهِ","بِالإِسْلَامِ."],["وَأَنْعَمْتَ عَلَيْهِ","بِالعِتْقِ، وَهُوَ زَيْدُ بْنُ حَارِثَةَ ﷺ."],["وَتُخْفِي فِي نَفْسِكَ","هُوَ: مَا أَوْحَاهُ اللَّهُ إِلَيْكَ مِنْ طَلَاقِ زَيْدٍ لِامْرَأَتِهِ، وَزَوَاجِكَ مِنْهَا."],["مُبْدِيهِ","مُظْهِرُهُ."],["وَتَخْشَى ٱلنَّاسَ","تَخَافُ مِنَ المُنَافِقِينَ أَنْ يَقُولُوا: تَزَوَّجَ مُحَمَّدٌ امْرَأَةَ مُتَبَنَّاهُ."],["حَرَجٌ","إِثْمٌ."],["أَدْعِيَائِهِمْ","مَنْ كَانُوا يَتَبَنَّوْنَهُمْ."],["وَطَرًا","حَاجَةً."]],"38":[["حَرَجٍ","إِثْمٌ."]],"42":[["بُكْرَةً وَأَصِيلًا","أَوَّلَ النَّهَارِ، وَآخِرَهُ."]],"49":[["تَمَسُّوهُنَّ","تَدْخُلُوا بِهِنَّ، وَتُجَامِعُوهُنَّ."],["عِدَّةٍ","مُدَّةٌ تَنْتَظِرُ فِيهَا المَرْأَةُ."],["فَمَتِّعُوهُنَّ","أَعْطُوهُنَّ مِنْ أَمْوَالِكُمْ مَا يَتَمَتَّعْنَ بِهِ بِحَسَبِ وُسْعِكُمْ؛ جَبْرًا لِخَوَاطِرِهِنَّ."],["وَسَرِّحُوهُنَّ","طَلِّقُوهُنَّ."],["جَمِيلًا","بِلَا أَذًى، أَوْ ضَرَرٍ."]],"50":[["وَمَا مَلَكَتْ يَمِينُكَ","الإِمَاءَ الَّتِي تَكُونُ مِلْكًا خَالِصًا لَكَ."],["أَفَاءَ اللَّهُ عَلَيْكَ","أَنْعَمَ بِهِ عَلَيْكَ بِالجِهَادِ."],["خَالِصَةً لَّكَ","خَاصَّةً بِكَ."],["حَرَجٍ","ضِيقٌ."]],"51":[["تُرْجِي","تُؤَخِّرُ القَسْمَ فِي المَبِيتِ، عَمَّنْ شِئْتَ مِنْ زَوْجَاتِكَ."],["وَتُؤْوِي","تَضُمُّ فِي المَبِيتِ."],["ابْتَغَيْتَ","طَلَبْتَ المَبِيتَ عِنْدَهَا."],["عَزَلْتَ","أَخَّرْتَ قَسْمَهَا."],["أَدْنَى","أَقْرَبُ."],["أَن تَقْرَأَ أَعْيُنُهُنَّ","أَنْ يَفْرَحْنَ."]],"52":[["وَلَا أَن تَبَدَّلَ","وَلَا أَنْ تُطَلِّقَ إِحْدَاهُنَّ لِتَسْتَبْدِلَهَا بِغَيْرِهَا."],["رَقِيبًا","مُطَّلِعًا لَا يَغِيبُ عَنْ عِلْمِهِ شَيْءٌ."]],"53":[["نَظِرِينَ إِنَاهُ","مُنْتَظِرِينَ نُضْجَهُ."],["مَتَاعًا","حَاجَةً مِنْ أَوَانِي البَيْتِ، وَنَحْوَهَا."]],"55":[["لَا جُنَاحَ عَلَيْهِنَّ","لَا إِثْمَ عَلَيْهِنَّ فِي عَدَمِ الِاحْتِجَابِ."],["وَلَا نِسَائِهِنَّ","أَيْ: النِّسَاءِ المُؤْمِنَاتِ."],["مَا مَلَكَتْ أَيْمَانُهُنَّ","العَبِيدَ المَمْلُوكِينَ لَهُنَّ."]],"56":[["يُصَلُّونَ","صَلَاةُ اللَّهِ: ثَنَاؤُهُ عَلَى عَبْدِهِ فِي المَلَإِ الأَعْلَى، وَصَلَاةُ المَلَائِكَةِ: ثَنَاؤُهُمْ وَدُعَاؤُهُمْ."]],"57":[["يُؤْذُونَ اللَّهَ","يُشْرِكُونَ بِهِ، وَيَعْصُونَهُ."],["لَعَنَهُمُ اللَّهُ","أَبْعَدَهُمْ، وَطَرَدَهُمْ مِنْ كُلِّ خَيْرٍ."]],"58":[["احْتَمَلُوا","ارْتَكَبُوا."],["بُهْتَانًا","أَفْحَشَ الكَذِبِ وَالزُّورِ."]],"59":[["يُدْنِينَ عَلَيْهِنَّ","يُرْخِينَ عَلَى رُؤُوسِهِنَّ وَوُجُوهِهِنَّ وَصُدُورِهِنَّ."],["جَلَابِيبِهِنَّ","الجِلْبَابُ: الرِّدَاءُ، وَالمِلْحَفَةُ الَّتِي تَسْتُرُ بَدَنَ المَرْأَةِ وَزِينَتَهَا."],["أَدْنَى","أَقْرَبُ."],["أَن يُعْرَفْنَ","يُمَيَّزْنَ بِالسِّتْرِ وَالصِّيَانَةِ؛ فَلَا يُتَعَرَّضُ لَهُنَّ بِمَكْرُوهٍ."]],"60":[["مَرَضٌ","شَكٌّ، وَرِيبَةٌ."],["وَالْمُرْجِفُونَ","الَّذِينَ يَنْشُرُونَ الأَخْبَارَ الكَاذِبَةَ."],["لَنُغْرِيَنَّكَ بِهِمْ","لَنُسَلِّطَنَّكَ عَلَيْهِمْ."],["لَا يُجَاوِرُونَكَ","لَا يُسَاكِنُونَكَ."]],"61":[["ثُقِفُوا","وُجِدُوا."]],"62":[["سُنَّةَ اللَّهِ","طَرِيقَتُهُ فِي المُنَافِقِينَ: القَتْلُ، وَالأَسْرُ."],["خَلَوْا","مَضَوْا."],["تَبْدِيلًا","تَحْوِيلًا، وَتَغْيِيرًا."]],"64":[["سَعِيرًا","نَارًا مُوقَدَةً، شَدِيدَةَ الحَرَارَةِ."]],"67":[["السَّبِيلَا","طَرِيقَ الهُدَى."]],"68":[["ضِعْفَيْنِ","مِثْلَيْنِ."]],"69":[["وَجِيهًا","عَظِيمَ القَدْرِ."]],"70":[["سَدِيدًا","مُوَافِقًا لِلْحَقِّ، خَالِيًا مِنَ الكَذِبِ وَالبَاطِلِ."]],"72":[["الأَمَانَةَ","مَا أَمَرَ اللَّهُ بِهِ، وَنَهَى عَنْهُ."],["فَأَبَيْنَ","امْتَنَعْنَ."],["وَأَشْفَقْنَ","خِفْنَ مِنَ الخِيَانَةِ فِيهَا."]]}