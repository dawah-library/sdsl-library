{"1":[["عَمَّ","عَنْ أَيِّ شَيْءٍ؟"]],"2":[["النَّبَإِ الْعَظِيمِ","الخَبَرِ العَظِيمِ؛ وَهُوَ القُرْآنُ الَّذِي فِيهِ خَبَرُ البَعْثِ."]],"6":[["مِهَاداً","مُمَهَّدَةً كَالْفِرَاشِ."]],"7":[["أَوْتَاداً","تُثْبِتُ الأَرْضَ."]],"8":[["أَزْوَاجاً","أَصْنَافاً: ذُكُوراً وَإِنَاثاً."]],"9":[["سُبَاتاً","رَاحَةً لِأَبْدَانِكُمْ، وَقَطْعاً لِأَعْمَالِكُمْ."]],"10":[["لِبَاساً","سَاتِراً لَكُمْ بِظُلْمَتِهِ؛ كَاللِّبَاسِ."]],"11":[["مَعَاشاً","تَحَصَّلُونَ فِيهِ مَا تَعِيشُونَ بِهِ."]],"13":[["سِرَاجاً وَهَّاجاً","مِصْبَاحاً وَقَّاداً، مُضِيئاً."]],"14":[["الْمُعْصِرَاتِ","السُّحُبِ المُمْطِرَةِ."],["ثَجَّاجاً","مُنْصَبّاً بِكَثْرَةٍ."]],"16":[["وَجَنَّاتٍ أَلْفَافاً","بَسَاتِينَ مُلْتَفَّةً أَشْجَارُهَا."]],"17":[["مِيقَاتاً","وَقْتاً، وَمِيعَاداً لِلْفَصْلِ بَيْنَ الخَلْقِ."]],"18":[["الصُّورِ","القَرْنِ الَّذِي يَنْفُخُ فِيهِ إِسْرَافِيلُ ؏."]],"19":[["أَبْوَاباً","ذَاتَ أَبْوَابٍ كَثِيرَةٍ؛ لِنُزُولِ المَلَائِكَةِ."]],"20":[["وَسُيِّرَتْ","نُسِفَتْ بَعْدَ ثُبُوتِهَا."]],"21":[["مِرْصَاداً","تَرْصُدُ أَهْلَهَا، وَتَرْقُبُهُمْ."]],"23":[["أَحْقَاباً","دُهُوراً لَا تَنْقَطِعُ."]],"24":[["بَرْداً","مَا يُبْرِدُ حَرَّ النَّارِ عَلَى أَجْسَادِهِمْ."]],"25":[["حَمِيماً","مَاءً حَارّاً بَالِغاً نِهَايَةَ الحَرَارَةِ."],["وَغَسَّاقاً","صَدِيدَ أَهْلِ النَّارِ."]],"26":[["وِفَاقاً","عَادِلًا، مُوَافِقاً لِأَعْمَالِهِمْ."]],"27":[["لَا يَرْجُونَ","لَا يَخَافُونَ."]],"29":[["أَحْصَيْنَاهُ","حَفِظْنَاهُ، وَضَبَطْنَاهُ مَكْتُوباً فِي اللَّوْحِ المَحْفُوظِ."]],"31":[["مَفَازًا","فَوْزًا بِدُخُولِهِمُ الجَنَّةَ، أَوْ مَكَانًا يَفُوزُونَ بِهِ؛ وَهُوَ الجَنَّةُ."]],"32":[["حَدَائِقَ","بَسَاتِينَ عَظِيمَةً قَدْ أَحَحَطْتَ بِهَا الْأَشْجَارُ."]],"33":[["وَكَوَاعِبَ","حَدِيثَاتِ السِّنِّ، نَوَاهِدَ."],["وَأَتْرَابًا","مُسْتَوِيَاتٍ فِي سِنٍّ وَاحِدَةٍ."]],"34":[["دِهَاقًا","مَمْلُوءَةً خَمْرًا."]],"35":[["لَغْوًا","بَاطِلًا مِنَ الْقَوْلِ."]],"36":[["حِسَابًا","كَثِيرًا، كَافِيًا لَهُمْ."]],"37":[["خِطَابًا","كَلَامًا، وَسُؤَالًا إِلَّا بِإِذْنِهِ."]],"38":[["الرُّوحُ","جِبْرِيلُ ؏."],["صَفًّا","مُصْطَفِّينَ."],["لَا يَتَكَلَّمُونَ","لَا يَشْفَعُونَ."],["صَوَابًا","حَقًّا، وَسَدَادًا."]],"39":[["الحَقُّ","الَّذِي لَا رَيْبَ فِي وُقُوعِهِ."],["مَآبًا","مَرْجِعًا بِالْعَمَلِ الصَّالِحِ."]]}