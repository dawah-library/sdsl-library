{"3":[["وَأَجَلٍ مُّسَمًّى","هُوَ: وَقْتُ فَنَائِهِمَا إِذَا قَامَتِ الْقِيَامَةُ."]],"4":[["لَّهُمْ شُرَكَاؤُ","شَرِكَةٌ وَنَصِيبٌ مَعَ اللَّهِ تَعَالَى فِي خَلْقِ السَّمَاوَاتِ."],["أُتُونِي","بَقِيَّةً."]],"5":[["وَمَنْ أَضَلّ","لَا أَحَدَ أَضَلُّ، وَأَجْهَلُ."]],"8":[["افْتَرٰهُ","اخْتَلَقَهُ."],["تُفِيضُونَ فِيهِ","تَقُولُونَ فِي الْقُرْآنِ."]],"9":[["بِدْعًا مِّنَ الرُّسُلِ","أَوَّلُ رُسُلِ اللَّهِ إِلَى خَلْقِهِ."]],"10":[["وَشَهِدَ شَاهِدٌ","كَعَبْدِ اللَّهِ بْنِ سَلَامٍ رَضِيَ اللَّهُ عَنْهُ."]],"11":[["إِفْكٍ قَدِيمٍ","كَذِبٍ مَأْثُورٍ عَنِ النَّاسِ الْأَقْدَمِينَ."]],"12":[["إِمَامًا","هَادِيًا يَأْتَمُّونَ بِهِ، وَيَعْمَلُونَ."],["مُصَدِّقٌ","لِكُتُبٍ قَبْلَهُ."]],"13":[["اسْتَقَامُوا","ثَبَتُوا عَلَى الْإِيمَانِ وَالطَّاعَةِ."]],"15":[["وَوَصَّيْنَا","أَمَرْنَاهُ، وَأَلْزَمْنَاهُ."],["كُرْهًا","عَلَى مَشَقَّةٍ، وَتَعَبٍ."],["وَفِصَالُهُ","فَطَامُهُ."],["بَلَغَ أَشُدَّهُ","نِهَايَةَ قُوَّتِهِ الْبَدَنِيَّةِ وَالْعَقْلِيَّةِ."],["أَوْزِعْنِي","أَلْهِمْنِي."]],"17":[["أُفٍّ لَّكُمَا","قُبْحًا لَكُمَا."],["أَن أُخْرَجَ","أَبُعَثُ مِنْ قَبْرِي حَيًّا."],["خَلَتِ الْقُرُونُ","مَضَتِ الْأُمَمُ السَّابِقَةُ."],["يَسْتَغِيثَانِ اللَّهَ","يَسْأَلَانِ اللَّهَ هِدَايَتَهُ."],["وَيْلَكَ","هَلَكْتَ."],["أَسَاطِيرُ الْأَوَّلِينَ","مَا سَطَرَهُ الْأَوَّلُونَ مِنَ الْأَكَاذِيبِ فِي كُتُبِهِمْ."]],"18":[["حَقَّ عَلَيْهِمُ الْقَوْلُ","وَجَبَ عَلَيْهِمُ الْعَذَابُ."],["فِي أُمَمٍ","فِي جُمْلَةِ أُمَمٍ كَافِرَةٍ."],["خَلَتْ","مَضَتْ."]],"19":[["وَلِكُلٍّ دَرَجَاتٌ","وَلِكُلِّ فَرِيقٍ مِنَ الْأَعْدَاءِ وَالْأَشْقِيَاءِ مَنَازِلُ فِي الْقِيَامَةِ بِأَعْمَالِهِمْ."]],"20":[["عَذَابَ الْهُونِ","عَذَابَ الْخِزْيِ وَالْهَوَانِ."]],"21":[["أَخَا عَادٍ","هُوَ: هُودٌ عَلَيْهِ السَّلَامُ."],["بِالْأَحْقَافِ","اسْمُ مَوْقِعِهِمْ؛ وَهُوَ فِي جَنُوبِ جَزِيرَةِ الْعَرَبِ."]],"22":[["لِتَأْفِكَنَا","لِتَصْرِفَنَا."]],"24":[["عَارِضًا","سَحَابًا عَرْضًا فِي أُفُقِ السَّّمَاءِ."]],"25":[["تُدَمِّرُ","تُهْلِكُ."],["كُلِّ شَيْءٍ","مَرَّتْ بِهِ مِمَّا أُرْسِلَتْ بِهَلَاكِهِ."]],"26":[["مَكَّنَّهُمْ","أَقْدَرْنَاهُمْ، وَبَسَطْنَا لَهُمْ."],["فِيمَا إِنْ مَكَّنَّكُمْ فِيهِ","فِي الَّذِي لَمْ نُمَكِّنْكُمْ فِيهِ."],["وَحَاقَ","نَزَلَ."]],"27":[["وَصَرَّفْنَا الْآيَاتِ","بَيَّنَّا لَهُمْ أَنْوَاعَ الْحُجَجِ، وَكَرَّرْنَاهَا لَهُمْ."]],"28":[["فَلَوْلَا","هَلَّا."],["قُرْبَانًا","يَتَقَرَّبُونَ بِهَا إِلَى رَبِّهِمْ."],["إِفْكُهُمْ","كَذِبُهُمْ."],["يَفْتَرُونَ","يَكْذِبُونَ."]],"29":[["صَرَفْنَا","بَعَثْنَا وَوَجَّهْنَا نَحْوَكَ."],["قُضِيَ","فَرَغَ رَسُولُ اللَّهِ ﷺ مِنْ تِلَاوَتِهِ."],["مُنْذِرِينَ","مُحذِّرِينَ مِنْ بَأْسِ اللَّهِ."]],"31":[["دَاعِيَ اللَّهِ","رَسُولَ اللَّهِ مُحَمَّدًا ﷺ."]],"32":[["أَوْلِيَاءُ","أَنْصَارٌ يَمْنَعُونَهُ مِنْ عَذَابِ اللَّهِ."]],"33":[["وَلَمْ يَعْيَ بِخَلْقِهِنَّ","لَمْ يَعْجِزْ عَنْ خَلْقِهِنَّ، وَلَمْ يَتْعَبْ بِهِ."]],"35":[["أُولُوا الْعَزْمِ","ذَوُو الثَّبَاتِ وَالصَّبْرِ؛ وَهُمْ: نُوحٌ، وَإِبْرَاهِيمُ، وَمُوسَى، وَعِيسَى، وَمُحَمَّدٌ؛ عَلَيْهِمُ الصَّلَاةُ وَالسَّلَامُ."],["وَلَا تَسْتَعْجِلْ لَهُمْ","لَا تَتَعَجَّلْ بِطَلَبِ عُقُوبَتَهِمْ."],["بَلَّغَ","هَذَا تَبْلِيغٌ مِنَ اللَّهِ لَهُمْ."]]}