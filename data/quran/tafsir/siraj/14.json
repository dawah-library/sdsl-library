{"3":[["وَيَبْغُونَهَا عِوَجًا","يُرِيدُونَهَا مَعْوَجَّةً؛ مُوَافَقَةً لِأَهْوَائِهِمْ."]],"5":[["بِأَيَّامِ اللَّهِ","نِعَمِهِ وَنِعَمِهِ الَّتِي قَدَّرَهَا فِي الأَيَّامِ."]],"6":[["يَسُومُونَكُمْ","يُذِيقُونَكُمْ."]],"7":[["تَأَذَّنَ","أَعْلَمَ إِعْلَامًا مُؤَكَّدًا."]],"9":[["فَرَدُّوا أَيْدِيَهُمْ فِي أَفْوَاهِهِمْ","عَضُّوا أَيْدِيَهِمْ؛ تَعَيْظًا عَلَى الرُّسُلِ وَدِينِهِمْ."],["مُرِيبٍ","مُوجِبٍ لِلرِّيبَةِ، وَالشَّكِّ."]],"10":[["فَاطِرِ","مُنْشِئِ وَمُبْدِعٍ."],["بِسُلْطَانٍ","بِحُجَّةٍ، وَدَلِيلٍ."]],"14":[["مَقَامِي","مَوْقِفَهُ بَيْنَ يَدَيْ لِلْحِسَابِ."]],"15":[["وَاسْتَفْتَحُوا","اسْتَنْصَرَ الرُّسُلُ بِاللَّهِ عَلَى الظَّالِمِينَ."],["وَخَابَ","هَلَكَ، وَخَسِرَ."]],"16":[["وَرَائِهِ","أَمَامِهِ."],["صَدِيدٍ","القَيْحُ وَالدَّمُ الَّذِي يَسِيلُ مِنْ أَجْسَادِ أَهْلِ النَّارِ."]],"17":[["يَتَجَرَّعُهُ","يُحَاوِلُ ابْتِلَاعَهُ."],["وَلَا يَكَادُ يُسِيغُهُ","لَا يَسْتَطِيعُ ابْتِلَاعَهُ؛ لِحَرَارَتِهِ وَقَذَارَتِهِ."],["وَمِنْ وَرَائِهِ","مِنْ بَعْدِهِ."]],"18":[["يَوْمِ عَاصِفٍ","شَدِيدِ هُبُوبِ الرِّيحِ."]],"21":[["سَوَاءٌ عَلَيْنَا","يَسْتَوِي عَلَيْنَا وَعَلَيْكُمْ."],["مَحِيصٍ","مَهْرَبٍ."]],"22":[["سُلْطَانٍ","حُجَّةٍ وَقُوَّةٍ أَقْهَرُكُمْ بِهَا عَلَى اتِّبَاعِي."],["بِمُصْرِخِكُمْ","بِمُغِيثِكُمْ."],["كَفَرْتُ","تَبَرَّأْتُ."]],"24":[["كَلِمَةً طَيِّبَةً","هِيَ كَلِمَةُ التَّوْحِيدِ «لَا إِلَهَ إِلَّا اللَّهُ»."],["كَشَجَرَةٍ طَيِّبَةٍ","هِيَ: النَّخْلَةُ."]],"25":[["أُكُلَهَا","ثَمَرَهَا."]],"26":[["كَلِمَةٍ خَبِيثَةٍ","كَلِمَةِ الكُفْرِ."],["كَشَجَرَةٍ خَبِيثَةٍ","هِيَ: شَجَرَةُ الحَنْظَلِ."],["اجْتُثَّتْ","اقْتُلِعَتْ."],["قَرَارٍ","أَصْلٍ ثَابِتٍ."]],"28":[["البَوَارَ","الهَلَاكَ."]],"30":[["أَنْدَادًا","شُرَكَاءَ."]],"31":[["خِلَالٌ","صَدَاقَةٌ."]],"32":[["الفُلْكِ","السُّفُنِ."]],"33":[["دَائِبَيْنِ","جَارِيَيْنِ لَا يَفْتُرَانِ وَلَا يَتَوَقَّفَانِ."]],"37":[["تَهْوِي إِلَيْهِمْ","تَمِيلُ إِلَيْهِمْ، وَتَحِنُّ."]],"42":[["تُشْخَصُ","تَرْتَفِعُ عُيُونُهُمْ فِيهِ، وَلَا تَطْمِضُ."]],"43":[["مُهْطِعِينَ","مُسْرِعِينَ."],["مُقْنِعِي رُءُوسِهِمْ","رَافِعِي رُؤُوسِهِمْ."],["وَأَفْئِدَتُهُمْ هَوَاءٌ","قُلُوبُهُمْ خَالِيَةٌ مِنْ شِدَّةِ الهَوْلِ."]],"49":[["مُقَرَّنِينَ فِي الْأَصْفَادِ","مُقَيَّدِينَ بِالقُيُودِ، قَدْ قُرِنَتْ أَيْدِيهِمْ وَأَرْجُلُهُمْ بِالسَّلَاسِلِ."]],"50":[["سَرَابِيلُهُمْ","ثِيَابُهُمْ."],["قَطِرَانٍ","مَادَّةٍ شَدِيدَةِ الِاشْتِعَالِ، تُشْبِهُ الزِّفْتَ، سَوْدَاءَ اللَّوْنِ مُنْتِنَةِ الرِّيحِ."],["وَتَغْشَى","تَعْلُو، وَتَلْفَحُ."]]}