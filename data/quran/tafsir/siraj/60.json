{"1":[["أَوْلِيَاءَ","خُلَصَاءَ وَأَحِبَّاءَ."],["أَنْ تُؤْمِنُوا","لِأَجْلِ إِيمَانِكُمْ."],["ضَلَّ سَوَاءَ السَّبِيلِ","أَخْطَأَ طَرِيقَ الهُدَى."]],"2":[["يَثْقَفُوكُمْ","يَظْفَرُوا بِكُمْ."],["وَيَبْسُطُوا","يَمُدُّوا."]],"3":[["يَفْصِلُ بَيْنَكُمْ","يُفَرِّقُ بَيْنَ المُطِيعِينَ، وَالعَاصِينَ."]],"4":[["أُسْوَةٌ","قُدْوَةٌ."],["بُرَآؤُا","بَرِيئُونَ."],["إِلَّا قَوْلَ إِبْرَاهِيمَ","لَكِنْ لَا تَقْتَدُوا بِإِبْرَاهِيمَ حِينَ قَالَ."],["أَنَبْنَا","رَجَعْنَا بِالتَّوْبَةِ، وَالطَّاعَةِ."],["الْمَصِيرُ","المَرْجِعُ."]],"5":[["فِتْنَةً لِلَّذِينَ كَفَرُوا","بِعَذَابِكَ لَنَا، أَوْ تَسْلِيطِ الكُفَّارِ عَلَيْنَا، فَيَقُولُونَ: لَوْ كَانَ هَؤُلَاءِ عَلَى حَقٍّ، مَا أَصَابَهُمُ العَذَابُ، فَيَزْدَادُوا كُفْرًا."]],"6":[["يَرْجُوا اللَّهَ","يَطْمَعُ فِي الخَيْرِ مِنْ اللَّهِ."],["يَتَوَلَّ","يُعْرِضُ عَنِ الاِقْتِدَاءِ بِالأَنْبِيَاءِ، وَيُوَالِ أَعْدَاءَ اللَّهِ."],["الْحَمِيدُ","المَحْمُودُ فِي ذَاتِهِ، وَصِفَاتِهِ، وَأَفْعَالِهِ."]],"7":[["مَوَدَّةً","مَحَبَّةً."]],"8":[["تَبْرُوهُمْ","تُكْرِمُوهُمْ."],["وَتُقْسِطُوا","تَعْدِلُوا فِيهِمْ."],["الْمُقْسِطِينَ","العَادِلِينَ."]],"9":[["وَظَاهَرُوا","عَاوَنُوا."],["أَنْ تَوَلَّوْهُمْ","أَنْ تَنْصُرُوهُمْ، وَتَوَدُّوهُمْ."]],"10":[["فَامْتَحِنُوهُنَّ","فَاخْتَبِرُوهُنَّ؛ لِتَعْلَمُوا صِدْقَ إِيمَانِهِنَّ."],["وَآتُوهُمْ مَا أَنْفَقُوا","وَأَعْطُوا أَزْوَاجَ اللَّاتِي أَسْلَمْنَ مِثْلَ مَا أَنْفَقُوا عَلَيْهِنَّ مِنْ المُهُورِ."],["جُنَاحَ","إِثْمٌ."],["أُجُورَهُنَّ","مُهُورَهُنَّ."],["بِعِصَمِ الْكَوَافِرِ","بِعُقُودِ نِكَاحِ زَوْجَاتِكُمُ الكَافِرَاتِ."],["وَسْئَلُوا مَا أَنْفَقْتُمْ","وَاطْلُبُوا مِنْ المُشْرِكِينَ مُهُورَ نِسَائِكُمُ المُرْتَدَّاتِ اللَّوَاتِي لَحِقْنَ بِهِمْ."]],"11":[["وَإِنْ فَاتَكُمْ شَيْءٌ مِنْ أَزْوَاجِكُمْ","انْفَلَتَتْ وَاحِدَةٌ بِرِدَّةٍ."],["فَعَاقَبْتُمْ","فَظَفِرْتُمْ بِالكُفَّارِ، وَغَنِمْتُمْ مِنْهُمْ."]],"12":[["يُبَايِعْنَكَ","يُعَاهِدْنَكَ."],["بِبُهْتَانٍ يَفْتَرِينَهُ","بِأَنْ يُلْحِقْنَ بِأَزْوَاجِهِنَّ أَوْلَادًا لَيْسُوا مِنْهُمْ."]],"13":[["لَا تَتَوَلَّوْا","لَا تَجْعَلُوهُمْ أَوْلِيَاءَ، وَأَخِلَّاءَ."]]}