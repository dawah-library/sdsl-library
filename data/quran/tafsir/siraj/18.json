{"1":[["عِوَجًا","مَيْلًا عَنِ الْحَقِّ."]],"2":[["قَيِّمًا","مُسْتَقِيمًا مُعْتَدِلًا."],["بَأْسًا","عَذَابًا."]],"6":[["بَخِعٌ","مُهْلِكٌ."],["أَسَفًا","حُزْنًا، وَغَمًّا."]],"8":[["صَعِيدًا جُرُزًا","تُرَابًا لَا نَبَاتَ فِيهِ."]],"9":[["وَالرَّقِيمِ","اللَّوْحُ الَّذِي كُتِبَ فِيهِ أَسْمَاؤُهُمْ."]],"10":[["أَوَى","الْتَجَأَ."]],"11":[["فَضَرَبْنَا عَلَى ءَاذَانِهِمْ","أَلْقَيْنَا عَلَيْهِمُ النَّوْمَ الْعَمِيقَ."]],"12":[["بَعَثْنٰهُمْ","أَيْقَظْنَاهُمْ مِنْ نَوْمِهِمْ."],["الْحِزْبَيْنِ","الطَّائِفَتَيْنِ الْمُتَنَازِعَتَيْنِ فِي مُدَّةِ لُبْثِهِمْ."]],"14":[["وَرَبَطْنَا عَلَىٰ قُلُوبِهِمْ","قَوَّيْنَا قُلُوبَهُمْ بِالْإِيمَانِ، وَشَدَدْنَا عَزِيمَتَهُمْ بِهِ."],["شَطَطًا","جَائِرًا، بَعِيدًا عَنِ الْحَقِّ."]],"15":[["بِسُلْطَانٍ بَيِّنٍ","بِحُجَّةٍ وَاضِحَةٍ."],["افْتَرَىٰ","اخْتَلَقَ."]],"16":[["مِرْفَقًا","مَا تَنْتَفَعُونَ بِهِ فِي حَيَاتِكُمْ مِنْ أَسْبَابِ الْعَيْشِ."]],"17":[["تَزَاوَرُ","تَمِيلُ."],["تَقْرِضُهُمْ","تَتْرُكُهُمْ، وَتَتَجَاوَزُ عَنْهُمْ."],["فَجْوَةٍ","مُتَّسَعٍ."]],"18":[["بِالْوَصِيدِ","بِفِنَاءِ الْكَهْفِ."],["فِرَارًا","هَرَبًا."]],"19":[["بِوَرِقِكُمْ","بِنُقُودِكُمُ الْفِضِّيَّةِ."],["أَزْكَىٰ","أَحَلُّ، وَأَطْيَبُ."]],"20":[["يَظْهَرُوا","يَطَّلِعُوا."]],"21":[["أَعْثَرْنَا عَلَيْهِمْ","أَطْلَعْنَا عَلَيْهِمْ أَهْلَ ذَلِكَ الزَّمَانِ."],["لَا رَيْبَ","لَا شَكَّ."],["الَّذِينَ غَلَبُوا","أَصْحَابُ النُّفُوذِ فِيهِمْ."]],"22":[["رَجْمًا بِالْغَيْبِ","قَوْلًا بِالظَّنِّ مِنْ غَيْرِ دَلِيلٍ."],["فَلَا تُمَارِ فِيهِمْ","لَا تُجَادِلْ فِي عِدَّتِهِمْ."],["إِلَّا مِرَاءً ظَاهِرًا","إِلَّا جِدَالًا ظَاهِرًا لَا عُمْقَ فِيهِ بِأَنْ تَتْلُوَ مَا أُوحِيَ إِلَيْكَ."]],"24":[["إِلَّا أَنْ يَشَاءَ اللَّهُ","إِلَّا أَنْ تُعَلِّقَ قَوْلَكَ بِالْمَشِيئَةِ، فَتَقُولَ: إِنْ شَاءَ اللَّهُ."]],"26":[["أَبْصِرْ بِهِ وَأَسْمِعْ","مَا أَشَدَّ بَصَرَ اللَّهِ بِكُلِّ شَيْءٍ وَسَمْعَهُ لِكُلِّ شَيْءٍ."]],"27":[["مُلْتَحَدًا","مَلْجَأً تَلْجَأُ إِلَيْهِ."]],"28":[["بِالْغَدَاةِ وَالْعَشِيِّ","فِي الصَّبَاحِ وَالْمَسَاءِ."],["وَلَا تَعُدُ عَيْنَاكَ","لَا تَصْرِفْ نَظَرَكَ."],["فُرُطًا","هَلَاكًا، وَضَيَاعًا."]],"29":[["سُرَادِقُهَا","سُورُهَا."],["كَالْمُهْلِ","كَالزَّيْتِ الْعَكِرِ."],["وَسَاءَتْ مُرْتَفَقًا","قَبُحَتْ مَنْزِلًا وَمُقَامًا."]],"31":[["عَدْنٍ","إِقَامَةٍ."],["سُندُسٍ","رَقِيقِ الْحَرِيرِ."],["وَإِسْتَبْرَقٍ","غَلِيظِ الْحَرِيرِ."],["الْأَرَائِكِ","الْأَسِرَّةِ الْمُزَيَّنَةِ بِالسُّتُورِ الْجَمِيلَةِ."]],"32":[["جَنَّتَيْنِ","حَدِيقَتَيْنِ."],["وَحَفَفْنَاهُمَا","أَحَطْنَاهُمَا."]],"33":[["وَآتَتْ أُكُلَهَا","أَثْمَرَتْ ثَمَرَهَا."],["تَظْلِمْ","تَنْقُصْ."],["فَجَّرْنَا","بَيْنَهُمَا."]],"34":[["ثَمَرٍ","ثِمَارٌ، وَأَمْوَالٌ أُخْرَى كَثِيرَةٌ."],["نَفَرًا","أَنْصَارًا، وَأَعْوَانًا."]],"35":[["مَا أَظُنُّ","لَا أَعْتَقِدُ."],["تَبِيدُ","تَهْلِكُ."]],"36":[["مُنْقَلَبًا","مَرْجِعًا وَمَرَدًّا."]],"38":[["لَكِنَّا","لَكِنْ أَنَا."]],"40":[["حُسْبَانًا","عَذَابًا."],["صَعِيدًا زَلَقًا","أَرْضًا مَلْسَاءَ جَرْدَاءَ لَا تَثْبُتُ عَلَيْهَا قَدَمٌ، وَلَا تُنْبِتُ شَيْئًا."]],"41":[["غَوْرًا","غَائِرًا ذَاهِبًا فِي عُمْقِ الْأَرْضِ."]],"42":[["وَأُحِيطَ بِثَمَرِهِ","أُهْلِكَتْ أَمْوَالُهُ، وَحَدِيقَتُهُ."],["يُقَلِّبَ كَفَّيْهِ","كِنَايَةً عَنِ النَّدَامَةِ وَالْحَسْرَةِ."]],"43":[["فِئَةٌ","جَمَاعَةٌ."]],"44":[["عُقْبًا","عَاقِبَةً."]],"45":[["هَشِيمًا","يَابِسًا مُتَكَسِّرًا."],["تَذْرُوهُ","تَسِفُهُ الرِّيَاحُ إِلَى كُلِّ جِهَةٍ."]],"46":[["وَالْبَاقِيَاتُ الصَّالِحَاتُ","الْأَعْمَالُ الصَّالِحَةُ."],["وَخَيْرُ أَمَلًا","خَيْرُ مَا يُرْجَى عِنْدَ اللَّهِ."]],"47":[["بَارِزَةً","ظَاهِرَةً لَيْسَ عَلَيْهَا مَا كَانَ يَسْتُرُهَا مِنَ الْمَخْلُوقَاتِ."],["وَحَشَرْنَاهُمْ","جَمَعْنَاهُمْ."],["فَلَمْ نُغَادِرْ","لَمْ نَتْرُكْ."]],"48":[["صَفًّا","مُصْطَفِّينَ."]],"49":[["وَوُضِعَ الْكِتَابُ","كِتَابُ أَعْمَالِ كُلِّ وَاحِدٍ فِي يَمِينِهِ، أَوْ شِمَالِهِ."],["لَا يُغَادِرُ","لَا يَتْرُكُ."],["حَاضِرًا","مُثْبَتًا."]],"50":[["فَفَسَقَ","فَخَرَجَ."],["أَوْلِيَاءَ","أَعْوَانًا تُطِيعُونَهُمْ."]],"51":[["عَضُدًا","أَعْوَانًا."]],"52":[["مَوْبِقًا","مَهْلِكًا فِي جَهَنَّمَ يَهْلِكُونَ فِيهِ جَمِيعًا."]],"53":[["مُوَاقِ