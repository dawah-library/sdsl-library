{"1":[["الْوَاقِعَةُ","الْقِيَامَةُ."]],"3":[["خَافِضَةٌ رَافِعَةٌ","تَخْفِضُ الْكُفَّارَ فِي النَّارِ، وَتَرْفَعُ الْمُؤْمِنِينَ"]],"4":[["رُجَّتِ","حُرِّكَتْ."],["رَجًّا","تَحْرِيكًا شَدِيدًا."]],"5":[["بُسَّتِ","فُتِّتْ."]],"6":[["هَبَاءً مُنْبَثًّا","غُبَارًا مُتَطَايِرًا فِي الْجَوِّ."]],"7":[["أَزْوَاجًا","أَصْنَافًا."]],"10":[["وَالسَّابِقُونَ","الَّذِينَ يَسْبِقُونَ إِلَى الْخَيْرَاتِ، وَيُسَارِعُونَ"],["السَّابِقُونَ","الَّذِينَ يَسْبِقُونَ إِلَى الْمَنَازِلِ الْعَالِيَةِ فِي الْجَنَّةِ."]],"13":[["ثُلَّةٌ","جَمَاعَةٌ كَثِيرَةٌ."]],"14":[["الْآخِرِينَ","آخِرُ هَذِهِ الْأُمَّةِ."]],"15":[["مَوْضُونَةٍ","مَنْسُوجَةٍ بِالذَّهَبِ."]],"17":[["وِلْدَانٌ مُخَلَّدُونَ","غِلْمَانٌ لِلْخِدْمَةِ لَا يَهْرَمُونَ، وَلَا يَمُوتُونَ."]],"18":[["بِأَكْوَابٍ","أَقْدَاحٍ لَا عُرَى لَهَا، وَلَا خَرَاطِيمَ."],["وَأَبَارِيقَ","أَوَانٍ لَهَا عُرَى، وَخَرَاطِيمُ."]],"19":[["لَا يُصَدَّعُونَ عَنْهَا","لَا تُصَدَّعُ مِنْهَا رُؤُوسُهُمْ."],["وَلَا يُنْزِفُونَ","لَا تَذْهَبُ بِعُقُولِهِمْ."]],"22":[["وَحُورٌ عِينٌ","نِسَاءُ بِيضٌ وَاسِعَاتُ الْأَعْيُنِ حِسَانُهَا."]],"23":[["الْمَكْنُونُ","الْمَصُونُ فِي أَصْدَافِهِ مِنْ صَفَائِهِنَّ،"]],"25":[["لَغْوًا","بَاطِلًا، وَكَلَامًا لَا خَيْرَ فِيهِ."],["تَأْثِيمًا","مَا يَتَأَثَّمُونَ بِسَمَاعِهِ."]],"26":[["قِيلًا","قَوْلًا."],["سَلَامًا","إِلَّا قَوْلًا سَالِمًا مِنْ هَذِهِ الْعُيُوبِ، وَإِلَّا"]],"28":[["سِدْرٍ مَخْضُودٍ","شَجَرِ النَّبْقِ لَا شَوْكَ فِيهِ."]],"29":[["وَطَلْحٍ مَنْضُودٍ","مَوْزٍ مُتَرَاكِبٍ بَعْضُهُ عَلَى بَعْضٍ، أَوْ هُوَ شَجَرُ"]],"30":[["وَظِلٍّ مَمْدُودٍ","ظِلٍّ دَائِمٍ لَا يَزُولُ."]],"31":[["مَسْكُوبٍ","جَارٍ لَا يَنْقَطِعُ."]],"34":[["مَرْفُوعَةٍ","مَرْفُوعَةٍ عَلَى السُّرُرِ."]],"35":[["إِنَّا أَنْشَأْنَاهُنَّ إِنْشَاءً","خَلَقْنَا نِسَاءَ أَهْلِ الْجَنَّةِ نَشْأَةً كَامِلَةً لَا تَقْبَلُ"]],"37":[["عُرُبًا","مُتَحَبِّبَاتٍ لِأَزْوَاجِهِنَّ."],["أَتْرَابًا","فِي سِنٍّ وَاحِدَةٍ."]],"42":[["سَمُومٍ","رِيحٍ حَارَّةٍ مِنْ حَرِّ نَارِ جَهَنَّمَ، تَأْخُذُ"],["وَحَمِيمٍ","مَاءٍ حَارٍّ يَغْلِي."]],"43":[["يَحْمُومٍ","دُخَانٍ شَدِيدِ السَّوَادِ."]],"44":[["لَا بَارِدٍ وَلَا كَرِيمٍ","لَا بَارِدِ الْمَنْزِلِ، وَلَا طَيِّبِ الْمَنْظَرِ."]],"45":[["مُتْرَفِينَ","مُتَنَعِّمِينَ مُنْهَمِكِينَ فِي الشَّهَوَاتِ."]],"46":[["الْحِنْثِ الْعَظِيمِ","الذَّنْبِ الْعَظِيمِ؛ وَهُوَ الشِّرْكُ بِاللَّهِ."]],"52":[["زَقُّومٍ","الزَّقُّومُ: أَقْبَحُ الشَّجَرِ فِي النَّارِ."]],"54":[["الْحَمِيمِ","مَاءٍ مُتَنَاهٍ فِي الْحَرَارَةِ."]],"55":[["شُرْبَ الْهِيمِ","كَشُرْبِ الْإِبِلِ الْعِطَاشِ الَّتِي لَا تَرْوَى لِدَاءٍ"]],"56":[["نُزُلُهُمْ","مَا أُعِدَّ لَهُمْ مِنَ الْجَزَاءِ."],["يَوْمَ الدِّينِ","يَوْمَ الْجَزَاءِ، وَالْحِسَابِ."]],"57":[["فَلَوْلَا تُصَدِّقُونَ","هَلَّا تُصَدِّقُونَ بِالْبَعْثِ؟!"]],"58":[["مَا تُمْنُونَ","النُّطْفَةَ الَّتِي تَقْذِفُونَهَا فِي أَرْحَامِ نِسَائِكُمْ."]],"60":[["بِمَسْبُوقِينَ","بِعَاجِزِينَ."]],"65":[["حُطَامًا","هَشِيمًا؛ لَا يُنْتَفَعُ بِهِ فِي مَطْعَمٍ."],["فَظَلْتُمْ","أَصْبَحْتُمْ."],["تَفَكَّهُونَ","تَتَعَجَّبُونَ مِمَّا نَزَلَ بِزَرْعِكُمْ."]],"66":[["إِنَّا لَمُغْرَمُونَ","تَقُولُونَ: إِنَّا لَخَاسِرُونَ مُعَذَّبُونَ."]],"71":[["تُورُونَ","تُوقِدُونَ، وَتَقْدَحُونَ الزِّنَادَ لِاسْتِخْرَاجِهَا."]],"72":[["أَنْشَأْتُمْ","أَوْجَدْتُمْ."],["شَجَرَتَهَا","الشَّجَرَةَ الَّتِي تَقْدَحُ مِنْهَا النَّارُ؛ كَالْمَرْخِ"]],"73":[["تَذْكِرَةً","تَذْكِيرًا لَكُمْ بِنَارِ جَهَنَّمَ."],["وَمَتَاعًا لِلْمُقْوِينَ","مَنْفَعَةً لِلْمُسَافِرِينَ."]],"74":[["فَسَبِّحْ بِاسْمِ رَبِّكَ","نَزِّهْ رَبَّكَ ذَاكِرًا اسْمَهُ."]],"75":[["فَلَا أُقْسِمُ","أُقْسِمُ وَأَحْلِفُ، وَ(لَا): تَوْكِيدٌ لِلْقَسَمِ."],["بِمَوَاقِعِ النُّجُومِ","بِمَسَاقِطِهَا فِي مَغَارِبِهَا فِي السَّمَاءِ."]],"77":[["كَرِيمٌ","عَظِيمُ المَنَافِعِ، كَثِيرُ الخَيْرِ، غَزِيرُ العِلْمِ."]],"78":[["مَكْنُونٌ","مَسْتُورٍ مَصُونٍ."]],"81":[["الْحَدِيثِ","القُرْآنِ."],["مُدْهِنُونَ","مُكَذِّبُونَ."]],"82":[["وَتَجْعَلُونَ رِزْقَكُمْ","تَجْعَلُونَ شُكْرَ نِعَمِ اللَّهِ عَلَيْكُمْ."]],"83":[["بَلَغَتِ الْحُلْقُومَ","وَصَلَتِ الرُّوحُ الحُلْقُومَ عِنْدَ المَوْتِ."]],"86":[["غَيْرَ مَدِينِينَ","غَيْرَ مَجْزِيِّينَ، وَمُحَاسَبِينَ."]],"87":[["تَرْجِعُونَهَا","تَرْدُّونَ الرُّوحَ إِلَى الجَسَدِ."]],"89":[["فَرَوْحٌ","رَحْمَةٌ وَاسِعَةٌ، وَاسْتِرَاحَةٌ، وَفَرْحٌ."],["وَرَيْحَانٌ","رِزْقٌ حَسَنٌ، وَرَائِحَةٌ طَيِّبَةٌ، وَجَمِيعُ مَا تَطِيبُ بِهَ نَفْسُهُ."]],"91":[["فَسَلَامٌ لَكَ","يُقَالُ لَهُ: سَلَامَةٌ لَكَ، وَأَمْنٌ."],["مِنْ أَصْحَابِ الْيَمِينِ","لَكَوْنِكَ مِنْ أَصْحَابِ اليَمِينِ."]],"93":[["فَنُزُلٌ","ضِيَافَةٌ."],["حَمِيمٌ","شَرَابٍ جَهَنَّمَ المُتَنَاهِي فِي الحَرَارَةِ."]],"94":[["وَتَصْلِيَةُ جَحِيمٍ","يَدْخُلُ فِيهَا، وَيُقَاسِي حَرَّهَا."]],"95":[["حَقِّ الْيَقِينِ","لَا مِرْيَةَ فِيهِ."]]}