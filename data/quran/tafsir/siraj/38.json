{"1":[["ذِي الذِّكْرِ","المُشْتَمِلِ عَلَى تَذْكِيرِ النَّاسِ بِمَا هُمْ عَنْهُ غَافِلُونَ."]],"2":[["عِزَّةٍ","تَكَبُّرٍ، وَحَمِيَّةٍ."],["وَشِقَاقٍ","مُخَالَفَةٍ، وَعِنَادٍ."]],"3":[["كَمْ أَهْلَكْنَا","كَثِيرًا مِنَ الْأُمَمِ أَهْلَكْنَا."],["قَرْنٍ","أُمَّةٍ سَابِقَةٍ."],["وَلَاتَ حِينَ مَنَاصٍ","لَيْسَ الوَقْتُ وَقْتَ فِرَارٍ وَخَلَاصٍ."]],"5":[["عُجَابٌ","عَجِيبٌ."]],"6":[["الْمَلَأُ","الْأَشْرَافُ، وَكِبَارُ القَوْمِ."],["امْشُوا","اسْتَمِرُّوا عَلَى دِينِكُمْ، وَشِرْكِكُمْ."],["لَشَيْءٌ يُرَادُ","مُدَبَّرٌ يُقْصَدُ مِنْهُ التَّرَؤُّسُ، وَالسِّيَادَةُ."]],"10":[["فَلْيَرْتَقُواْ فِي ٱلْأَسْبَابِ","فَلْيَأْخُذُوا بِالْأَسْبَابِ الْمُوصِلَةِ إِلَى السَّمَاءِ، وَلِيَمْنَعُوا الْوَحْيَ."]],"11":[["جُندُ مَّا","جُنُودٌ قَلِيلُونَ حَقِيرُونَ."]],"12":[["ذُو ٱلْأَوْتَادِ","صَاحِبُ الْجُنُودِ، وَالْقُوَّةِ الْعَظِيمَةِ."]],"13":[["وَأَصْحَبُ لِيَكَةَ","أَصْحَابُ الْأَشْجَارِ وَالْبَسَاتِينِ؛ وَهُمْ قَوْمُ شُعَيْبٍ ﷺ."]],"14":[["فَحَقَّ عِقَابِ","فَوَجَبَ الْعِقَابُ عَلَيْهِمْ."]],"15":[["وَمَا يَنظُرُ","مَا يَنْتَظِرُ."],["صَيْحَةً وَحِدَةً","نَفْخَةَ الْقِيَامَةِ."],["فَوَاقٍ","رُجُوعٍ."]],"16":[["قِطَنَا","نَصِيبَنَا مِنَ الْعَذَابِ."]],"17":[["ذَا ٱلْأَيْدِ","صَاحِبُ الْقُوَّةِ عَلَى الطَّاعَةِ، وَفِي الْحَرْبِ."],["أَوَّابٍ","كَثِيرُ الرُّجُوعِ إِلَى مَا يُرْضِي اللَّهَ."]],"18":[["بِٱلْعَشِيِّ","آخِرِ النَّهَارِ."],["وَٱلْإِشْرَاقِ","أَوَّلِ النَّهَارِ."]],"19":[["مَّحْشُورَةٌ","مَجْمُوعَةٌ."],["أَوَّابٍ","مُطِيعٍ."]],"20":[["وَشَدَدْنَا مُلْكَهُ","قَوَّيْنَا مُلْكَهُ بِالْهَيْبَةِ، وَالتَّمْكِينِ، وَالنَّصْرِ."],["ٱلْحِكْمَةَ","النُّبُوَّةَ."],["وَفَصْلَ ٱلْخِطَابِ","الْبَيَانَ الشَّافِيَ وَالْفَصْلَ فِي الْكَلَامِ وَالْحُكْمِ."]],"21":[["نَبَأُ","خَبَرُ."],["ٱلْخَصْمِ","الْمُتَخَاصِمِينَ."],["ٱلْمِحْرَابُ","مَكَانَ عِبَادَتِهِ."]],"22":[["وَلَا تُشْطِطْ","لَا تَجُرْ فِي حُكْمِكَ، وَلَا تَظْلِمْ."],["سَوَاءِ ٱلصِّرَٰطِ","وَسَطَ الطَّرِيقِ الصَّوَابِ."]],"23":[["أَكْفِلْنِيهَا","أَعْطِنِيهَا، وَانْزِلْ لِي عَنْهَا."],["وَعَزَّنِي فِي ٱلْخِطَابِ","غَلَبَنِي فِي الْكَلَامِ، وَاشْتَدَّ عَلَيَّ فِيهِ."]],"24":[["ٱلْخُلَطَاءِ","الشُّرَكَاءِ."],["لَيَبْغِي","لِيَعْتَدِيَ."],["وَظَنَّ","أَيْقَنَ."],["فَتَنَّهُ","ابْتَلَيْنَاهُ، وَامْتَحَنَّاهُ."],["وَخَرَّ رَاكِعًا","سَجَدَ لِلَّهِ تَعَالَى."],["وَأَنَابَ","رَجَعَ، وَتَابَ."]],"25":[["لُزْلْفَىٰ","لِقُرْبَى وَمَكَانَةٍ."],["مَابٍ","مَرْجِعٍ."]],"27":[["بَطِلَّا","عَبَثًا وَلَهْوًا."],["فَوَيْلٌ","فَهَلَاكٌ."]],"30":[["أَوَّابٍ","كَثِيرِ الرُّجُوعِ إِلَى اللَّهِ بِالتَّوْبَةِ، وَالطَّاعَةِ."]],"31":[["بِٱلْعَشِيِّ","عَصْرًا."],["ٱلصَّفِنَاتُ","الْخُيُولُ الْوَاقِفَةُ عَلَى ثَلَاثِ قَوَائِمَ، وَتَرْفَعُ الرَّابِعَةَ؛ لِنَجَابَتِهَا وَخِفَّتِهَا."],["ٱلْجِيَادُ","الْخُيُولُ الْأَصِيلَةُ السَّرِيعَةُ."]],"32":[["أَحْبَبْتُ حُبَّ ٱلْخَيْرِ","آثَرْتُ حُبَّ الْمَالِ."],["تَوَارَتْ بِٱلْحِجَابِ","غَابَتِ الشَّمْسُ، أَوْ غَابَتِ الْخَيْلُ عَنْ عَيْنِهِ."]],"33":[["فَطَفِقَ","شَرَعَ."],["مَسْحًا بِٱلسُّوقِ وَٱلْأَعْنَاقِ","يَمْسَحُ سِيقَانَهَا وَأَعْنَاقَهَا، أَوْ يَقْطَعُهَا بِالسَّيْفِ تَقَرُّبًا إِلَى اللَّهِ."]],"34":[["فَتَنَّا","ابْتَلَيْنَا."],["جَسَدًا","شِقَّ إِنْسَانٍ وُلِدَ لَهُ."],["أَنَابَ","رَجَعَ إِلَى اللَّهِ بِالتَّوْبَةِ."]],"36":[["رِخَاءً","لَيِّنَةً طَيِّعَةً."],["حَيْثُ أَصَابَ","حَيْثُ أَرَادَ."]],"38":[["مُقَرَّنِينَ","مُوَثَّقِينَ."],["ٱلْأَصْفَادِ","الْأَغْلَالَ."]],"39":[["فَأَمْنُنْ","أَعْطِ مَنْ شِئْتَ."]],"40":[["لَزُلْفَىٰ","لِقُرْبَى وَكَرَامَةٍ."],["وَحُسْنَ مَابٍ","حُسْنَ مَرْجِعٍ فِي الْآخِرَةِ."]],"41":[["نُصْبٍ","مَشَقَّةٍ، وَتَعَبٍ."],["وَعَذَابٍ","أَلَمٍ فِي جَسَدِي، وَمَالِي، وَأَهْلِي."]],"42":[["ٱرْكُضْ بِرِجْلِكَ","اضْرِبْ بِرِجْلِكَ الْأَرْضَ لِيَنْبُعْ لَكَ الْمَاءُ."],["مُغْتَسَلٌ بَارِدٌ","مَاءٌ تَغْتَسِلُ بِهِ، فِيهِ شِفَاؤُكَ."]],"43":[["لِأُوْلِي ٱلْأَلْبَابِ","لِأَصْحَابِ الْعُقُولِ السَّلِيمَةِ."]],"44":[["ضِغْثًا","حُزْمَةً شَمَارِيخَ أَوْ قَبْضَةَ حَشِيشٍ."],["وَلَا تَحْنَثْ","لَا تَنْقُضْ يَمِينَكَ الَّتِي حَلَفْتَهَا بِضَرْبِ زَوْجِتِكَ."],["أَوَّابٍ","رَجَّاعٍ إِلَى طَاعَةِ اللَّهِ."]],"45":[["أُوْلِي ٱلْأَيْدِي","أَصْحَابِ الْقُوَّةِ فِي الطَّاعَةِ."],["وَٱلْأَبْصَارِ","الْبَصِيرَةِ فِي الدِّينِ."]],"46":[["أَخْلَصْنَاهُم بِخَالِصَةٍ","خَصَصْنَاهُمْ بِخَصْلَةٍ عَظِيمَةٍ."],["ذِكْرَى ٱلدَّارِ","تَذَكُّرُ الْآخِرَةِ فِي قُلُوبِهِمْ."]],"47":[["ٱلْمُصْطَفَيْنَ","الْمُخْتَارِينَ."]],"49":[["لَحُسْنَ مَابٍ","حُسْنَ مَرْجِعٍ فِي الْآخِرَةِ."]],"52":[["قَصِرَٰتُ ٱلطَّرْفِ","لَا يَنْظُرْنَ إِلَى غَيْرِ أَزْوَاجِهِنَّ."],["أَتْرَابٌ","مُتَسَاوِيَاتُ السِّنِّ."]],"54":[["نَفَادٍ","انْقِطَاعٍ."]],"55":[["لَشَرِّ مَابٍ","أَسْوَأَ مَرْجِعٍ فِي الْآخِرَةِ."]],"56":[["يَصْلَوْنَهَا","يَدْخُلُونَهَا وَيُقَاسُونَ حَرَّهَا."],["ٱلْمِهَادُ","الْفِرَاشُ."]],"57":[["حَمِيمٌ","مَاءٌ شَدِيدُ الْحَرَارَةِ."],["وَغَسَّاقٌ","صَدِيدٌ سَائِلٌ مِنْ أَجْسَادِ أَهْلِ النَّارِ."]],"58":[["مِنْ شَكْلِهِ","مِنْ مِثْلِهِ."],["أَزْوَاجٌ","أَصْنَافٌ، وَأَلوانٌ."]],"59":[["فَوْجٌ","جَمَاعَةٌ مِنْ أَهْلِ النَّارِ."],["مُقْتَحِمٌ مَعَكُمْ","دَاخِلَةٌ النَّارَ مَعَكُمْ."],["لَا مَرْحَبًا بِهِمْ","لَا رَحُبَتْ بِهِمُ النَّارُ، وَلَا اتَّسَعَتْ مَنَازِلُهُمْ فِيهَا."],["صَالُوا النَّارَ","مُقَاسُو حَرَّهَا."]],"60":[["الْقَرَارُ","الْمَقَرُّ."]],"61":[["ضِعْفًا","مُضَاعَفًا."]],"63":[["زَاغَتْ","مَالَتْ، فَلَمْ تَقَعْ عَلَيْهِمْ."]],"64":[["تَخَاصُمُ","جِدَالٌ."]],"67":[["نَبَأٌ عَظِيمٌ","الْقُرْآنُ خَبَرٌ عَظِيمُ النَّفْعِ."]],"69":[["بِالْمَلَإِ الْأَعْلَى","الْمَلَائِكَةِ."]],"72":[["سَوَّيْتُهُ","خَلَقْتُ جَسَدَهُ كَامِلًا مُتَنَاسِقَ الْأَعْضَاءِ."]],"77":[["رَجِيمٌ","مَرْجُومٌ مَطْرُودٌ مِنْ رَحْمَةِ اللَّهِ."]],"78":[["لَعْنَتِي","طَرْدِي، وَإِبْعَادِي."]],"79":[["فَأَنْظِرْنِي","أَخِّرْنِي."]],"82":[["فَبِعِزَّتِكَ","بِسُلْطَانِكَ، وَعَظَمَتِكَ."],["لَأُغْوِيَنَّهُمْ","لَأُضِلَّنَّهُمْ."]],"83":[["الْمُخْلَصِينَ","الَّذِينَ أَخْلَصْتُهُمْ، وَاصْطَفَيْتُهُمْ لِعِبَادَتِكَ."]],"86":[["أَجْرٍ","جَزَاءً وَأُجْرَةً عَلَى الْهِدَايَةِ وَالدَّعْوَةِ."],["الْمُتَكَلِّفِينَ","الْمُتَصَنِّعِينَ الْمُتَقَوِّلِينَ عَلَى اللَّهِ."]],"88":[["نَبَأهُ","خَبَرَ الْقُرْآنِ وَصِدْقَهُ."]]}