{"1":[["نَفَرٌ","جَمَاعَةٌ."],["عَجَباً","يُتَعَجَّبُ مِنْهُ فِي فَصَاحَتِهِ، وَبَلَاغَتِهِ، وَمَعَانِيهِ."]],"2":[["الرُّشْدَ","الحَقَّ، وَالهُدَى."]],"3":[["جَدُّ رَبِّنَا","عَظَمَةُ رَبِّنَا، وَجَلَالُهُ، وَغِنَاهُ."],["صَاحِبَةً","زَوْجَةً."]],"4":[["سَفِيهُنَا","إِبْلِيسُ."],["شَطَطاً","قَوْلًا بَعِيدًا عَنِ الحَقِّ مِنْ دَعْوَى الصَّاحِبَةِ وَالوَلَدِ."]],"6":[["يَعُوذُونَ","يَسْتَجِيرُونَ، وَيَسْتَعِيذُونَ."],["رَهَقاً","طُغْيَانًا، وَسَفَهًا."]],"7":[["وَأَنَّهُمْ ظَنُّوا","وَأَنَّ كُفَّارَ الإِنْسِ حَسِبُوا."]],"8":[["لَمَسْنَا السَّمَاءَ","طَلَبْنَا بُلوغَ السَّمَاءِ؛ لِاسْتِرَاقِ السَّمْعِ."]],"9":[["وُشُهاْباً","نُجُومًا مُحْرِقَةً؛ وَذَلِكَ لَمَّا بُعِثَ النَّبِيُّ ﷺ."],["مَقَاعِدَ لِلسَّمْعِ","مَوَاضِعَ؛ لِنَسْتَمِعَ إِلَى أَخْبَارِهَا."],["رَصَداً","أُرْصِدَ لَهُ؛ لِيُرْمَى بِهِ."]],"10":[["رَشَداً","خَيْرًا، وَصَلَاحًا، وَرَحْمَةً."]],"11":[["طَرَائِقَ قِدَداً","فِرَقًا وَمَذَاهِبَ مُخْتَلِفَةً."]],"12":[["ظَنَنَّا","أَيْقَنَّا."],["لَّن نُّعْجِزَ اللَّهَ","لَنْ نَفُوتَهُ، وَنُفْلِتَ مِنْ قَبْضَتِهِ."]],"13":[["بَخْسًا","نُقْصَانًا مِنْ حَسَنَاتِهِ."]],"14":[["الْقَاسِطُونَ","الجَائِرُونَ، الظَّالِمُونَ الَّذِينَ حَادُوا عَنِ الحَقِّ."]],"16":[["وَأَلَّوِ اسْتَقَامُواْ","وَأَنَّهُ لَوِ اسْتَقَامَ الكُفَّارُ."],["الطَّرِيقَةِ","دِينَ الإِسْلَامِ."],["غَدَقًا","كَثِيرًا."]],"17":[["لَنَفْتِنَهُمْ فِيهِ","لَنُخْتَبَرَّهُمْ كَيْفَ يَشْكُرُونَ نِعَمَ اللَّهِ عَلَيْهِمْ."],["يَسْلُكْهُ","يُدْخِلْهُ."],["صَعَدًا","شَدِيدًا شَاقًّا."]],"19":[["يَدْعُوهُ","يَعْبُدُ رَبَّهُ."],["كَادُواْ","قَارَبَ الجِنُّ."],["لِبَدًا","جَمَاعَاتٍ مُتَرَاكِبَةً بَعْضُهَا فَوْقَ بَعْضٍ، مِنْ شِدَّةِ ازدِحَامِهِمْ لِسَمَاعِ القُرْآنِ مِنْهُ."]],"21":[["رَشَدًا","نَفْعًا."]],"22":[["يُجِيرُنِي","يُنْقِذُنِي."],["مُلْتَحَدًا","مَلْجَأً أَفِرُ إِلَيْهِ مِنْ عَذَابِهِ."]],"23":[["إِلَّا بَلَغًا","لَكِنْ أَمْلِكُ أَنْ أُبْلِغَكُمْ."]],"25":[["إِنْ أَدْرِي","مَا أَدْرِي."],["مَا تُوعَدُونَ","العَذَابَ الَّذِي وُعِدْتُمْ بِهِ."],["أَمَدًا","مُدَّةً طَوِيلَةً."]],"27":[["يَسْلُكُ","يُرْسِلُ."],["رَصَدًا","مَلَائِكَةً يَحْفَظُونَهُ، وَيَحْرُسُونَهُ."]]}