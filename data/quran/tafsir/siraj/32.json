{"3":[["افْتَرَاهُ","اخْتَلَقَهُ مِنْ عِنْدِ نَفْسِهِ."]],"4":[["اسْتَوَى","عَلَا وَارْتَفَعَ؛ اسْتِوَاءً يَلِيقُ بِجَلَالِهِ وَعَظَمَتِهِ."]],"5":[["يَعْرُجُ إِلَيْهِ","يَصْعَدُ إِلَيْهِ."]],"8":[["نَسْلُهُ","ذُرِّيَّتُهُ."],["سُلَالَةٍ","وَهِيَ النُّطْفَةُ؛ لِأَنَّهَا مُسْتَلَّةٌ مِنْ جَمِيعِ الْبَدَنِ."],["مَهِينٍ","ضَعِيفٍ، رَقِيقٍ."]],"10":[["ضَلَلْنَا فِي الْأَرْضِ","تَحَوْلْنَا تُرَابًا بَعْدَ الْمَوْتِ."]],"12":[["نَاكِسُو رُءُوسِهِمْ","قَدْ خَفَضُوهَا، وَأَطْرَقُوا خِزْيًا وَنَدَمًا."]],"13":[["حَقَّ الْقَوْلُ","ثَبَتَ وَتَحَقَّقَ وَوَجَبَ."],["الْجِنَّةَ","الْجِنُّ."]],"16":[["تَتَجَافَى","تَرْتَفِعُ، وَتَتَنَحَّى لِلْعِبَادَةِ."],["الْمَضَاجِعُ","فُرُشُ النَّوْمِ."]],"17":[["مَا أُخْفِيَ لَهُمْ","مَا ادُّخِرَ لَهُمْ مِنَ الْجَزَاءِ."],["مِنْ قُرَّةِ أَعْيُنٍ","مَا يُفْرِحُ، وَيَسُرُّ."]],"19":[["الْمَأْوَى","الَّتِي يَأْوُونَ إِلَيْهَا، وَيُقِيمُونَ بِهَا."],["نُزُلًا","ضِيَافَةً لَهُمْ."]],"21":[["الْعَذَابَ الْأَدْنَى","الْبَلَايَا وَالْمَصَائِبَ فِي الدُّنْيَا."]],"23":[["مِنْ لِقَائِهِ","لِقَاءِ مُوسَى ﷺ لَيْلَةَ الْإِسْرَاءِ."]],"26":[["أَوَلَمْ يَهْدِ لَهُمْ","أَوَلَمْ يَتَبَيَّنْ لَهؤلاءِ الْمُكَذِّبِينَ؟"],["كَمْ أَهْلَكْنَا","مَا أَكْثَرَ إِهْلَاكَنَا."],["مِنَ الْقُرُونِ","مِنَ الْأُمَمِ السَّابِقَةِ."]],"27":[["الْجُرُزِ","الْيَابِسَةِ، الْغَلِيظَةِ الَّتِي لَا نَبَاتَ فِيهَا."]],"28":[["الْفَتْحُ","يَوْمُ الْعَذَابِ الَّذِي تَعِدُونَنَا."]],"29":[["يُنْظَرُونَ","يُمْهَلُونَ."]]}