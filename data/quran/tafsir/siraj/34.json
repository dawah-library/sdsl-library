{"2":[["يَلِجُ","يَدْخُلُ."],["يَعْرُجُ","يَصْعَدُ."]],"3":[["لَا يَعْزُبُ","لَا يَغِيبُ."],["مِثْقَالَ ذَرَّةٍ","وَزْنَ نَمْلَةٍ صَغِيرَةٍ."]],"5":[["مُعَاجِزِينَ","مُشَاقِّينَ اللَّهَ، مُغَالِبِينَ أَمْرَهُ."],["عَذَابٌ مِّن رِّجْزٍ أَلِيمٌ","أَسْوَأُ العَذَابِ، وَأَشَدُّهُ أَلَمًا."]],"7":[["مُّزَّقْتُمْ","مُتُّمْ، وَتَفَرَّقَتْ أَجْسَادُكُمْ فِي الأَرْضِ."]],"8":[["أَفْتَرَى","أَخْتَلَقَ؟"],["جِنَّةٌ","جُنُونٌ."]],"9":[["نَخْسِفْ بِهِمُ","نُغَيِّبْهُمْ فِي الأَرْضِ."],["كَسْفًا","قِطَعًا مِنَ العَذَابِ."],["مُّنِيبٍ","رَاجِعٍ إِلَى رَبِّهِ بِالتَّوْبَةِ وَالطَّاعَةِ."]],"10":[["فَضْلًا","نُبُوَّةً، وَعِلْمًا، وَكِتَابًا وَمُلْكًا."],["أَوْيِي مَعَهُ","سَبِّحِي مَعَهُ."]],"11":[["سَابِغَاتٍ","دُرُوعًا تَامَّاتٍ وَاسِعَاتٍ."],["وَقَدِّرْ فِي السَّرْدِ","قَدِّرِ المَسَامِيرَ فِي حَلَقِ الدُّرُوعِ بِأَلَّا تَكُونَ الحَلَقُ صَغِيرَةً ضَعِيفَةً، وَلَا كَبِيرَةً ثَقِيلَةً."]],"12":[["غُدُوُّهَا شَهْرٌ","جَرْيَانُهَا مِنْ أَوَّلِ النَّهَارِ إِلَى انْتِصَافِهِ مَسِيرَةُ شَهْرٍ بِالسَّيْرِ الْمُعْتَادِ."],["وَرَوَاحُهَا شَهْرٌ","جَرْيَانُهَا مِنْ مُنْتَصَفِ النَّهَارِ إِلَى اللَّيْلِ مَسِيرَةُ شَهْرٍ بِالسَّيْرِ الْمُعْتَادِ."],["وَأَسَلْنَا","أَذَبْنَا."],["عَيْنَ الْقِطْرِ","عَيْنَ النُّحَاسِ، فَيُسِيلُ لَهُ النُّحَاسُ كَالْمَاءِ."],["يَزِغْ","يَعْدِلْ، وَيَمِلْ."]],"13":[["مَحَارِيبَ","مَسَاجِدَ لِلْعِبَادَةِ."],["وَتَمَاثِيلَ","صُوَرَ مِنْ نُحَاسٍ وَزُجَاجٍ."],["وَجِفَانٍ كَالْجَوَابِ","قِصَاعٍ كَبِيرَةٍ؛ كَالْأَحْوَاضِ الَّتِي يَجْتَمِعُ فِيهَا الْمَاءُ."],["وَقُدُورٍ رَاسِيَاتٍ","قُدُورٍ ثَابِتَاتٍ لَا تَتَحَرَّكُ مِنْ أَمَاكِنِهَا لِعِظَمِهَا."]],"14":[["دَابَّةُ الْأَرْضِ","الْأَرْضَةُ الَّتِي تَأْكُلُ الْخَشَبَ."],["مِنْسَأَتُهُ","عَصَاهُ الَّتِي كَانَ مُتَّكِئاً عَلَيْهَا."],["خَرَّ","وَقَعَ عَلَى الْأَرْضِ مَيِّتاً."]],"15":[["لَسَبَأٌ","قَبِيلَةٌ بِالْيَمَنِ سُمُّوا بِاسْمِ جَدِّهِمْ."],["آيَةٌ","دَلَالَةً عَلَى قُدْرَتِنَا."],["جَنَّتَانِ","بُسْتَانَانِ."],["بَلْدَةٌ طَيِّبَةٌ","كَرِيمَةُ التُّرْبَةِ، طَيِّبَةُ الْهَوَاءِ."]],"16":[["سَيْلَ الْعَرِمِ","السِّيْلَ الْجَارِفَ الشَّدِيدَ الَّذِي خَرَّبَ السَّدَّ، وَأَغْرَقَ الْبَسَاتِينَ."],["ذَوَاتَيْ","صَاحِبَتَيْ."],["أُكُلٍ خَمْطٍ","ثَمَرٍ مُرٍّ، كَرِيهِ الطَّعْمِ."],["وَأَثْلٍ","شَجَرٍ مَعْرُوفٍ شَبِيهٍ بِالطَّرْفَاءِ، لَا ثَمَرَ لَهُ."],["سِدْرٍ","شَجَرِ النَّبْقِ، كَثِيرِ الشَّوْكِ."]],"18":[["الْقُرَى الَّتِي بَارَكْنَا","قُرَى الشَّامِ."],["قُرًى ظَاهِرَةً","مُدُناً مُتَّصِلَةً يُرَى بَعْضُهَا مِنْ بَعْضٍ."],["وَقَدَّرْنَا فِيهَا السَّيْرَ","جَعَلْنَا السَّيْرَ بَيْنَهَا عَلَى مَرَاحِلَ مُتَقَارِبَةٍ."]],"19":[["فَجَعَلْنَاهُمْ أَحَادِيثَ","جَعَلْنَاهُمْ عِبَراً وَأَحَادِيثَ لِمَنْ يَأْتِي بَعْدَهُمْ."],["وَمَزَّقْنَاهُمْ","فَرَّقْنَاهُمْ فِي الْبِلَادِ."]],"20":[["صَدَّقَ عَلَيْهِمْ","حَقَّقَ عَلَيْهِمْ."]],"21":[["سُلْطَانٍ","قَهْرٍ عَلَى الْكُفْرِ."]],"22":[["مِثْقَالَ ذَرَّةٍ","وَزْنَ نَمْلَةٍ صَغِيرَةٍ."],["شِرْكٌ","شَرَاكَةٍ فِي الْخَلْقِ."]],"23":[["فُزِّعَ","زَالَ الْفَزَعُ عَنْ قُلُوبِهِمْ."]],"26":[["يَفْتَحُ","يَقْضِي."],["بِالْحَقِّ","بِالْعَدْلِ."],["الْفَتَّاحُ","الْحَاكِمُ بَيْنَ خَلْقِهِ."]],"31":[["وَلَا بِالَّذِي بَيْنَ يَدَيْهِ","وَلَا بِالَّذِي تَقَدَّمَهُ مِنَ التَّوْرَاةِ وَالْإِنْجِيلِ وَالزَّبُورِ."],["مَوْقُوفُونَ","مَحْبُوسُونَ فِي مَوْقِفِ الْحِسَابِ."],["يَرْجِعُ","يَرُدُّ بَعْضُهُمْ عَلَى بَعْضٍ."]],"33":[["بَلْ مَكْرُ اللَّيْلِ وَالنَّهَارِ","بَلْ تَدْبِيرُ الشَّرِّ لَنَا بِاللَّيْلِ وَالنَّهَارِ هُوَ الَّذِي أَهْلَكَنَا."],["النَّدَامَةَ","التَّحَسُّرَ."]],"36":[["يَبْسُطُ","يُوسِعُ."],["وَيَقْدِرُ","يُضَيِّقُ."]],"37":[["زُلْفَى","قُرْبَى."],["جَزَاءُ الضِّعْفِ","الثَّوَابُ الْمُضَاعَفُ."],["الْغُرُفَاتُ","الْمَنَازِلُ الرَّفِيعَةُ فِي الْجَنَّةِ."]],"38":[["يَسْعَوْنَ فِي آيَاتِنَا","يَجْهَدُونَ فِي إِبْطَالِ حُجَجِنَا."],["مُعَاجِزِينَ","مُشَاقِّينَ يَظُنُّونَ أَنَّهُمْ يَفُوتُونَنَا."],["مُحْضَرُونَ","تُحْضِرُهُمُ الزَّبَانِيَةُ إِلَى جَهَنَّمَ."]],"39":[["وَيَقْدِرُ لَهُ","يُضَيِّقُهُ عَلَيْهِ."]],"41":[["سُبْحَانَكَ","نُنَزِّهُكَ."],["أَنْتَ وَلِيُّنَا","أَنْتَ الَّذِي نُوَالِيهِ وَنَعْبُدُهُ."]],"43":[["إِفْكٍ مُفْتَرًى","كِذْبٍ مُخْتَلَقٍ."]],"44":[["يَدْرُسُونَهَا","يَقْرَؤُونَهَا."]],"45":[["مَعْشَرَ مَا آتَيْنَاهُمْ","عُشْرَ مَا أَعْطَيْنَاكُمْ مِنَ الْقُوَّةِ وَالنِّعَمِ."],["نَكِيرِ","إِنْكَارِي عَلَيْهِمْ."]],"46":[["بِوَاحِدَةٍ","بِخَصْلَةٍ وَاحِدَةٍ."],["مَثْنَى","اثْنَيْنِ اثْنَيْنِ."],["جِنَّةٍ","جُنُونٍ."]],"48":[["يَقْذِفُ بِالْحَقِّ","يَرْمِي بِحُجَجِ الْحَقِّ عَلَى الْبَاطِلِ؛ فَيَدْمَغُهُ."]],"51":[["فَلَا فَوْتَ","فَلَا نَجَاةَ لَهُمْ، وَلَا مَهْرَبَ."]],"52":[["وَأَنَّى لَهُمُ التَّنَاوُشُ","كَيْفَ لَهُمْ تَنَاوُلُ الْإِيمَانِ، وَهُمْ فِي الْآخِرَةِ؟"]],"53":[["وَيَقْذِفُونَ بِالْغَيْبِ","يَرْمُونَ بِالظُّنُونِ الْكَاذِبَةِ."]],"54":[["بِأَشْيَاعِهِمْ","أَمْثَالِهِمْ مِنْ كُفَّارِ الْأُمَمِ السَّابِقَةِ."],["مُرِيبٍ","مُحْدِثٍ لِلرَّيْبَةِ وَالْقَلَقِ."]]}