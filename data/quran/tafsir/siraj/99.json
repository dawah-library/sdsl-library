{"1":[["زُلْزِلَتْ","رُجَّتْ وَحُرِّكَتْ بِقُوَّةٍ."]],"2":[["أَثْقَالَهَا","مَا فِي بَطْنِهَا مِنَ المَوْتَى وَالكُنُوزِ."]],"3":[["مَا لَهَا","مَا الَّذِي حَدَثَ لَهَا؟"]],"4":[["تُحَدِّثُ أَخْبَارَهَا","تُخْبِرُ الأَرْضُ بِمَا عُمِلَ عَلَيْهَا."]],"5":[["بِأَنَّ رَبَّكَ أَوْحَى لَهَا","بِسَبَبِ أَنَّ رَبَّكَ أَمَرَهَا بِأَنْ تُخْبِرَ."]],"6":[["يَصْدُرُ النَّاسُ","يَرْجِعُونَ عَنْ مَوْقِفِ الحِسَابِ."],["أَشْتَاتًا","أَصْنَافًا مُتَفَرِّقِينَ."]],"8":[["مِثْقَالَ ذَرَّةٍ","وَزْنَ نَمْلَةٍ صَغِيرَةٍ."]]}