{"4":[["يَعْمَهُونَ","يَتَرَدَّدُونَ فِي أَعْمَالِهِمُ الْقَبِيحَةِ مُتَحَيِّرِينَ."]],"6":[["لَتُلَقَّى","لَتُلَقَّى."],["مِن لَدُنْ","مِنْ عِنْدِ."]],"7":[["بِشِهَابٍ قَبَسٍ","بِشُعْلَةِ نَارٍ."],["تَصْطَلُونَ","تَسْتَدْفِئُونَ بِهَا مِنَ الْبَرْدِ."]],"8":[["بُورِكَ","قُدِّسَ وَطُهِّرَ."],["وَسُبْحَانَ اللَّهِ","تَنْزِيهًا لِلَّهِ عَمَّا لَا يَلِيقُ بِهِ."]],"10":[["تَهْتَزُّ","تَتَحَرَّكُ فِي خِفَّةٍ."],["جَانٌّ","حَيَّةٌ خَفِيفَةٌ."],["مُدْبِرًا","هَارِبًا."],["وَلَمْ يُعَقِّبْ","يَرْجِعْ عَلَى عَقِبِهِ."]],"11":[["إِلَّا مَنْ ظَلَمَ","لَكِنْ مَنْ ظَلَمَ نَفْسَهُ."]],"12":[["جَيْبِكَ","فَتْحَةِ الْقَمِيصِ الَّتِي يَدْخُلُ مِنْهَا الرَّأْسُ."],["مِنْ غَيْرِ سُوءٍ","مِنْ غَيْرِ بَرَصٍ وَلَا مَرَضٍ."]],"13":[["مُبْصِرَةً","طَاهِرَةً بَيِّنَةً."],["مُّبِينٌ","وَاضِحٌ بَيِّنٌ."]],"14":[["وَعُلُوًّا","تَكَبُّرًا."]],"16":[["وَوَرِثَ سُلَيْمَانُ دَاوُودَ","خَلَفَ سُلَيْمَانُ أَبَاهُ فِي النُّبُوَّةِ، وَالْعِلْمِ، وَالْمُلْكِ."]],"17":[["وَحُشِرَ","جُمِعَ."],["يُوزَعُونَ","يُرَدُّ أَوَّلُ كُلِّ جِنْسٍ عَلَى آخِرِهِمْ لِيَقِفُوا جَمِيعًا مُنْتَظِمِينَ."]],"18":[["لَا يَحْطِمَنَّكُمْ","لَا يُهْلِكَنَّكُمْ."]],"19":[["أَوْزِعْنِي","أَلْهِمْنِي."]],"21":[["بِسُلْطَانٍ مُّبِينٍ","حُجَّةٍ ظَاهِرَةٍ."]],"22":[["فَمَكَثَ غَيْرَ بَعِيدٍ","بَقِيَ زَمَنًا غَيْرَ طَوِيلٍ."],["سَبَإٍ","مَدِينَةٍ بِالْيَمَنِ."],["بَنَإٍ","خَبَرٍ خَطِيرٍ."]],"23":[["عَرْشٍ","سَرِيرٍ."]],"25":[["أَلَّا يَسْجُدُوا","زَيَّنَ لَهُمُ الشَّيْطَانُ ذَلِكَ لِئَلَّا يَسْجُدُوا."],["الْخَبْءَ","الْمَخْبُوءَ الْمَسْتُورَ عَنِ الْأَعْيُنِ."]],"28":[["تَوَلَّ عَنْهُمْ","تَنَحَّ عَنْهُمْ قَرِيبًا مِنْهُمْ."],["فَانْظُرْ","تَأَمَّلْ، وَاسْمَعْ."],["مَاذَا يَرْجِعُونَ","مَا يَتَرَدَّدُ بَيْنَهُمْ مِنَ الْكَلَامِ."]],"29":[["الْمَلَؤُاْ","أَشْرَافُ النَّاسِ."],["كَرِيمٌ","جَلِيلُ الْقَدْرِ."]],"31":[["تَعْلُوا عَلَيَّ","تَتَكَبَّرُوا عَلَيَّ."]],"32":[["أَفْتُونِي","أَشِيرُوا عَلَيَّ."]],"34":[["أُوْلُواْ","أَصْحَابُ."]],"35":[["فَنَاظِرَةٌ","مُنْتَظَرَةٌ."]],"37":[["لَا قِبَلَ لَهُم بِهَا","لَا طَاقَةَ لَهُمْ بِمُقَاوَمَةِ الْجُنُودِ."],["صَاغِرُونَ","مُهَانُونَ."]],"38":[["الْمَلَؤُاْ","مَنْ سَخَّرَهُمُ اللَّهُ لَهُ مِنَ الْجِنِّ وَالْإِنْسِ."]],"39":[["عِفْرِيتٌ","مَارِدٌ قَوِيٌّ شَدِيدٌ."],["مَقَامِكَ","مَجْلِسِكَ."]],"40":[["يَرْتَدُّ إِلَيْكَ طَرْفُكَ","قَبْلَ ارْتِدَادِ أَجْفَانِكَ إِذَا نَظَرْتَ إِلَى شَيْءٍ."],["مُسْتَقِرّاً عِندَهُ","حَاضِرًا لَدَيْهِ ثَابِتًا عِنْدَهُ."]],"41":[["نَكِّرُواْ","غَيِّرُوا."]],"44":[["الصَّرْحَ","الْقَصْرَ، وَكَانَ صَحْنُهُ مِنْ زُجَاجٍ تَحْتَهُ مَاءٌ."],["حَسِبَتْهُ لُجَّةً","ظَنَّتْهُ مَاءً غَزِيرًا."],["مُمَرَّدٌ","مُمَلَّسٌ مُسَوًّى."],["مِن قَوَارِيرَ","مِنْ زُجَاجٍ صَافٍ."]],"47":[["اطَّيَرْنَا","تَشَاءَمْنَا."],["طَائِرُكُمْ عِندَ اللَّهِ","مَا أَصَابَكُمْ مِنْ خَيْرٍ، أَوْ شَرٍّ، فَاللَّهُ مُقَدِّرُهُ عَلَيْكُمْ."],["تُفْتَنُونَ","تُخْتَبَرُونَ بِالسَّرَّاءِ، وَالضَّرَّاءِ."]],"48":[["الْمَدِينَةِ","مَدِينَةُ صَالِحٍ ﷺ، وَهِيَ الحِجْرُ شَمَالَ غَرْبِ الجَزِيرَةِ العَرَبِيَّةِ."]],"49":[["تَقَاسَمُواْ","حَلَفَ كُلُّ وَاحِدٍ مِنْهُمْ لِلْآخَرِ."],["لَنُبَيِّتَنَّهُ","لَنُبَيِّتَنَّهُ بِاللَّيْلِ بَعْتَةً فَنَقْتُلُهُ."],["لَوْلِيِّهِ","قَرِيبِهِ الَّذِي يُطَالَبُ بِدَمِهِ."]],"52":[["خَاوِيَةً","خَالِيَةً."]],"54":[["الْفَاحِشَةَ","الْفِعْلَةَ المُتَنَاهِيَةَ فِي القُبْحِ."],["تُبْصِرُونَ","تَعْلَمُونَ قُبْحَهَا."]],"56":[["يَتَطَهَّرُونَ","يَتَنَزَّهُونَ عَنْ إِتْيَانِ الدُّبُرَانِ."]],"57":[["قَدَّرْنَاهَا","جَعَلْنَا امْرَأَةَ لُوطٍ."],["الْغَابِرِينَ","البَاقِينَ فِي العَذَابِ."]],"58":[["مَطَرًا","حِجَارَةً مِنَ السَّمَاءِ."],["فَسَاءَ","قَبُحَ."]],"60":[["ذَاتِ بَهْجَةٍ","ذَاتِ مَنْظَرٍ حَسَنٍ."],["يَعْدِلُونَ","يَجْعَلُونَ اللَّهَ عِدْلًا وَنَظِيرًا."]],"61":[["خِلَالَهَا","وَسَطَهَا."],["رَوَاسِيَ","جِبَالًا ثَوَابِتَ."],["الْبَحْرَيْنِ","العَذْبَ، وَالْمَالِحَ."]],"62":[["وَيَكْشِفُ السُّوءَ","يُزِيلُ المَكْرُوهَ."],["خُلَفَاءَ الْأَرْضِ","تَخْلُفُونَ مَنْ سَبَقَكُمْ فِي الْأَرْضِ."]],"63":[["يَهْدِيكُمْ","يُرْشِدُكُمْ."],["بُشْرًا","مُبَشِّرَاتِ بِالمَطَرِ."]],"65":[["وَمَا يَشْعُرُونَ","مَا يَعْلَمُونَ."],["وَمَا يَشْعُرُونَ أَيَّانَ","مَتَى؟"]],"66":[["ادَّارَكَ","تَكَامَلَ أَوْ انْتَهَى عِلْمُهُمْ وَعَجِزَ عَنْ مَعْرِفَةِ وَقْتِهَا."],["عَمُونَ","عَمِيَتْ بَصَائِرُهُمْ عَنْهَا."]],"68":[["أَسَاطِيرُ الْأَوَّلِينَ","مَا سَطَّرَ الْقُدَمَاءُ مِنَ الْأَكَاذِيبِ."]],"72":[["رَدِفَ لَكُم","اقْتَرَبَ لَكُمْ."]],"74":[["تُكِنُّ","تُخْفِي."]],"75":[["غَائِبَةٍ","شَيْءٍ غَائِبٍ عَنِ الْأَبْصَارِ."],["كِتَابٍ مُّبِينٍ","هُوَ: اللَّوْحُ المَحْفُوظُ."]],"80":[["وَلَّوْا مُدْبِرِينَ","أَعْرَضُوا عَنْكَ."]],"82":[["وَقَعَ الْقَوْلُ","وَجَبَ العَذَابُ."],["دَابَّةً","الدَّابَّةُ: عَلَامَةٌ مِنْ عَلَامَاتِ السَّاعَةِ الْكُبْرَى تَخْرُجُ، وَتُحَدِّثُ النَّاسَ، وَتَسِمُهُمْ عَلَى وُجُوهِهِمْ."],["تُكَلِّمُهُمْ","تُحَدِّثُهُمْ فَتَقُولُ: إِنَّ النَّاسَ..."]],"83":[["نَحْشُرُ","نَجْمَعُ."],["فَوْجًا","جَمَاعَةً."],["يُوزَعُونَ","يُدْفَعُونَ أَوْ يُحْبَسُ أَوَّلُ المُكَذِّبِينَ مِنْ كُلِّ أُمَّةٍ عَلَى آخِرِهِمْ؛ لِيَجْتَمِعُوا، ثُمَّ يُسَاقُونَ إِلَى الحِسَابِ."]],"85":[["وَوَقَعَ الْقَوْلُ عَلَيْهِمْ","حَقَّتْ عَلَيْهِمْ كَلِمَةُ العَذَابِ."],["لَا يَنطِقُونَ","لَا يَتَكَلَّمُونَ بِحُجَّةٍ تَدْفَعُ العَذَابَ عَنْهُمْ."]],"86":[["مُبْصِرًا","يُبْصِرُونَ فِيهِ."]],"87":[["الصُّورِ","القَرْنِ الَّذِي يَنْفُخُ فِيهِ إِسْرَافِيلُ ﷺ."],["دَاخِرِينَ","صَاغِرِينَ أَذِلَّاءَ."]],"88":[["وَتَرَى الْجِبَالَ","تُبْصِرُ الجِبَالَ يَوْمَ القِيَامَةِ."],["جَامِدَةً","وَاقِفَةً مُسْتَقِرَّةً."],["تَمُرُّ","تَسِيرُ."]],"89":[["بِالْحَسَنَةِ","بِالتَّوْحِيدِ، وَالإِيمَانِ، وَالعِبَادَةِ."]],"90":[["بِالسَّيِّئَةِ","بِالشِّرْكِ وَالكُفْرِ."]],"91":[["الْبَلْدَةَ","مَكَّةَ."],["حَرَّمَهَا","جَعَلَهَا حَرَامًا؛ فَلَا يُسْفَكُ فِيهَا دَمٌ، أَوْ يُصَادُ صَيْدٌ، أَوْ يُقْطَعُ شَجَرٌ."]]}