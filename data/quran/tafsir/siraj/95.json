{"2":[["وَطُورِ سِينِينَ","جَبَلِ طُورِ سَيْنَاءَ الَّذِي كَلَّمَ اللَّهُ عَلَيْهِ مُوسَى ﷺ."]],"3":[["وَهَذَا الْبَلَدِ","مَكَّةَ."]],"4":[["تَقْوِيمٍ","صُورَةٍ."]],"5":[["أَسْفَلَ سَافِلِينَ","النَّارَ؛ إِنْ لَمْ يُطِعِ اللَّهَ."]],"6":[["غَيْرُ مَمْنُونٍ","غَيْرُ مَقْطُوعٍ، وَلَا مَنْقُوصٍ."]],"7":[["بِالدِّينِ","بِالبَعْثِ، وَالجَزَاءِ."]]}