{"1":[["وَالضُّحَى","قَسَمٌ بِأَوَّلِ النَّهَارِ، أَوْ كُلِّهِ."]],"2":[["سَجَى","غَطَّى الكَوْنَ بِظَلَامِهِ، وَسَكَنَ."]],"3":[["مَا وَدَّعَكَ","مَا تَرَكَكَ."]],"6":[["فَآوَى","فَآوَاكَ، وَرَعَاكَ."]],"7":[["ضَالًّا","لَا تَدْرِي الوَحْيَ، وَلَا تَعْلَمُ القُرْآنَ."]],"8":[["عَائِلاً","فَقِيرًا."]],"9":[["فَلَا تَقْهَرْ","لَا تُسِيئُ مُعَامَلَتَهُ، وَتَأْخُذْ مَالَهُ."]],"10":[["السَّائِلَ","الفَقِيرَ الَّذِي يَسْأَلُ، وَطَالِبَ العِلْمِ."],["فَلَا تَنْهَرْ","لَا تَزْجُرْ."]]}