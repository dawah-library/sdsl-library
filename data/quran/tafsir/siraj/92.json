{"1":[["يَغْشَى","يُغَطِّي بِظَلَامِهِ الْأَرْضَ."]],"2":[["تَجَلَّى","انْكَشَفَ بِضِيَائِهِ."]],"5":[["أَعْطَى","بَذَلَ مَالَهُ مُتَصَدِّقًا."]],"6":[["بِالْحُسْنَى","بِالثَّوَابِ عَلَى أَعْمَالِهِ."]],"7":[["لِلْيُسْرَى","لِكُلِّ خَيْرٍ، وَسَعَادَةٍ."]],"11":[["وَمَا يُغْنِي","لَا يَنْفَعُهُ."],["تَرَدَّى","وَقَعَ فِي النَّارِ."]],"12":[["إِنَّ عَلَيْنَا لَلْهُدَى","عَلَيْنَا أَنْ نُبَيِّنَ طَرِيقَ الهُدَى؛ فَضْلًا مِنَّا وَرَحْمَةً."]],"14":[["تَلَظَّى","تَتَوَهَّجُ."]],"15":[["لَا يَصْلَهَا","لَا يَدْخُلُهَا، وَيُقَاسِي حَرَّهَا."]],"17":[["وَسَيُجَنَّبُهَا","سَيُبْعَدُ عَنْهَا."]],"19":[["تُجْزَى","تُكَافَأُ؛ فَلَيْسَ إِنْفَاقُهُ مُكَافَأَةً لِمَنْ أَحْسَنَ إِلَيْهِ."]]}