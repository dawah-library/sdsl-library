{"1":[["تَبَارَكَ","كَثُرَ خَيْرُهُ، وَعَظُمَتْ بَرَكَتُهُ، وَكَمُلَتْ صِفَاتُهُ."],["الْفُرْقَانَ","الْقُرْآنَ الْفَارِقَ بَيْنَ الْحَقِّ، وَالْبَاطِلِ."]],"2":[["فَقَدَّرَهُ","سَوَّاهُ عَلَى مَا يُنَاسِبُ مِنَ الْخَلْقِ."]],"4":[["إِفْكٍ افْتَرَاهُ","كَذِبٌ اخْتَرَعَهُ مِنْ عِنْدِ نَفْسِهِ."],["زُورًا","كَذِبًا شَنِيعًا."]],"5":[["أَسَاطِيرُ الْأَوَّلِينَ","أَحَادِيثُ الْأُمَمِ الْقَدِيمَةِ الْمُسَطَّرَةُ فِي كُتُبِهِمْ."],["بُكْرَةً وَأَصِيلًا","أَوَّلَ النَّهَارِ، وَآخِرَهُ."]],"8":[["جَنَّةٌ","بُسْتَانٌ مُثْمِرٌ."]],"9":[["ضَرَبُوا لَكَ الْأَمْثَالَ","قَالُوا فِي حَقِّكَ الْأَقْوَالَ الْعَجِيبَةَ الَّتِي تُشْبِهُ لِغَرَابَتِهَا الْأَمْثَالَ."]],"11":[["سَعِيرًا","نَارًا حَارَّةً تُسَعَّرُ بِهِمْ."]],"12":[["زَفِيرًا","صَوْتًا شَدِيدًا مِنْ شِدَّةِ الْغَيْظِ."]],"13":[["مُقَرَّنِينَ","قُرِنتْ أَيْدِيهِمْ بِالسَّلَاسِلِ إِلَى أَعْنَاقِهِمْ."],["ثُبُورًا","هَلَاكًا."]],"14":[["بُورًا","هَالِكِينَ."]],"19":[["صَرْفًا","دَفْعًا لِلْعَذَابِ."]],"20":[["فِتْنَةً","ابْتِلَاءً، وَاخْتِبَارًا."]],"21":[["لَا يَرْجُونَ لِقَاءَنَا","لَا يُؤْمِنُونَ بِالْيَوْمِ الْآخِرِ."],["عُتُوًّا","تَجَاوَزُوا الْحَدَّ فِي الطُّغْيَانِ."]],"22":[["حِجْرًا مَحْجُورًا","تَقُولُ الْمَلَائِكَةُ لَهُمْ: الْجَنَّةُ مَكَانٌ مُحَرَّمٌ عَلَيْكُمْ."]],"23":[["هَبَاءً","كَالْهَبَاءِ، وَهُوَ مَا يُرَى فِي ضَوْءِ الشَّمْسِ مِنْ خَفِيفِ الْغُبَارِ."]],"24":[["مَقِيلًا","مَنْزِلًا مُرِيحًا."]],"25":[["بِالْغَمَامِ","بِالسَّحَابِ الْأَبْيَضِ الرَّقِيقِ."]],"27":[["سَبِيلًا","طَرِيقًا إِلَى الْجَنَّةِ."]],"32":[["وَرَتَّلْنَاهُ","بَيَّنَاهُ فِي تَثَبُّتٍ وَمُهْلَةٍ."]],"38":[["وَأَصْحَابَ الرَّسِّ","أَصْحَابَ بِئْرٍ."],["وَقُرُونًا","أُمَمًا."]],"39":[["الْأَمْثَالَ","الْحُجَجَ."],["تَبَّرْنَا","أَهْلَكْنَا وَدَمَّرْنَا."]],"40":[["مَطَرَ السَّوْءِ","حِجَارَةً مِنَ السَّمَاءِ أَهْلَكَتْهُمْ."]],"42":[["كَادَ لَيُضِلُّنَا","قَارَبَ أَنْ يَصْرِفَنَا عَنْ عِبَادَةِ أَصْنَامِنَا."]],"43":[["أَرَأَيْتَ","أَخْبِرْنِي."]],"45":[["مَدَّ الظِّلَّ","بَسَطَهُ مِنْ طُلُوعِ الْفَجْرِ إِلَى طُلُوعِ الشَّمْسِ."],["سَاكِنًا","ثَابِتًا مُسْتَقِرًّا."]],"47":[["لِبَاسًا","سَاتِرًا لَكُمْ بِظَلَامِهِ."],["سُبَاتًا","رَاحَةً لِأَبْدَانِكُمْ."],["نُشُورًا","وَقْتًا لِلِانْتِشَارِ وَالسَّعْيِ فِي الْأَرْضِ."]],"48":[["بُشْرًا","مُبَشِّرَاتٍ بِالرَّحْمَةِ، وَهِيَ الْمَطَرُ."]],"50":[["صَرَفْنَهُ","أَنْزَلْنَا الْمَطَرَ عَلَى أَرْضٍ دُونَ أُخْرَى."]],"52":[["وَجَاهِدْهُمْ بِهِ","بَلِّغْهُمُ الْقُرْآنَ بَاذِلًا وُسْعَكَ."],["جِهَادًا كَبِيرًا","لَا يُخَالِطُهُ فُتُورٌ."]],"53":[["مَرَجَ","خَلَطَ."],["فُرَاتٌ","شَدِيدُ العُذُوبَةِ."],["أُجَاجٌ","شَدِيدُ المُلُوحَةِ."],["بَرْزَخًا","حَاجِزًا يَمْنَعُ إِفْسَادَ أَحَدِهِمَا لِلْآخَرِ."],["وَحِجْرًا مَّحْجُورًا","سِتْرًا يَمْنَعُ وُصُولَ أَحَدِهِمَا إِلَى الآخَرِ."]],"54":[["الْمَاءِ","مَنِيُّ الرَّجُلِ وَالمَرْأَةِ."],["نَسَبًا","قَرَابَةُ النَّسَبِ."],["صِهْرًا","قَرَابَةُ المُصَاهَرَةِ."]],"55":[["ظَهِيرًا","مُعِينًا لِلشَّيْطَانِ عَلَى رَبِّهِ؛ بِالشِّرْكِ، مُظَاهِرًا لَهُ فِي المَعْصِيَةِ."]],"59":[["اسْتَوَى","عَلَا وَارْتَفَعَ اسْتِوَاءً يَلِيقُ بِجَلَالِهِ."]],"60":[["نُفُورًا","بُعْدًا."]],"61":[["بُرُوجًا","نُجُومًا كِبَارًا بِمَنَازِلِهَا."],["سِرَاجًا","شَمْسًا مُضِيئَةً."]],"62":[["خِلْفَةً","مُتَعَاقِبِينَ يَخْلُفُ أَحَدُهُمَا الآخَرَ."]],"63":[["هَوْنًا","بِسَكِينَةٍ، وَوَقَارٍ، وَتَوَاضُعٍ."],["قَالُوا سَلَامًا","خَاطَبُوا الجَاهِلَ بِكَلَامٍ يَسْلَمُونَ فِيهِ مِنَ الإِثْمِ، وَلَمْ يُقَابِلُوهُ بِجَهْلِهِ."]],"65":[["غَرَامًا","مُلَازِمًا؛ كَالغَرِيمِ (وَهُوَ الدَّائِنُ) يُلَازِمُ غَرِيمَهُ."]],"67":[["يُقْتِرُوا","يُضَيِّقُوا فِي النَّفَقَةِ."],["قَوَامًا","وَسَطًا."]],"68":[["أَثَامًا","عِقَابًا."]],"69":[["مُهَانًا","ذَلِيلًا حَقِيرًا."]],"71":[["مَتَابًا","رُجُوعًا صَحِيحًا."]],"72":[["لَا يَشْهَدُونَ الزُّورَ","لَا يَشْهَدُونَ بِالْكَذِبِ، وَلَا يَحْضُرُونَ مَجَالِسَ الكَذِبِ."],["مَرُّوا بِاللَّغْوِ","مَرُّوا بِأَهْلِ البَاطِلِ وَالكَلَامِ القَبِيحِ وَمَا لَا يَنْفَعُ."]],"73":[["لَمْ يَخِرُّوا","لَمْ يَقَعُوا سُجُودًا غَافِلِينَ، بَلْ سَجَدُوا مُطِيعِينَ."]],"74":[["قُرَّةَ أَعْيُنٍ","تَقَرُّ بِهِمْ عُيُونُنَا، وَبِهِمْ نَأْنَسُ وَنَفْرَحُ."],["إِمَامًا","قُدْوَةً يُقْتَدَى بِهِ فِي الخَيْرِ."]],"75":[["الْغُرْفَةَ","أَعْلَى مَنَازِلِ الجَنَّةِ."],["وَسَلَامًا","تَسْلِيمًا مِنَ المَلَائِكَةِ، وَسَلَامَةً مِنَ الآفَاتِ."]],"77":[["مَا يَعْبَؤُا","مَا يَكْتَرِثُ بِكُمْ وَلَا يُبَالِي."],["دُعَاؤُكُمْ","عِبَادَتُكُمْ وَسُؤَالُكُمْ إِيَّاهُ."],["لِزَامًا","عَذَابًا مُلَازِمًا لَكُمْ."]]}