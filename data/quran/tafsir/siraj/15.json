{"3":[["وَيُلْهِهِمُ الْأَمَلُ","يَشْغَلُهُمُ الطَّمَعُ فِي الدُّنْيَا، وَطُولُ البَقَاءِ فِيهَا."]],"7":[["لَوْ مَا","هَلَّا."]],"8":[["مُنْظَرِينَ","مُمَهَّلِينَ، وَمُؤَخَّرِينَ."]],"10":[["شِيَعِ الْأَوَّلِينَ","فِرَقِ الأُمَمِ السَّابِقِينَ."]],"12":[["نَسْلُكُهُ","نُدْخِلُ الكُفْرَ."]],"13":[["خَلَتْ","مَضَتْ."]],"14":[["فَظَلُّوا","فَاسْتَمَرُّوا."]],"16":[["بُرُوجًا","مَنَازِلَ لِلْكَوَاكِبِ تَنْزِلُ فِيهَا."]],"17":[["رَجِيمٍ","مَطْرُودٍ مِنْ رَحْمَةِ اللَّهِ."]],"18":[["اسْتَرَقَ السَّمْعَ","اخْتَلَسَ الوَحْيَ مِنَ السَّمَاءِ الدُّنْيَا."],["فَأَتْبَعَهُ","فَأَدْرَكَهُ."],["شِهَابٌ","كَوْكَبٌ مُضِيءٌ مُحْرِقٌ."]],"19":[["رَوَاسِيَ","رَاسِيَةً تُثَبِّتُهَا."]],"20":[["مَعَايِشَ","مَا تَعِيشُونَ بِهِ مِنْ مَعَادِنَ، وَحِجَارَةٍ، وَنَبَاتٍ."]],"22":[["لَوَاقِحَ","تُلْقِحُ السَّحَابَ؛ فَيَمْتَلِئُ بِالمَاءِ."]],"26":[["صَلْصَالٍ","طِينٍ يَابِسٍ يُسْمَعُ لَهُ صَوْتٌ إِذَا نُقِرَ."],["حَمَإٍ","طِينٍ أَسْوَدَ."],["مَسْنُونٍ","مُتَغَيِّرٍ لَوْنُهُ وَرِيحُهُ."]],"27":[["نَارِ السَّمُومِ","نَارٍ شَدِيدَةِ الحَرَارَةِ لَا دُخَانَ لَهَا."]],"36":[["فَأَنْظِرْنِي","فَأَمْهِلْنِي."]],"41":[["صِرَاطٌ","طَرِيقٌ."]],"42":[["سُلْطَٰنٌ","قُوَّةٌ."]],"46":[["بِسَلَٰمٍ","سَالِمِينَ مِنْ كُلِّ سُوءٍ."]],"47":[["غِلٍّ","حِقْدٍ."]],"48":[["نَصَبٌ","تَعَبٌ."]],"52":[["وَجِلُونَ","فَزِعُونَ، خَائِفُونَ."]],"55":[["الْقَانِطِينَ","الْيَايِسِينَ."]],"57":[["فَمَا خَطْبُكُمْ","فَمَا شَأْنُكُمْ الْخَطِيرُ؟"]],"60":[["قَدَّرْنَا","قَضَيْنَا."],["الْغَابِرِينَ","الْبَاقِينَ فِي الْعَذَابِ."]],"62":[["مُنكَرُونَ","غَيْرُ مَعْرُوفِينَ لِي."]],"63":[["يَمْتَرُونَ","يَشُكُّونَ."]],"65":[["بِقِطْعٍ","بِجُزْءٍ."],["وَاتَّبِعْ أَدْبَارَهُمْ","سِرْ وَرَاءَهُمْ."],["وَامْضُواْ","سِيرُوا."]],"66":[["وَقَضَيْنَا","أَوْحَيْنَا."],["دَابِرَ","آخِرَ."],["مَقْطُوعٌ","مُهْلَكٌ بِالْعَذَابِ."]],"72":[["لَعَمْرُكَ","قَسَمٌ مِنَ اللَّهِ بِحَيَاةِ نَبِيِّنَا مُحَمَّدٍ ﷺ."],["سَكْرَتِهِمْ","غَفْلَتِهِمْ."],["يَعْمَهُونَ","يَتَرَدَّدُونَ مُتَحَيِّرِينَ."]],"73":[["مُشْرِقِينَ","وَقْتَ شُرُوقِ الشَّمْسِ."]],"74":[["سِجِّيلٍ","طِينٍ مُتَصَلِّبٍ مَتِينٍ."]],"75":[["لِلْمُتَوَسِّمِينَ","لِلنَّاظِرِينَ، الْمُعْتَبِرِينَ."]],"76":[["مُّقِيمٍ","ثَابِتٍ يَرَاهُ الْمُسَافِرُونَ، الْمَارُّونَ بِهَا."]],"78":[["أَصْحَٰبُ الأَيْكَةِ","الْأَيْكَةُ: الشَّجَرَةُ الْمُلْتَفَّةُ، وَأَصْحَابُ الْأَيْكَةِ: قَوْمُ شُعَيْبٍ."]],"79":[["لَبِإِمَامٍ مُّبِينٍ","لَفِي طَرِيقٍ وَاضِحٍ يَمُرُّ بِهَا النَّاسُ."]],"80":[["أَصْحَٰبُ الْحِجْرِ","سُكَّانُ وَادِي الْحِجْرِ، وَهُمْ ثَمُودُ، وَنَبِيُّهُمْ صَالِحٌ."]],"83":[["الصَّيْحَةُ","صَاعِقَةُ الْعَذَابِ."]],"85":[["فَاصْفَحْ","تَجَاوَزْ، وَاعْفُ."]],"87":[["سَبْعًا مِّنَ الْمَثَانِي","سَبْعُ آيَاتٍ تُكَرَّرُ فِي كُلِّ صَلَاةٍ، وَهِيَ الْفَاتِحَةُ."]],"88":[["لَا تَمُدَّنَّ عَيْنَيْكَ","لَا تَنْظُرْ بِعَيْنَيْكَ، وَلَا تَتَمَنَّ."],["أَزْوَاجًا","أَصْنَافًا."],["وَاخْفِضْ جَنَاحَكَ","تَوَاضَعَ."]],"90":[["الْمُقْتَسِمِينَ","الَّذِي قَسَمُوا الْقُرْآنَ فَآمَنُوا بِبَعْضٍ، وَكَفَرُوا بِبَعْضٍ."]],"91":[["عِضِينَ","أَجْزَاءً، فَقَالَ بَعْضُهُمْ: سِحْرٌ، وَقَالَ بَعْضُهُمْ: كِهَانَةٌ، وَغَيْرُ ذَلِكَ."]],"94":[["فَاصْدَعْ","فَاجْهَرْ."]],"98":[["السَّاجِدِينَ","الْعَابِدِينَ، الْمُصَلِّينَ."]],"99":[["الْيَقِينُ","الْمَوْتُ."]]}