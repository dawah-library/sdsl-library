{"3":[["ذِي الطَّوْلِ","صَاحِبِ الإِنْعَامِ وَالتَّفَضُّلِ."]],"4":[["فَلَا يَغْرُرْكَ","فَلَا يَخْدَعْكَ."],["تَقَلُّبُهُمْ","تَنَقُّلُهُمْ وَتَرَدُّدُهُمْ بِأَنْوَاعِ التِّجَارَاتِ وَالنَّعِيمِ."]],"5":[["وَالْأَحْزَابُ","الأُمَمُ المُتَحَزِّبَةُ عَلَى رُسُلِهِمْ، مُعْلِنِينَ الحَرْبَ عَلَيْهِمْ."],["لِيَأْخُذُوهُ","لِيَقْتُلُوهُ."],["وَلِيُدْحِضُوا","لِيُبْطِلُوا."]],"6":[["حَقَّتْ","وَجَبَتْ."]],"7":[["سَبِيلِكَ","طَرِيقِكَ؛ وَهُوَ الإِسْلَامُ."],["وَقِهِمْ","جَنِّبْهُمْ."]],"9":[["وَقِهِمُ السَّيِّئَاتِ","اصْرِفْ عَنْهُمْ سُوءَ عَاقِبَةِ سَيِّئَاتِهِمْ."]],"10":[["يُنَادُونَ","يَدْعُوهُمْ خَزَنَةُ جَهَنَّمَ."],["لَمَقْتُ اللَّهِ","المَقْتُ: البُغْضُ الشَّدِيدُ."]],"11":[["أَمَتَّنَا اثْنَتَيْنِ","مَرَّةً قَبْلَ نَفْخِ الأَرْوَاحِ فِي الأَجِنَّةِ، وَمَرَّةً حِينَ انْقَضَى أَجَلُنَا."],["وَأَحْيَيْتَنَا اثْنَتَيْنِ","مَرَّةً فِي الدُّنْيَا، وَمَرَّةً فِي الآخِرَةِ."]],"13":[["رِزْقاً","مَطَرًا تُرْزَقُونَ بِهِ."]],"15":[["رَفِيعُ الدَّرَجَاتِ","اِرْتَفَعَتْ دَرَجَاتُهُ اِرْتِفَاعًا بَائِنًا بِهِ مَخْلُوقَاتِهِ، وَارْتَفَعَ بِهِ قَدْرُهُ."],["يُلْقِي الرُّوحَ","يُنْزِلُ الوَحْيَ."],["يَوْمَ التَّلَاقِ","اليَوْمُ الَّذِي يَلْتَقِي فِيهِ الأَوَّلُونَ وَالآخِرُونَ."]],"16":[["بَارِزُونَ","ظَاهِرُونَ أَمَامَ رَبِّهِمْ."]],"18":[["يَوْمَ الْآزِفَةِ","يَوْمَ القِيَامَةِ القَرِيبِ."],["لَدَى الْحَنَاجِرِ","قُلُوبُهُمْ عِنْدَ حُلُوقِهِمْ مِنْ شِدَّةِ الكَرْبِ."],["كَاظِمِينَ","مُمْتَلِئِينَ غَمًّا، وَحُزْنًا."],["حَمِيمٍ","قَرِيبٍ، وَصَاحِبٍ."]],"19":[["خَائِنَةَ الْأَعْيُنِ","مَا تَخْتَلِسُهُ العُيُونُ مِنَ النَّظَرِ إِلَى مَا لَا يَحِلُّ."]],"20":[["يَقْضِي بِالْحَقِّ","يَحْكُمُ بِالعَدْلِ."]],"21":[["وَاقٍ","دَافِعٍ."]],"23":[["وَسُلْطَانٍ مُبِينٍ","حُجَّةٍ بَيِّنَةٍ عَلَى صِدْقِهِ."]],"27":[["عُذْتُ","اسْتَجَرْتُ."]],"28":[["مُسْرِفٍ","مُتَجَاوِزٌ لِلْحَدِّ بِتَرْكِ الحَقِّ، وَاتِّبَاعِ البَاطِلِ."]],"29":[["ظَهِيرِينَ","غَالِبِينَ عَالِينَ."],["بَأْسِ اللَّهِ","عَذَابِ اللَّهِ."],["مَا أُرِيكُمْ","مَا أُشِيرُ عَلَيْكُمْ."],["أَهْدِيكُمْ","أَدْعُوكُمْ."],["سَبِيلَ الرَّشَادِ","طَرِيقَ الحَقِّ وَالصَّوَابِ."]],"30":[["الْأَحْزَابِ","الأُمَمِ المُتَحَزِّبَةِ عَلَى أَنْبِيَائِهَا، المُعَادِيَةِ لَهُمْ."]],"31":[["دَأْبِ قَوْمِ نُوحٍ","عَادَتِهِمْ فِي الكُفْرِ وَالتَّكْذِيبِ."]],"32":[["يَوْمَ التَّنَادِ","يَوْمَ القِيَامَةِ الَّذِي يُنَادِي النَّاسُ فِيهِ بَعْضُهُمْ بَعْضًا."]],"33":[["مُدْبِرِينَ","هَارِبِينَ."],["عَاصِمٍ","مَانِعٍ يَمْنَعُكُمْ."]],"34":[["شَكٍّ","رِيبَةٍ."],["هَلَكَ","مَاتَ."],["مُسْرِفٌ","مُتَجَاوِزٌ لِلْحَدِّ فِي الضَّلَالِ."],["مُرْتَابٍ","شَاكٌّ فِي اللَّهِ."]],"35":[["سُلْطَانٍ","حُجَّةٍ."],["يَطْبَعُ","يَخْتِمُ."]],"36":[["صَرْحًا","بِنَاءً عَظِيمًا."]],"37":[["السَّبِيلَ","طَرِيقَ الحَقِّ."],["كَيْدُ فِرْعَوْنَ","تَدْبِيرُهُ، وَاحْتِيَالُهُ."],["تَبَابٍ","خَسَارٍ، وَبَوَارٍ."]],"40":[["بِغَيْرِ حِسَابٍ","بِلَا نِهَايَةٍ، وَلَا تَبِعَةٍ."]],"43":[["لَا جَرَمَ","حَقًّا."],["لَيْسَ لَهُ دَعْوَةٌ","لَا يَسْتَحِقُّ الدَّعْوَةَ إِلَى عِبَادَتِهِ، وَلَا يُلْجَأُ إِلَيْهِ؛ لِعَجْزِهِ."],["مَرَدَّنَا","مَرْجِعَنَا، وَمَصِيرَنَا."]],"44":[["وَأُفَوِّضُ","أَعْتَصِمُ، وَأَلْجَأُ، وَأَتَوَكَّلُ."]],"45":[["سَيِّئَاتِ مَا مَكَرُواْ","عُقُوبَاتِ مَكْرِهِمْ مِنْ إِرَادَةِ إِهْلَاكِهِ."],["وَحَاقَ","نَزَلَ، وَأَحَاطَ."]],"46":[["غُدُوًّا وَعَشِيًّا","أَوَّلَ النَّهَارِ، وَآخِرَهُ."]],"47":[["يَتَحَاجُّونَ","يَتَخَاصَمُونَ."],["مُغْنُونَ","دَافِعُونَ."]],"50":[["ضَلَالٍ","ضِيَاعٍ؛ فَلَا يُقْبَلُ، وَلَا يُسْتَجَابُ."]],"51":[["الْأَشْهَادُ","مَنْ يَشْهَدُونَ عَلَى المُكَذِّبِينَ؛ مِنَ المَلَائِكَةِ وَالأَنْبِيَاءِ وَالمُؤْمِنِينَ."]],"52":[["مَعْذِرَتُهُمْ","عُذْرُهُمْ."],["اللَّعْنَةُ","الطَّرْدُ وَالإِبْعَادُ مِنْ رَحْمَةِ اللَّهِ."]],"53":[["الْكِتَبَ","التَّوْرَاةَ."]],"54":[["لِأُولِي الْأَلْبَابِ","لِأَصْحَابِ العُقُولِ السَّلِيمَةِ."]],"55":[["وَسَبِّحْ بِحَمْدِ رَبِّكَ","نَزِّهْ رَبَّكَ وَاحْمَدْهُ."],["بِالْعَشِيِّ وَالْإِبْكَارِ","فِي آخِرِ النَّهَارِ، وَأَوَّلِهِ."]],"56":[["سُلْطَانٍ","حُجَّةٍ بَيِّنَةٍ."],["إِنْ فِي","مَا فِي."]],"59":[["لَا رَيْبَ فِيهَا","لَا شَكَّ فِيهَا."]],"60":[["دَاخِرِينَ","صَاغِرِينَ، حَقِيرِينَ."]],"61":[["لِتَسْكُنُواْ","لِتَرْتَاحُوا."],["مُبْصِرًا","مُضِيئًا."]],"62":[["فَأَنَّى تُؤْفَكُونَ","كَيْفَ تُصْرَفُونَ عَنِ الإِيمَانِ بِهِ؟!"],["يُؤْفَكُ","يُصْرَفُ."]],"64":[["فَتَبَارَكَ","تَكَاثَرَ خَيْرُهُ وَفَضْلُهُ."]],"66":[["أَنْ أُسْلِمَ","أَنْ أَخْضَعَ وَأَنْقَادَ بِالطَّاعَةِ."]],"67":[["عَلَقَةٍ","الدَّمَ الغَلِيظَ؛ المُتَعَلِّقَ بِجِدَارِ الرَّحِمِ، وَهُوَ أَحَدُ أَطْوَارِ الجَنِينِ."],["لِتَبْلُغُوا أَشُدَّكُمْ","لِتَتَكَامَلَ قُوَّتُكُمْ."],["أَجَلًا مُّسَمًّى","مُدَّةً مُقَدَّرَةً تَنْتَهِي بِهَا أَعْمَارُكُمْ."]],"69":[["أَنَّى يُصْرَفُونَ","كَيْفَ يَعْدِلُونَ عَنْهَا مَعَ صِحَّتِهَا؟!"]],"70":[["بِالْكِتَبِ","بِالقُرْآنِ."]],"71":[["وَالسَّلَسِلُ","القُيُودُ فِي الأَرْجُلِ."]],"72":[["الْحَمِيمِ","المَاءَ الَّذِي بَلَغَ غَايَةَ الحَرَارَةِ."],["يُسْجَرُونَ","يُوقَدُ عَلَيْهِمْ."]],"74":[["ضَلُّوا عَنَّا","غَابُوا عَنْ عُيُونِنَا."]],"75":[["تَمْرَحُونَ","تَتَوَسَّعُونَ فِي الْفَرَحِ أَشَرًا وَبَطَرًا."]],"76":[["مَثْوَىً","مَأْوَىً، وَمَسْكَنٌ."]],"80":[["حَاجَةً فِي صُدُورِكُمْ","أَمْرًا ذَا بَالٍ تَهْتَمُّونَ بِهِ."]],"82":[["فَمَا أَغْنَى عَنْهُمْ","فَمَا دَفَعَ عَنْهُمْ."]],"83":[["مِنَ الْعِلْمِ","الْعِلْمِ بِالدُّنْيَا، وَبِمَا عِنْدَهُمْ مِنَ الْأَبَاطِيلِ الَّتِي يَظُنُّونَهَا عِلْمًا."],["وَحَاقَ","نَزَلَ وَأَحَاطَ."]],"84":[["بَأْسِنَا","عَذَابِنَا."]],"85":[["سُنَّتَ اللَّهِ","طَرِيقَتَهُ فِي عَدَمِ قَبُولِ تَوْبَةِ مَنْ عَايَنَ الْعَذَابَ."],["خَلَتْ","مَضَتْ."]]}