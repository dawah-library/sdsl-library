{"1":[["وَجَعَلَ","خَلَقَ."],["يَعْدِلُونَ","يُسَوُّونَ بِهِ غَيْرَهُ، وَيُشْرِكُونَ."]],"2":[["تَمْتَرُونَ","تَشُكُّونَ."]],"3":[["وَهُوَ اللَّهُ","الْإِلَهُ الْمَعْبُودُ بِحَقٍّ."]],"6":[["قَرْنٍ","أُمَّةٍ مِنَ النَّاسِ."],["مِدْرَارًا","غَزِيرًا."]],"8":[["لَا يُنْظَرُونَ","لَا يُمْهَلُونَ."]],"9":[["وَلَلَبَسْنَا","لَحَلَبْنَا حَتَّى يَشْتَبِهَ عَلَيْهِمُ الْأَمْرُ."]],"10":[["فَحَاقَ","أَحَاطَ وَنَزَلَ."]],"17":[["يَمْسَسْكَ","يُصِبْكَ."]],"23":[["فِتْنَتُهُمْ","إِجَابَتُهُمْ."]],"25":[["أَكِنَّةً","أَغْطِيَةً."],["وَقْرًا","ثِقَلًا وَصَمَمًا."],["أَسَاطِيرُ الْأَوَّلِينَ","حِكَايَاتُهُمُ الَّتِي لَا حَقِيقَةَ لَهَا."]],"26":[["وَيَنْأَوْنَ","يَبْتَعِدُونَ."]],"35":[["كَبُرَ","عَظُمَ."]],"38":[["مَا فَرَّطْنَا","مَا تَرَكْنَا."]],"39":[["صُمٌّ","الَّذِينَ لَا يَسْمَعُونَ."],["وُبْكُمٌ","الَّذِينَ لَا يَتَكَلَّمُونَ."]],"40":[["أَرَأَيْتَكُمْ","أَخْبِرُونِي."]],"42":[["بِالْبَأْسَاءِ","الْفَقْرِ."]],"44":[["مُبْلِسُونَ","آيِسُونَ، مُنْقَطِعُونَ مِنْ كُلِّ خَيْرٍ."]],"45":[["فَقُطِعَ","أُسْتُؤْصِلَ."],["دَابِرُ الْقَوْمِ","آخِرُهُمْ."]],"46":[["نُصَرِّفُ","نُنَوِّعُ."],["يَصْدِفُونَ","يُعْرِضُونَ."]],"52":[["بِالْغَدَاةِ","أَوَّلِ النَّهَارِ."],["وَالْعَشِيِّ","آخِرِ النَّهَارِ."]],"53":[["فَتَنَّا","ابْتَلَيْنَا بِاخْتِلَافِ الْأَرْزَاقِ وَغَيْرِهَا."]],"54":[["بِجَهَالَةٍ","بِسَفَاهَةٍ، وَكُلُّ عَاصٍ لِلَّهِ فَهُوَ جَاهِلٌ."]],"59":[["مَفَاتِحُ الْغَيْبِ","خَزَائِنُ الْغَيْبِ؛ وَهِيَ خَمْسٌ مَذْكُورَةٌ فِي آخِرِ لُقْمَانَ."]],"60":[["جَرَحْتُمْ","اكْتَسَبْتُمْ."]],"61":[["لَا يُفَرِّطُونَ","لَا يُضَيِّعُونَ، وَلَا يُقَصِّرُونَ."]],"63":[["تَضَرُّعًا","مُظْهِرِينَ الضَّرَاعَةَ؛ وَهِيَ شِدَّةُ الْفَقْرِ إِلَى الشَّيْءِ وَالْحَاجَةِ."],["وَخُفْيَةً","مُسِرِّينَ بِالدُّعَاءِ."]],"65":[["يَلْبِسَكُمْ شِيَعًا","يَخْلِطُكُمْ فِرَقًا مُتَنَاحِرَةً."],["نُصَرِّفُ","نُنَوِّعُ."]],"67":[["مُسْتَقَرٌّ","نِهَايَةٌ يُعْرَفُ بِهَا أَحَقٌّ، أَمْ بَاطِلٌ."]],"68":[["يَخُوضُونَ","يَتَكَلَّمُونَ مُسْتَهْزِئِينَ."]],"70":[["تُبْسَلَ","تُرْتَهَنُ، وَتُحْبَسُ."],["تُعْدَلَ","تُفْتَدَ."],["أُبْسِلُوا","ارْتَهَنُوا بِذُنُوبِهِمْ."],["حَمِيمٍ","مَاءٍ بَالِغِ الْحَرَارَةِ."]],"71":[["اسْتَهْوَتْهُ","هَوَتْ بِهِ؛ فَأَضَلَّتْهُ."]],"73":[["الصُّورِ","الْقَرْنِ الَّذِي يُنْفَخُ فِيهِ إِسْرَافِيلُ علي السلام."]],"76":[["جَنَّ","أَظْلَمَ."],["الْآفِلِينَ","الْغَائِبِينَ."]],"77":[["أَفَلَ","غَابَ."]],"79":[["حَنِيفًا","مَائِلاً عَنِ الشِّرْكِ إِلَى التَّوْحِيدِ."]],"82":[["يَلْبِسُوا","يَخْلِطُوا."]],"91":[["حَقَّ قَدْرِهِ","حَقَّ تَعْظِيمِهِ."],["خَوْضِهِمْ","حَدِيثِهِمُ الْبَاطِلِ."]],"93":[["غَمَرَاتُ","أَهْوَالٌ."]],"94":[["خَوَّلْنَاكُمْ","مَلَّكْنَاكُمْ مِنْ مَتَاعِ الدُّنْيَا."],["تَقَطَّعَ بَيْنَكُمْ","زَالَ تَوَاصُلُكُمْ."]],"95":[["فَالِقُ الْحَبِّ","الَّذِي يَشُقُّ الْحَبَّ؛ فَيُخْرِجُ الزَّرْعَ مِنْهُ."],["تُؤْفَكُونَ","تُصْرَفُونَ عَنِ الْحَقِّ."]],"96":[["فَالِقُ الْإِصْبَاحِ","الَّذِي يَشُقُّ ضِيَاءَ الصُّبْحِ."],["حُسْبَانًا","بِحِسَابٍ مُقَدَّرٍ."]],"98":[["فَمُسْتَقَرٌّ","رَحِمُ الْمَرْأَةِ؛ تَسْتَقَرُّ فِيهِ النُّطْفَةُ."],["وَمُسْتَوْدَعٌ","صُلْبُ الرَّجُلِ؛ تُحْفَظُ فِيهِ النُّطْفَةُ."]],"99":[["خَضِرًا","زَرْعًا، وَشَجَرًا أَخْضَرَ."],["مُتَرَاكِبًا","يَرْكَبُ بَعْضُهُ فَوْقَ بَعْضٍ."],["طَلْعُهَا","مَا تَنْشَأُ فِيهِ عُذُوقُ الرُّطَبِ."],["قِنْوَانٌ دَانِيَةٌ","عُذُوقٌ قَرِيبَةُ التَّنَاوُلِ."],["وَيِنْعِهِ","نُضْجِهِ، وَبُلُوغِهِ حِينَ يَبْلُغُ."]],"100":[["وَخَرَقُوا","اخْتَلَقُوا وَافْتَرَوْا لَهُ سُبْحَانَهُ."]],"101":[["بَدِيعُ","خَالِقٌ، وَمُبْدِعٌ."]],"103":[["يُدْرِكُ الْأَبْصَارَ","يُبْصِرُهَا، وَيُحِيطُ بِهَا عِلْمًا."]],"104":[["بَصَائِرُ","بَرَاهِينُ."]],"105":[["نُصَرِّفُ","نُبَيِّنُ."],["دَرَسْتَ","تَعَلَّمْتَ."]],"109":[["جَهْدَ أَيْمَانِهِمْ","بِأَيْمَانٍ مُؤَكَّدَةٍ."]],"110":[["يَعْمَهُونَ","يَتَحَيَّرُونَ."]],"111":[["وَحَشَرْنَا","جَمَعْنَا."],["قُبُلًا","مُوَاجَهَةً."]],"112":[["زُخْرُفَ الْقَوْلِ","الْقَوْلَ الْبَاطِلَ الَّذِي زَيَّنَهُ قَائِلُوهُ."],["غُرُورًا","خِدَاعًا."],["يَفْتَرُونَ","يَخْتَلِقُونَ مِنْ كَذِبٍ وَزُورٍ."]],"113":[["وَلِتَصْغَى","لِتَمِيلَ."],["وَلِيَقْتَرِفُوا","لِيَكْتَسِبُوا."]],"114":[["الْمُمْتَرِينَ","الشَّاكِّينَ."]],"115":[["صِدْقًا","فِي الْأَخْبَارِ."],["وَعَدْلًا","فِي الْأَحْكَامِ."]],"116":[["يَخْرُصُونَ","يَظُنُّونَ وَيَكْذِبُونَ."]]}