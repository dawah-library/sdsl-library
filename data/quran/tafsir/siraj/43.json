{"4":[["أُمِّ الْكِتَابِ","اللَّوْحُ المَحْفُوظُ."],["لَعَلِيٌّ","رَفِيعُ الشَّأْنِ."],["حَكِيمٌ","مُحْكَمٌ، وَذُو حِكْمَةٍ بَالِغَةٍ."]],"5":[["أَفَنَضْرِبُ عَنْكُمُ الذِّكْرَ صَفْحاً","أَفَنُعْرِضُ عَنْكُمْ، وَنَتْرُكُ تَذْكِيرَكُمْ بِالقُرْآنِ؟!"],["أَنْ كُنْتُمْ","بِسَبَبِ أَنْ كُنْتُمْ."]],"6":[["وَكَمْ أَرْسَلْنَا","كَثِيرًا مِنَ الأَنْبِيَاءِ أَرْسَلْنَا."]],"8":[["بَطْشاً","قُوَّةً."],["وَمَضَى مَثَلُ الْأَوَّلِينَ","سَبَقَ فِي القُرْآنِ أَحَادِيثُ إِهْلَاكِهِمْ."]],"10":[["مَهْداً","فِرَاشًا مُمَهَّدًا."],["سُبُلاً","طُرُقًا لِمَعَاشِكُمْ تَسْلُكُونَهَا."]],"11":[["بِقَدَرٍ","بِمِقْدَارٍ، وَوَزْنٍ مَعْلُومٍ."],["فَأَنْشَرْنَا","أَحْيَيْنَا."],["مَيْتاً","مَقْفِرَةً مِنَ النَّبَاتِ."]],"12":[["الْأَزْوَاجَ","الأَصْنَافَ؛ مِنْ نَبَاتٍ، وَحَيَوَانٍ."],["الْفُلْكِ","السُّفُنِ."]],"13":[["مُقْرِنِينَ","مُطِيقِينَ."]],"15":[["جُزْءاً","نَصِيبًا."],["لَكَفُورٌ","لَجَحُودٌ لِنِعَمِ رَبِّهِ."]],"16":[["وَأَصْفَاكُمْ","خَصَّكُمْ."]],"17":[["بِمَا ضُرِبَ لِلرَّحْمَنِ مَثَلاً","بِالأُنْثَى الَّتِي نَسَبَهَا لِلرَّحْمَنِ؛ حِينَ زَعَمَ أَنَّ المَلَائِكَةَ بَنَاتُ اللَّهِ."],["ظَلَّ","صَارَ."],["كَظِيمٌ","مُمْتَلِئٌ حُزْنًا، وَغَمًّا."]],"18":[["يُنَشَّؤُا","يُرَبَّى."],["الْحِلْيَةِ","الزِّينَةِ."],["الْخِصَامِ","الجِدَالِ."],["غَيْرُ مُبِينٍ","غَيْرُ وَاضِحٍ، وَبَيِّنٍ."]],"20":[["يَخْرُصُونَ","يَتَقَوْلُونَ عَلَى اللَّهِ الكَذِبَ."]],"22":[["أُمَّةً","طَرِيقَةً، وَدِينًا."]],"26":[["بَرَاءٌ","بَرِيءٌ."]],"27":[["فَطَرَنِي","خَلَقَنِي."]],"28":[["كَلِمَةً بَاقِيَةً","أَيْ: لَا إِلَهَ إِلَّا اللَّهُ: بَاقِيَةً."],["عَقِبَهُ","ذُرِّيَّتَهُ."]],"29":[["مَتَّعْتُ هَؤُلَاءِ","لَمْ أُعَاجِلْهُمْ بِالعُقُوبَةِ."]],"31":[["الْقَرْيَتَيْنِ","مَكَّةَ، وَالطَّائِفَ."]],"32":[["رَحْمَتَ رَبِّكَ","النُّبُوَّةَ."],["سُخْرِيّاً","مُسَخَّرًا فِي العَمَلِ."],["وَرَحْمَتُ رَبِّكَ","الجَنَّةُ."]],"33":[["أُمَّةً وَاحِدَةً","جَمَاعَةً وَاحِدَةً عَلَى الكُفْرِ."],["وَمَعَارِجَ","سَلَالِمَ مِنْ فِضَّةٍ."],["يَظْهَرُونَ","يَصْعَدُونَ."]],"35":[["وَزُخْرُفاً","ذَهَبًا."],["وَإِنْ كُلُّ ذَلِكَ لَمَّا","مَا كُلُّ ذَلِكَ إِلَّا."]],"36":[["يَعْشُ","يُعْرِضْ."]],"38":[["قَرِينٌ","مُلَازِمٌ، وَمُصَاحِبٌ."],["بُعْدَ الْمَشْرِقَيْنِ","مِثْلَ تَبَاعُدِ مَا بَيْنَ المَشْرِقِ، وَالمَغْرِبِ."]],"44":[["لِذِكْرٍ","لَشَرَفٍ؛ لِأَنَّهُ أُنْزِلَ بِلُغَتِهِمْ."]],"53":[["آيَةً","حُجَّةً عَلَى صِدْقِ دَعْوَتِهِ."],["مُقْتَرِنِينَ","مَقْرُونِينَ مَعَهُ يُصَدِّقُونَهُ."]],"49":[["ٱلسَّاحِرُ","العَالِمُ (وَكَانَ السَّاحِرُ فِيهِمْ عَظِيمًا يُوقِّرُونَهُ، وَلَمْ يَكُنْ صِفَةَ ذَمٍّ)."],["بِمَا عَهِدَ عِندَكَ","بِعَهْدِهِ الَّذِي عَهِدَ إِلَيْكَ، وَمَا خَصَّكَ بِهِ مِنَ الفَضَائِلِ."]],"50":[["يَنكُثُونَ","يَغْدِرُونَ، وَيُصِرُّونَ عَلَى الكُفْرِ."]],"52":[["مَّهِينٌ","ضَعِيفٌ لَا عِزَّ لَهُ."],["وَلَا يَكَادُ يُبِينُ","لَا يَكَادُ يُفْصِحُ فِي كَلَامِهِ."]],"54":[["فَاستَخَفَّ قَوْمَهُ","اسْتَخَفَّ بِعُقُولِهِمْ."]],"56":[["سَلَفًا","قُدْوَةً لِمَنْ يَعْمَلُ مِثْلَ عَمَلِهِمْ؛ فَيَسْتَحِقُّ العُقُوبَةَ."],["وَمَثَلًا","عِظَةً، وَعِبْرَةً."]],"57":[["يَصُدُّونَ","يَضِجُّونَ وَيَصِيحُونَ، فَرَحًا، وَجَذَلًا."]],"58":[["خَصِمُونَ","شَدِيدُو الخُصُومَةِ بِالبَاطِلِ."]],"59":[["مَّثَلًا","عِبْرَةً، وَآيَةً."]],"60":[["لَجَعَلْنَا مِنكُم","لَجَعَلْنَا بَدَلَكُمْ."],["يَخْلُفُونَ","يَخْلُفُ بَعْضُهُمْ بَعْضًا، بَدَلًا مِنْ بَنِي آدَمَ."]],"61":[["وَإِنَّهُ لَعِلْمُ لِلسَّاعَةِ","إِنَّ نُزُولَ عِيسَى العَلَيْهِ السَّلَامُ لَدَلِيلٌ عَلَى قُرْبِ وُقُوعِ السَّاعَةِ."],["فَلَا تَمْتَرُنَّ","لَا تَشُكُّوا."],["صِرَاطٌ مُّسْتَقِيمٌ","طَرِيقٌ قَوِيمٌ إِلَى الجَنَّةِ لَا عَوْجَ فِيهِ."]],"63":[["بِالحِكْمَةِ","بِالنُّبُوَّةِ."]],"65":[["ٱلأَحْزَابُ","الفِرَقُ."],["فَوَيْلٌ","هَلَاكٌ، وَدَمَارٌ."]],"66":[["بَغْتَةً","فَجْأَةً."]],"67":[["ٱلأَخِلَّاءُ","الأَصْدِقَاءُ، وَالأَحْبَابُ."]],"70":[["تُحْبَرُونَ","تُنْعَمُونَ، وَتُسُرُّونَ."]],"71":[["بِصِحَافٍ","بِأَوَانٍ."]],"75":[["مُّبْلِسُونَ","آيِسُونَ مِنْ رَحْمَةِ اللَّهِ."]],"77":[["يَمْلِكُ","هُوَ: خَازِنُ جَهَنَّمَ."],["لِيَقْضِ","لِيُمِيتَنَا."]],"79":[["أَمْ أَبْرَمُوا أَمْرًا","أَحْكَمُوا أَمْرًا فِي كَيْدِ نَبِيِّنَا مُحَمَّدٍ ﷺ."]],"80":[["يَحْسَبُونَ","يَظُنُّونَ."],["وَنَجْوَاهُمْ","مَا نَتَكَلَّمُ فِيهِ فِيمَا بَيْنَهُمْ."],["وَرُسُلُنَا","مَلَائِكَتُنَا الكِرَامُ الحَفَظَةُ."]],"84":[["إِلَهُ","مَعْبُودٌ بِحَقٍّ."]],"85":[["وَتَبَارَكَ","تَكَاثَرَتْ بَرَكَةُ اللَّهِ، وَكَثُرَ خَيْرُهُ."]],"86":[["شَهِدَ بِالحَقِّ","أَقَرَّ بِتَوْحِيدِ اللَّهِ، وَنُبُوَّةِ نَبِيِّنَا مُحَمَّدٍ ﷺ."]],"87":[["فَأَنَّى يُؤْفَكُونَ","كَيْفَ يُنْصَرَفُونَ عَنْ عِبَادَةِ اللَّهِ؟!"]],"88":[["وَقِيلِهِ","وَقَوْلِ مُحَمَّدٍ فِي شَكْوَاهُ."]],"89":[["فَأَصْفَحْ","أَعْرِضْ عَنْ أَذَاهُمْ."]]}