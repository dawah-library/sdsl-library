{"1":[["فُصِّلَتْ","بُيِّنَتْ بِالأَمْرِ وَالنَّهْيِ."]],"3":[["تُوبُوا إِلَيْهِ","ارْجِعُوا إِلَيْهِ نَادِمِينَ."]],"5":[["يَثْنُونَ صُدُورَهُمْ","يُضْمِرُونَ فِي صُدُورِهِمُ الكُفْرَ."],["يَسْتَغْشُونَ ثِيَابَهُمْ","يَتَغَطَّوْنَ بِثِيَابِهِمْ."]],"6":[["مُسْتَقَرَّهَا","مَسْكَنَهَا فِي الدُّنْيَا، وَبَعْدَ المَوْتِ."],["وَمُسْتَوْدَعَهَا","المَوْضِعَ الَّذِي تَمُوتُ فِيهِ."]],"7":[["لِيَبْلُوَكُمْ","لِيَخْتَبِرَكُمْ."]],"8":[["أُمَّةٍ مَعْدُودَةٍ","أَجَلٍ مَعْلُومٍ."],["مَا يَحْبِسُهُ","مَا يَمْنَعُهُ؟"],["وَحَاقَ","أَحَاطَ بِهِمْ مِنْ كُلِّ جَانِبٍ."]],"9":[["لَيَئُوسٌ","شَدِيدُ اليَأْسِ وَالقُنُوطِ."]],"10":[["ضَرَّاءَ","ضِيقٍ وَنَكْبَةٍ."],["السَّيِّئَاتُ","الضِّيقُ، وَالشَّدَائِدُ."],["لَفَرِحٌ","لَبَطِرٌ بِالنَّعْمِ، مَغْرُورٌ بِهَا."],["فَخُورٌ","مُبَالِغٌ فِي الفَخْرِ وَالتَّعَالِي عَلَى النَّاسِ."]],"12":[["كَنْزٌ","مَالٌ كَثِيرٌ."]],"15":[["لَا يُبْخَسُونَ","لَا يُنْقَصُونَ شَيْئًا مِنْ جَزَائِهِمُ الدُّنْيَوِيِّ."]],"16":[["وَحَبِطَ","ذَهَبَ نَفْعُ مَا عَمِلُوهُ."]],"17":[["بَيِّنَةٍ","يَقِينٍ."],["وَيَتْلُوهُ شَاهِدٌ مِنْهُ","هُوَ جِبْرِيلُ، أَوْ نَبِيُّنَا مُحَمَّدٌ، عَلَيْهِمَا الصَّلَاةُ وَالسَّلَامُ."],["الأَحْزَابِ","الكُفَّارِ الَّذِينَ تَحَزَّبُوا عَلَى نَبِيِّنَا مُحَمَّدٍ ﷺ."],["فَلَا تَكُ","فَلَا تَكُنْ."],["مِرْيَةٍ","شَكٍّ."]],"18":[["الأَشْهَادُ","المَلَائِكَةُ، وَالنَّبِيُّونَ، وَالجَوَارِحُ، الَّذِينَ يَشْهَدُونَ يَوْمَ القِيَامَةِ."]],"19":[["وَيَبْغُونَهَا","يُرِيدُونَهَا."],["عِوَجًا","مُعْوَجَّةً، مُوَافَقَةً لِأَهْوَائِهِمْ."]],"20":[["مُعْجِزِينَ","فَائِتِينَ مِنْ عَذَابِ اللَّهِ بِالهَرَبِ."]],"21":[["وَضَلَّ","ذَهَبَ."]],"22":[["لَا جَرَمَ","حَقًّا."]],"23":[["وَأَخْبَتُوا","خَضَعُوا لِلَّهِ."]],"24":[["وَالأَصَمِّ","الَّذِي لَا يَسْمَعُ."]],"27":[["المَلَأُ","رُؤَسَاءُ الكُفْرِ."],["أَرَاذِلُنَا","أَسَافِلُنَا."],["بَادِيَ الرَّأْيِ","مِنْ غَيْرِ تَفَكُّرٍ، وَلَا رُوِيَّةٍ."]],"28":[["فَعُمِّيَتْ عَلَيْكُمْ","فَأُخْفِيَتْ عَلَيْكُمْ."],["أَنُلْزِمُكُمُوهَا","أَنُجْبِرُكُمْ عَلَى قَبُولِهَا."]],"31":[["تَزْدَرِي","تَحْتَقِرُ."]],"35":[["أَمْ يَقُولُونَ","بَلْ أَيَقُولُونَ."],["افْتَرَاهُ","اخْتَلَقَهُ."]],"36":[["فَلَا تَبْتَئِسْ","لَا تَحْزَنْ."]],"37":[["الفُلْكِ","السَّفِينَةِ."],["بِأَعْيُنِنَا","بِحِفْظِنَا وَمَرْأَى مِنَّا."]],"38":[["مَلَأٌ","أَشْرَافٌ."]],"40":[["فَارَ","نَبَعَ المَاءُ بِقُوَّةٍ."],["التَّنُّورُ","المَكَانُ الَّذِي يُخْبَرُ فِيهِ."]],"41":[["مَجْرَاهَا","جَرْيُهَا."],["وَمُرْسَاهَا","مُنْتَهَى سَيْرِهَا وَرُسُوِّهَا."]],"44":[["أَقْلِعِي","أَمْسِكِي عَنِ المَطَرِ."],["وَغِيضَ","نَقَصَ، وَنَضَبَ."],["وَاسْتَوَتْ","رَسَتْ."],["الجُودِيِّ","اسْمُ جَبَلٍ."],["بُعْدًا","هَلَاكًا."]],"46":[["أَعِظَكَ أَنْ تَكُونَ","أَعِظُكَ لِئَلَّا تَكُونَ."]],"47":[["أَعُوذُ بِكَ","أَسْتَجِيرُ بِكَ."]],"50":[["مُفْتَرُونَ","كَاذِبُونَ."]],"52":[["مِدْرَارًا","مُتَتَابِعًا، كَثِيرًا."]],"53":[["عَنْ قَوْلِكَ","مِنْ أَجْلِ قَوْلِكَ."]],"54":[["بِسُوءٍ","بِجُنُونٍ."]],"55":[["فَكِيدُونِي","فَاجْتَهِدُوا فِي إِصَالِ الضُّرِّ إِلَيَّ."],["ثُمَّ لَا تُنْظِرُونِي","لَا تُمْهِلُونِي."]],"56":[["آخِذٌ بِنَاصِيَتِهَا","مَالِكُهَا، وَالمُتَصَرِّفُ فِيهَا."]],"57":[["وَيَسْتَخْلِفُ","يَأْتِي بِقَوْمٍ آخَرِينَ يَخْلُفُونَكُمْ فِي دِيَارِكُمْ."],["حَفِيظٌ","يَحْفَظُ مِنْ كُلِّ سُوءٍ."]],"58":[["غَلِيظٌ","شَدِيدٍ."]],"59":[["جَبَّارٍ","مُسْتَكْبِرٍ."],["عَنِيدٍ","لَا يَقْبَلُ الحَقَّ."]],"61":[["أَنْشَأَكُمْ","ابْتَدَأَ خَلْقَكُمْ."],["وَاسْتَعْمَرَكُمْ فِيهَا","جَعَلَكُمْ عُمَّارًا لَهَا."]],"62":[["كُنْتَ فِينَا مَرْجُوًّا","كُنَّا نَرْجُو أَنْ تَكُونَ سَيِّدًا."],["مُرِيبٍ","مُوقِعٍ فِي الرَّيْبِ وَالشَّكِّ."]],"64":[["بِسُوءٍ","بِنَحْرٍ أَوْ ضَرْبٍ."]],"65":[["فَعَقَرُوهَا","فَنَحَرُوهَا."],["تَمَتَّعُوا فِي دَارِكُمْ","اسْتَمْتِعُوا بِحَيَاتِكُمْ فِي بَلَدِكُمْ."]],"66":[["خِزْيِ يَوْمِئِذٍ","هَوَانِ ذَلِكَ الْيَوْمِ، وَذِلَّتِهِ."]],"67":[["الصَّيْحَةُ","صَوْتٌ عَظِيمٌ مُهْلِكٌ مِنَ السَّمَاءِ."],["جِثِمِينَ","هَامِدِينَ، سَاقِطِينَ عَلَى وُجُوهِهِمْ."]],"68":[["لَمْ يَغْنَوْا","لَمْ يَعِيشُوا، وَيُقِيمُوا."],["بُعْدًا","هَلَاكًا، وَطَرْدًا."]],"69":[["حَنِيذٍ","مَشْوِيٍّ بِالْحِجَارَةِ الْمُحَمَّاةِ."]],"70":[["نَكِرَهُمْ","أَنْكَرَ ذَلِكَ مِنْهُمْ."],["وَأَوْجَسَ مِنْهُمْ خِيفَةً","أَحَسَّ فِي نَفْسِهِ خَوْفًا مِنْهُمْ."]],"71":[["وَمِنْ وَرَاءِ","وَمِنْ بَعْدُ."]],"72":[["يَٰوَيْلَتَى","كَلِمَةُ تَعَجُّبٍ."],["بَعْلِي","زَوْجِي."]],"73":[["حَمِيدٌ","مَحْمُودُ الصِّفَاتِ وَالْأَفْعَالِ."],["مَجِيدٌ","ذُو عَظَمَةٍ."]],"74":[["الرَّوْعُ","الْخَوْفُ."]],"75":[["أَوَّهْ","كَثِيرُ التَّضَرُّعِ وَالدُّعَاءِ."],["مُنِيبٌ","تَائِبٌ يَرْجِعُ إِلَى اللَّهِ فِي أُمُورِهِ كُلِّهَا."]],"77":[["سِيءَ بِهِمْ","سَاءَهُ مَجِيئُهُمْ."],["وَضَاقَ بِهِمْ ذَرْعًا","ضَاقَ صَدْرُهُ، وَاغْتَمَّ لِمَجِيئِهِمْ؛ خَوْفًا عَلَيْهِمْ مِنْ قَوْمِهِ."],["عَصِيبٌ","شَدِيدٌ."]],"78":[["يُهْرَعُونَ","يُسْرِعُونَ."],["وَلَا تُخْزُونِي","لَا تَفْضَحُونِي."],["رَشِيدٌ","يَأْمُرُ بِالْمَعْرُوفِ، وَيَنْهَى عَنِ الْمُنْكَرِ."]],"79":[["مِنْ حَقٍّ","مِنْ حَاجَةٍ، أَوْ رَغْبَةٍ."]],"81":[["بِقِطْعِ مِنَ الَّيْلِ","بِبَقِيَّةٍ مِنَ اللَّيْلِ."]],"82":[["سِجِّيلٍ","طِينٍ مُتَصَلِّبٍ مَتِينٍ."],["مَنْضُودٍ","صَفٌّ بَعْضُهَا إِلَى بَعْضٍ مُتَتَابِعَةً."]],"83":[["مُسَوَّمَةً","مُعَلَّمَةً عِنْدَ اللَّهِ بِعَلَامَةٍ مَعْرُوفَةٍ لَا تُشْبِهُ حِجَارَةَ الْأَرْضِ."]],"85":[["بِالْقِسْطِ","بِالْعَدْلِ."],["وَلَا تَبْخَسُوا","لَا تَنْقُصُوا."],["وَلَا تَعْثَوْا","لَا تَسْعَوْا، وَلَا تُسْفِرُوا."]],"86":[["بَقِيَّتُ اللَّهِ","مَا يُبْقِي اللَّهُ لَكُمْ بَعْدَ إِيفَاءِ الْكَيْلِ وَالْمِيزَانِ مِنَ الرِّبْحِ الْحَلَالِ."],["بَحَفِيظٍ","رَقِيبٍ أُحْصِي أَعْمَالَكُمْ."]],"88":[["أُنِيبُ","أَرْجِعُ بِالتَّوْبَةِ، وَالطَّاعَةِ."]],"89":[["لَا يَجْرِمَنَّكُمْ","لَا يَحْمِلَنَّكُمْ."],["شِقَاقِي","عَدَاوَتِي."]],"91":[["ضَعِيفًا","لَسْتَ مِنَ الْكُبَرَاءِ، وَلَا الرُّؤَسَاءِ."]],"93":[["مَكَانَتِكُمْ","طَرِيقَتِكُمْ وَحَالَتِكُمْ."]],"94":[["جِثِمِينَ","بَارِكِينَ عَلَى رُكَبِهِمْ مُيِّتِينَ."]],"95":[["لَمْ يَغْنَوْا","لَمْ يُقِيمُوا."],["بُعْدًا","هَلَاكًا، وَإِبْعَادًا."]],"96":[["وَسُلْطَانٍ مُبِينٍ","حُجَّةٍ تَظْهَرُ لِمَنْ عَايَنَهَا."]],"98":[["فَأَوْرَدَهُمْ","فَأَدْخَلَهُمْ."],["الْوِرْدُ","الْمَدْخَلُ."],["الْمَوْرُودُ","الْمَدْخُولُ فِيهِ، وَهُوَ هُنَا النَّارُ."]],"99":[["الرِّفْدُ","الْعَوْنُ، وَالْعَطَاءُ."],["الْمَرْفُودُ","الْمُعْطَى لَهُمْ."]],"100":[["قَائِمٌ","آثَارُهُ بَاقِيَةٌ كَمَدَائِنِ صَالِحٍ."],["وَحَصِيدٌ","مَحْصُودٌ قَدْ مُحِيَتْ آثَارُهُ، وَلَمْ يَبْقَ مِنْهُ شَيْءٌ."]],"101":[["أَغْنَتْ","نَفَعَتْ."]],"106":[["زَفِيرٌ","صَوْتٌ شَنِيعٌ، يُسْمَعُ عِنْدَ إِخْرَاجِ النَّفْسِ."],["وَشَهِيقٌ","صَوْتٌ شَنِيعٌ يُسْمَعُ عِنْدَ إِدْخَالِ النَّفْسِ."]],"108":[["مَجْذُوذٍ","مَقْطُوعٍ."]],"109":[["فَلَا تَكُ","لَا تَكُنْ."],["مِرْيَةٍ","شَكٍّ."]],"110":[["مُرِيبٍ","مُوقِعٍ فِي الرِّيبَةِ، وَقَلَقِ النَّفْسِ."]],"112":[["وَلَا تَطْغَوْا","لَا تَتَجَاوَزُوا مَا حَدَّهُ اللَّهُ لَكُمْ."]],"113":[["وَلَا تَرْكَنُوا","لَا تَمِيلُوا."]],"114":[["طَرَفَيْ النَّهَارِ","الصَّبَاحَ وَالْمَسَاءَ، وَقِيلَ: الْمُرَادُ بِهَا: صَلَاةُ الْفَجْرِ وَالظُّهْرِ وَالْعَصْرِ."],["وَزُلَفًا مِنَ اللَّيْلِ","سَاعَاتٍ مِنَ اللَّيْلِ، وَقِيلَ: الْمُرَادُ بِهَا: الْمَغْرِبُ وَالْعِشَاءُ أَوِ الْعِشَاءُ وَحْدَهَا."]],"116":[["فَلَوْلَا","فَهَلَّا."],["الْقُرُونِ","الْأُمَمِ الْمَاضِيَةِ."],["أُولُوا بَقِيَّةٍ","بَقَايَا مِنْ أَهْلِ الْخَيْرِ وَالصَّلَاحِ."],["أَتْرَفُوا فِيهِ","مُتِّعُوا فِيهِ مِنْ لَذَّاتِ الدُّنْيَا."]],"118":[["أُمَّةً وَاحِدَةً","جَمَاعَةً وَاحِدَةً عَلَى دِينِ وَاحِدٍ، وَهُوَ الْإِسْلَامُ."]],"121":[["مَكَانَتِكُمْ","حَالَتِكُمْ، وَطَرِيقَتِكُمْ."]]}