{"1":[["لَا تُقَدِّمُواْ","لَا تَتَقَدَّمُوا بِقَوْلٍ أَوْ فِعْلٍ، وَلَا تَقْضُوا أَمْرًا دُونَ أَمْرِ اللَّهِ وَرَسُولِهِ؛ فَتَبْتَدِعُوا."]],"2":[["أَن تُحْبَطَ","كَرَاهَةَ أَنْ تَبْطُلَ."]],"3":[["يَغُضُّونَ","يَخْفِضُونَ."],["آمْتَحَنَ اللَّهُ قُلُوبَهُمْ","اخْتَبَرَهَا، وَصَفَّاهَا، وَأَخْلَصَهَا لِتَقْوَاهُ."]],"4":[["يُنَادُونَكَ","يُنَادِيكَ الْأَعْرَابُ بِصَوْتٍ مُرْتَفِعٍ، غَلِيظٍ، جَافٍ."],["الْحُجُرَاتِ","حُجُرَاتِ زَوْجَاتِهِ ﷺ."]],"6":[["بِنَبَإٍ","بِخَبَرٍ."],["فَتَبَيَّنُواْ","فَتَبَشَّتُوا مِنْ خَبَرِهِ."],["أَن تُصِيبُواْ","خَشْيَةَ أَنْ تُصِيبُوا."]],"7":[["لَعِنْتُمْ","لَأَدَّى إِلَى مَشَقَّتِكُمْ، وَعَنَتِكُمْ."]],"9":[["بَغَتْ","اعْتَدَتْ."],["وَأَقْسِطُواْ","اعْدِلُوا."],["الْمُقْسِطِينَ","العَادِلِينَ فِي أَحْكَامِهِمْ."]],"11":[["لَا يَسْخَرْ","لَا يَهْزَأُ، وَيَنْتَقِصُ."],["قَوْمٌ","رِجَالٌ."],["وَلَا تَلْمِزُواْ","لَا يَعِيبُ، وَلَا يَطْعُنُ بَعْضُكُمْ بَعْضًا."],["وَلَا تَنَابَزُواْ بِالْأَلْقَابِ","لَا يَدْعُ بَعْضُكُمْ بَعْضًا بِمَا يَكْرَهُ مِنَ الأَلْقَابِ."],["بِئْسَ الاِسْمُ الْفُسُوقُ","قُبْحُ الاسْمِ وَالصِّفَةِ الفُسُوقُ؛ وَهُوَ: السُّخْرِيَّةُ، وَاللَّمْزُ، وَالتَّنَابُزُ."]],"12":[["كَثِيرًا مِّنَ الظَّنِّ","هُوَ ظَنُّ السُّوءِ بِالمُؤْمِنِينَ."],["وَلَا تَجَسَّسُواْ","لَا تَفَتَّشُوا عَنْ عَوْرَاتِ المُسْلِمِينَ."],["وَلَا يَغْتَب","لَا يَقُلْ أَحَدُكُمْ فِي أَخِيهِ الغَائِبِ مَا يَكْرَهُ."]],"13":[["وَقَبَائِلَ","القَبِيلَةُ: الجَمَاعَةُ دُونَ الشَّعْبِ."]],"14":[["الْأَعْرَابُ","البَدْوُ."],["لَا يَلِتْكُم مِّنْ أَعْمَالِكُمْ","لَا يَنْقُصُكُمْ مِنْ ثَوَابِ أَعْمَالِكُمْ."]],"15":[["لَمْ يَرْتَابُواْ","لَمْ يَشُكُّوا."]]}