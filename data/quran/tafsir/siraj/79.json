{"1":[["وَالنَّازِعَاتِ","قَسَمٌ بِالمَلَائِكَةِ تَنْزِعُ أَرْوَاحَ الْكُفَّارِ."]],"2":[["وَالنَّاشِطَاتِ","قَسَمٌ بِالمَلَائِكَةِ تَسُلُّ أَرْوَاحَ الْمُؤْمِنِينَ بِرِفْقٍ."]],"3":[["وَالسَّابِحَاتِ","قَسَمٌ بِالمَلَائِكَةِ الَّتِي تَسْبَحُ فِي نُزُولِهِمَا مِنَ السَّمَاءِ، وَصُعُودِهَا إِلَيْهَا."]],"4":[["فَالسَّابِقَاتِ","قَسَمٌ بِالمَلَائِكَةِ الَّتِي تَسْبِقُ الشَّيَاطِينَ بِالْوَحْيِ إِلَى الْأَنْبِيَاءِ؛ لِئَلَّا تَسْتَرِقَهُ."]],"5":[["فَالْمُدَبِّرَاتِ أَمْرًا","قَسَمٌ بِالمَلَائِكَةِ الْمُنَفِّذَاتِ أَمْرَ اللَّهِ، وَجَوَابُ الْقَسَمِ مَحْذُوفٌ، وَتَقْدِيرُهُ: لَتُبْعَثُنَّ."]],"6":[["تَرْجُفُ الرَّاجِفَةُ","تَضْطَرِبُ الْأَرْضُ بِالنَّفْخَةِ الْأُولَى: نَفْخَةِ الصَّعْقِ."]],"7":[["تَتْبَعُهَا الرَّادِفَةُ","تَلِيهَا نَفْخَةٌ أُخْرَى لِلْبَعْثِ."]],"8":[["وَاجِفَةٌ","خَائِفَةٌ، مُضْطَرِبَةٌ."]],"9":[["خَاشِعَةٌ","ذَلِيلَةٌ مِنْ هَوْلِ مَا تُشَاهِدُ."]],"10":[["الحَافِرَةِ","الْحَالَةِ الَّتِي كُنَّا عَلَيْهَا فِي الْأَرْضِ."]],"11":[["نَخِرَةً","بَالِيَةً."]],"12":[["كَرَّةٌ خَاسِرَةٌ","رَجْعَةٌ خَائِبَةٌ ذَاتُ خُسْرَانٍ."]],"13":[["زَجْرَةٌ","نَفْخَةٌ."]],"14":[["بِالسَّاهِرَةِ","بِوَجْهِ الْأَرْضِ أَحْيَاءً بَعْدَ أَنْ كَانُوا فِي بَطْنِهَا."]],"16":[["المُقَدَّسِ","المُطَهَّرِ."],["طُوًى","اسْمُ الْوَادِي."]],"18":[["تَزَكَّى","تَتَطَهَّرُ مِنَ الْكُفْرِ، وَتَتَحَلَّى بِالْإِيمَانِ."]],"19":[["وَأَهْدِيَكَ","أُرْشِدَكَ."]],"20":[["الْآيَةَ الْكُبْرَى","مُعْجِزَةَ الْعَصَا، وَالْيَدِ الْبَيْضَاءِ."]],"22":[["يَسْعَى","يَجْتَهِدُ فِي مُعَارَضَةِ مُوسَى ؏."]],"23":[["فَحَشَرَ","جَمَعَ أَهْلَ مَمْلَكَتِهِ."]],"25":[["نَكَالَ","عُقُوبَةً."]],"29":[["وَأَغْطَشَ لَيْلَهَا","أَظْلَمَ لَيْلَهَا بِغُرُوبِ شَمْسِهَا."],["وَأَخْرَجَ ضُحَاهَا","أَبْرَزَ نَهَارَهَا بِشُرُوقِ شَمْسِهَا."]],"30":[["دَحَاهَا","بَسَطَهَا، وَأَوْدَعَ فِيهَا مَنَافِعَهَا."]],"31":[["وَمَرْعَاهَا","مَا يُرْعَى مِنَ النَّبَاتِ."]],"32":[["أَرْسَاهَا","أَثْبَتَهَا عَلَى الْأَرْضِ؛ كَالْأَوْتَادِ."]],"34":[["الطَّامَّةُ","الْقِيَامَةُ، وَهِيَ النَّفْخَةُ الثَّانِيَةُ."]],"36":[["وَبُرِزَتْ","أُظْهِرَتْ إِظْهَارًا بَيِّنًا."]],"39":[["الْمَأْوَى","الْمَصِيرُ."]],"40":[["مَقَامَ رَبِّهِ","الْقِيَامَ بَيْنَ يَدَيْ رَبِّهِ لِلْحِسَابِ."]],"43":[["فِيمَ أَنْتَ مِنْ ذِكْرَاهَا","لَيْسَ عِنْدَكَ عِلْمُهَا؛ حَتَّى تَذْكُرَهَا."]],"46":[["عَشِيَّةً","مَا بَيْنَ الظُّهْرِ إِلَى غُرُوبِ الشَّمْسِ."],["ضُحَاهَا","مَا بَيْنَ طُلُوعِ الشَّمْسِ إِلَى نِصْفِ النَّهَارِ."]]}