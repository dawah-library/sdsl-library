{"1":[["أَضَلَّ أَعْمَالَهُمْ","أَحْبَطَهَا، وَأَبْطَلَهَا."]],"3":[["كَفَرَ","أَزَالَ، وَمَحَا."]],"4":[["فَضَرْبَ الرِّقَابِ","اضْرِبُوا مِنْهُمُ الْأَعْنَاقَ."],["أَثْخَنْتُمُوهُمْ","أَضْعَفْتُمُوهُمْ بِكَثْرَةِ الْقِتَالِ، وَكَسَرْتُمْ شَوْكَتَهُمْ."],["فَشُدُّوا الْوَثَاقَ","أَحْكِمُوا قَيْدَ الْأَسْرَى."],["مَنًّا","تَمُنُّونَ عَلَيْهِمْ بِإِطْلَاقِ الْأَسْرَى مِنْ غَيْرِ عِوَضٍ."],["فِدَاءً","تَطْلُبُونَ مِنْهُمْ فِدْيَةً تُخَلِّصُهُمْ مِنَ الْأَسْرِ."],["حَتَّى تَضَعَ الْحَرْبُ أَوْزَارَهَا","أَثْقَالَهَا؛ وَالْمُرَادُ: حَتَّى تَنْتَهِيَ الْحَرْبُ."],["لِيَبْلُوَ","لِيَخْتَبِرَ."],["يُضِلَّ أَعْمَالَهُمْ","يُبْطِلَ ثَوَابَ أَعْمَالِهِمْ."]],"5":[["بالَهُمْ","شَأْنَهُمْ فِي الدُّنْيَا وَالْآخِرَةِ."]],"6":[["عَرَّفَهَا لَهُمْ","بَيَّنَهَا لَهُمْ؛ فَيَهْتَدُونَ إِلَى مَسَاكِنِهِمْ فِيهَا مِنْ غَيْرِ اسْتِدْلَالٍ."]],"7":[["وَيُثَبِّتْ أَقْدَامَكُمْ","يُثَبِّتْكُمْ عِنْدَ الْقِتَالِ، وَيُقَوِّ قُلُوبَكُمْ."]],"8":[["وَأَضَلَّ أَعْمَالَهُمْ","أَذْهَبَ ثَوَابَ أَعْمَالِهِمْ."]],"9":[["فَأَحْبَطَ أَعْمَالَهُمْ","أَبْطَلَ أَعْمَالَهُمْ."]],"10":[["أَمْثَالُهَا","عُقُوبَاتٌ مُمَاثِلَةٌ."]],"11":[["مَوْلَىً","وَلِيٌّ، وَنَاصِرٌ."]],"12":[["مَثْوَىً","مَأْوَىً، وَمَسْكَنٌ."]],"13":[["وَكَأَيِّنْ مِنْ قَرْيَةٍ","كَثِيرٍ مِنَ الْقُرَى."]],"15":[["مَثَلُ","صِفَةُ."],["غَيْرِ آسِنٍ","غَيْرِ مُتَغَيِّرٍ، وَلَا مُنْتِنٍ."],["حَمِيمًا","بَالِغِ الْغَايَةِ فِي الْحَرَارَةِ."]],"16":[["وَمِنْهُمْ","مِنَ الْمُنَافِقِينَ."],["آنِفًا","الْآنَ."]],"18":[["جَاءَ أَشْرَاطُهَا","ظَهَرَتْ عَلَامَاتُهَا."],["فَأَنَّىٰ","مِنْ أَيْنَ لَهُمْ؟!"],["ذِكْرَاهُمْ","تَذَكُّرُهُمْ."]],"19":[["مُتَقَلَّبَكُمْ","تَصَرُّفَكُمْ فِي يَقَظَتِكُمْ نَهَارًا."],["وَمَثْوَاكُمْ","مُسْتَقَرَّكُمْ فِي نَوْمِكُمْ لَيْلًا."]],"20":[["مَرَضٌ","شَكٌّ، وَنِفَاقٌ."],["الْمَغْشِيِّ عَلَيْهِ","الْمُغْمَى عَلَيْهِ مِنْ شِدَّةِ الْخَوْفِ."]],"21":[["عَزْمُ الْأَمْرِ","وَجَبَ الْقِتَالُ."]],"22":[["فَهَلْ عَسِيتُمْ","لَعَلَّكُمْ."],["تَوَلَّيْتُمْ","أَعْرَضْتُمْ عَنِ الْإِيمَانِ."]],"24":[["أَمْ","بَلْ."],["أَقْفَالُهَا","مُغْلَقَةٌ؛ فَلَا تَفْهَمُ الْقُرْآنَ."]],"25":[["ارْتَدُّوا عَلَىٰ أَدْبَارِهِمْ","رَجَعُوا كُفَّارًا."],["سَوَّلَ لَهُمْ","زَيَّنَ لَهُمْ خَطَايَاهُمْ."],["وَأَمْلَىٰ لَهُمْ","مَدَّ لَهُمْ فِي الْأَمَلِ."]],"26":[["لِلَّذِينَ كَرِهُوا","هُمُ الْيَهُودُ."],["إِسْرَارَهُمْ","مَا يُخْفُونَهُ، وَيُسِرُّونَهُ."]],"28":[["فَأَحْبَطَ أَعْمَالَهُمْ","أَبْطَلَ ثَوَابَ أَعْمَالِهِمْ."]],"29":[["أَمْ حَسِبَ","بَلْ ظَنَّ."],["مَرَضٌ","نِفَاقٌ، وَشَكٌّ."],["أَضْغَانَهُمْ","أَحْقَادَهُمْ."]]}