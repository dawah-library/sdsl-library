{"1":[["ذَاتِ الْبُرُوجِ","ذَاتِ الْمَنَازِلِ الَّتِي تَمُرُّ بِهَا الشَّمْسُ، وَالْقَمَرُ."]],"2":[["وَالْيَوْمِ الْمَوْعُودِ","هُوَ: يَوْمُ الْقِيَامَةِ."]],"3":[["وَشَاهِدٍ وَمَشْهُودٍ","أَقْسَمَ اللهُ بِكُلِّ شَاهِدٍ يَشْهَدُ، وَبِكُلِّ مَنْ يُشْهَدُ عَلَيْهِ."]],"4":[["قُتِلَ","لُعِنَ، وَعُذِّبَ، وَهَلَكَ."],["أَصْحَابِ الْأُخْدُودِ","الَّذِينَ شَقُّوا فِي الْأَرْضِ شَقًّا عَظِيمًا؛ لِإِحْرَاقِ الْمُؤْمِنِينَ."]],"5":[["الْوَقُودِ","مَا تُشْعَرُ وَتُوقَدُ بِهِ النَّارُ."]],"7":[["شُهُودٌ","حُضُورٌ."]],"10":[["فَتَنُوا","حَرَّقُوا بِالنَّارِ."],["عَذَابُ الْحَرِيقِ","الْعَذَابُ الْمُحْرِقُ."]],"12":[["بَطْشُ","انْتِقَامٌ."]],"13":[["يُبْدِئُ","يَخْلُقُ الْخَلْقَ ابْتِدَاءً."],["وَيُعِيدُ","يُحْيِيهِمْ بَعْدَ مَوْتِهِمْ."]],"14":[["الْوَدُودُ","الْمُحِبُّ لِأَوْلِيَائِهِ، الْمَحْبُوبُ لَهُمْ."]],"15":[["الْمَجِيدُ","الْعَظِيمُ."]]}