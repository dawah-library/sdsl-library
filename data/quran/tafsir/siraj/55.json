{"5":[["بِحُسْبَانٍ","يَجْرِيَانِ مُتَعَاقِبَيْنِ، بِحِسَابٍ مُتْقَنٍ لَا يَضْطَرِبُ."]],"6":[["وَالنَّجْمُ","الكَوْكَبُ فِي السَّمَاءِ."]],"7":[["وَوَضَعَ الْمِيزَانَ","وَضَعَ فِي الأَرْضِ العَدْلَ."]],"8":[["أَلَّا تَطْغَوْا","لِئَلَّا تَعْتَدُوا، وَتَخُونُوا."]],"9":[["بِالْقِسْطِ","بِالعَدْلِ."],["وَلَا تُخْسِرُوا","وَلَا تَنْقُصُوا."]],"10":[["وَوَضَعَهَا لِلْأَنَامِ","مَهَدَهَا؛ لِيَسْتَقِرَّ عَلَيْهَا الخَلْقُ."]],"11":[["الْأَكْمَامِ","الأَوْعِيَةِ الَّتِي يَكُونُ مِنْهَا التَّمْرُ."]],"12":[["وَالْحَبُّ ذُو الْعَصْفِ","وَفِيهَا الحَبُّ ذُو القِشْرِ وَالتِّبْنِ؛ رِزْقًا لَكُمْ وَلِأَنْعَامِكُمْ."],["وَالرَّيْحَانُ","كُلُّ نَبْتٍ طَيِّبِ الرَّائِحَةِ."]],"14":[["الْإِنسَانُ","آدَمُ ﷺ."],["صَلْصَالٍ","طِينٍ يَابِسٍ يُسْمَعُ لَهُ صَلْصَلَةٌ."],["كَالْفَخَّارِ","هُوَ الطِّينُ الَّذِي يُطْبَخُ لِيَتَحَجَّرَ."]],"15":[["الْجَانَّ","إِبْلِيسُ."],["مَارِجٍ مِّن نَّارٍ","لَهَبِ النَّارِ المُخْتَلِطِ بَعْضُهُ بِبَعْضٍ."]],"16":[["فَبِأَيِّ آلَاءِ رَبِّكُمَا","نِعَمِ رَبِّكُمَا."],["تُكَذِّبَانِ","يَا مَعْشَرَ الإِنْسِ وَالجِنِّ."]],"17":[["الْمَشْرِقَيْنِ","مَشْرِقِ الشَّمْسِ؛ فِي الشِّتَاءِ، وَالصَّيْفِ."],["الْمَغْرِبَيْنِ","مَغْرِبِ الشَّمْسِ؛ فِي الشِّتَاءِ، وَالصَّيْفِ."]],"19":[["مَرَجَ الْبَحْرَيْنِ","خَلَطَ مَاءَ البَحْرَيْنِ: العَذْبَ، وَالمَالِحَ."]],"20":[["بَرْزَخٌ","حَاجِزٌ."],["لَا يَبْغِيَانِ","لَا يَطْغَى أَحَدُهُمَا عَلَى الآخَرِ، وَيَذْهَبُ بِخَصَائِصِهِ."]],"24":[["الْجوَارِ","السُّفُنُ الجَارِيَةُ الضَّخْمَةُ."],["الْمُنشَآتُ","المَرْفُوعَاتُ الأَشْرِعَةِ."],["كَالْأَعْلَامِ","كَالجِبَالِ فِي عِظَمِهَا."]],"26":[["فَانٍ","هَالِكٌ."]],"27":[["ذُو الْجَلَالِ","صَاحِبُ العَظَمَةِ، وَالكِبْرِيَاءِ."],["وَالْإِكْرَامِ","الفَضْلِ، وَالجُودِ."]],"29":[["فِي شَأْنٍ","أَيْ: أَمْرٍ فَيُعِزُّ وَيُذِلُّ، وَيُعْطِي وَيَمْنَعُ، وَيُحْيِي وَيُمِيتُ."]],"33":[["تَنفُذُوا","تَجِدُونَ مَنْفَذًا تَهْرُبُونَ مِنْهُ."],["أَقْطَارِ","نَوَاحِي."],["فَانفُذُوا","اهْرُبُوا (أَمْرُ تَعْجِيزٍ)."],["بِسُلْطَانٍ","بِقُوَّةٍ، وَكَمَالِ قُدْرَةٍ."]],"35":[["شُوَاظٌ","لَهَبٌ خَالِصٌ."],["وَنُحَاسٌ","نُحَاسٌ مُذَابٌ، يُصَبُّ عَلَى رُؤُوسِكُمْ، أَوْ دُخَانٌ لَا لَهَبَ فِيهِ."],["فَلَا تَنْتَصِرَانِ","فَلَا يَنْصُرُ بَعْضُكُمْ بَعْضًا."]],"37":[["وَرْدَةً","حَمْرَاءَ كَلَوْنِ الوَرْدِ."],["كَالدِّهَانِ","كالزَّيْتِ المُغْلِي، أَوْ كَالجِلْدِ الأَحْمَرِ."]],"41":[["بِسِيمَاهُمْ","بِعَلَامَاتِهِمْ."],["فَيُؤْخَذُ بِالنَّوَاصِي","تَأْخُذُهُمْ مَلَائِكَةُ العَذَابِ بِمُقَدَّمَةِ رُؤُوسِهِمْ، وَأَقْدَامِهِمْ فَتَرْمِيهُمْ فِي النَّارِ."]],"44":[["حَمِيمٍ آنٍ","مَاءٍ حَارٍّ قَدْ بَلَغَ الغَايَةَ فِي الحَرَارَةِ."]],"48":[["أَفْنَانٍ","أَغْصَانٍ كَثِيرَةٍ نَضِرَةٍ."]],"52":[["زَوْجَانِ","صِنْفَانِ."]],"54":[["بَطَائِنُهَا","بِطَانَتُهَا."],["إِسْتَبْرَقٍ","غَلِيظُ الدِّيبَاجِ."],["وَجَنَى","ثَمَرُ."],["دَانٍ","قَرِيبُ القِطَافِ."]],"56":[["قَاصِرَاتُ الطَّرْفِ","قَصَرْنَ أَبْصَارَهُنَّ عَلَى أَزْوَاجِهِنَّ؛ فَلَا يَنْظُرْنَ إِلَى غَيْرِهِمْ."],["يَطْمِثْهُنَّ","يَطَأْهُنَّ."]],"62":[["وَمِن دُونِهِمَا","أَيْ: أَدْنَى مِنَ الجَنَّتَيْنِ السَّابِقَتَيْنِ."]],"64":[["مُدَهَامَّتَانِ","خَضْرَاوَانِ قَدِ اشْتَدَّتْ خُضْرَتُهُمَا حَتَّى مَالَتْ إِلَى السَّوَادِ."]],"66":[["نَضَّاخَتَانِ","فَوَّارَتَانِ بِالمَاءِ؛ لَا تَنْقَطِعَانِ."]],"70":[["خَيْرَاتٌ","زَوْجَاتٌ طَيِّبَاتُ الأَخْلَاقِ."]],"72":[["حُورٌ","نِسَاءُ بِيضٌ حِسَانٌ."],["مَقْصُورَاتٌ","مَسْتُورَاتٌ مَصُونَاتٌ."]],"76":[["رَفْرَفٍ خُضْرٍ","وَسَائِدَ ذَوَاتِ أَغْطِيَةٍ خُضْرٍ."],["وَعَبْقَرِيٍّ","فُرُشٍ، وَبُسُطٍ."]],"78":[["تَبَارَكَ","كَثُرَتْ بَرَكَتُهُ، وَخَيْرُهُ."]]}