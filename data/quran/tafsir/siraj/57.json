{"1":[["سَبَّحَ لِلَّهِ","نَزَّهَ اللَّهَ عَمَّا لَا يَلِيقُ بِهِ جَلَّ جَلَالُهُ."]],"3":[["الْأَوَّلُ","الَّذِي لَيْسَ قَبْلَهُ شَيْءٌ."],["وَالْآخِرُ","الَّذِي لَيْسَ بَعْدَهُ شَيْءٌ."],["وَالظَّاهِرُ","الَّذِي لَيْسَ فَوْقَهُ شَيْءٌ."],["وَالْبَاطِنُ","الَّذِي لَيْسَ دُونَهُ شَيْءٌ."]],"4":[["مَا يَلِجُ","مَا يَدْخُلُ مِنْ مَطَرٍ، وَغَيْرِهِ."],["وَمَا يَخْرُجُ مِنْهَا","مَا يَصْعَدُ إِلَيْهَا مِنَ المَلَائِكَةِ، وَالأَعْمَالِ."],["يُولِجُ","يُدْخِلُ."]],"7":[["وَمَا جَعَلَكُمْ مُسْتَخْلَفِينَ فِيهِ","مِنَ المَالِ الَّذِي جَعَلَكُمْ خُلَفَاءَ فِي التَّصَرُّفِ فِيهِ."]],"10":[["الْفَتْحِ","فَتْحِ مَكَّةَ."],["الْحُسْنَى","الجَنَّةَ."]],"11":[["قَرْضًا حَسَنًا","مُحْتَسِبًا فِي نَفَقَتِهِ بِلَا مَنٍّ، وَلَا أَذًى."]],"13":[["انْظُرُونَا","انْتَظِرُونَا."],["بَاطِنُهُ","مِمَّا يَلِي المُؤْمِنِينَ."],["وَظَاهِرُهُ","مِمَّا يَلِي المُنَافِقِينَ."]],"14":[["فَتَنْتُمْ","أَهْلَكْتُمْ."],["وَتَرَبَّصْتُمْ","تَرَقَّبْتُمْ حُصُولَ النَّوَائِبِ لِلنَّبِيِّ ﷺ، وَالمُؤْمِنِينَ مَعَهُ."],["وَارْتَبْتُمْ","شَكَكْتُمْ فِي البَعْثِ."],["وَغَرَّتْكُمُ الْأَمَانِيُّ","خَدَعَتْكُمُ الأَبَاطِيلُ."],["أَمْرُ اللَّهِ","المَوْتُ."],["الْغَرُورُ","الشَّيْطَانُ."]],"15":[["فِدْيَةٌ","عِوَضٌ لِيُفْتَدَى بِهِ مِنْ عَذَابِ اللَّهِ."],["مَأْوَاكُمْ","مَصِيرُكُمْ."],["مَأْوَاكُمْ","أَوْلَى بِكُمْ."],["الْمَصِيرُ","المَرْجِعُ."]],"16":[["أَلَمْ يَأْنِ","أَلَمْ يَحِنْ وَيَجِيءُ الوَقْتُ؟!"],["تَخْشَعَ","تَخْضَعَ، وَتَرِقَّ، وَتَلِينَ."],["الْأَمَدُ","الزَّمَانُ."]],"18":[["الْمُصَّدِّقِينَ","المُتَصَدِّقِينَ."],["قَرْضًا حَسَنًا","مُحْتَسِبِينَ فِي نَفَقَاتِهِمْ بِلَا مَنٍّ، وَلَا أَذًى."]],"19":[["الصِّدِّيقُونَ","المُبَالِغُونَ فِي التَّصْدِيقِ."],["وَالشُّهَدَاءُ","الَّذِينَ قُتِلُوا فِي سَبِيلِ اللَّهِ."]],"20":[["لَعِبٌ","تَلْعَبُ بِهَا الأَبْدَانُ."],["وَلَهْوٌ","تَلْهُو بِهَا القُلُوبُ."],["الْكُفَّارُ","الزُّرَّاعُ، سُمُّوا بِذَلِكَ؛ لِأَنَّهُمْ يَسْتُرُونَ الحَبَّ فِي التُّرَابِ."],["حُطَامًا","فُتَاتًا مُتَهَشِّمًا."]],"21":[["سَابِقُواْ","سَارِعُوا مُسَارَعَةَ المُتَسَابِقِينَ فِي المِضْمَارِ."]],"22":[["كِتٰبٍ","هُوَ: اللَّوْحُ المَحْفُوظُ."],["نَبْرَأَهَا","نَخْلُقَ هَذِهِ المَخْلُوقَاتِ."]],"23":[["تَأْسَوْاْ","تَحْزَنُوا."],["تَفْرَحُواْ","فَرَحَ بَطَرٍ، وَاخْتِيَالٍ."],["مُخْتَالٍ","مُتَكَبِّرٍ."],["فَخُورٍ","مُتَطَاوِلٍ بِهِ يَفْخَرُ عَلَى النَّاسِ."]],"24":[["الْحَمِيدُ","المَحْمُودُ عَلَى كَمَالِ صِفَاتِهِ، وَجَمِيلِ فِعَالِهِ."]],"25":[["بِالْبَيِّنَاتِ","بِالحُجَجِ الوَاضِحَاتِ."],["وَالْمِيزَانَ","العَدْلَ فِي الأَقْوَالِ، وَالأَفْعَالِ."],["بَأْسٌ","قُوَّةٌ."],["عَزِيزٌ","غَالِبٌ لَا يُغْلَبُ."]],"27":[["وَقَفَّيْنَا عَلَىٰ ءَاثَارِهِمْ","أَتْبَعْنَاهُمْ، وَبَعَثْنَا بَعْدَهُمْ."],["وَرَهْبَانِيَّةً","غَلَوْا فِي التَّعَبُّدِ."],["مَا كَتَبْنٰهَا","مَا فَرَضْنَاهَا."],["ابْتِغَاءَ","فَعَلُوهَا مِنْ عِنْدِ أَنْفُسِهِمْ يَطْلُبُونَ..."],["فَمَا رَعَوْهَا","مَا قَامُوا بِهَا حَقَّ القِيَامِ، بَلْ بَدَّلُوا وَخَالَفُوا."]],"28":[["كِفْلَيْنِ","ضِعْفَيْنِ."]],"29":[["لِئَلَّا يَعْلَمَ","أَعْطَاكُمُ اللَّهُ ذَلِكَ لِأَجْلِ أَنْ يَعْلَمَ."]]}