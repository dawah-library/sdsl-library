{"42":[["إِنَّ الَّذِينَ كَفَرُوا بِالذِّكْرِ","إِنَّ الْجَاحِدِينَ بِالْقُرْآنِ، وَالْخَبَرُ مَحْذُوفٌ، تَقْدِيرُهُ: هَالِكُونَ."],["السَّبِيلُ","المُؤَاخَذَةُ."],["يَبْغُونَ","يَعْتَدُونَ."]],"49":[["لَا يَسْأَمُ","لَا يَمَلُّ."]],"5":[["يَتَفَطَّرْنَ","يَتَشَقَّقْنَ."]],"6":[["أَوْلِيَاءُ","آلِهَةً يَتَوَلَّوْنَهَا، وَيَعْبُدُونَهَا."],["حَفِيظٌ","رَقِيبٌ عَتِيدٌ."]],"7":[["أُمَّ الْقُرَى","مَكَّةُ؛ وَالْمُرَادُ أَهْلُهَا."],["لَا رَيْبَ فِيهِ","لَا شَكَّ فِي مَجِيئِهِ."]],"8":[["أُمَّةً وَاحِدَةً","مُجْتَمِعِينَ عَلَى الْهُدَى."]],"10":[["وَإِلَيْهِ أُنِيبُ","إِلَيْهِ أَرْجِعُ فِي كُلِّ الْأُمُورِ."]],"11":[["فَاطِرُ","خَالِقٌ، وَمُبْدِعٌ."],["وَمِنَ الْأَنْعَامِ أَزْوَاجًا","أَنْوَاعًا؛ ذُكُورًا، وَإِنَاثًا."],["يَذْرَؤُكُمْ فِيهِ","يُكَثِّرُكُمْ؛ بِسَبَبِ التَّزْوِيجِ."]],"12":[["مَقَالِيدُ السَّمَاوَاتِ","مُلْكُهَا، وَمَفَاتِيحُ خَزَائِنِهَا."],["يَبْسُطُ","يُوسِعُ."],["وَيَقْدِرُ","يُضَيِّقُ."]],"13":[["كَبُرَ","عَظُمَ."],["يَجْتَبِي إِلَيْهِ","يَصْطَفِي لِتَوْحِيدِهِ، وَدِينِهِ."],["يُنِيبُ","يَرْجِعُ إِلَيْهِ بِالطَّاعَةِ."]],"14":[["بَغْيًا","عِنَادًا، وَظُلْمًا."],["كَلِمَةٌ سَبَقَتْ","بِتَأْخِيرِ الْعَذَابِ."],["الْكِتَابَ","التَّوْرَاةَ، وَالْإِنْجِيلَ."],["مُرِيبٍ","مَوْقِعٍ فِي الرِّيبَةِ، وَالِاخْتِلَافِ الْمَذْمُومِ."]],"15":[["فَلِذَلِكَ فَادْعُ","قُمْ بِالدَّعْوَةِ إِلَى ذَلِكَ الدِّينِ."],["لَا حُجَّةَ بَيْنَنَا وَبَيْنَكُمْ","لَا جِدَالَ بَيْنَنَا وَبَيْنَكُمْ؛ بَعْدَمَا تَبَيَّنَ الْحَقُّ."],["الْمَصِيرُ","الْمَرْجِعُ."]],"16":[["يُحَاجُّونَ فِي اللَّهِ","يُخَاصِمُونَ فِي دِينِ اللَّهِ."],["دَاحِضَةٌ","ذَاهِبَةٌ بَاطِلَةٌ."]],"17":[["بِالْحَقِّ","بِالصِّدْقِ."],["وَالْمِيزَانَ","الْعَدْلَ."]],"18":[["مُشْفِقُونَ مِنْهَا","خَائِفُونَ مِنْ قِيَامِهَا."],["يُمَارُونَ","يُجَادِلُونَ."]],"20":[["حَرْثَ الْآخِرَةِ","ثَوَابَهَا."]],"21":[["كَلِمَةُ الْفَصْلِ","قَضَاؤُهُ بِإِمْهَالِهِمْ وَعَدَمِ مُعَاجَلَتِهِمْ بِالْعُقُوبَةِ."]],"23":[["إِلَّا الْمَوَدَّةَ فِي الْقُرْبَى","لَا تُؤْذُونِي فِي تَبْلِيغِ الدَّعْوَةِ؛ لِمَا بَيْنِي وَبَيْنَكُمْ مِنَ الْقَرَابَةِ."],["يَقْتَرِفْ حَسَنَةً","يَكْتَسِبْ طَاعَةً."]],"24":[["افْتَرَى","اخْتَلَقَ."],["يَخْتِمْ","يَطْبَعْ."]],"27":[["لَبَغَوْا","لَطَغَوْا وَتَجَبَّرُوا."]],"28":[["وَيُنَشِّرُ رَحْمَتَهُ","يَبْسُطُ مَطَرَهُ."],["الْوَلِيُّ","الَّذِي يَتَوََلَّى عِبَادَهُ بِإِحْسَانِهِ."]],"29":[["بَثَّ","فَرَّقَ، وَنَشَرَ."],["دَابَّةٍ","مَا يَدُبُّ عَلَى الْأَرْضِ؛ مِنْ إِنْسٍ، وَحَيَوَانٍ، وَغَيْرِهِمَا."]],"31":[["بِمُعْجِزِينَ","بِفَائِتِينَ مِنَ الْعَذَابِ."]],"32":[["الْجَوَارِ","السُّفُنُ الْجَارِيَةُ."],["كَالْأَعْلَامِ","كَالْجِبَالِ فِي عِظَمِهَا."]],"33":[["فَيَظْلَلْنَ","يَصِرْنَ وَيَبْقَيْنَ."],["رَوَاكِدَ","ثَوَابِتَ لَا تَجْرِي."]],"34":[["يُوبِقْهُنَّ","يُهْلِكُ السُّفُنَ بِالْغَرَقِ."]],"35":[["مَحِيصٍ","مَهْرَبٌ، وَمَلْجَأٌ."]],"37":[["وَالْفَوَاحِشَ","مَا عَظُمَ قُبْحُهُ مِنَ الْمَعَاصِي."]],"39":[["الْبَغْيُ","الظُّلْمُ، وَالْعُدْوَانُ."],["يَنْتَصِرُونَ","يَنْتَقِمُونَ مِمَّنْ بَغَى عَلَيْهِمْ؛ لِشَجَاعَتِهِمْ، وَلَا يَعْتَدوُنَ."]],"40":[["وَأَصْلَحَ","وَضَعَ عَفْوُهُ فِيمَنْ يُصْلِحُهُ العَفْوُ."]],"41":[["سَبِيلٍ","مُؤَاخَذَةٍ."]],"43":[["عَزْمِ الْأُمُورِ","الأَفْعَالِ الحَمِيدَةِ، وَالخِصَالِ المَشْكُورَةِ."]],"44":[["يُضْلِلِ اللَّهُ","يَصْرِفْهُ عَنِ الهُدَى."],["مَرَدٍّ","مَرْجِعٍ إِلَى الدُّنْيَا."],["سَبِيلٍ","طَرِيقٍ."]],"45":[["خَاشِعِينَ","خَاضِعِينَ مُتَضَائِلِينَ."],["يَنْظُرُونَ مِنْ طَرْفٍ خَفِيٍّ","يُسَارِقُونَ النَّظَرَ، وَلَا يَنْظُرُونَ بِمِلْءِ أَعْيُنِهِمْ."]],"46":[["فَمَا لَهُ مِنْ سَبِيلٍ","مَا لَهُ مِنْ طَرِيقٍ يَصِلُ بِهِ إِلَى الحَقِّ فِي الدُّنْيَا."]],"47":[["لَا مَرَدَّ لَهُ","لَا يُمْكِنُ رَدُّهُ."],["نَكِيرٍ","لَا تُنْكِرُونَ ذُنُوبَكُمْ، وَلَيْسَ لَكُمْ مَكَانُ تَسْتَخْفُونَ وَتَتَنَكَّرُونَ فِيهِ."]],"48":[["حَفِيظاً","حَافِظًا لِأَعْمَالِهِمْ."],["كَفُورٌ","جَحُودٌ؛ يُعَدِّدُ المَصَائِبَ، وَيَنْسَى النِّعَمَ."]],"50":[["يُزَوِّجُهُمْ","يَجْمَعُ لَهُ النَّوْعَيْنِ."],["عَقِيماً","لَا يُولَدُ لَهُ."]],"51":[["وَحْياً","إِعْلَامًا فِي المَنَامِ، أَوْ بِالإِلْهَامِ."],["مِنْ وَرَاءِ حِجَابٍ","كَمَا كَلَّمَ مُوسَى العليَّة"],["رَسُولاً","هُوَ: جِبْرِيلُ اليَّةِ"]],"52":[["رُوحاً","قُرْآنًا، سُمِّيَ القُرْآنُ رُوحًا؛ لِأَنَّهُ حَيَاةُ القُلُوبِ."],["صِرَاطٍ مُسْتَقِيمٍ","هُوَ: الإِسْلَامُ."]],"53":[["تَصِيرُ","تَرْجِعُ إِلَيْهِ، فَيُجَازِيكُمْ عَلَيْهَا."]]}