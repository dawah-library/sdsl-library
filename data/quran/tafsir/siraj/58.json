{"1":[["تُجَادِلُكَ","تُرَاجِعُكَ، وَهِيَ: خَوْلَةُ بِنْتُ ثَعْلَبَةَ."],["زَوْجَهَا","أَوْسُ بْنُ الصَّامِتِ."]],"2":[["يُظَاهِرُونَ","يَقُولُ الرَّجُلُ لِامْرَأَتِهِ: أَنْتِ عَلَيَّ كَظَهْرِ أُمِّي."],["إِنْ أُمَّهَاتُهُمْ","مَا أُمَّهَاتُهُمْ."]],"4":[["يَتَمَاسَّا","يَسْتَمْتِعَا بِالجِمَاعِ."]],"5":[["يُحَادُّونَ","يُشَاقُّونَ وَيُخَالِفُونَ."],["كُبِتُوا","خُذِلُوا، وَأُهِينُوا."]],"8":[["بِمَا لَمْ يُحَيِّكَ بِهِ اللَّهُ","قَالُوا لَكَ: السَّلامُ عَلَيْكُمْ، أَيِ: المَوْتُ لَكَ."],["لَوْلَا","هَلَّا."],["حَسْبُهُمْ","كَافِيهْتُمْ."],["المَصِيرُ","المَرْجِعُ، وَالمَالَ."]],"10":[["إِنَّمَا النَّجْوَى","التَّحَدُّثُ بِخُفْيَةٍ بِالإِثْمِ وَالعُدْوَانِ."]],"11":[["تَفَسَّحُوا","لِيُوَسِّعْ بَعْضُكُمْ لِبَعْضٍ فِي المَجَالِسِ."],["انشُزُواْ","قُومُوا مِنْ مَجَالِسِكُمْ لِأَمْرٍ فِيهِ خَيْرٌ لَكُمْ."]],"14":[["الَّذِينَ تَوَلَّوْا قَوْمًا","المُنَافِقِينَ اتَّخَذُوا اليَهُودَ أَصْدِقَاءَ، وَوَالَوْهُمْ."]],"16":[["جُنَّةً","وِقَايَةً لَهُمْ مِنَ القَتْلِ."]],"18":[["وَيَحْسَبُونَ","يَعْتَقِدُونَ."]],"19":[["اسْتَحْوَذَ","غَلَبَ، وَاسْتَوْلَى."]],"20":[["يُحَادُّونَ","يُخَالِفُونَ، وَيُشَاقُّونَ."],["الْأَذَلِينَ","الأَذِلَّاءِ المَغْلُوبِينَ المُهَانِينَ."]],"21":[["لَأَغْلِبَنَّ","لَأَنْتَصِرَنَّ."],["عَزِيزٌ","غَالِبٌ لَا يُغْلَبُ."]],"22":[["يُوَادُّونَ","يُحِبُّونَ."],["حَادُّوا","عَادَى."],["عَشِيرَتَهُمْ","أَقْرِبَاءَهُمْ."],["وَأَيَّدَهُمْ","قَوَّاهُمْ."],["بِرُوحٍ مِّنْهُ","بِنَصْرٍ، وَتَأْيِيدٍ."]]}