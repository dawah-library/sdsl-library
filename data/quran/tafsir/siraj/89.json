{"1":[["وَالْفَجْرِ","قَسَمٌ بِالوَقْتِ المَعْرُوفِ أَوَّلِ النَّهَارِ."]],"2":[["وَلَيَالٍ عَشْرٍ","قَسَمٌ بِلَيَالِي عَشْرِ ذِي الحِجَّةِ الأُولَى، وَمَا"]],"3":[["وَالشَّفْعِ وَالْوَتْرِ","قَسَمٌ بِكُلِّ زَوْجٍ، وَفَرْدٍ."]],"4":[["يَسْرِ","يَسْرِي بِظَلَامِهِ، وَجَوَابُ القَسَمِ مَحْذُوفٌ،"]],"5":[["لِذِي حِجْرٍ","لِصَاحِبِ عَقْلٍ."]],"7":[["إِرَمَ","قَبِيلَةُ إِرَمَ؛ نِسْبَةً إِلَى جَدِّهِمْ."],["ذَاتِ الْعِمَادِ","صَاحِبَةِ القُوَّةِ، وَالأَبْنِيَةِ المَرْفُوعَةِ عَلَى"]],"9":[["جَابُوا","قَطَعُوا."],["بِالْوَادِ","وَادِي القُرَى شَمَالَ غَرْبِ الجَزِيرَةِ"]],"10":[["ذِي الْأَوْتَادِ","صَاحِبِ الجُنُودِ الَّذِينَ ثَبَّتُوا مُلْكَهُ."]],"11":[["طَغَوْا","تَجَاوَزُوا الحَدَّ فِي الإِفْسَادِ."]],"13":[["سَوْطَ عَذَابٍ","عَذَابًا شَدِيدًا."]],"14":[["لَبِالْمِرْصَادِ","يَرْقُبُ العَاصِينَ، وَيُمْهِلُهُمْ، ثُمَّ يَأْخُذُهُمْ."]],"15":[["ابْتَلَاهُ","اخْتَبَرَهُ بِالنِّعْمَةِ."]],"16":[["فَقَدَرَ","ضَيَّقَ."]],"17":[["الْيَتِيمَ","الَّذِي مَاتَ أَبُوهُ قَبْلَ بُلُوغِهِ."]],"18":[["وَلَا تَحُضُّونَ","لَا يَحُضُّ بَعْضُكُمْ بَعْضًا."]],"19":[["التُّرَاثَ","المِيرَاثَ."],["لَمًّا","شَدِيدًا."]],"20":[["جَمًّا","مُفْرِطًا."]],"21":[["دُكَّتْ","زُلْزِلَتْ."]],"22":[["وَجَاءَ رَبُّكَ","جَاءَ رَبُّكَ لِفَصْلِ القَضَاءِ بَيْنَ العِبَادِ مَجِيئًا"],["وَالْمَلَكُ","المَلَائِكَةُ."]],"23":[["وَأَنَّى لَهُ الذِّكْرَى","لَا يَنْفَعُهُ التَّذَكُّرُ؛ فَقَدْ فَاتَ أَوَانُهُ."]],"26":[["وَلَا يُوثِقُ","لَا يَشُدُّ بِالسَّلَاسِلِ، وَالأَغْلَالِ."],["وَثَاقَهُ","مِثْلَ إِيثَاقِهِ."]]}