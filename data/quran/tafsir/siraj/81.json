{"1":[["كُوِّرَتْ","لُفَّتْ، وَذَهَبَ ضَوْؤُهَا."]],"2":[["انْكَدَرَتْ","تَنَاثَرَتْ، وَذَهَبَ نُورُهَا."]],"3":[["سُيِّرَتْ","أُزِيلَتْ عَنْ وَجْهِ الْأَرْضِ؛ فَصَارَتْ هَبَاءً مَنْثُورًا."]],"4":[["الْعِشَارُ","النُّوقُ الْحَوَامِلُ."]],"5":[["حُشِرَتْ","جُمِعَتْ، وَاخْتَلَطَتْ؛ لِيُقْتَصَّ لِبَعْضِهَا مِنْ بَعْضٍ."]],"6":[["سُجِّرَتْ","مُلِئَتْ حَتَّى خَاضَتْ، فَانْفَجَرَتْ، ثُمَّ اتَّقَدَتْ نِيرَانًا."]],"7":[["زُوِّجَتْ","قُرِنَتْ بِأَمْثَالِهَا وَنَظَائِرِهَا."]],"10":[["الصُّحُفُ","صُحُفُ الْأَعْمَالِ."],["نُشِرَتْ","فُتِحَتْ، وَبُسِطَتْ."]],"11":[["كُشِطَتْ","قُلِعَتْ، وَأُزِيلَتْ."]],"12":[["سُعِّرَتْ","أُوقِدَتْ، فَأُضْرِمَتْ."]],"13":[["أُزْلِفَتْ","قُرِّبَتْ مِنْ أَهْلِهَا."]],"14":[["أَحْضَرَتْ","قَدَّمَتْ مِنْ خَيْرٍ أَوْ شَرٍّ."]],"15":[["فَلَا أُقْسِمُ","أُقْسِمُ، وَ(لَا): لِتَأْكِيدِ الْقَسَمِ."],["بِالْخُنَّسِ","النُّجُومُ الْمُخْتَفِيَةُ أَنْوَارُهَا نَهَارًا."]],"16":[["الْجَوَارِ","النُّجُومُ الْجَارِيَةُ فِي أَفْلَاكِهَا."],["الْكُنَّسِ","النُّجُومُ الْمُسْتَتِرَةُ فِي أَبْرَاجِهَا."]],"17":[["عَسْعَسَ","أَقْبَلَ بِظَلَامِهِ، وَأَدْبَرَ."]],"18":[["تَنَفَّسَ","ظَهَرَ ضِيَاؤُهُ، وَامْتَدَّ."]],"19":[["رَسُولٍ كَرِيمٍ","هُوَ: جِبْرِيلُ عَلَيْهِ السَّلَامُ."]],"20":[["مَكِينٍ","ذِي مَكَانَةٍ رَفِيعَةٍ عِنْدَ اللَّهِ."]],"21":[["ثَمَّ","هُنَاكَ فِي السَّمَاوَاتِ."]],"23":[["وَلَقَدْ رَأَاهُ بِالْأُفُقِ","رَأَى نَبِيُّنَا مُحَمَّدٌ ﷺ جِبْرِيلَ عَلَيْهِ السَّلَامُ فِي الْأُفُقِ عَلَى صُورَتِهِ الَّتِي خُلِقَ عَلَيْهَا."]],"24":[["بِضَنِينٍ","بِبَخِيلٍ فِي تَبْلِيغِ الْوَحْيِ، وَفِي قِرَاءَةٍ: (بِظَنِينٍ)، أَيْ: مُتَّهَمٍ عَلَى الْوَحْيِ."]],"25":[["رَجِيمٍ","مَرْجُومٍ، مَطْرُودٍ مِنْ رَحْمَةِ اللَّهِ."]],"27":[["إِنْ هُوَ إِلَّا","مَا هُوَ."],["لِلْعَالَمِينَ","الْإِنْسُ، وَالْجِنُّ."]],"29":[["رَبُّ الْعَالَمِينَ","رَبُّ الْخَلَائِقِ أَجْمَعِينَ."]]}