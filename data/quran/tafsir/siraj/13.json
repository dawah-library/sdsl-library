{"2":[["اسْتَوَىٰ عَلَى الْعَرْشِ","عَلَا وَارْتَفَعَ وَاسْتَقَرَّ، كَمَا يَلِيقُ بِهِ."]],"3":[["رَوَاسِيَ","جِبَالًا تُثْبِتُ الأَرْضَ."],["يُغْشِي","يُغَطِّي."]],"4":[["قِطَعٌ","بِقَاعٌ مُخْتَلِفَةٌ."],["مُتَجَاوِرَاتٌ","يُجَاوِرُ بَعْضُهَا بَعْضًا؛ مِنْهَا: طَيِّبَةٌ، وَمِنْهَا: سَبْخَةٌ مِلَحَةٌ."],["وَنَخِيلٌ صِنْوَانٌ","مُجْتَمِعَةٌ فِي مَنْبِتٍ وَاحِدٍ."]],"5":[["الْأَغْلِلُ","السَّلَاسِلُ."]],"6":[["الْمَثُلَاتُ","عُقُوبَاتُ أَمْثَالِهِمْ مِنَ المُكَذِّبِينَ."]],"8":[["تَغِيضُ الْأَرْحَامُ","تَنْقُصُهُ الأَرْحَامُ؛ فَيَسْقُطُ قَبْلَ تَمَامِهِ."]],"9":[["الْمُتَعَالِ","العَالِي بِذَاتِهِ وَقَدْرِهِ وَقَهْرِهِ."]],"10":[["وَسَارِبٌ","مَنْ جَهَرَ بِأَعْمَالِهِ."]],"11":[["مُعَقِّبَاتٌ","مَلَائِكَةٌ يَتَعَاقَبُونَ عَلَى الإِنْسَانِ لِحِفْظِهِ، وَإِحْصَاءِ عَمَلِهِ."],["مِنْ وَالٍ","وَلِيٌّ يَتَوََلَّى أُمُورَهُمْ، وَيَدْفَعُ البَلَاءَ عَنْهُمْ."]],"13":[["الْمِحَالِ","الحَوْلِ، وَالقُوَّةِ، وَالبَطْشِ."]],"15":[["بِالْغُدُوِّ","أَوَّلِ النَّهَارِ."],["وَالْآصَالِ","آخِرِ النَّهَارِ."]],"17":[["بِقَدَرِهَا","بِقَدْرِ صِغَرِ الأَوْدِيَةِ وَكِبَرِهَا."],["زَبَداً","غُثَاءً لَا نَفْعَ فِيهِ."],["رَابِياً","مُرْتَفِعًا."],["جُفَاءً","مُتَلَاشِيًا لَا بَقَاءَ لَهُ، أَوْ يُرْمَى بِهِ؛ إِذْ لَا فَائِدَةَ مِنْهُ."]],"18":[["الْحُسْنَىٰ","الجَنَّةُ."],["الْمِهَادُ","الفِرَاشُ، وَالمُسْتَقَرُّ."]],"19":[["الْأَلْبَابِ","العُقُولُ."]],"20":[["الْمِيثَاقَ","العَهْدَ المُؤَكَّدَ."]],"22":[["وَيَدْرَءُونَ","يَدْفَعُونَ."],["عُقْبَى الدَّارِ","العَاقِبَةُ المَحْمُودَةُ فِي الآخِرَةِ."]],"26":[["وَيَقْدِرُ","يُضَيِّقُ."],["مَتَاعٌ","شَيْءٌ قَلِيلٌ يَتَمَتَّعُ بِهِ سُرْعَانَ مَا يَزُولُ."]],"29":[["طُوبَىٰ لَهُمْ","فَرَجٌ، وَقُرَّةُ عَيْنٍ، وَحَالٌ طَيِّبَةٌ."]],"31":[["يَأْيَسْ","يَعْلَمْ وَيَتَبَيَّنْ."],["قَارِعَةٌ","مُصِيبَةٌ."]],"32":[["فَأَمْلَيْتُ","أَمْهَلْتُ."]],"35":[["أُكُلُهَا","ثَمَرُهَا."],["عُقْبَىٰ","عَاقِبَةُ."]],"36":[["الْأَحْزَابِ","المُتَحَزِّبِينَ، المُتَجَمِّعِينَ عَلَى الكُفْرِ."]],"39":[["أُمُّ الْكِتَابِ","اللَّوْحُ المَحْفُوظُ."]],"41":[["نَنْقُصُهَا مِنْ أَطْرَافِهَا","بِفَتْحِ المُسْلِمِينَ بِلَادَ المُشْرِكِينَ."],["لَا مُعَقِّبَ","لَا رَادَّ، وَلَا مُبْطِلَ."]]}