{"2":[["لَا يُفْتَنُونَ","لَا يُخْتَبَرُونَ بِالشَّدَائِدِ؛ لِيَتَبَيَّنَ المُؤْمِنُ مِنَ المُنَافِقِ."]],"4":[["يَسْبِقُونَا","يُعْجِزُونَا، وَيَفُوتُونَا بِأَنْفُسِهِمْ."]],"5":[["أَجَلُ اللَّهِ","الوَقْتُ اللَّذِي حَدَّدَهُ اللَّهُ لِلْبَعْثِ."]],"10":[["فِتْنَةُ النَّاسِ","عَذَابُ النَّاسِ لَهُ، وَأَذَاهُمْ."]],"12":[["سَبِيلَنَا","دِينَنَا."]],"13":[["يَفْتَرُونَ","يَخْتَلِقُونَ مِنَ الكَذِبِ."]],"17":[["وَتَخْلُقُونَ إِفْكًا","تَفْتَرُونَ كَذِبًا."],["فَابْتَغُوا","الْتَمِسُوا وَاُطْلُبُوا."]],"20":[["بَدَأَ الْخَلْقَ","أَنْشَأَهُ."]],"21":[["تُقْلَبُونَ","تُرَدُّونَ، وَتُرْجَعُونَ."]],"22":[["بِمُعْجِزِينَ","فَائِتِينَ مِنْ عَذَابِهِ بِالهَرَبِ وَغَيْرِهِ."]],"25":[["مَوَدَّةَ بَيْنِكُمْ","تَتَحَابُّونَ عَلَى عِبَادَتِهَا، وَتَتَوَادُّونَ عَلَى خِدْمَتِهَا."],["يَكْفُرُ","يَتَبَرَّأُ."],["وَمَا لَكُمْ","مَصِيرُكُمْ."]],"26":[["مُهَاجِرٌ","تَارِكٌ دَارَ قَوْمِي إِلَى أَرْضِ الشَّامِ المُبَارَكَةِ."]],"27":[["أَجْرَهُ فِي الدُّنْيَا","بِالذِّكْرِ الحَسَنِ، وَالوَلَدِ الصَّالِحِ وَالنُّبُوَّةِ فِي ذُرِّيَّتِهِ."]],"29":[["وَتَقْطَعُونَ السَّبِيلَ","تَقْطَعُونَ طُرُقَ المُسَافِرِينَ بِفِعْلِكُمُ الفَاحِشَةَ بِهِمْ."],["نَادِيكُمْ","مَجْلِسُكُمُ الَّذِي تَجْتَمِعُونَ فِيهِ."],["الْمُنْكَرَ","الأَعْمَالَ المُنْكَرَةَ؛ كَالسُّخْرِيَةِ مِنَ النَّاسِ، وَقَذْفِ المَارَّةِ."]],"31":[["بِالْبُشْرَى","بِالخَبَرِ السَّارِّ، وَهُوَ: البِشَارَةُ بِإِسْحَاقَ."]],"32":[["الْغَابِرِينَ","البَاقِينَ فِي العَذَابِ."]],"33":[["سِيءَ بِهِمْ","سَاءَهُ مَجِيئُهُمْ خَوْفًا عَلَيْهِمْ مِنْ قَوْمِهِ أَنْ يَفْعَلُوا بِهِمُ الفَاحِشَةَ."],["وَضَاقَ بِهِمْ ذَرْعًا","ضَاقَ صَدْرُهُ، وَحَزِنَ خَوْفًا عَلَيْهِمْ."]],"34":[["رِجْزًا","عَذَابًا شَدِيدًا."]],"35":[["تَرَكْنَا مِنْهَا","أَبْقَيْنَا مِنْ دِيَارِهِمْ."],["آيَةً بَيِّنَةً","آثَارًا وَاضِحَةً."]],"36":[["وَارْجُوا الْيَوْمَ الْآخِرَ","اُطْلُبُوا بِعِبَادَتِكُمْ جَزَاءَ الآخِرَةِ."],["وَلَا تَعْثَوْا","لَا تُكْثِرُوا الفَسَادَ."]],"37":[["الرَّجْفَةُ","الزُّلْزَلَةُ الشَّدِيدَةُ."],["جَاثِمِينَ","صَرْعَى هَالِكِينَ."]],"38":[["مُسْتَبْصِرِينَ","عَارِفِينَ بِكُفْرِهِمْ مُعْجَبِينَ بِهِ."]],"39":[["وَمَا كَانُوا سَابِقِينَ","فَائِتِينَ مِنْ عَذَابِ اللَّهِ."]],"40":[["أَخَذْنَا بِذَنْبِهِ","أَخَذْنَا المَذْكُورِينَ بِعَذَابِنَا بِسَبَبِ ذُنُوبِهِمْ."],["حَاصِبًا","حِجَارَةً مِنْ طِينٍ مَنْضُودٍ."],["الصَّيْحَةُ","صَوْتٌ مِنَ السَّمَاءِ مُهْلِكٌ."]],"41":[["أَوْهَنُ","أَضْعَفُ."]],"43":[["وَمَا يَعْقِلُهَا","يَتَدَبَّرُهَا، وَيَفْهَمُهَا."]],"45":[["أَكْبَرُ","أَعْظَمُ وَأَفْضَلُ مِنْ كُلِّ شَيْءٍ."]],"46":[["ظَلَمُوا مِنْهُمْ","عَانَدُوا الحَقَّ، وَأَعْلَنُوا الحَرْبَ."],["مُسْلِمُونَ","خَاضِعُونَ مُتَذَلِّلُونَ بِالطَّاعَةِ."]],"47":[["وَمِنْ هَؤُلَاءِ","العَرَبِ مِنْ قُرَيْشٍ."]],"50":[["لَوْلَا","هَلَّا."]],"53":[["أَجَلٍ مُّسَمًّى","وَقْتُ عَذَابِهِمُ المُقَدَّرُ عِنْدَ اللَّهِ."],["بَغْتَةً","فَجْأَةً."]],"55":[["يَغْشَاهُمُ","يُحِيطُ بِهِمْ وَيَعْلُوهُمْ."]],"58":[["لَنُبَوِّئَنَّهُمْ","لَنُنْزِلَنَّهُمْ."],["غُرَفًا","مَنَازِلَ عَالِيَةً."]],"60":[["وَكَأَيِّن مِّن","وَكَمْ مِنْ؟"],["لَا تَحْمِلُ رِزْقَهَا","لَا تَدَّخِرُهُ لِغَدٍ."]],"61":[["فَأَنَّى يُؤْفَكُونَ","فَكَيْفَ يُصْرَفُونَ عَنِ الإِيمَانِ؟"]],"62":[["يَبْسُطُ","يُوَسِّعُ."],["وَيَقْدِرُ","يُضَيِّقُ."]],"64":[["الْحَيَوَانُ","الحَيَاةُ الحَقِيقِيَّةُ الكَامِلَةُ الدَّائِمَةُ."]],"65":[["الْفُلْكِ","السُّفُنِ."]],"67":[["وَيَتَخَطَّفُ النَّاسُ","يُسْتَلَبُونَ بِسُرْعَةٍ قَتْلًا وَأَسْرًا."]],"68":[["مَثْوَىً","مَسْكَنٌ وَمُسْتَقَرٌّ."]]}