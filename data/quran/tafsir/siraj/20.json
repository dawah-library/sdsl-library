ِنْ أَثَرِ حَافِرِ فَرَسِ جِبْرِيلَ عليه السلام."],["فَنَبَذْتُهَا","أَلْقَيْتُهَا عَلَى الحُلِيِّ."],["سَوَّلَتْ","زَيَّنَتْ."]],"97":[["لَا مِسَاسَ","أَيْ: تَكُونُ مَنْبُوذًا؛ تَقُولُ لِكُلِّ وَاحِدٍ: لَا أَمْسَكُ، وَلَا تَمَسَّنِي."],["ظَلْتَ","أَقَمْتَ."]],"99":[["مِن لُّدُنَّا","مِنْ عِنْدِنَا."]],"100":[["وِزْراً","إثْمًا عَظِيمًا."]],"102":[["الصُّورِ","القَرْنِ الَّذِي يَنْفُخُ فِيهِ إِسْرَافِيلُ عليه السلام."],["وَنَحْشُرُ","نَسُوقُ."],["زُرْقاً","زُرْقَ العُيُونِ مَعَ سَوَادِ وُجُوهِهِمْ."]],"103":[["يَتَخَافَتُونَ","يَتَسَارُّونَ، وَيَتَهَامَسُونَ."]],"104":[["أَمْثَلُهُمْ طَرِيقَةً","أَعْلَمُهُمْ، وَأَوْفَاهُمْ عَقْلًا."]],"105":[["يُسِيفُهَا","يُزِيلُهَا عَنْ أَمَاكِنِهَا."],["نَسْفاً","يَجْعَلُهَا هَبَاءً مَبْثُوثاً."]],"106":[["فَيَذَرُهَا","فَيَتْرُكُهَا."],["قَاعاً","أَرْضاً مَلْسَاءَ لَا نَبَاتَ بِهَا."],["صَفْصَفاً","مُسْتَوِيَةً."]],"107":[["عِوَجاً","انْخِفَاضاً."],["أَمْتاً","ارْتِفَاعاً."]],"108":[["لَا يَعْوِجُ لَهُ","لَا مَحِيدَ عَنْ دَعْوَةِ الدَّاعِي."],["وَخَشَعَتِ","سَكَنَتْ خُضُوعاً."]],"111":[["وَعَنَتِ","خَضَعَتْ، وَذَلَّتْ."],["الْقَيُّومُ","الْقَائِمُ عَلَى شُؤُونِ خَلْقِهِ."]],"112":[["ظُلْماً","زِيَادَةً فِي سَيِّئَاتِهِ."],["هَضْماً","نَقْصاً مِنْ حَسَنَاتِهِ."]],"113":[["وَصَرَّفْنَا","فَصَّلْنَا فِيهِ أَنْوَاعاً مِنَ الْوَعِيدِ."],["ذِكْراً","تَذْكِرَةً، وَعِظَةً."]],"114":[["فَتَعَالَى","فَتَنَزَّهَ، وَارْتَفَعَ، وَتَقَدَّسَ عَنْ كُلِّ نَقْصٍ."]],"115":[["عَهِدْنَا","وَصَيْنَا."],["عَزْماً","حِفْظاً لِمَا أُمِرَ بِهِ."]],"118":[["وَلَا تَعْرَى","لَا يُصِيبُكَ الْعُرِيُّ."]],"119":[["وَلَا تَضْحَى","لَا يُصِيبُكَ حَرُّ الشَّمْسِ."]],"120":[["لَا يَبْلَى","لَا يَنْقَضِي، وَلَا يَنْقَطِعُ."]],"121":[["وَطَفِقَا","أَخَذَا."],["يَخْصِفَانِ","يُلْصِقَانِ."]],"124":[["ضَنْكاً","ضَيِّقَةً شَاقَّةً."]],"128":[["الْقُرُونُ","الْأُمَمِ الْمُكَذِّبَةِ."],["لِأُولِي النُّهَى","لِذَوِي الْعُقُولِ."]],"129":[["لَكَانَ لِزَاماً","لَكَانَ الْهَلَاكُ عَاجِلاً لَازِماً."]],"130":[["آنَاءِ","سَاعَاتٍ."]],"131":[["وَلَا تَمُدَّنَّ","لَا تَنْظُرْ، 