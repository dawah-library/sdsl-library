{"5":[["اسْتَوَى","ارْتَفَعَ، وَعَلَا عَلَى الْعَرْشِ، اسْتِوَاءً يَلِيقُ بِجَلَالِهِ وَعَظَمَتِهِ."]],"6":[["الثَّرَى","التُّرَابُ النَّدِيُّ؛ وَالْمُرَادُ: الْأَرْضُونَ السَّبْعُ؛ لِأَنَّهَا تَحْتَهُ."]],"10":[["بِقَبَسٍ","بِشُعْلَةٍ تَسْتَدْفِئُونَ بِهَا."],["هُدًى","هَادِيًا يَدُلُّنَا الطَّرِيقَ."]],"12":[["الْمُقَدَّسِ","الْمُبَارَكِ الْمُطَهَّرِ."]],"14":[["لِذِكْرِي","لِتَذْكُرَنِي فِيهَا."]],"15":[["أَكَادُ أُخْفِيهَا","أَقْرَبُ أَنْ أَسْتُرَهَا مِنْ نَفْسِي."]],"16":[["فَتَرْدَى","فَتَهْلِكَ."]],"18":[["أَتَوَكَّؤُا عَلَيْهَا","أَعْتَمِدُ عَلَيْهَا فِي الْمَشْيِ."],["وَأَهُشُّ بِهَا عَلَى غَنَمِي","أَهُزُّ بِهَا الشَّجَرَ؛ لِتَرْعَى غَنَمِي مَا يَتَسَاقَطُ مِنْ وَرَقِهِ."],["مَآرِبُ","مَنَافِعُ، وَحَاجَاتٌ."]],"20":[["تَسْعَىٰ","تَمْشِي بِسُرْعَةٍ وَخِفَّةٍ."]],"21":[["سِيرَتَهَا","حَالَتَهَا."]],"22":[["جَنَاحَكَ","جَنْبِكَ تَحْتَ العُضُدِ."],["سُوءٍ","بَرَصٍ."]],"31":[["أَشُدُّدْ بِهِۦ أَزْرِي","قَوِّنِي بِهِ، وَشُدَّ بِهِ ظَهْرِي."]],"32":[["أَمْرِي","النُّبُوَّةَ."]],"39":[["اليَمِّ","نَهْرِ النِّيلِ."]],"40":[["يَكْفُلُهُۥ","يُرَبِّيهِ، وَيَرْضَعُهُ."],["تَقَرَّ عَيْنُهَا","تَطْيِبُ نَفْسُهَا."],["وَفَتَنَّاكَ فُتُوناً","ابْتَلَيْنَاكَ ابْتِلَاءً."],["عَلَى قَدَرٍ","عَلَى وَفْقِ الوَقْتِ المُقَدَّرِ لِإِرْسَالِكَ."]],"41":[["وَاصْطَنَعْتُكَ لِنَفْسِي","اصْطَفَيْتُكَ لِرِسَالَتِي."]],"42":[["وَلَا تَنِيَا","لَا تَفْتُرَا وَلَا تَضْعُفَا."]],"45":[["يَفْرُطَ عَلَيْنَا","يُعَاجِلَنَا بِالعُقُوبَةِ."]],"50":[["خَلْقَهُۥ","صُورَتَهُ اللَّائِقَةَ بِخَاصَّتِهِ وَمَنْفَعَتِهِ."]],"51":[["القُرُونِ الأُولَى","الأُمَمِ المَاضِيَةِ."]],"53":[["مَهْداً","مَيْسَرَةً لِلِانْتِفَاعِ بِهَا."],["سُبُلاً","طُرُقاً."],["أَزْوَاجاً","أَنْوَاعاً مُخْتَلِفَةً."]],"54":[["لِأُولِي النُّهَىٰ","لِذَوِي العُقُولِ السَّلِيمَةِ."]],"58":[["سُوًى","مُسْتَوِياً مُعْتَدِلًا."]],"59":[["يَوْمَ الزِّينَةِ","يَوْمُ العِيدِ."],["يُحْشَرُ","يُجْمَعُ."]],"60":[["كَيْدُهُۥ","المُرَادُ: سَحَرَتُهُ الَّذِينَ يَكِيدُ بِهِمْ."]],"61":[["لَا تَفْتَرُوا","لَا تَخْتَلِقُوا."],["فَيُسْحِتَكُم","ف