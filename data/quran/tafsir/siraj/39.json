{"2":[["مُخْلِصًا لَهُ الدِّينَ","مُوَحِّدًا لَهُ الْعِبَادَةَ وَالطَّاعَةَ."]],"3":[["الدِّينُ الْخَالِصُ","الطَّاعَةُ التَّامَّةُ السَّالِمَةُ مِنَ الشِّرْكِ."],["زُلْفَى","تَقَرُّبًا."]],"4":[["لَاصْطَفَى","لَاخْتَارَ."]],"5":[["يُكَوِّرُ","يُدْخِلُ."],["وَسَخَّرَ","ذَلَّلَ."],["الْعَزِيزُ","الْغَالِبُ عَلَى أَمْرِهِ، الْمُنْتَقِمُ مِنْ أَعْدَائِهِ."]],"6":[["ثَمَانِيَةَ أَزْوَاجٍ","ثَمَانِيَةَ أَنْوَاعٍ ذُكُورًا وَإِنَاثًا؛ مِنَ الْإِبِلِ وَالْبَقَرِ وَالضَّأْنِ وَالْمَعْزِ."],["خَلْقًا مِنْ بَعْدِ خَلْقٍ","طَوْرًا مِنْ بَعْدِ طَوْرٍ."],["فِي ظُلُمَاتٍ ثَلَاثٍ","ظُلْمَةِ الْبَطْنِ، وَالرَّحِمِ، وَالْمَشِيمَةِ."],["فَأَنَّى تُصْرَفُونَ","كَيْفَ تُعْدَلُونَ عَنْ عِبَادَتِكَ؟!"]],"7":[["وَلَا تَزِرُ وَازِرَةٌ","لَا تَحْمِلُ نَفْسٌ آثِمَةٌ."],["وِزْرَ أُخْرَى","إِثْمَ نَفْسٍ أُخْرَى."]],"8":[["مُنِيبًا إِلَيْهِ","رَاجِعًا إِلَيْهِ، مُسْتَغِيثًا بِهِ."],["خَوَّلَهُ","أَعْطَاهُ وَمَنَحَهُ."],["أَنْدَادًا","شُرَكَاءَ، وَأَمْثَالًا."]],"9":[["قَانِتٌ","مُطِيعٌ خَاضِعٌ لِلَّهِ."],["آنَاءَ اللَّيْلِ","سَاعَاتِ اللَّيْلِ."],["أُولُوا الْأَلْبَابِ","أَصْحَابُ الْعُقُولِ السَّدِيدَةِ."]],"10":[["يُوَفَّى","يُعْطَى وَافِيًا."],["بِغَيْرِ حِسَابٍ","لَا يُحَاسَبُونَ، أَوْ لَا نِهَايَةَ لِمَا يُعْطَوْنَ."]],"16":[["ظُلَلٌ مِنَ النَّارِ","أَطْبَاقٌ مِنْ عَذَابِ النَّارِ كَهَيْئَةِ الظُّلَلِ الْمَبْنِيَّةِ."]],"17":[["الطَّاغُوتَ","الْمَعْبُودَاتِ مِنْ دُونِ اللَّهِ؛ مِنَ الْأَوْثَانِ وَالشَّيَاطِينِ."],["وَأَنَابُوا","رَجَعُوا إِلَى اللَّهِ بِالتَّوْبَةِ، وَالطَّاعَةِ."],["الْبُشْرَى","الذِّكْرُ الْحَسَنُ، وَالتَّوْفِيقُ فِي الدُّنْيَا، وَالْجَنَّةُ فِي الْآخِرَةِ."]],"18":[["أُولُوا الْأَلْبَابِ","أَصْحَابُ الْعُقُولِ السَّدِيدَةِ."]],"20":[["غُرَفٌ","مَنَازِلُ رَفِيعَةٌ عَالِيَةٌ فِي الْجَنَّةِ."]],"21":[["فَسَلَكَهُ يَنَابِيعَ","أَدْخَلَهُ فِي عُيُونٍ وَمَجَارٍ."],["يَهِيجُ","يَيْبَسُ."],["حُطَامًا","مُتَكَسِّرًا مُتَفَتَّتًا."],["لِأُولِي الْأَلْبَابِ","لِأَصْحَابِ الْعُقُولِ السَّلِيمَةِ."]],"22":[["فَوَيْلٌ","هَلَاكٌ، وَحَسْرَةٌ."]],"23":[["مُتَشَابِهًا","يُشْبِهُ بَعْضُهُ بَعْضًا فِي الْحُسْنِ وَالْإِحْكَامِ."],["مَثَانِيَ","تُثَنَّى وَتُكَرَّرُ فِيهِ الْأَحْكَامُ وَالْقَصَصُ وَالْحُجَجُ."],["تَقْشَعِرُّ","تَضْطَرِبُ، وَتَرْتَعِدُ."],["تَلِينُ","تَسْكُنُ، وَتَطْمَئِنُّ."]],"24":[["يُتَّقَى بِوَجْهِهِ","يُلْقَى فِي النَّارِ مَغْلُولًا، فَيَتَلَقَّاهَا بِوَجْهِهِ."]],"26":[["الْخِزْيُ","الذُّلُّ، وَالْهَوَانُ."]],"27":[["مِنْ كُلِّ مَثَلٍ","مِنْ أَمْثَالِ الْقُرُونِ الْخَالِيَةِ، وَأَمْثَالِ التَّوْحِيدِ وَالشِّرْكِ وَغَيْرِهَا."]],"28":[["عِوَجٍ","اضْطِرَابٍ، وَلَبْسٍ."]],"29":[["رَجُلًا","عَبْدًا مَمْلُوكًا."],["مُتَشَاكِسُونَ","مُتَنَازِعُونَ."],["سَلَمًا","خَالِصًا."],["لِرَجُلٍ","لِمَالِكِ وَاحِدٍ."]],"33":[["بِالصِّدْقِ","بِالْحَقِّ."],["مَأْوَى","مَأْوَى وَمَسْكَنُ."]],"38":[["حَسْبِيَ","كَافِينِي."]],"40":[["يُخْزِيهِ","يُذِلُّهُ، وَيُهِينُهُ."]],"42":[["يَتَوَفَّى","يَقْبِضُ."]],"45":[["اشْمَأَزَّتْ","نَفَرَتْ."]],"46":[["فَاطِرُ","خَالِقٌ وَمُبْدِعٌ."],["الْغَيْبِ وَالشَّهَادَةِ","السِّرِّ، وَالْعَلَانِيَةِ."]],"47":[["يَحْتَسِبُونَ","يَظُنُّونَ، وَيَتَوَقَّعُونَ."]],"48":[["حَاقَ","أَحَاطَ بِهِمْ مِنْ كُلِّ جَانِبٍ."]],"49":[["خَوَّلْنَاهُ","أَعْطَيْنَاهُ، وَمَنَحْنَاهُ."],["فِتْنَةٌ","ابْتِلَاءٌ وَاخْتِبَارٌ."]],"51":[["بِمُعْجِزِينَ","بِفَائِتِينَ اللَّهَ، وَلَا سَابِقِينِ."]],"52":[["يَبْسُطُ","يُوسِعُ."],["وَيَقْدِرُ","يُضَيِّقُ."]],"53":[["أَسْرَفُوا","تَجَاوَزُوا الحَدَّ فِي المَعَاصِي."],["لَا تَقْنَطُوا","لَا تَيْئَسُوا."]],"54":[["وَأَنِيبُوا","ارْجِعُوا إِلَى اللَّهِ بِالتَّوْبَةِ، وَالطَّاعَةِ."],["وَأَسْلِمُوا","اخْضَعُوا، وَانْقَادُوا."]],"55":[["بَغْتَةً","فَجْأَةً."]],"56":[["فَرَّطْتُ","ضَيَّعْتُ."],["جَنْبِ اللَّهِ","طَاعَتِهِ، وَحَقِّهِ."],["السَّاخِرِينَ","المُسْتَهْزِئِينَ."]],"57":[["هَدَانِي","أَرْشَدَنِي إِلَى دِينِهِ."]],"58":[["كَرَّةً","رَجْعَةً."]],"60":[["مَثْوَى","مَأْوىً، وَمَسْكَنٌ."]],"61":[["بِمَفَازَتِهِمْ","بِفَوْزِهِمْ وَظَفَرِهِمْ بِالمَطْلُوبِ."]],"63":[["مَقَالِيدُ","مَفَاتِيحُ الخَزَائِنِ."]],"67":[["وَمَا قَدَرُوا","مَا عَظَّمُوا."],["قَبْضَتُهُ","فِي قَبْضَةِ يَدِهِ."],["مَطُوِيَّاتٌ","يَطْوِيهَا وَيِلُفُّهَا بِيَدِهِ."],["بِيَمِينِهِ","بِيَدِهِ اليُمْنَى، وَكِلْتَا يَدَيْهِ يَمِينٌ، وَاللَّهُ يَدَانِ لَائِقَتَانِ بِجَلَالِهِ نُثْبِتُهُمَا بِلَا تَكْيِيفٍ، وَلَا تَحْرِيفٍ، وَلَا تَمْثِيلٍ، وَلَا تَعْطِيلٍ."],["سُبْحَانَهُ","تَنَزَّهَ."],["وَتَعَالَى","تَعَاظَمَ."]],"68":[["وَنُفِخَ","أَيِ: النَّفْخَةُ الأُولَى الَّتِي يَمُوتُ بِهَا الخَلْقُ؛ وَهِيَ نَفْخَةُ الصَّعْقِ."],["الصُّورِ","القَرْنِ الَّذِي يَنْفُخُ فِيهِ إِسْرَافِيلُ عَلَيْهِ السَّلَامُ لِلصَّعْقِ وَالبَعْثِ."],["فَصَعِقَ","مَاتَ."],["ثُمَّ نُفِخَ","أَيِ: النَّفْخَةُ الثَّانِيَةُ؛ نَفْخَةُ البَعْثِ الَّتِي يُحْيَا بِهَا الخَلْقُ."]],"69":[["وَأَشْرَقَتِ","أَضَاءَتْ."],["بِنُورِ رَبِّهَا","عِنْدَ تَجَلِّيهِ لِلْخَلَائِقِ؛ لِفَصْلِ القَضَاءِ."],["وَوُضِعَ الْكِتَابُ","نَشَرَتِ المَلَائِكَةُ صَحِيفَةَ كُلِّ فَرْدٍ."],["وَالشُّهَدَاءِ","مَنْ يَشْهَدُونَ عَلَى الأُمَمِ."],["وَقُضِيَ","حُكِمَ."],["بِالْحَقِّ","بِالعَدْلِ التَّامِّ."]],"71":[["زُمَرًا","جَمَاعَاتٍ."],["خَزَنَتُهَا","المَلَائِكَةُ المُوَكَّلُونَ بِالنَّارِ."],["حُقَّتْ","وَجَبَتْ."]],"72":[["فَبِئْسَ","قَبُحَ."],["مَثْوَى","مَصِيرٌ، وَمَأْوىً."]],"73":[["طُبْتُمْ","طُهِّرْتُمْ مِنْ دَنَسِ المَعَاصِي."]],"74":[["الْأَرْضَ","أَرْضَ الجَنَّةِ."],["نَتَبَوَّأُ","نَنْزِلُ."]],"75":[["حَافِينَ","مُحْدِقِينَ، وَمُحِيطِينَ."],["وَقُضِيَ بَيْنَهُمْ بِالْحَقِّ","حُكِمَ بَيْنَ الخَلَائِقِ بِالعَدْلِ."]]}