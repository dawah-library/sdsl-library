{"3":[["عَلَا","تَكَبَّرَ، وَطَغَى."]],"4":[["شِيَعاً","طَوَائِفَ مُتَفَرِّقَةً."]],"7":[["الْيَمِّ","النَّهْرِ، وَهُوَ نَهْرُ النِّيلِ."]],"8":[["خَاطِئِينَ","آثِمِينَ."]],"9":[["قُرَّتُ عَيْنِ لِي","مَصْدَرُ سُرُورِ لِي."]],"10":[["فَارِغاً","خَالِيًا مِنْ كُلِّ شَيْءٍ إِلَّا هَمَّ مُوسَى عَلَيْهِ السَّلَامُ."]],"11":[["عَنْ جُنُبٍ","عَنْ بُعْدٍ."]],"12":[["يَكْفُلُونَهُ لَكُمْ","يَقُومُونَ بِتَرْبِيَتِهِ وَإِرْضَاعِهِ."]],"14":[["بَلَغَ أَشُدَّهُ","قَوِيَ بَدَنُهُ."],["وَاسْتَوَى","تَكَامَلَ عَقْلُهُ."]],"15":[["مِنْ شِيعَتِهِ","مِنْ قَوْمِ مُوسَى عَلَيْهِ السَّلَامُ، وَهُمْ بَنُو إِسْرَائِيلَ."],["فَوَكَزَهُ","ضَرَبَهُ بِجَمْعِ كَفِّهِ."]],"17":[["ظَهِيراً","نَصِيرًا."]],"18":[["يَتَرَقَّبُ","يَتَوَقَّعُ الْمَكْرُوهَ."],["يَسْتَصْرِخُهُ","يَطْلُبُ مِنْهُ النَّصْرَ."],["لَغَوِيٌّ","كَثِيرُ الْغَوَايَةِ، ضَالٌّ عَنِ الرُّشْدِ."]],"22":[["تِلْقَاءَ مَدْيَنَ","جِهَتَهَا."],["سَوَاءَ السَّبِيلِ","الطَّرِيقَ الْأَحْسَنَ إِلَى مَدْيَنَ."]],"23":[["مَا خَطْبُكُمَا","مَا شَأْنُكُمَا؟"],["يُصْدِرَ الرِّعَاءُ","يَنْصَرِفُ الرُّعَاةُ بِأَغْنَامِهِمْ عَنِ الْمَاءِ."],["شَيْخٌ كَبِيرٌ","رَجُلٌ مُسِنٌّ وَلَيْسَ هُوَ شُعَيْبًا، خِلَافًا لِلْمَشْهُورِ."]],"27":[["تَأْجُرَنِي","تَكُونَ أَجِيرًا لِي فِي رَعْيِ مَاشِيَتِي."],["حِجَجٍ","سِنِينَ."]],"28":[["الْأَجَلَيْنِ","الْمُدَّتَيْنِ، الثَّمَانِ أَوِ الْعَشْرِ."],["فَلَا عُدْوَانَ عَلَىَّ","فَلَا أُطَالِبُ بِزِيَادَةٍ فِي الْمُدَّةِ."],["وَكِيلٌ","حَافِظٌ يُرَاقِبُنَا."]],"29":[["آنَسَ","أَبْصَرَ."],["جَذْوَةٍ","شُعْلَةٍ مِنَ النَّارِ."],["تَصْطَلُونَ","تَسْتَدْفِئُونَ."]],"30":[["شَاطِئِ","جَانِبِ."]],"31":[["تَهْتَزُّ","تَتَحَرَّكُ، وَتَضْطَرِبُ."],["جَانٌّ","حَيَّةٌ خَفِيفَةٌ فِي سُرْعَةِ حَرَكَتِهَا."],["مُدْبِراً","هَارِبًا جَاعِلًا النَّارَ خَلْفَ ظَهْرِهِ."],["وَلَمْ يُعَقِّبْ","لَمْ يَلْتَفِتْ."]],"32":[["اسْلُكْ","أَدْخِلْ."],["جَيْبِكَ","فَتْحَةِ قَمِيصِكَ."],["مِنْ غَيْرِ سُوءٍ","مِنْ غَيْرِ بَرَصٍ، وَلَا مَرَضٍ."],["وَاضْمُمْ إِلَيْكَ جَنَاحَكَ","ضُمَّ يَدَكَ إِلَى صَدْرِكَ."],["مِنَ الرَّهْبِ","لِتَأْمَنَ مِنَ الْخَوْفِ."],["فَذَانِكَ","هَاتَانِ."],["بُرْهَانَانِ","آيَتَانِ."]],"34":[["رِدْءاً","عَوْنًا."]],"35":[["سَنَشُدُّ عَضُدَكَ","سَنُقَوِّيكَ، وَنُعِينُكَ."],["سُلْطَانَاً","حُجَّةً، أَوْ تَسَلُّطًا، وَغَلَبَةً."],["فَلَا يَصِلُونَ إِلَيْكُمَا","فَلَا يُصِيبُكُمَا مِنْهُمْ سُوءٌ."],["بِآيَاتِنَا","بِسَبَبِ آيَاتِنَا."]],"36":[["مُفْتَرًى","مُخْتَلَقٌ، تَنْسُبُهُ إِلَى اللَّهِ كَذِبًا."]],"37":[["عَاقِبَةُ الدَّارِ","النِّهَايَةُ الْمَحْمُودَةُ فِي الْآخِرَةِ."]],"38":[["صَرْحاً","بِنَاءً عَالِيًا."]],"40":[["فَنَبَذْنَاهُمْ فِي الْيَمِّ","فَالْقَيْنَاهُمْ وَأَغْرَقْنَاهُمْ فِي الْبَحْرِ."]],"41":[["أَئِمَّةً","قَادَةً إِلَى النَّارِ."]],"42":[["وَأَتْبَعْنَاهُمْ","أَلْحَقْنَاهُمْ."],["لَعْنَةً","طَرْدًا وَإِبْعَادًا مِنَ الرَّحْمَةِ."],["الْمَقْبُوحِينَ","الْمُبْعَدِينَ الْمُسْتَقْذَرَةَ أَفْعَالُهُمْ."]],"43":[["الْقُرُونَ الْأُولَى","الْأُمَمَ الْمَاضِيَةَ الْمُكَذِّبَةَ."],["بَصَائِرَ لِلنَّاسِ","نُورًا لِقُلُوبِهِمْ يُبْصِرُونَ بِهِ الْحَقَائِقَ."]],"44":[["الْغَرْبِيِّ","الْجَبَلِ الْغَرْبِيِّ مِنْ مُوسَى ﷺ."],["قَضَيْنَا","عَهِدْنَا."]],"45":[["أَنْشَأْنَا","خَلَقْنَا."],["قُرُوناً","أُمَمًا."],["فَتَطَاوَلَ عَلَيْهِمُ الْعُمُرُ","فَمَكَثُوا زَمَنًا طَوِيلًا."],["ثَاوِيّاً","مُقِيمًا."],["أَهْلَ مَدْيَنَ","هُمْ قَوْمُ شُعَيْبٍ ﷺ."]],"46":[["الطُّورِ","جَبَلٍ بِسَيْنَاءَ كَلَّمَ اللَّهُ مُوسَى ﷺ بِجَانِبِهِ."]],"47":[["تُصِيبَهُمْ مُصِيبَةٌ","يَنْزِلُ بِهِمْ عَذَابٌ."]],"48":[["سِحْرَانِ تَظَاهَرَا","تَعَاوُنَا، يَقْصِدُونَ التَّوْرَاةَ وَالْقُرْآنَ."]],"51":[["وَصَّلْنَا","فَصَّلْنَا وَبَيَّنَّا."]],"54":[["مَرَّتَيْنِ","لِإِيمَانِهِمْ بِكِتَابِهِمْ وَبِالْقُرْآنِ."]],"55":[["اللَّغْوَ","الْبَاطِلَ."],["أَعْرَضُوا عَنْهُ","لَمْ يُصْغُوا إِلَيْهِ."],["سَلَامٌ عَلَيْكُمْ","لَا تَسْمَعُونَ مِنَّا إِلَّا الْخَيْرَ؛ قَدْ سَلِمْتُمْ مِنَّا."],["لَا نَبْتَغِي الْجَاهِلِينَ","لَا نُرِيدُ طَرِيقَةَ الْغَافِلِينَ عَنِ الْحِلْمَةِ وَالْحِلْمِ."]],"57":[["يُجْبَى","يُجْلَبُ إِلَيْهِ."]],"58":[["وَكَمْ","كَثِيرًا!"],["بَطِرَتْ مَعِيشَتَهَا","طَغَتْ وَتَمَرَّدَتْ فِي حَيَاتِهَا."]],"59":[["أُمُّهَا","أَعْظَمُهَا، وَهِيَ مَكَّةُ."]],"61":[["الْمُحْضَرِينَ","مِمَّنْ أُحْضِرُوا لِلنَّارِ."]],"63":[["أَغْوَوْنَا","دَعَوْنَاهُمْ لِلْغَوَايَةِ فَاتَّبَعُونَا."]],"66":[["فَعَمِيَتْ","فَخَفِيَتْ."],["الْأَنْبَاءُ","الحُجَجُ."]],"68":[["وَيَخْلُقُ","يَصْطَفِي."],["الْخِيَرَةُ","الِاخْتِيَارُ."]],"69":[["تُكِنُّ","تُخْفِي."]],"71":[["أَرَأَيْتُمْ","أَخْبِرُونِي."]],"72":[["سَرْمَدًا","دَائِمًا بَاقِيًا."]],"75":[["شَهِيدًا","رَسُولًا شَاهِدًا يَشْهَدُ عَلَى قَوْمِهِ بِشِرْكِهِمْ."],["وَضَلَّ","ذَهَبَ."],["يَفْتَرُونَ","يَخْتَلِقُونَ مِنَ الكَذِبِ."]],"76":[["فَبَغَى عَلَيْهِمْ","تَجَاوَزَ حَدَّهُ فِي الكِبْرِ والتَّجَبُّرِ عَلَيْهِمْ."],["الْكُنُوزَ","خَزَائِنَ الْأَمْوَالِ."],["مَفَاتِحُهُُ","مَفَاتِيحُ خَزَائِنِ مَالِهِ وَصَنَادِيقِهُ الْمُقْفَلَةِ."],["لَتَنُوءُ بِالْعُصْبَةِ","لَيُثْقِلُ حَمْلُهَا عَلَى الجَمَاعَةِ الكَثِيرَةِ."],["لَا تَفْرَحْ","لَا تَبْطَرْ."]],"77":[["وَابْتَغِ","الْتَمِسْ وَاُطْلُبْ."],["وَلَا تَنْسَ نَصِيبَكَ","لَا تَتْرُكْ حَظَّكَ."]],"78":[["الْقُرُونِ","الأُمَمِ."],["وَلَا يُسْأَلُ","أَيْ: لَا يُسْأَلُونَ سُؤَالَ اسْتِعْلَامٍ؛ بَلْ سُؤَالَ تَوْبِيخٍ وَتَقْرِيرٍ."]],"80":[["يُلْقَهَا","يُتَقَبَّلُ النَّصِيحَةَ، وَيُوَفَّقُ لِلْعَمَلِ بِهَا."]],"81":[["فِئَةٌ","جُنْدٌ، وَجَمَاعَةٌ."]],"82":[["وَيْكَأَنَّ","كَلِمَةُ تَوَجُّعٍ، وَتَأَسُّفٍ، وَتَعَجُّبٍ."],["وَيَقْدِرُ","يُضَيِّقُ."],["وَيْكَأَنَّهُ","أَلَمْ تَعْلَمْ أَنَّهُ؟"]],"83":[["عُلُوًّا","تَكَبُّرًا."]],"85":[["فَرَضَ","أَنْزَلَ."],["لَرَادُّكَ إِلَى مَعَادٍ","لَمَرْجِعِكَ إِلَى المَوْضِعِ اللَّذِي خَرَجْتَ مِنْهُ، وَهُوَ مَكَّةُ."]],"86":[["تَرْجُوا","تُؤْمِلُ."],["يُلْقَى","يُنْزَلُ."],["ظَهِيرًا","عَوْنًا."]]}