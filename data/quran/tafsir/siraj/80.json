{"1":[["عَبَسَ","قَطَّبَ وَجْهَهُ، وَظَهَرَ أَثَرُ التَّغَيُّرِ عَلَيْهِ."]],"11":[["كَلَّا","لَيْسَ الْأَمْرُ كَمَا فَعَلْتَ."]],"15":[["سَفَرَةٍ","مَلَائِكَةٍ كَتَبَةٍ يَقُومُونَ بِالسِّفَارَةِ بَيْنَ اللَّهِ وَخَلْقِهِ."]],"16":[["بَرَرَةٍ","مُطِيعِينَ اللَّهَ لَا يَعْصُونَهُ."]],"17":[["قُتِلَ الْإِنْسَانُ","لُعِنَ الْكَافِرُ، وَعُذِّبَ."],["مَا أَكْفَرَهُ","مَا أَشَدَّ كُفْرَهُ!"]],"19":[["نُطْفَةٍ","مَاءٍ قَلِيلٍ مَهِينٍ؛ وَهُوَ الْمَنِيُّ."],["فَقَدَّرَهُ","خَلَقَهُ أَطْوَارًا."]],"20":[["السَّبِيلَ يَسَّرَهُ","سَهَّلَ لَهُ طَرِيقَ خُرُوجِهِ مِنْ بَطْنِ أُمِّهِ، وَبَيَّنَ لَهُ طَرِيقَ الْخَيْرِ وَالشَّرِّ."]],"21":[["فَأَقْبَرَهُ","جَعَلَ لَهُ مَكَانًا يُقْبَرُ فِيهِ."]],"22":[["أَنْشَرَهُ","أَحْيَاهُ."]],"23":[["لَمَّا يَقْضِ مَا أَمَرَهُ","لَمْ يُؤَدِّ الْكَافِرُ مَا أَمَرُهُ اللَّهُ بِهِ مِنَ الْإِيمَانِ وَالطَّاعَةِ."]],"28":[["وَقَضْباً","عَلَفًا لِلدَّوَابِّ."]],"30":[["غُلْباً","عَظِيمَةَ الْأَشْجَارِ."]],"31":[["وَأَبًّا","كَلَّا لِلْبَهَائِمِ."]],"33":[["الصَّاخَّةُ","صَيْحَةُ يَوْمِ الْقِيَامَةِ الَّتِي تَصَمُّ الْآذَانَ مِنْ هَوْلِهَا."]],"37":[["يُغْنِيهِ","يُشْغِلُهُ."]],"38":[["مُسْفِرَةٌ","مُسْتَنِيرَةٌ."]],"39":[["مُسْتَبْشِرَةٌ","فَرِحَةٌ."]],"40":[["غَبَرَةٌ","غُبَارٌ، وَكُدُورَةٌ."]],"41":[["تَرْهَقُهَا","تَغْشَاهَا."]],"42":[["الْكَفَرَةُ","الْجَاحِدُونَ بِقُلُوبِهِمْ."],["الْفَجَرَةُ","الْعُصَاةُ بِأَعْمَالِهِمْ."]]}