{"1":[["أَفْلَحَ","فَازَ."]],"3":[["ٱللَّغْوِ","مَا لَا خَيْرَ فِيهِ مِنَ الأَقْوَالِ وَالأَفْعَالِ."]],"6":[["أَوْ مَا مَلَكَتْ أَيْمَٰنُهُمْ","الإِمَاءُ."]],"7":[["ٱلْعَادُونَ","المُجَاوِزُونَ الحَلَالَ إِلَى الحَرَامِ."]],"8":[["رَٰعُونَ","حَافِظُونَ."]],"11":[["ٱلْفِرْدَوْسَ","أَعْلَى مَنَازِلِ الجَنَّةِ، وَهُوَ أَعْلَى مَنَازِلِ الجَنَّةِ وَأَوْسَطُهَا."]],"12":[["سُلَٰلَةٍ مِّن طِينٍ","مَأْخُوذٍ وَمُسْتَلٍّ مِنْ جَمِيعِ الأَرْضِ."]],"13":[["نُطْفَةٍ","مَنِيِّ الرِّجَالِ يَخْرُجُ مِنْ أَصْلَابِهِمْ."]],"14":[["عَلَقَةً","دَمًا أَحْمَرَ مُلْتَصِقًا بِالرَّحِمِ."],["مُضْغَةً","قِطْعَةَ لَحْمٍ قَدْرَ مَا يُمْضَغُ."]],"17":[["طَرَائِقَ","سَمَاوَاتٍ بَعْضُهَا فَوْقَ بَعْضٍ."]],"18":[["بِقَدَرٍ","بِمِقْدَارِ حَاجَةِ الخَلْقِ."]],"20":[["وَشَجَرَةً","هِيَ شَجَرَةُ الزَّيْتُونِ."],["بِٱلدُّهْنِ","بِالزَّيْتِ."]],"22":[["ٱلْفُلْكِ","السُّفُنُ."]],"25":[["جِنَّةٌ","مَسٌّ مِنَ الجُنُونِ."]],"27":[["بِأَعْيُنِنَا","بِحِفْظِنَا وَكَلَاءَتِنَا؛ وَفِيهِ إِثْبَاتُ صِفَةِ العَيْنِ لِلَّهِ عَلَى الوَجْهِ اللَّائِقِ بِهِ."],["وَفَارَ ٱلتَّنُّورُ","نَبَعَ المَاءُ مِنَ التَّنُّورِ المَعْرُوفِ."],["فَاسْلُكْ فِيهَا","فَأَدْخِلْ فِيهَا."],["سَبَقَ عَلَيْهِ ٱلْقَوْلُ","اسْتَحَقَّ العَذَابَ."]],"30":[["لَمُبْتَلِينَ","لَمُخْتَبِرِينَ."]],"31":[["قَرْنًا","جِيلًا."]],"33":[["ٱلْمَلَأُ مِن قَوْمِهِ","أَشْرَافُ قَوْمِ هُودٍ، وَوُجَهَاؤُهُمْ."]],"36":[["هَيْهَاتَ","بَعِيدًا حَقًّا."]],"40":[["عَمَّا قَلِيلٍ","بَعْدَ زَمَنٍ قَرِيبٍ."]],"41":[["غُثَاءً","كَغُثَاءِ السَّيْلِ الَّذِي يَطْفُو عَلَى المَاءِ."],["فَبُعْدًا","فَهَلَاكًا وَإِبْعَادًا مِنَ الرَّحْمَةِ."]],"42":[["قُرُونًا","أُمَمًا وَأَجْيَالًا."]],"43":[["أَجَلَهَا","مَوْعِدَ هَلَاكِهَا المُحَدَّدَ."]],"44":[["تَتْرَا","يَتْبَعُ بَعْضُهُمْ بَعْضًا."],["أَحَادِيثَ","أَخْبَارًا لِمَنْ بَعْدَهُمْ."]],"45":[["بِـَٔايٰتِنَا","وَهِيَ تِسْعٌ: العَصَا، وَاليَدُ، وَالجَرَادُ، وَالقُمَّلُ، وَالضَّفَادِعُ، وَالدَّمُ، وَالطُّوفَانُ، وَالسُّنُونُ، وَنَقْصُ الثَّمَرَاتِ."]],"46":[["عَالِينَ","مُتَكَبِّرِينَ مُتَطَاوِلِينَ عَلَى النَّاسِ."]],"47":[["عَبِدُونَ","مُتَذَلِّلُونَ مُطِيعُونَ."]],"50":[["رَبْوَةٍ","مَكَانٍ مُرْتَفِعٍ مِنَ الأَرْضِ."],["ذَاتِ قَرَارٍ","مُسْتَوٍ لِلاسْتِقْرَارِ عَلَيْهِ."],["وَمَعِينٍ","مَاءٍ جَارٍ ظَاهِرٍ لِلْعُيُونِ."]],"52":[["أُمَّتُكُمْ","دِينُكُمْ يَا مَعْشَرَ الأَنْبِيَاءِ."],["أُمَّةً وَّاحِدَةً","دِينًا وَاحِدًا هُوَ: الإِسْلَامُ."]],"53":[["فَتَقَطَّعُوۡاْ أَمْرَهُم","فَتَفَرَّقَ الأَتْبَاعُ فِي الدِّينِ."],["زُبُرًا","شِيَعًا، وَأَحْزَابًا."]],"54":[["غَمْرَتِهِمْ","ضَلَالَتِهِمْ، وَجَهْلِهِمْ."]],"57":[["مُشْفِقُونَ","وَجِلُونَ."]],"60":[["وَجِلَةٌ","خَائِفَةٌ مِنْ عَدَمِ القَبُولِ."]],"63":[["فِي غَمْرَةٍ مِّنْ هَذَا","ضَلَالٍ عَنْ هَذَا القُرْآنِ."]],"64":[["يَجْئَرُونَ","يَرْفَعُونَ أَصْوَاتَهُمْ مُتَضَرِّعِينَ."]],"66":[["عَلَىٰ أَعْقَابِكُمْ تَنكِصُونَ","تَنْفِرُونَ مِنْ سَمَاعِ الآيَاتِ كَالَّذِي يَرْجِعُ إِلَى الوَرَاءِ."]],"67":[["مُسْتَكْبِرِينَ بِهِۦ","مُسْتَعْلِينَ عَلَى النَّاسِ بِسَبَبِ الحَرَامِ؛ تَقُولُونَ: نَحْنُ أَهْلُهُ لَا نُغْلَبُ فِيهِ."],["سَامِرًا تَهْجُرُونَ","تَتَسَامَرُونَ بِاللَّيْلِ حَوْلَ الحَرَمِ بِالسَّيِّئِ مِنَ القَوْلِ."]],"71":[["بِذِكْرِهِمْ","بِمَا فِيهِ عِزُّهُمْ وَشَرَفُهُمْ، وَهُوَ القُرْآنُ."]],"75":[["يَعْمَهُونَ","يَتَحَيَّرُونَ وَيَتَخَبَّطُونَ."]],"76":[["اسْتَكَانُواْ","خَضَعُوا."]],"77":[["مُبْلِسُونَ","آيِسُونَ مِنْ كُلِّ خَيْرٍ مُتَحَيِّرُونَ."]],"79":[["ذَرَٰكُمْ","خَلَقَكُمْ، وَبَثَّكُمْ."]],"88":[["وَلَا يُجَارُ عَلَيْهِ","لَا يُغَاثُ أَحَدٌ وَيُحْمَى مِنْهُ."]],"89":[["فَأَنَّى تُسْحَرُونَ","فَكَيْفَ تَذْهَبُ عُقُولُكُمْ وَتُخْدَعُونَ عَنْ تَوْحِيدِهِ؟!"]],"91":[["وَلَعَلَا","لَعَالَبَ وَطَلَبَ العُلُوَّ."],["عَمَّا يَصِفُونَ","عَنْ وَصْفِهِمْ إِيَّاهُ بِالشَّرِيكِ، وَالوَلَدِ."]],"97":[["هَمَزَاتِ الشَّيَاطِينِ","وَسَاوِسُهُمْ، وَنَزَغَاتُهُمْ."]],"100":[["بَرْزَخٌ","حَاجِزٌ دُونَ الرَّجْعَةِ."]],"104":[["تَلْفَحُ","تَحْرُقُ."],["كَٰلِحُونَ","عَابِسُونَ قَلَصَتْ شِفَاهُهُمْ، وَبَرَزَتْ أَسْنَانُهُمْ."]],"108":[["اخْسَؤُواْ","امْكُثُوا أَذِلَّاءَ."]],"110":[["فَاتَّخَذْتُمُوهُمْ سِخْرِيًّا","اشْتَغَلْتُمْ بِالاسْتِهْزَاءِ بِهِمْ."]],"113":[["العَادِّينَ","الحُسَّابَ الَّذِينَ يَعُدُّونَ الأَيَّامَ."]]}