{"1":[["الَم","هَذَا الْقُرْآنُ مُؤَلَّفٌ مِنْ هَذِهِ الْحُرُوفِ، وَلَا يَسْتَطِيعُونَ الْإِتْيَانَ بِمِثْلِهِ."]],"2":[["لِلْمُتَّقِينَ","مَنْ جَعَلُوا بَيْنَهُمْ وَبَيْنَ عَذَابِ اللَّهِ وِقَايَةً بِفِعْلِ الْأَوَامِرِ وَتَرْكِ النَّوَاهِي."]],"7":[["خَتَمَ اللَّهُ","طَبَعَ اللَّهُ."],["غِشَاوَةٌ","غِطَاءٌ."]],"10":[["مَرَضٌ","شَكٌّ، وَنِفَاقٌ."]],"15":[["وَيَمُدُّهُمْ","يَزِيدُهُمْ، وَيُمْهِلُهُمْ."],["يَعْمَهُونَ","يَتَحَيَّرُونَ، وَيَعْمَوْنَ عَنِ الرُّشْدِ."]],"18":[["بُكْمٌ","لَا يَنْطِقُونَ بِالْحَقِّ."]],"19":[["كَصَيِّبٍ","كَمَطَرٍ شَدِيدٍ."]],"22":[["أَنْدَادًا","نَظَرَاءَ، وَأَمْثَالًا."]],"23":[["رَيْبٍ","شَكٌّ."]],"25":[["مُتَشَابِهًا","فِي اللَّوْنِ، وَالْمَنْظَرِ، لَا فِي الطَّعْمِ."]],"29":[["اسْتَوَى","قَصَدَ."]],"30":[["خَلِيفَةً","أَقْوَامًا يَخْلُفُ بَعْضُهُمْ بَعْضًا."],["وَيَسْفِكُ","يُرِيقُ."],["وَنُقَدِّسُ لَكَ","نُمَجِّدُكَ، وَنُطَهِّرُ ذِكْرَكَ عَمَّا لَا يَلِيقُ."]],"35":[["رَغَدًا","تَمَتُّعًا هَنِيئًا وَاسِعًا."]],"36":[["فَأَزَلَّهُمَا","أَوْقَعَهُمَا فِي الْخَطِيئَةِ."]],"40":[["فَارْهَبُونِ","خَافُونِ."]],"42":[["وَلَا تَلْبِسُوا","لَا تَخْلِطُوا."]],"48":[["عَدْلٌ","فِدْيَةٌ."]],"49":[["يَسُومُونَكُمْ","يُذِيقُونَكُمْ."],["بَلَاءٌ","اخْتِبَارٌ أو نِعْمَةٌ."]],"50":[["فَرَقْنَا","فَصَلْنَا."]],"53":[["وَالْفُرْقَانَ","الَّذِي يَفْصِلُ بَيْنَ الْحَقِّ وَالْبَاطِلِ؛ وَهُوَ التَّوْرَاةُ."]],"54":[["بَارِئِكُمْ","خَالِقِكُمْ."]],"55":[["الصَّعِقَةُ","نَارٌ مِنَ السَّمَاءِ."]],"57":[["وَظَلَّلْنَا","جَعَلْنَاهُ ظِلًّا مِنْ حَرِّ الشَّمْسِ."],["الْغَمَامَ","السَّحَابَ."],["الْمَنَّ","شَيْئًا يُشْبِهُ الصَّمْغَ كَالْعَسَلِ."],["وَالسَّلْوَىٰ","طَيْرًا يُشْبِهُ السُّمَّانَىٰ."]],"58":[["وَقُولُوا حِطَّةٌ","أَيْ: قُولُوا احْطُطْ، وَضَعْ عَنَّا ذُنُوبَنَا."]],"59":[["رِجْزًا","عَذَابًا."]],"60":[["وَلَا تَعْثَوْا","لَا تَسْعَوْا."]],"61":[["بَقْلِهَا","الْبُقُولُ وَالْخُضَرُ كَالنَّعْنَاعِ."],["وَقِثَّائِهَا","الْخِيَارُ."],["وَفُومِهَا","الْحِنْطَةُ، وَالْحُبُوبُ الَّتِي تُؤْكَلُ."],["مِصْرًا","بَلَدًا."],["وَالْمَسْكَنَةُ","فَقْرُ النَّفْسِ.