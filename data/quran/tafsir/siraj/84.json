{"1":[["انْشَقَّتْ","تَصَدَّعَتْ، وَتَفَطَّرَتْ بِالْغَمَامِ يَوْمَ الْقِيَامَةِ."]],"2":[["وَأَذِنَتْ لِرَبِّهَا","أَطَاعَتْ لِأَمْرِ رَبِّهَا."]],"3":[["مُدَّتْ","بُسِطَتْ، وَوُسِّعَتْ، وَدُكَّتْ جِبَالُهَا."]],"4":[["وَأَلْقَتْ","قَذَفَتْ مَا فِي بَطْنِهَا مِنَ الْأَمْوَاتِ."]],"6":[["كَادِحٌ إِلَى رَبِّكَ","سَاعٍ إِلَى اللهِ، وَعَامِلٌ بِالْخَيْرِ أَوْ الشَّرِّ."]],"7":[["كِتَابُهُ","صَحِيفَةُ عَمَلِهِ."]],"11":[["يَدْعُوا ثُبُورًا","يَدْعُو بِالْهَلَاكِ قَائِلًا: وَاثُبُورَاهُ!"]],"12":[["وَيَصْلَى سَعِيرًا","يَدْخُلُ النَّارَ يُقَاسِي حَرَّهَا."]],"14":[["لَنْ يَحُورَ","لَنْ يَرْجِعَ إِلَى اللهِ لِيُحَاسِبَهُ."]],"16":[["بِالشَّفَقِ","بِاحْمِرَارِ الْأُفُقِ عِنْدَ الْغُرُوبِ."]],"17":[["وَسَقَ","جَمَعَ."]],"18":[["اتَّسَقَ","تَكَامَلَ نُورُهُ، وَأَبْدَرَ."]],"19":[["طَبَقًا عَنْ طَبَقٍ","أَطْوَارًا مُتَعَدِّدَةً، وَأَحْوَالًا مُتَبَايِنَةً: نُطْفَةً، ثُمَّ عَلَقَةً، وَهَكَذَا."]],"25":[["غَيْرُ مَمْنُونٍ","غَيْرُ مَقْطُوعٍ، وَلَا مَنْقُوصٍ."]]}