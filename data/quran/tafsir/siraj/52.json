{"1":[["وَالطُّورِ","قَسَمٌ بِالجَبَلِ الَّذِي كَلَّمَ اللَّهُ عَلَيْهِ مُوسَى ﷺ."]],"2":[["وَكِتَابٍ مَّسْطُورٍ","قَسَمٌ بِالقُرْآنِ المَكْتُوبِ."]],"3":[["فِي رَقٍّ مَّنْشُورٍ","فِي صُحُفٍ مَنْشُورَةٍ، مَبْسُوطَةٍ."]],"4":[["وَالْبَيْتِ الْمَعْمُورِ","قَسَمٌ بِالبَيْتِ المَعْمُورِ بِالمَلَائِكَةِ الَّذِينَ يَطُوفُونَ بِهِ دَائِمًا، وَهُوَ فِي السَّمَاءِ بِحِذَاءِ الكَعْبَةِ، يَطُوفُ بِهِ كُلَّ يَوْمٍ سَبْعُونَ أَلْفَ مَلَكٍ."]],"5":[["وَالسَّقْفِ الْمَرْفُوعِ","قَسَمٌ بِالسَّمَاءِ."]],"6":[["الْمَسْجُورِ","المَمْلُوءِ بِالمَاءِ."]],"13":[["يُدَعُّونَ","يُدْفَعُونَ بِعُنْفٍ وَشِدَّةٍ."]],"20":[["بِحُورٍ","نِسَاءٍ بِيضٍ."],["عِينٍ","وَاسِعَاتِ العُيُونِ، حِسَانِهَا."]],"21":[["وَمَا أَلَتْنَهُم","مَا نَقَصْنَا الآبَاءَ بِهَذَا الإِلْحَاقِ."],["رَهِينٍ","مَرْهُونٌ بِعَمَلِهِ، لَا يَحْمِلُ ذَنْبَ غَيْرِهِ."]],"23":[["كَأْسًا","مِنَ الخَمْرِ."],["لَا لَغْوٌ فِيهَا","لَا كَلَامَ سَاقِطَ أَثْنَاءَ شُرْبِهَا."],["وَلَا تَأْثِيمٌ","وَلَا يَقَعُ بِسَبَبِهَا إِثْمٌ فِي قَوْلٍ أَوْ فِعْلٍ."]],"24":[["مَّكْنُونٌ","مَصُونٌ، مَسْتُورٌ فِي أَصْدَافِهِ."]],"26":[["مُشْفِقِينَ","خَائِفِينَ مِنَ العَذَابِ."]],"27":[["عَذَابَ السَّمُومِ","عَذَابَ النَّارِ الَّتِي تَنْفُذُ فِي المَسَامِّ."]],"28":[["الْبَرُّ","المُحْسِنُ، كَثِيرُ الخَيْرِ."]],"29":[["بِنِعْمَتِ رَبِّكَ","بِسَبَبِ إِنْعَامِ اللَّهِ عَلَيْكَ بِالنُّبُوَّةِ، وَرَجَاحَةِ العَقْلِ."],["بِكَاهِنٍ","يَدَّعِي عِلْمَ الغَيْبِ."]],"30":[["أَمْ","بَلْ."]],"32":[["أَحْلَامُهُم","عُقُولُهُمْ."],["طَاغُونَ","مُتَجَاوِزُونَ الحَدَّ فِي العِصْيَانِ."]],"33":[["تَقُولُهُ","اخْتَلَقَ القُرْآنَ مِنْ عِنْدِ نَفْسِهِ."]],"37":[["خَزَائِنُ رَبِّكَ","خَزَائِنُ رِزْقِهِ وَرَحْمَتِهِ."],["المُصَيْطِرُونَ","المُتَسَلِّطُونَ، الجَبَّارُونَ."]],"38":[["سُلَّمٌ","مِصْعَدٌ إِلَى السَّمَاءِ."],["بِسُلْطَانٍ مُّبِينٍ","بِحُجَّةٍ بَيِّنَةٍ تُصَدِّقُ دَعْوَاهُ."]],"40":[["مَّن مَّغْرَمٍ","مِنْ التِزَامِ غَرَامَةٍ تَطْلُبُهَا مِنْهُمْ."],["مُّثْقَلُونَ","مُتْعَبُونَ، مُجْهَدُونَ."]],"42":[["كَيْدًا","مَكْرًا."],["المَكِيدُونَ","يَرْجِعُ مَكْرُهُمْ عَلَى أَنْفُسِهِمْ."]],"44":[["كِسْفًا","قِطَعًا."],["مَرْكُومٌ","مُتَرَاكِمٌ بَعْضُهُ فَوْقَ بَعْضٍ."]],"45":[["يُصْعَقُونَ","يَهْلِكُونَ."]],"46":[["لَا يُغْنِي عَنْهُمْ","لَا يَدْفَعُ عَنْهُمْ."]],"47":[["دُونَ ذَلِكَ","قَبْلَ ذَلِكَ يَقَعُ فِي الدُّنْيَا عَلَيْهِمْ."]],"48":[["بِأَعْيُنِنَا","بِمَرْأَى مِنَّا، وَحِفْظٍ، وَاعْتِنَاءٍ؛ وَفِيهِ: إِثْبَاتُ صِفَةِ العَيْنَيْنِ لِلَّهِ؛ كَمَا يَلِيقُ بِهِ؛ بِلَا تَكْيِيفٍ، وَلَا تَمْثِيلٍ، وَجَاءَتْ بِصِيغَةِ الجَمْعِ لِلتَّعْظِيمِ."],["وَسَبِّحْ بِحَمْدِ رَبِّكَ","نَزِّهْ رَبِّكَ، حَامِدًا لَهُ."],["حِينَ تَقُومُ","لِلصَّلَاةِ، وَمِنْ نَوْمِكَ."]],"49":[["فَسَبِّحْهُ","نَزِّهْهُ، وَعَظِّمْهُ، وَصَلِّ لَهُ."],["وَإِدْبَارَ النُّجُومِ","نَزِّهْهُ، وَصَلِّ لَهُ صَلَاةَ الصُّبْحِ وَقْتَ غَيْبَةِ النُّجُومِ."]]}