{"1":[["الْحَاقَّةُ","القِيَامَةُ الوَاقِعَةُ حَقًّا الَّتِي يَتَحَقَّقُ فِيهَا الوَعْدُ وَالوَعِيدُ."]],"5":[["بِالطَّاغِيَةِ","بِالصَّيْحَةِ الَّتِي جَاوَزَتِ الحَدَّ فِي شِدَّتِهَا."]],"6":[["صَرْصَرٍ","بَارِدَةٍ."],["عَاتِيَةٍ","شَدِيدَةِ الهُبُوبِ."]],"7":[["سَخَّرَهَا عَلَيْهِمْ","سَلَّطَهَا عَلَيْهِمْ."],["حُسُومًا","مُتَتَابِعَةً؛ لَا تَفْتُرُ، وَلَا تَنْقَطِعُ."],["صَرْعَى","مَوْتَى."],["أَعْجَازُ نَخْلٍ","أُصُولُ نَخْلٍ."],["خَاوِيَةٍ","خَرِبَةٍ مُتَأَكِلَةِ الأَجْوَافِ."]],"9":[["وَالْمُؤْتَفِكَاتُ","أَهْلُ قُرَى قَوْمِ لُوطٍ الَّذِينَ انْقَلَبَتْ بِهِمْ دِيَارُهُمْ."],["بِالْخَاطِئَةِ","بِالفِعْلَاتِ ذَاتِ الخَطَإِ الجَسِيمِ."]],"10":[["رَابِيَةً","بَالِغَةً فِي الشِّدَّةِ."]],"11":[["طَغَا المَاءُ","جَاوَزَ المَاءُ حَدَّهُ، وَارْتَفَعَ فَوْقَ كُلِّ شَيْءٍ."],["فِي الجَارِيَةِ","السَّفِينَةِ الَّتِي صَنَعَهَا نُوحٌ عَلَيْهِ السَّلَامُ، تَجْرِي فِي المَاءِ."]],"12":[["وَتَعِيَهَا","تَحْفَظَهَا."]],"13":[["الصُّورُ","القَرْنُ الَّذِي يَنْفُخُ فِيهِ إِسْرَافِيلُ عَلَيْهِ السَّلَامُ."],["نَفْخَةٌ وَاحِدَةٌ","هِيَ: النَّفْخَةُ الأُولَى الَّتِي يَكُونُ بِهَا هَلَاكُ العَالَمِ."]],"14":[["وَحُمِلَتْ","رُفِعَتْ مِنْ أَمَاكِنِهَا."],["فَدُكَّتَا","دُقَّتَا، وَكُسِرَتَا."]],"15":[["وَوَقَعَتِ الْوَاقِعَةُ","قَامَتِ القِيَامَةُ."]],"16":[["وَاهِيَةٌ","ضَعِيفَةٌ، مُسْتَرْخِيَةٌ."]],"17":[["وَالْمَلَكُ","المَلَائِكَةُ."]],"18":[["تُعْرَضُونَ","عَلَى اللَّهِ لِلْجَزَاءِ وَالحِسَابِ."]],"19":[["هَاؤُمُ","خُذُوا."]],"20":[["ظَنَنْتُ","أَيْقَنْتُ."]],"21":[["رَاضِيَةٍ","هَنِيَّةٍ مَرْضِيَّةٍ."]],"23":[["قُطُوفُهَا","ثِمَارُهَا."],["دَانِيَةٌ","قَرِيبَةٌ يَتَنَاوَلُهَا القَاعِدُ وَالمُضْطَجِعُ."]],"24":[["هَنِيئًا","غَيْرَ مُنغَّصٍ، وَلَا مُكَدَّرٍ."],["أَسْلَفْتُمْ","قَدَّمْتُمْ."]],"26":[["مَا حِسَابِيَةْ","مَا جَزَائِي."]],"27":[["كَانَتِ الْقَاضِيَةْ","المَوْتَةَ القَاطِعَةَ لِأَمْرِي، وَلَمْ أُبْعَثْ."]],"28":[["مَا أَغْنَى","مَا نَفَعَنِي."]],"29":[["هَلَكَ عَنِّي","ذَهَبَ عَنِّي."],["سُلْطَانِيَهْ","حُجَّتِي، وَقُوَّتِي."]],"30":[["فَغُلُّوهُ","اجْمَعُوا يَدَيْهِ إِلَى عُنُقِهِ بِالأَغْلَالِ."]],"31":[["صَلُوهُ","أَدْخِلُوهُ، وَأَحْرِقُوهُ بِهَا."]],"32":[["ذَرْعُهَا","طُولُهَا بِذِرَاعِ المَلِكِ."],["فَاسْلُكُوهُ","فَأَدْخِلُوهُ فِيهَا."]],"35":[["حَمِيمٌ","قَرِيبٌ يَحْمِيهِ مِنَ العَذَابِ."]],"36":[["غِسْلِينٍ","صَدِيدُ أَهْلِ النَّارِ."]],"37":[["الْخَاطِئُونَ","المُذْنِبُونَ، المُصِرُّونَ عَلَى الكُفْرِ."]],"38":[["فَلَا أُقْسِمُ","أُقْسِمُ، وَ(لَا): لِتَأْكِيدِ القَسَمِ."]],"42":[["بِقَوْلِ كَاهِنٍ","بِسَجْعٍ كَسَجْعِ الكُهَّانِ الَّذِينَ يَدَّعُونَ عِلْمَ المُغَيَّبَاتِ."]],"46":[["الْوَتِينَ","نِياطَ القَلْبِ، وَهُوَ: عِرْقٌ مُتَصِلٌ بِهِ إِذَا قُطِعَ مَاتَ صَاحِبُهُ."]],"47":[["حَاجِزِينَ","مَانِعِينَ الهَلَاكَ وَالعِقَابَ عَنْهُ."]],"50":[["لَحَسْرَةٌ","لَنَدَامَةٌ عَظِيمَةٌ."]],"52":[["فَسَبِّحْ بِاسْمِ رَبِّكَ","فَنَزِّهْ رَبَّكَ عَمَّا لَا يَلِيقُ بِهِ ذَاكِرًا اسْمَهُ."]]}