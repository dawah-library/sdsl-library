{"1":[["أَمْرُ اللَّهِ","قِيَامُ السَّاعَةِ."]],"2":[["بِالرُّوحِ","بِالْوَحْيِ."]],"4":[["خَصِيمٌ","شَدِيدُ الْخُصُومَةِ."]],"6":[["تُرِيحُونَ","تَرُدُّونَهَا إِلَى مَبَارِيكِهَا وَحَظَائِرِهَا فِي الْمَسَاءِ."],["تَسْرَحُونَ","تُخْرِجُونَهَا لِلْمَرْعَى فِي الصَّبَاحِ."]],"7":[["أَثْقَالَكُمْ","أَمْتِعَتَكُمُ الثَّقِيلَةَ."]],"9":[["قَصْدُ السَّبِيلِ","بَيَانُ الطَّرِيقِ الْمُسْتَقِيمِ."],["جَائِرٌ","مَائِلٌ عَنِ الْحَقِّ."]],"10":[["فِيهِ تُسِيمُونَ","فِي الشَّجَرِ تَرْعَوْنَ دَوَابَّكُمْ."]],"13":[["ذَرَا","خَلَقَ."]],"14":[["لَحْماً طَرِيّاً","هُوَ: السَّمَكُ."],["مَوَاخِرَ فِيهِ","السُّفُنُ الْجَوَارِي فِيهِ تَشُقُّ وَجْهَ الْمَاءِ."]],"15":[["رَوَاسِيَ","جِبَالًا ثَوَابِتَ."],["أَن تَمِيدَ","لِئَلَّا تَمِيلَ، وَتَضْطَرِبَ."]],"16":[["وَعَلَامَاتٍ","مَعَالِمَ مِنْ جِبَالٍ كِبَارٍ وَصِغَارٍ، تَسْتَدِلُّونَ بِهَا عَلَى الطَّرِيقِ نَهَارًا."]],"21":[["أَيَّانَ","وَقْتَ."]],"23":[["لَا جَرَمَ","حَقًّا."]],"24":[["أَسَاطِيرُ","قَصَصٌ، وَأَبَاطِيلُ."]],"25":[["أَوْزَارَهُمْ","آثَامَهُمْ."]],"26":[["فَخَرَّ","فَسَقَطَ."]],"27":[["يُخْزِيهِمْ","يَفْضَحُهُمْ، وَيُذِلُّهُمْ بِالْعَذَابِ."],["تُشَاقُّونَ فِيهِمْ","تُحَارِبُونَ، وَتُجَادِلُونَ الْأَنْبِيَاءَ لِأَجْلِهِمْ."]],"28":[["فَأَلْقَوُا السَّلَمَ","فَاسْتَسْلَمُوا لِأَمْرِ اللَّهِ."]],"29":[["مَثْوَى","مَقَرٌّ."]],"34":[["وَحَاقَ","وَأَحَاطَ."]],"36":[["الطَّاغُوتَ","مَا يُعْبَدُ مِنْ دُونِ اللَّهِ."]],"38":[["جَهَدُوا أَيْمَانَهُمْ","مُجْتَهِدِينَ بِالْحَلِفِ بِأَغْلَظِ الْأَيْمَانِ."]],"41":[["لَنُبَوِّئَنَّهُمْ","لَنُسْكِنَنَّهُمْ."],["حَسَنَةٌ","دَارًا طَيِّبَةً."]],"44":[["وَالزُّبُرِ","الْكُتُبِ السَّمَاوِيَّةِ."]],"45":[["مَكَرُوا السَّيِّئَاتِ","دَبَّرُوا الْمَكَايِدَ."]],"46":[["تَقَلُّبَهُمْ","أَسْفَارَهُمْ، وَتَصَرُّفَاتَهُمْ."]],"47":[["تَخَوُّفٍ","حَالِ خَوْفٍ، وَنَقْصٍ فِي الْأَمْوَالِ وَالْأَنْفُسِ."]],"48":[["دَاخِرُونَ","خَاضِعُونَ لِعَظَمَةِ اللَّهِ."]],"51":[["فَأَرۡهَبُونَ","فَخَافُونِي."]],"52":[["وَلَهُ ٱلدِّينُ","لَهُ العِبَادَةُ وَالطَّاعَةُ وَحْدَهُ."],["وَاصِبًا","دَائِمًا."]],"53":[["تَج