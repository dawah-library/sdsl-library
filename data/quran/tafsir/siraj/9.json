{"3":[["وَأَذَانٌ","إِعْلَامٌ."]],"4":[["لَمْ يَنقُصُوكُمْ","لَمْ يَخُونُوا الْعَهْدَ."],["وَلَمْ يُظَاهِرُواْ","لَمْ يُعَاوِنُوا."]],"5":[["انسَلَخَ","انْقَضَى."],["الْأَشْهُرُ الْحُرُمُ","الْأَشْهُرُ الْأَرْبَعَةُ الَّتِي أَمَنْتُمْ فِيهَا الْمُشْرِكِينَ، بَدَأَتْ يَوْمَ النَّحْرِ، وَانْتَهَتْ فِي الْعَاشِرِ مِنْ رَبِيعِ الثَّانِي."],["وَأَحْصِرُوهُمْ","حَاصِرُوهُمْ فِي مَعَاقِلِهِمْ."]],"6":[["اسْتَجَارَكَ","طَلَبَ الْأَمَانَ مِنَ الْقَتْلِ."]],"7":[["اسْتَقَامُواْ","وَفَوْا بِعَهْدِكُمْ."]],"8":[["يَظْهَرُواْ","يَظْفَرُوا بِكُمْ."],["إِلًّا","قَرَابَةً."],["ذِمَّةً","عَهْدًا."]],"12":[["نَكَثُواْ","نَقَضُوا."],["أَيْمَانَهُمْ","مَوَاثِيقَهُمْ، وَعُهُودَهُمْ."],["لَا أَيْمَانَ لَهُمْ","لَا عَهْدَ لَهُمْ وَلَا ذِمَّةَ."]],"16":[["وَلِيجَةً","بِطَانَةً، وَأَوْلِيَاءَ."]],"24":[["اقْتَرَفْتُمُوهَا","اكْتَسَبْتُمُوهَا."],["كَسَادُهَا","عَدَمُ رَوَاجِهَا."]],"25":[["فَلَمْ تُغْنِ عَنكُمْ","لَمْ تَنْفَعْكُمْ."],["وَلَّيْتُم مُّدْبِرِينَ","فَرَرْتُمْ مُنْهَزِمِينَ."]],"28":[["عَيْلَةً","فَقْرًا."]],"29":[["الْجِزْيَةَ","مَالٌ يُفْرَضُ عَلَى الْكَافِرِ الْمُقِيمِ بِبِلَادِ الْمُسْلِمِينَ."],["صَاغِرُونَ","أَذِلَّاءُ."]],"30":[["يُضَاهِؤُونَ","يُشَابِهُونَ."],["أَنَّى يُؤْفَكُونَ","كَيْفَ يُصْرَفُونَ عَنِ الْحَقِّ؟!"]],"31":[["أَحْبَارُهُمْ","عُلَمَاءُ الْيَهُودِ."],["رُهْبَانُهُمْ","عُبَّادُ النَّصَارَى."],["سُبْحَانَهُ","تَنَزَّهَ، وَتَقَدَّسَ."]],"33":[["لِيُظْهِرَهُ","لِيُعْلِيَهُ."]],"34":[["لَيَأْكُلُونَ","لَيَأْخُذُونَ."],["يَكْنِزُونَ","لَا يُؤَدُّونَ الزَّكَاةَ."]],"36":[["كِتَابِ اللَّهِ","اللَّوْحِ الْمَحْفُوظِ."],["أَرْبَعَةٌ حُرُمٌ","حَرَّمَ اللَّهُ فِيهَا الْقِتَالَ، وَهِيَ: ذُو الْقَعْدَةِ، وَذُو الْحِجَّةِ، وَالْمُحَرَّمُ، وَرَجَبٌ."]],"37":[["النَّسِيءُ","التَّأْخِيرُ لِحُرْمَةِ شَهْرٍ إِلَى شَهْرٍ آخَرَ."],["لِيُوَاطِؤُواْ","لِيُوَافِقُوا."],["عِدَّةَ","عَدَدَ."]],"38":[["أَثَاقَلتُمْ","تَبَاطَأْتُمْ، وَتَكَاسَلْتُمْ."]],"39":[["إِلَّا تَنَفِرُواْ","إِلَّا تَخْرُجُوا لِلْجِهَادِ."]],"42":[["عَرَضًا قَرِيبًا","مَتَاعًا مِنَ الدُّنْيَا، سَهْلَ الْمَأْخَذِ."],["وَسَفَرًا قَاصِدًا","مُتَوَسِّطًا بَيْنَ الْقَرِيبِ وَالْبَعِيدِ."],["الشُّقَّةُ","الْمَسَافَةُ الَّتِي تُقْطَعُ بِمَشَقَّةٍ."]],"45":[["وَارْتَابَتْ","شَكَّتْ."],["يَتَرَدَّدُونَ","يَتَحَيَّرُونَ."]],"46":[["لِأَعَدُّواْ لَهُ عُدَّةً","لَتَأَهَّبُوا بِالزَّادِ وَالرَّاحِلَةِ."],["انبِعَاثَهُمْ","خُرُوجَهُمْ لِلْجِهَادِ مَعَكَ."],["فَثَبَّطَهُمْ","ثَقُلَ عَلَيْهِمُ الْخُرُوجُ."]],"47":[["خَبَالًا","فَسَادًا، وَاضْطِرَابًا."],["وَلَأَوْضَعُواْ خِلَالَكُمْ","لَأَسْرَعُوا السَّيْرَ بَيْنَكُمْ بِالنَّمِيمَةِ."],["يَبْغُونَكُمُ الْفِتْنَةَ","يَطْلُبُونَ فِتْنَتَكُمْ، وَفَسَادَ ذَاتِ بَيْنِكُمْ."],["سَمَّاعُونَ","جَوَاسيسُ يَسْمَعُونَ أَخْبَارَكُمْ، وَيَنْقُلُونَهَا إِلَيْهِمْ."]],"48":[["وَقَلَبُوا لَكَ الْأُمُورَ","دَبَّرُوا الْحِيَلَ."]],"52":[["تَرَبَّصُونَ","تَنْتَظِرُونَ."],["إِحْدَى الْحُسْنَيَيْنِ","الشَّهَادَةَ أَوِ النَّصْرَ."]],"56":[["يَحْلِفُونَ","يَحَافُونَ."]],"57":[["مَلْجَاً","مَأْمَنًا، وَحِصْنًا."],["مَغَارَاتٍ","كُهُوفًا فِي الجِبَالِ."],["مُدَّخَلاً","نَفَقًا."],["يَجْمَحُونَ","يُسْرِعُونَ."]],"58":[["يَلْمِزُكَ","يَعِيبُكَ."]],"59":[["حَسْبُنَا اللَّهُ","كَافِينَا اللَّهُ."]],"60":[["لِلْفُقَرَاءِ","لِلَّذِينَ لَا يَمْلِكُونَ شَيْئًا."],["وَالْمَسَاكِينِ","الَّذِينَ يَمْلِكُونَ دُونَ كِفَايَتِهِمْ."],["وَالْعَامِلِينَ عَلَيْهَا","السُّعَاةَ الَّذِينَ يَجْمَعُونَ الزَّكَاةَ."],["وَالْمُؤَلَّفَةِ قُلُوبُهُمْ","مَنْ يُرْجَى إِسْلَامُهُمْ، أَوْ دَفْعُ شَرِّهِمْ."],["الرِّقَابِ","عِتْقَ الأَرْقِاءِ، وَفَكَاكَ الأَسْرَى."],["وَالْغَارِمِينَ","المَدِينِينَ، وَمَنْ غَرِمُوا لِإِصْلَاحِ ذَاتِ البَيْنِ."],["وَفِي سَبِيلِ اللَّهِ","فِي الجِهَادِ."],["وَابْنِ السَّبِيلِ","المُسَافِرُ، المُنْقَطِعُ."]],"61":[["أُذُنٌ","يَسْتَمِعُ لِكُلِّ مَا يُقَالُ لَهُ، فَيُصَدِّقُهُ."],["وَيُؤْمِنُ لِلْمُؤْمِنِينَ","يُصَدِّقُ المُؤْمِنِينَ فِيمَا يُخْبِرُونَهُ."]],"63":[["يُحَادِدْ","يُشَاقُّ وَيُخَالِفُ."]],"68":[["حَسْبُهُمْ","كَافِيهِمْ."]],"69":[["فَاسْتَمْتَعْتُمْ بِخَلَاقِكُمْ","فَتَمَتَّعُوا بِنَصِيبِهِمْ مِنْ مَلَاذُّ الدُّنْيَا."],["وَخُضْتُمْ","دَخَلْتُمْ فِي الكَذِبِ وَالبَاطِلِ."],["حَبِطَتْ","بَطَلَتْ."]],"70":[["وَالْمُؤْتَفِكَاتِ","قُرَى قَوْمِ لُوطٍ، سُمِّيَتْ بِذَلِكَ؛ لِأَنَّ اللَّهَ قَلَبَهَا عَلَيْهِمْ."]],"72":[["عَدْنٍ","إِقَامَةٍ."]],"77":[["فَأَعْقَبَهُمْ","فَصَيَّرَ عَاقِبَتَهُمْ وَجَزَاءَهُمْ."]],"79":[["يَلْمِزُونَ","يَعِيبُونَ."],["الْمُطَّوِّعِينَ","الَّذِينَ يَتَطَوَّعُونَ بِالصَّدَقَةِ بِالمَالِ الكَثِيرِ."]],"81":[["بِمَقْعَدِهِمْ","بِقُعُودِهِمْ."],["خِلَافَ","مُخَالِفِينَ."]],"83":[["الْخَالِفِينَ","المُتَخَلِّفِينَ عَنِ الجِهَادِ."]],"86":[["أُولُوا الطَّوْلِ","أَصْحَابُ الغِنَى وَالسَّعَةِ."]],"87":[["الْخَوَالِفِ","القَاعِدِينَ، المُتَخَلِّفِينَ؛ مِنَ النِّسَاءِ، وَالصِّبْيَانِ، وَأَصْحَابِ الأَعْذَارِ."],["وَطُبِعَ","خَتَمَ."]],"90":[["الْمُعَذِّرُونَ","المُعْتَذِرُونَ."]],"91":[["الضُّعَفَاءِ","كَالشُّيُوخِ."],["حَرَجٌ","إِثْمٌ."],["نَصَحُوا لِلَّهِ","أَخْلَصُوا لِلَّهِ، وَلَمْ يُثْبِطُوا، وَعَلِمَ اللَّهُ مِنْ قُلُوبِهِمْ أَنَّهُمْ لَوْلَا العُذْرُ لَجَاهَدُوا."]],"92":[["لِتَحْمِلَهُمْ","لَتَجِدَ لَهُمْ دَوَابَّ يَرْكَبُونَهَا لِلْجِهَادِ."],["تَفِيضُ","تَسِيلُ."]],"93":[["السَّبِيلُ","الإِثْمُ، وَاللَّوْمُ."],["الْخَوَالِفِ","النِّسَاءِ، وَالصِّبْيَانِ."]],"94":[["لَنْ نُؤْمِنَ لَكُمْ","لَنْ نُصَدِّقَكُمْ."]],"95":[["رِجْسٌ","خُبْثَاءُ البَوَاطِنِ."]],"97":[["الْأَعْرَابُ","سُكَّانُ البَادِيَةِ."],["وَأَجْدَرُ","أَحَقُّ، وَأَحْرَى."]],"98":[["مَغْرَمًا","غَرَامَةً، وَخَسَارَةً."],["وَيَتَرَبَّصُ","يَنْتَظِرُ."],["الدَّوَائِرَ","الحَوَادِثَ وَالآفَاتِ."],["عَلَيْهِمْ دَائِرَةُ السَّوْءِ","دُعَاءٌ بِالشَّرِّ وَالعَذَابِ يَدُورُ عَلَيْهِمْ."]],"101":[["مَرَدُوا","لَجَوَّا فِيهِ، وَاسْتَمَرُّوا عَلَيْهِ، وَدَرَبُوا."]],"103":[["وَصَلِّ عَلَيْهِمْ","ادْعُ لَهُمْ بِالمَغْفِرَةِ."],["سَكَنٌ لَهُمْ","رَحْمَةٌ، وَطُمَأْنِينَةٌ لَهُمْ."]],"106":[["مُرْجَوْنَ","مُؤَخَّرُونَ."]],"107":[["ضِرَارًا","مُضَارَّةً لِلْمُؤْمِنِينَ."],["وَإِرْصَادًا","انْتِظَارًا."]],"109":[["شَفَا","طَرَفٍ."],["جُرُفٍ هَارٍ","حُفْرَةٍ مُتَدَاعِيَةٍ لِلسُّقُوطِ."]],"110":[["رِيبَةً","شَكًّا، وَنِفَاقًا."],["تَقَطَّعَ قُلُوبُهُمْ","بِالمَوْتِ، أَوْ بِالنَّدَامَةِ وَالتَّوْبَةِ."]],"111":[["وَمَنْ أَوْفَى","لَا أَحَدَ أَوْفَى."],["فَاسْتَبْشِرُوا","أَظْهِرُوا السُّرُورَ."]],"112":[["السَّائِحُونَ","الصَّائِمُونَ."]],"117":[["سَاعَةَ الْعُسْرَةِ","وَقْتَ الشِّدَّةِ، وَالمُرَادُ: غَزْوَةُ تَبُوكَ."],["يَزِيغُ","يَمِيلُ."]],"118":[["بِمَا رَحُبَتْ","مَعَ رَحْبِهَا وَسَعَتِهَا."]],"122":[["لِيَنْفِرُوا كَافَّةً","لِيَخْرُجُوا لِلْجِهَادِ جَمِيعًا."]],"123":[["الَّذِينَ يَلُونَكُمْ","القَرِيبِينَ مِنْكُمْ."]],"125":[["مَرَضٌ","شَكٌّ، وَنِفَاقٌ."],["رِجْسًا","نِفَاقًا وَشَكًّا."]],"126":[["يُفْتَنُونَ","يُبْتَلَوْنَ بِالقَحْطِ وَالشِّدَّةِ، وَإِظْهَارِ مَا يُبْطِنُونَهُ مِنَ النِّفَاقِ."]],"128":[["عَزِيزٌ","صَعْبٌ، وَشَاقٌّ عَلَيْهِ."],["مَا عَنِتُّمْ","عَنَتُكُمْ، وَمَشَقَّتُكُمْ."]],"129":[["حَسْبِيَ","كَافِيَّ."]]}