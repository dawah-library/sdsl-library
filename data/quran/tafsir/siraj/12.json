{"3":[["لِمَنْ الْغَافِلِينَ","أَيْ: لَا تَدْرِي عَنْ قَصَصِ السَّابِقِينَ شَيْئًا."]],"6":[["يَجْتَبِيكَ","يَصْطَفِيكَ."]],"8":[["عُصْبَةٌ","جَمَاعَةٌ ذَوُو عَدَدٍ."],["ضَلَالٍ","خَطَإٍ."]],"10":[["غَيَابَتِ الْجُبِّ","جَوْفَ بِئْرٍ، وَالْجُبُّ: هُوَ الْبِئْرُ الَّذِي قُطِعَ مِنْ الْأَرْضِ دُونَ بِنَاءٍ يَحْمِيهِ مِنَ الِانْهِيَارِ."],["السَّيَّارَةُ","المَارَّةُ مِنَ المُسَافِرِينَ."]],"12":[["يَرْتَعْ","يَأْكُلْ مَا لَذَّ وَطَابَ."]],"14":[["عُصْبَةٌ","جَمَاعَةٌ قَوِيَّةٌ."]],"15":[["وَأَجْمَعُوا","عَزَمُوا وَصَمَّمُوا."]],"17":[["نَسْتَبِقُ","نَتَسَابَقُ فِي الجَرْيِ، وَالرَّمْيِ بِالسِّهَامِ."],["بِمُؤْمِنٍ لَنَا","بِمُقِرٍّ لَنَا، وَمُصَدِّقٍ لَنَا."]],"18":[["سَوَّلَتْ","زَيَّنَتْ."],["فَصَبْرٌ جَمِيلٌ","احْتِمَالٌ لِلْمُصِيبَةِ لَا شَكْوَى مَعَهُ لِأَحَدٍ مِنَ الخَلْقِ."]],"19":[["سَيَّارَةٌ","جَمَاعَةٌ مِنَ المُسَافِرِينَ."],["وَارِدَهُمْ","مَنْ يَتَقَدَّمُهُمْ لِطَلَبِ المَاءِ."],["فَأَرْسَلَ دَلْوَهُ","فَأَرْسَلَ دَلْوَهُ فِي البِئْرِ؛ لِيَمْلَأَهَا بِالمَاءِ."],["وَأَسَرُوهُ بِضَاعَةً","كَتَمَ إِخْوَةُ يُوسُفَ كَوْنَهُ أَخَاهُمْ لِيَبِيعُوهُ."]],"20":[["وَشَرَوْهُ","بَاعَهُ إِخْوَتُهُ."],["بِخْسٍ","قَلِيلٍ."]],"21":[["مَثْوَاهُ","مَقَامَهُ."]],"22":[["أَشُدَّهُ","مُنْتَهَى قُوَّتِهِ فِي شَبَابِهِ."]],"23":[["وَرَاوَدَتْهُ","دَعَتْهُ إِلَى نَفْسِهَا بِرِفْقٍ وَلِينٍ."],["هَيْتَ لَكَ","هَلُمَّ إِلَيَّ."],["مَعَاذَ اللَّهِ","أَعْتَصِمُ بِاللَّهِ."],["رَبِّي","سَيِّدِي."],["مَثْوَايَ","مَنْزِلِي وَمَقَامِي."]],"24":[["هَمَّ بِهَا","مَالَتْ نَفْسُهَا لِفِعْلِ الفَاحِشَةِ."],["وَهَمَّ بِهَا","خَطَرَ بِقَلْبِهِ إِجَابَتُهَا."],["بُرْهَانَ رَبِّهِ","آيَةً مِنَ اللَّهِ زَجَرَتْهُ عَنْ ذَلِكَ الخَاطِرِ."],["المُخْلَصِينَ","الَّذِينَ أَخْلَصُوا فِي عِبَادَةِ اللَّهِ؛ فَأَخْلَصَهُمْ، وَاخْتَصَّهُمْ بِرَحْمَتِهِ."]],"25":[["وَاسْتَبَقَا البَابَ","أَسْرَعَا إِلَى البَابِ يُرِيدُ الخُرُوجَ وَهِيَ تَمْنَعُهُ."],["قَدَّتْ","شَقَّتْ."],["وَأَلْفِيَا","وَجَدَا."],["سَيِّدَهَا","زَوْجَهَا."]],"26":[["قُدَّ مِنْ قُبُلٍ","شُقَّ مِنَ الأَمَامِ."]],"29":[["الخَاطِئِينَ","الآثِمِينَ."]],"30":[["شَغَفَهَا حُبًّا","بَلَغَ حُبُّهَا لَهُ شِغَافَ قَلْبِهَا وَهُوَ غِلَافُهُ."]],"31":[["وَأَعْتَدَتْ","هَيَّأَتْ."],["مُتَّكَئًا","مَا يَتَّكِئُونَ عَلَيْهِ مِنَ الوَسَائِدِ."],["وَقَطَّعْنَ","جَرَحْنَ."],["حَاشَ لِلَّهِ","تَنْزِيهًا لِلَّهِ."]],"32":[["الصَّاغِرِينَ","الأَذِلَّاءِ."]],"36":[["بِتَأْوِيلِهِ","بِتَفْسِيرِهِ."]],"39":[["أَرْبَابٌ مُتَفَرِّقُونَ","أَعِبَادَةُ آلِهَةٍ شَتَّى؟"]],"40":[["سُلْطَانٍ","حُجَّةٍ، وَبُرْهَانٍ."]],"43":[["عِجَافٌ","ضَعِيفَاتٌ، مَهَازِيلُ."],["تَعْبُرُونَ","تُفَسِّرُونَ."]],"44":[["أَضْغَاثُ","أَخْلَاطٌ."]],"45":[["وَادَّكَرَ","تَذَكَّرَ."],["بَعْدَ أُمَّةٍ","بَعْدَ مُدَّةٍ."]],"47":[["دَأَبًا","مُتَابِعَةً، وَأَنْتُمْ جَادُونَ فِي العَمَلِ."]],"48":[["تُحْصِنُونَ","تَحْفَظُونَ، وَتَدَّخِرُونَ."]],"49":[["يَعْصِرُونَ","يَعْصِرُونَ الثِّمَارَ، لِكَثْرَةِ الخِصْبِ."]],"51":[["خَطْبُكُنَّ","شَأْنُكُنَّ."],["حَاشَ لِلَّهِ","تَنْزِيهًا لِلَّهِ."],["حَصْحَصَ الحَقُّ","ظَهَرَ بَعْدَ خَفَائِهِ."]],"53":[["لَأَمَّارَةٌ بِالسُّوءِ","كَثِيرَةُ الأَمْرِ بِالمَعَاصِي."]],"54":[["أَسْتَخْلِصْهُ","أَجْعَلْهُ مِنْ خُلَصَائِي، وَأَهْلِ مَشُورَتِي."],["مَكِينٌ","عَظِيمُ المَكَانَةِ."]],"56":[["يَتَبَوَّأُ","يَنْزِلُ."]],"59":[["جَهَّزَهُمْ بِجَهَازِهِمْ","أَعْطَاهُمْ مَا طَلَبُوا، وَوَفَّى الكَيْلَ لَهُمْ."]],"61":[["سَنُرَاوِدُ عَنْهُ أَبَاهُ","سَنَبْدُلُ جُهْدَنَا، لِإِقْنَاعِ أَبِيهِ."]],"62":[["بِضَاعَتَهُمْ","الثَّمَنَ الَّذِي دَفَعُوهُ."],["رِحَالَهُمْ","أَمْتِعَتَهُمْ، وَأَوْعِيَتَهُمْ."]],"65":[["مَتَاعَهُمْ","أَوْعِيَتَهُمْ."],["مَا نَبْغِي","مَاذَا نَطْلُبُ أَكْثَرَ مِنْ هَذَا؟"],["بِضَاعَتُنَا","الثَّمَنُ الَّذِي دَفَعْنَاهُ."],["وَنَمِيرُ","نَجْلِبُ طَعَامًا وَفِيرًا."],["كَيْلُ بَعِيرٍ","حَمْلُ بَعِيرٍ."]],"69":[["آوَى إِلَيْهِ","ضَمَّ."],["فَلَا تَبْتَئِسْ","فَلَا تَغْتَمَّ."]],"70":[["السِّقَايَةَ","الإِنَاءَ الَّذِي كَانَ يَكِيلُ بِهِ لِلنَّاسِ."],["رَحْلِ","مَتَاعِ."],["العِيرِ","القَافِلَةُ فِيهَا الأَحْمَالُ."]],"72":[["صُوَاعَ","صَاعَ."],["زَعِيمُ","ضَامِنٌ، وَكَافِلٌ."]],"75":[["فَهُو جَزَاؤُهُ","يَكُونُ السَّارِقُ عَبْدًا لِلْمَسْرُوقِ مِنْهُ."]],"76":[["دِينَ الْمَلِكِ","حُكْمِهِ وَقَضَائِهِ؛ لِأَنَّهُ لَيْسَ فِيهِ اسْتِعْبَادُ السَّارِقِ."]],"79":[["مَعَاذَ اللَّهِ","نَعْتَصِمُ بِاللَّهِ، وَنَسْتَجِيرُ بِهِ."]],"80":[["اسْتَيْأَسُوا","يَئِسُوا وَانْقَطَعَ رَجَاؤُهُمْ."],["خَلَصُوا نَجِيّاً","انْفَرَدُوا يَتَنَاجَوْرُونَ."],["مَوْثِقاً","عَهْدًا مُؤَكَّدًا."],["فَرَّطْتُمْ","قَصَّرْتُمْ."],["أَبْرَحَ","أُفَارِقُ."]],"82":[["وَالْعِيرَ","القَافِلَةَ."]],"83":[["سَوَّلَتْ","رَوَّنَتْ."]],"84":[["كَظِيمٌ","شَدِيدُ الكِتْمَانِ لِحُزْنِهِ."]],"85":[["تَفْتَؤُوا","مَا تَزَالُ."],["حَرِضاً","تُشْرِفُ عَلَى الهَلَاكِ."]],"86":[["بَثِّي","هَمِّي."]],"87":[["فَتَحَسَّسُوا","فَاسْتَقْصُوا خَبَرَهُ."],["وَلَا تَيْئَسُوا","لَا تَقْطَعُوا رَجَاءَكُمْ."],["رَوْحِ اللَّهِ","رَحْمَةِ اللَّهِ."]],"88":[["الضُّرُّ","القَحْطُ، وَالجَدْبُ."],["بِبِضَاعَةٍ مُزْجَاةٍ","ثَمَنٍ رَدِيءٍ قَلِيلٍ."]],"91":[["لَخَاطِئِينَ","آثِمِينَ بِمَا فَعَلْنَاهُ بِكَ، وَبِأَخِيكَ عَمْدًا."]],"92":[["لَا تَثْرِيبَ","لَا تَأْنِيبَ."]],"94":[["فَصَلَتِ الْعِيرُ","خَرَجَتِ القَافِلَةُ مِنْ أَرْضِ مِصْرَ."],["تُفَنِّدُونِ","تُسَفِّهُونِي."]],"95":[["ضَلَالِكَ","خَطَئِكَ."]],"99":[["ءَاوَىٰ","ضَمَّ."]],"100":[["الْعَرْشِ","سَرِيرِ المُلْكِ."],["وَخَرُّوا لَهُ سُجَّداً","حَيَّوْهُ بِالسُّجُودِ؛ تَكْرِيمًا، لَا عِبَادَةً، وَهُوَ فِي شَرْعِهِمْ جَائِزٌ."],["الْبَدْوِ","البَادِيَةِ."],["نَزَغَ","أَفْسَدَ."]],"102":[["أَجْمَعُوا","دَبَّرُوا، وَعَزَمُوا."]],"105":[["وَكَأَيِّنْ مِنْ ءَايَةٍ","كَثِيرٌ مِنَ الآيَاتِ."]],"107":[["غَشِيَةٌ","عَذَابٌ يَعُمُّهُمْ."],["بُغْتَةً","فَجْأَةً."]],"110":[["اسْتَيْأَسَ الرُّسُلُ","يَئِسُوا مِنْ أَقْوَامِهِمْ."],["وَظَنُّوا","أَيْقَنُوا."],["بَأْسُنَا","عَذَابُنَا."]]}