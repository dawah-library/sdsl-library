{"1":[["تَبَارَكَ","تَعَالَى، وَتَعَاظَمَ، وَتَكَاثَرَ خَيْرُهُ وَبِرُّهُ."]],"2":[["لِيَبْلُوَكُمْ","لِيَخْتَبَرَكُمْ."],["أَحْسَنُ عَمَلًا","أَخْلَصُهَ، وَأَصْوَبُهُ."]],"3":[["طِبَاقًا","بَعْضُهَا فَوْقَ بَعْضٍ، مِنْ غَيْرِ مُمَاسَّةٍ."],["تَفَاوُتٍ","اخْتِلَافٍ، وَتَبَايُنٍ."],["فُطُورٍ","شُقُوقٍ، وَصُدُوعٍ."]],"4":[["ثُمَّ ارْجِعِ البَصَرَ كَرَّتَيْنِ","أَعِدِ النَّظَرَ مَرَّةً بَعْدَ مَرَّةٍ."],["يَنْقَلِبْ","يَرْجِعْ."],["خَاسِئًا","ذَلِيلًا صَاغِرًا."],["حَسِيرٌ","مُتْعَبٌ، كَلِيلٌ."]],"5":[["رُجُومًا لِلشَّيَاطِينِ","شُهُبًا مُحْرِقَةً لِمُسْتَرِقِي السَّمْعِ مِنَ الشَّيَاطِينِ."],["وَأَعْتَدْنَا","أَعْدَدْنَا."]],"7":[["شَهِيقًا","صَوْتًا مُنْكَرًا."],["تَفُورُ","تَغْلِي غَلَيَانًا شَدِيدًا."]],"8":[["تَمَايَزُ مِنَ الغَيْظِ","تَتَمَزَّقُ مِنْ شِدَّةِ غَضَبِهَا عَلَى الكُفَّارِ."],["فَوْجٌ","جَمَاعَةٌ."],["نَذِيرٌ","رَسُولٌ يُحذِّرُكُمْ هَذَا العَذَابَ."]],"9":[["إِنْ أَنْتُمْ","مَا أَنْتُمْ."]],"12":[["بِالغَيْبِ","يَخْشَوْنَهُ وَهُمْ غَائِبُونَ عَنْ أَعْيُنِ النَّاسِ، وَيَخْشَوْنَ العَذَابَ قَبْلَ مُعَايَنَتِهِ."]],"15":[["ذَلُولًا","سَهْلَةً، مُمَهَّدَةً تَسْتَقِرُّونَ عَلَيْهَا."],["مَنَاكِبِهَا","نَوَاحِيهَا، وَجَوَانِبِهَا."],["وَإِلَيْهِ النُّشُورُ","إِلَيْهِ تُبْعَثُونَ مِنْ قُبُورِكُمْ لِلْجَزَاءِ وَالحِسَابِ."]],"16":[["مَنْ فِي السَّمَاءِ","اللَّهُ الَّذِي فِي العُلُوِّ."],["تَمُورُ","تَضْطَرِبُ بِكُمْ حَتَّى تَهْلِكُوا."]],"17":[["حَاصِباً","رِيحاً تَرْجُمُكُمْ بِالحِجَارَةِ الصَّغِيرَةِ."],["نَذِيرِ","تَحْذِيرِي لَكُمْ."]],"18":[["نَكِيرِ","إِنْكَارِي عَلَيْهِمْ، وَتَغْييرُ مَا بِهِمْ مِنَ النِّعْمَةِ."]],"19":[["صَافَّاتٍ","بَاسِطَاتٍ أَجْنِحَتَهَا عِنْدَ طَيَرَانِهَا فِي الهَوَاءِ."],["وَيَقْبِضْنَ","يَضْمُمْنَهَا إِلَى جُنُوبِهَا أَحْيَاناً."]],"20":[["غُرُورٍ","خِدَاعٍ وَضَلَالٍ مِنَ الشَّيْطَانِ."]],"21":[["لُجُّواْ","اسْتَمَرُّوا، وَتَمَادَوْا."],["عُتُوٍّ","مُعَانَدَةٍ، وَاسْتِكْبَارٍ."],["وَنُفُورٍ","شُرُودٍ وَتَبَاعُدٍ عَنِ الحَقِّ."]],"22":[["مُكِبًّا","مُنْكَبّاً."],["سَوِيًّا","مُسْتَوِياً، مُنْتَصِبَ القَامَةِ سَالِماً."],["صِرَاطٍ مُّسْتَقِيمٍ","طَرِيقٍ وَاضِحٍ لَا اعْوِجَاجَ فِيهِ."]],"23":[["أَنشَأَكُمْ","أَوْجَدَكُمْ."]],"24":[["ذَرَأَكُمْ","خَلَقَكُمْ، وَنَشَرَكُمْ فِي الأَرْضِ."]],"27":[["رَأَوْهُ زُلْفَةً","رَأَوْا عَذَابَ اللَّهِ قَرِيباً."],["سِيئَتْ","ذَلَّتْ، وَاسْوَدَّتْ."],["تَدَّعُونَ","تَطْلُبُونَ أَنْ يُعَجِّلَ لَكُمْ مِنَ العَذَابِ اسْتِهْزَاءً."]],"28":[["يُجِيرُ","يَحْمِي."]],"30":[["غَوْراً","ذَاهِباً فِي الأَرْضِ لَا تَصِلُونَ إِلَيْهِ بِوَسِيلَةٍ."],["مَّعِينٍ","جَارٍ عَلَى وَجْهِ الأَرْضِ، ظَاهِرٍ لِلْعُيُونِ."]]}