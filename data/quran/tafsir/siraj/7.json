"],["أَنْ تَقُولُوا","لِئَلَّا تَقُولُوا."]],"175":[["فَانْسَلَخَ مِنْهَا","خَرَجَ مِنْهَا بِكُفْرِهِ، وَنَبَذَهَا."],["فَأَتْبَعَهُ الشَّيْطَانُ","لَحِقَهُ، وَصَارَ قَرِينَهُ، وَاسْتَحْوَذَ عَلَيْهِ."]],"176":[["أَخْلَدَ إِلَى الْأَرْضِ","رَكَنَ إِلَى الدُّنْيَا، وَرَضِيَ بِهَا."],["تَحْمَلْ عَلَيْهِ","تَطْرُدْهُ."],["يَلْهَثْ","يُخْرِجُ لِسَانَهُ لَاهِثًا."]],"177":[["سَاءَ","قَبُحَ."]],"179":[["ذَرَآنَا","خَلَقْنَا."]],"180":[["يُلْحِدُونَ","يَمِيلُونَ عَنِ الْحَقِّ فِي أَسْمَائِهِ؛ كَأَنْ يُسَمُّوا آلِهَتَهُمْ بِأَسْمَائِهِ، أَوْ فِي مَعَانِيهَا بِتَحْرِيفِهَا."]],"181":[["يَعْدِلُونَ","يَقْضُونَ، وَيَحْكُمُونَ."]],"182":[["سَنَسْتَدْرِجُهُمْ","سَنَفْتَحُ لَهُمُ الْأَرْزَاقَ؛ لِيَغْتَرُّوا، ثُمَّ نُبَاجِئُهُمْ بِالْعُقُوبَةِ."]],"183":[["وَأُمْلِي لَهُمْ","أُمَهِّلُهُمْ."],["مَتِينٌ","قَوِيٌّ، شَدِيدٌ، لَا يُدْفَعُ بِقُوَّةٍ، وَلَا حِيلَةٍ."]],"184":[["جِنَّةٌ","جُنُونٌ."]],"186":[["يَعْمَهُونَ","يَتَحَيَّرُونَ، وَيَتَرَدَّدُونَ."]],"187":[["أَيَّانَ مُرْسَاهَا","مَتَى وُقُوعُهَا."],["يُجَلِّيهَا","يُظْهِرُهَا."],["ثَقُلَتْ","عَظُمَ عِلْمُهَا، وَخَفِيٌّ."],["حَفِيٌّ عَنْهَا","حَرِيصٌ عَلَى الْعِلْمِ بِهَا."]],"189":[["لَيَسْكُنَ","لِيَأْنَسَ، وَيَطْمَئِنَّ."],["تَغْشَهَا","جَامَعَهَا."],["فَمَرَّتْ بِهِ","قَامَتْ بِهِ، وَقَعَدَتْ؛ لِخِفَّةِ الْحَمْلِ."],["أَثْقَلَتْ","صَارَتْ ثَقِيلَةً لِأَجْلِ الْحَمْلِ."]],"190":[["فَتَعَالَى","تَعَاظَمَ، وَتَنَزَّهَ."]],"195":[["تُنْظِرُونِ","تُمْهِلُونِ."]],"196":[["وَلِيِّيَ","نَاصِرِي، وَحَافِظِي مِنْ كُلِّ سُوءٍ."]],"199":[["خُذِ الْعَفْوَ","خُذْ مَا تَيَسَّرَ مِنْ أَخْلَاقِ النَّاسِ، وَلَا تُكَلِّفْهُمْ مَالا يُرِيدُونَ بِذُلِّ لَكَ."],["بِالْعُرْفِ","بِالْمَعْرُوفِ، وَهُوَ كُلُّ قَوْلٍ وَعَمَلٍ حَسَنٍ."],["الْجَاهِلِينَ","السُّفَهَاءِ."]],"200":[["نَزْغٌ","وَسْوَسَةٌ، وَتَثْبِيطٌ عَنِ الْخَيْرِ، وَحَثٌّ عَلَى الشَّرِّ."],["فَاسْتَعِذْ بِاللَّهِ","فَالْجَأْ مُسْتَجِيرًا بِاللَّهِ."]],"201":[["طَائِفٌ مِنَ الشَّيْطَانِ","عَارِضٌ مِنْ وَسْوَسَةِ الشَّيْطَانِ."]],"202":[["يَمُدُّونَهُمْ","يُعِينُونَهُمْ فِي الْغِوَايَةِ."],["لَا يُقْصِرُونَ","لَا يَدَّخِرُونَ وُسْعًا فِي غَوَايَتِهِمْ."]],"203":[["اجْتَبَيْتَهَا","اخْتَلَقْتَهَا وَأَحْدَثْتَهَا."],["بَصَائِرُ","حُجَجٌ، وَبَرَاهِينُ."]],"205":[["تَضَرُّعًا","تَخَشُّعًا وَتَذَلُّلًا."],["وَخِيفَةً","تَوَاضُعًا، وَخَوْفًا مِنْهُ."],["بِالْغُدُوِّ","بِأَوَّلِ النَّهَارِ."],["وَالْآصَالِ","آخِرِ النَّهَارِ."]],"206":[["وَيُسَبِّحُونَهُ","يُنَزِّهُونَهُ عَمَّا لَا يَلِيقُ بِجَلَالِهِ."]]}