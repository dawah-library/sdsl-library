{"1":[["وَالطَّارِقِ","النَّجْمُ الَّذِي يَطْلُعُ لَيْلًا."]],"3":[["الثَّاقِبُ","الْمُضِيءُ الْمَتَوَهِّجُ."]],"4":[["إِنْ كُلُّ نَفْسٍ لَمَّا","مَا كُلُّ نَفْسٍ إِلَّا."],["حَافِظٌ","مَلَكٌ يَحْفَظُ أَعْمَالَهَا."]],"6":[["دَافِقٍ","مُنْصَبٌّ بِسُرْعَةٍ فِي الرَّحِمِ."]],"7":[["الصُّلْبِ","الظَّهْرِ."],["وَالتَّرَائِبِ","عِظَامِ الصَّدْرِ."]],"8":[["رَجْعِهِ","رَدِّهِ حَيًّا بَعْدَ الْمَوْتِ."]],"9":[["تُبْلَى السَّرَائِرُ","تُخْتَبَرُ، وَتُكَشَفُ ضَمَائِرُ الْقُلُوبِ."]],"11":[["ذَاتِ الرَّجْعِ","صَاحِبَةِ الْمَطَرِ الْمَتَكَرِّرِ."]],"12":[["ذَاتِ الصَّدْعِ","ذَاتِ التَّشَقُّقِ بِالنَّبَاتِ."]],"13":[["فَصْلٌ","فَاصِلٌ بَيْنَ الْحَقِّ، وَالْبَاطِلِ."]],"17":[["رُوَيْدًا","قَلِيلًا."]]}