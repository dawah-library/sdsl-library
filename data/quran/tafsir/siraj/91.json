{"1":[["وَضُحَاهَا","قَسَمٌ بِإِشْرَاقِ الشَّمْسِ ضُحًى."]],"2":[["تَلَاهَا","تَبِعَ الشَّمْسَ فِي الطُّلُوعِ وَالْأُفُولِ."]],"3":[["جَلَّاهَا","كَشَفَ ظُلْمَةَ اللَّيْلِ وَأَزَالَهَا."]],"4":[["يَغْشَاهَا","يُغَطِّي الْأَرْضَ بِظُلْمَتِهِ."]],"6":[["طَحَاهَا","بَسَطَهَا."]],"7":[["سَوَّاهَا","أَكْمَلَ خَلْقَهَا؛ لِأَدَاءِ مُهِمَّتِهَا."]],"8":[["فَأَلْهَمَهَا","بَيِّنْ لَهَا."],["فُجُورَهَا وَتَقْوَاهَا","طَرِيقَ الْخَيْرِ، وَطَرِيقَ الشَّرِّ."]],"9":[["زَكَّاهَا","طَهَّرَهَا وَنَمَّاهَا بِالطَّاعَةِ."]],"10":[["خَابَ","خَسِرَ."],["دَسَّاهَا","أَخْفَى نَفْسَهُ، وَنَقَصَهَا بِالْمَعَاصِي."]],"11":[["بِطَغْوَاهَا","بِسَبَبِ طُغْيَانِهَا، وَتَجَاوُزِهَا الْحَدَّ فِي الْعِصْيَانِ."]],"12":[["انْبَعَثَ","نَهَضَ مُسْرِعًا؛ لِعَقْرِ النَّاقَةِ."],["أَشْقَهَا","أَكْثَرُهُمْ شَقَاوَةً، وَتَمَرُّدًا؛ وَهُوَ قُدَارُ بْنُ سَالِفٍ."]],"13":[["نَاقَةَ اللَّهِ وَسُقْيَاهَا","احذَرُوا نَاقَةَ اللَّهِ أَنْ تَمَسُّوهَا بِسُوءٍ، وَأَنْ تَعْتَدُوا عَلَى سُقْيِهَا."]],"14":[["فَعَقَرُوهَا","فَنَحَرُوهَا."],["فَدَمْدَمَ","فَأَطْبَقَ عَلَيْهِمُ العُقُوبَةَ."],["فَسَوَّاهَا","عَمَّهُمْ بِالعُقُوبَةِ؛ فَلَمْ يُفْلِتْ مِنْهُمْ أَحَدٌ."]],"15":[["عُقْبَهَا","عَاقِبَةَ مَا نَزَلَ بِهِمْ مِنَ العُقُوبَةِ."]]}