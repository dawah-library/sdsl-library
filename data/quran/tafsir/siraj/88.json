{"1":[["الْغَاشِيَةِ","القِيَامَةُ تَغْشَى النَّاسَ بِأَهْوَالِهَا."]],"2":[["خَاشِعَةٌ","ذَلِيلَةٌ مُنْكَسِرَةٌ."]],"3":[["عَامِلَةٌ نَاصِبَةٌ","مُجْهَدَةٌ بِالعَمَلِ وَالتَّعَبِ فِي النَّارِ."]],"4":[["تَصْلَى نَارًا","تَدْخُلُ نَارًا، وَتُقَاسِي حَرَّهَا."]],"5":[["آنِيَةٍ","شَدِيدَةُ الحَرَارَةِ."]],"6":[["ضَرِيعٍ","نَبْتٍ خَبِيثٍ ذِي شَوْكٍ، لَا تَرْعَاهُ الدَّوَابُّ."]],"9":[["لِسَعْيِهَا","لِعَمَلِهَا بِالطَّاعَةِ فِي الدُّنْيَا."]],"11":[["لَاغِيَةً","لَا كَلِمَةَ لَغْوٍ وَاحِدَةً، وَلَا نَفْسًا تَلْغُو"]],"12":[["جَارِيَةٌ","مُتَدَفِّقَةٌ بِالمَاءِ."]],"14":[["مَوْضُوعَةٌ","مُعَدَّةٌ لِلشَّارِبِينَ."]],"15":[["وَنَمَارِقُ","وَسَائِدُ."]],"16":[["وَزَرَابِيُّ مَبثُوثَةٌ","بُسُطٌ كَثِيرَةٌ مَفْرُوشَةٌ."]],"20":[["سُطِحَتْ","بُسِطَتْ، وَمُهِّدَتْ."]],"22":[["بِمُصَيْطِرٍ","بِمُتَسَلِّطٍ تُكْرِهُهُمْ عَلَى الإِيمَانِ."]],"25":[["إِيَابَهُمْ","مَرْجِعَهُمْ بَعْدَ المَوْتِ."]]}