{"4":[["يَبُثُّ","يَنْشُرُ، وَيُفَرِّقُ."]],"5":[["وَتَصْرِيفِ الرِّيَاحِ","تَقْلِيبُهَا فِي مَهَابِّهَا لِمَنْفَعَتِكُمْ."]],"7":[["وَيْلٌ","هَلَاكٌ، وَدَمَارٌ."],["أَفَّاكٍ","كَذَّابٍ."],["أَثِيمٍ","كَثِيرِ الْإِثْمِ."]],"9":[["هُزُوًا","سُخْرِيَةً."]],"12":[["الْفُلْكِ","السُّفُنُ."]],"14":[["لَا يَرْجُونَ أَيَّامَ اللَّهِ","لَا يَتَوَقَّعُونَ وَقَائِعَهُ وَعَذَابَهُ بِأَعْدَائِهِ."]],"16":[["الْكِتٰبَ","التَّوْرَاةَ، وَالْإِنْجِيلَ."],["وَالْحُكْمَ","تَحْكِيمَهُمَا."]],"17":[["بَيِّنَاتٍ مِّنَ الْأَمْرِ","شَرَائِعَ وَاضِحَاتٍ فِي الْحَلَالِ، وَالْحَرَامِ، وَدَلَالَاتٍ تُبَيِّنُ الْحَقَّ مِنَ الْبَاطِلِ."],["بَغْيًا بَيْنَهُمْ","حَسَدًا وَعَدَاوَةً بَيْنَهُمْ."]],"18":[["شَرِيعَةً مِّنَ الْأَمْرِ","مِنْهَاجَ وَاضِحٍ مِنْ أَمْرِ الدِّينِ."]],"19":[["لَن يُغْنُوا عَنكَ","لَنْ يَدْفَعُوا عَنْكَ."]],"20":[["بَصَائِرُ","يُبْصِرُ بِهِ النَّاسُ الْحَقَّ."]],"21":[["أَمْ حَسِبَ","بَلْ ظَنَّ."]],"23":[["أَفَرَأَيْتَ","أَخْبَرْنِي."],["وَخَتَمَ","طَبَعَ."]],"26":[["لَا رَيْبَ فِيهِ","لَا شَكَّ فِيهِ."]],"33":[["وَحَاقَ بِهِم","نَزَلَ بِهِمْ."]],"34":[["نُنسِكُمْ","نَتْرُكُكُمْ فِي الْعَذَابِ."],["وَمَأْوَاكُمُ","مَنْزِلُكُمْ وَمَفَرُّكُمْ."]],"35":[["وَغَرَّتْكُمُ","خَدَعَتْكُمْ."],["وَلَا هُمْ يُسْتَعْتَبُونَ","لَا يُطْلَبُ مِنْهُمْ أَنْ يُرْضُوا رَبَّهُمْ بِالتَّوْبَةِ، وَالطَّاعَةِ."]],"37":[["الْكِبْرِيَاءُ","الْعَظَمَةُ، وَالسُّلْطَانُ، وَالْقُدْرَةُ."]]}