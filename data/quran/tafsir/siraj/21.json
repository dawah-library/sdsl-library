{"2":[["يُحْدَثُ","حَدِيثِ التَّنْزِيلِ يُجَدِّدُ الذِّكْرَى لَهُمْ."]],"3":[["وَأَسَرُّوا النَّجْوَى","بَالَغُوا فِي إِخْفَاءِ مَا يَتَنَاجَوْنَ بِهِ."]],"5":[["أَضْغَاثُ أَحْلَامٍ","أَخْلَاطُ مَنَامَاتٍ لَا حَقِيقَةَ لَهَا."]],"8":[["جَسَداً","أَجْسَاداً خَارِجَةً عَنْ طِبَاعِ الْبَشَرِ."]],"10":[["فِيهِ ذِكْرُكُمْ","فِيهِ عِزُّكُمْ، وَشَرَفُكُمْ، إِنِ اتَّعَظْتُمْ بِهِ."]],"11":[["وَكَمْ قَصَمْنَا","كَثِيراً أَهْلَكْنَا."]],"12":[["أَحَسُّوا","رَأَوْا."],["بَأْسَنَا","عَذَابَنَا."],["يَرْكُضُونَ","يُسْرِعُونَ هَارِبِينَ مِنَ الْعَذَابِ."]],"13":[["أُتْرِفْتُمْ","نَعَمْتُمْ فِيهِ فَبَطِرْتُمْ وَاسْتَكْبَرْتُمْ."]],"14":[["يَوَيْلَنَا","يَا هَلَاكَنَا."]],"15":[["حَصِيداً","كَالزَّرْعِ الْمَحْصُودِ."],["خَامِدِينَ","مَيِّتِينَ."]],"18":[["نَقْذِفُ بِالْحَقِّ","نَرْمِي بِهِ، وَنُبَيِّنُهُ فَنُرْدُّ بِهِ الْبَاطِلَ."],["زَاهِقٌ","ذَاهِبٌ، مُضْمَحِلٌّ."],["الْوَيْلُ","الْعَذَابُ."]],"19":[["وَلَا يَسْتَحْسِرُونَ","لَا يَمَلُّونَ."]],"20":[["لَا يَفْتُرُونَ","لَا يَضْعُفُونَ، وَلَا يَسْأَمُونَ."]],"21":[["هُمْ يُنْشِرُونَ","هُمْ يُحْيُونَ الْمَوْتَى؟ كَلَّا !"]],"22":[["لَوْ كَانَ فِيهِمَا آلِهَةٌ إِلَّا اللَّهُ لَفَسَدَتَا","غَيْرُ اللَّهِ لَاخْتَلَّ نِظَامُهُمَا، وَخَرِبَتَا؛ لِحُصُولِ التَّنَازُعِ."]],"24":[["ذِكْرُ مَنْ مَعِي","الْقُرْآنُ."],["وَذِكْرُ مَنْ قَبْلِي","الْكُتُبُ السَّابِقَةُ."]],"30":[["رَتْقاً","مُلْتَصِقَتَيْنِ."],["فَفَتَقْنَاهُمَا","فَفَصَلْنَاهُمَا بِقُدْرَتِنَا."]],"31":[["رَوَاسِيَ","جِبَالاً نُثَبِّتُهَا."],["أَنْ تَمِيدَ","لِئَلَّا تَضْطَرِبَ."],["فِجَاجاً سُبُلاً","طُرُقاً وَاسِعَةً مَسْلُوكَةً."]],"32":[["سَقْفاً مَحْفُوظاً","لَا تَسْقُطُ، وَلَا تَخْتَرِقُهَا الشَّيَاطِينُ."]],"33":[["فِي فَلَكٍ يَسْبَحُونَ","فِي مَدَارٍ يَجْرِي فِيهِ لَا يَحِيدُ عَنْهُ."]],"35":[["وَنَبْلُوكُمْ","نَخْتَبِرُكُمْ مَعَ عِلْمِنَا بِحَالِكُمْ."]],"37":[["مِنْ عَجَلٍ","لِكَثْرَةِ اسْتِعْجَالِهِ فِي أَحْوَالِهِ؛ كَأَنَّهُ خُلِقَ مِنْ عَجَلٍ."]],"39":[["لَا يَكُفُّونَ","لَا يَدْفَعُونَ."]],"40":[["بَغْتَةً","فَجْأَةً."],["فَتَبَهْتُهُمْ","فَتَحَيَّرُهُمْ."],["يُنْظَرُونَ","يُمْهَلُونَ."]],"41":[["فَحَاقَ","فَحَاقَ، وَأَحَاطَ."]],"42":[["يَكْلُؤُكُمْ","يَحْفَظُكُمْ، وَيَحْرُسُكُمْ."]],"43":[["يَصْحَبُونَ","يُجَارُونَ، وَيَمْنَعُونَ."]],"44":[["نَنْقُصُهَا مِنْ أَطْرَافِهَا","يَنْقُصُ اللَّهُ الْأَرْضَ مِنْ جَوَانِبِهَا بِمَا يُنْزِلُهُ مِنْ عَذَابِهِ، وَهَزِيمَةٍ بِالْكُفَّارِ فِي كُلِّ نَاحِيَةٍ."]],"45":[["أُنذِرُكُم","أُخَوِّفُكُمْ."]],"46":[["نَفْحَةٌ","نَصِيبٌ يَسِيرٌ."]],"47":[["ٱلْقِسْطِ","ذَوَاتِ العَدْلِ."],["مِثْقَالَ حَبَّةٍ","العَادِلِ أَوْ وَزْنِ ذَرَّةٍ."]],"48":[["ٱلْفُرْقَانَ","التَّوْرَاةَ الفَارِقَةَ بَيْنَ الحَقِّ وَالبَاطِلِ."]],"51":[["رُشْدَهُ","هُدَاهُ."]],"52":[["ٱلتَّمَاثِيلُ","الأَصْنَامُ الَّتِي صَنَعْتُمُوهَا."]],"57":[["لَأَكِيدَنَّ","لأَمْكُرَنَّ، وَأَكْسِرَنَّ."],["مُدْبِرِينَ","ذَاهِبِينَ."]],"58":[["جُذَاذًا","قِطَعًا صَغِيرَةً."]],"61":[["عَلَىٰ أَعْيُنِ النَّاسِ","بِمَرْأَى مِنَ النَّاسِ."]],"65":[["نُكِسُوا عَلَىٰ رُءُوسِهِمْ","رَجَعُوا إِلَى عِنَادِهِمْ."]],"67":[["أُفٍّ لَّكُمْ","قُبْحًا لَكُمْ."]],"71":[["ٱلْأَرْضَ الَّتِي بَارَكْنَا فِيهَا","أَرْضِ الشَّامِ."]],"72":[["نَافِلَةً","زِيَادَةً عَمَّا سَأَلَ."]],"74":[["قَوْمَ سَوْءٍ","أَهْلَ فَسَادٍ وَقُبْحٍ."]],"78":[["يَحْكُمَانِ","يَقْضِيَانِ بَيْنَ خَصْمَيْنِ عَدَتْ غَنَمُ أَحَدِهِمَا عَلَى زَرْعِ الآخَرِ."],["ٱلْحَرْثَ","الزَّرْعِ."],["نَفَشَتْ","انْتَشَرَتْ فِيهِ لَيْلاً بِلاَ رَاعٍ."]],"79":[["يُسَبِّحْنَ","تُسَبِّحُ الجِبَالُ مَعَهُ إِذَا سَبَّحَ."]],"80":[["صَنْعَةَ لَبُوسٍ","صِنَاعَةَ الدُّرُوعِ يَعْمَلُهَا حَلَقاً مُتَشَابِكَةً."],["لِتُحْصِنَكُم","لِتُحْصِينَكُمْ."],["بَأْسِكُمْ","حَرْبِكُمْ."]],"81":[["عَاصِفَةً","شَدِيدَةَ الهُبُوبِ."]],"82":[["يَغُوصُونَ لَهُۥ","يَغُوصُونَ فِي البِحَارِ؛ لِاسْتِخْرَاجِ اللَّآلِئِ."]],"87":[["وَذَا النُّونِ","وَصَاحِبِ الحُوتِ، وَهُوَ يُونُسُ عَلَيْهِ السَّلَامُ."],["أَن لَّن نَّقْدِرَ عَلَيْهِ","أَنْ لَنْ نُضَيِّقَ عَلَيْهِ فِي بَطْنِ الحُوتِ، وَنُؤَاخِذَهُ."]],"89":[["خَيْرُ الْوَارِثِينَ","خَيْرُ البَاقِينَ، وَخَيْرُ مَنْ خَلَفَنِي بِخَيْرٍ."]],"90":[["رَغَبًا وَرَهَبًا","رَجَاءً فِي الثَّوَابِ، وَخَوْفاً مِنَ العِقَابِ."],["خَاشِعِينَ","خَاضِعِينَ، مُتَذَلِّلِينَ."]],"91":[["أَحْصَنَتْ فَرْجَهَا","حَفِظَتْهُ مِنَ الفَوَاحِشِ."],["فَنَفَخْنَا","نَفَخَ جِبْرِيلُ عَلَيْهِ السَّلَامُ فِي جَيْبِ قَمِيصِهَا، فَوَصَلَتِ النَّفْخَةُ إِلَى رَحِمِهَا."],["مِن رُّوحِنَا","مِنْ جِهَةِ رُوحِنَا، وَهُوَ: جِبْرِيلُ عَلَيْهِ السَّلَامُ."]],"92":[["أُمَّتُكُمْ أُمَّةً وَاحِدَةً","مِلَّتُكُمْ مِلَّةٌ وَاحِدَةٌ، وَهِيَ: الإِسْلَامُ."]],"93":[["وَتَقَطَّعُوۡاْ أَمۡرَهُم","اخْتَلَفُوا عَلَى رُسُلِهِمْ، وَتَفَرَّقُوا."]],"94":[["فَلَا كُفْرَانَ لِسَعْيِهِ","فَلاَ جُحُودَ لِعَمَلِهِ."]],"95":[["وَحَرَامٌ","مُمْتَنِعٌ."],["لاَ يَرْجِعُونَ","أَيْ: إِلَى الدُّنْيَا؛ لِيَسْتَدْرِكُوا مَا فَرَّطُوا فِيهِ."]],"96":[["فُتِحَتْ يَأْجُوجُ","أَيْ: سَدُّ يَأْجُوجَ."],["حَدَبٍ","مُرْتَفِعٍ مِنَ الأَرْضِ."],["يُنسِلُونَ","يُسْرِعُونَ."]],"97":[["ٱلْوَعْدُ الْحَقُّ","يَوْمُ القِيَامَةِ."],["شَاخِصَةٌ","مَفْتُوحَةٌ لاَ تَكَادُ تَطْرُفُ."]],"98":[["حَصَبُ جَهَنَّمَ","وَقُودُهَا، وَحَطَبُهَا."],["وِرُودُونَ","دَاخِلُونَ."]],"100":[["زَفِيرٌ","تَنَفُّسٌ شَدِيدٌ تَنْتَفِخُ مِنْهُ الضُّلُوعُ يَدُلُّ عَلَى شِدَّةِ عَذَابِهِمْ."]],"102":[["حَسِيسَهَا","صَوْتَ لَهِيبِهَا، وَاخْتِرَاقَ الأَجْسَادِ فِيهَا."]],"103":[["ٱلْفَزَعُ الْأَكْبَرُ","الهَوْلُ الأَعْظَمُ يَوْمَ القِيَامَةِ."]],"104":[["كَطَيِّ السِّجِلِّ لِلْكُتُبِ","كَمَا تُطْوَى الصَّحِيفَةُ عَلَى مَا كُتِبَ فِيهَا."]],"105":[["ٱلزُّبُورِ","الكُتُبِ المُنَزَّلَةِ عَلَى الأَنْبِيَاءِ."],["ٱلذِّكْرِ","اللَّوْحِ المَحْفُوظِ."]],"109":[["أَذَنتُكُمْ","أَعْلَمْتُكُمْ مَا أُمِرْتُ بِهِ."],["عَلَى سَوَاءٍ","أَنَا وَأَنْتُمْ مُسْتَوُونَ فِي العِلْمِ بِهِ."]],"111":[["وَإِن أَدْرِي","لَسْتُ أَدْرِي."]],"112":[["ٱحْكُم بِالْحَقِّ","افْصِلْ بَيْنَنَا، وَبَيْنَ المُكَذِّبِينَ بِالقَضَاءِ الحَقِّ."]]}