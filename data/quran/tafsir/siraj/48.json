{"29":[["سِيمُوهُمْ","عَلَامَاتُهُمُ الظَّاهِرَةُ."],["سِيمَاهُمْ","عَلَامَاتُهُمْ."],["مِّثْلُهُمْ","صِفَتُهُمْ."],["شَطْئَهُ","سَاقَهُ، وَفَرْعَهُ."],["فَآزَرَهُ","قَوَى ذَلِكَ الشَّطْءُ الزَّرْعَ."],["فَاسْتَغْلَظَ","صَارَ غَلِيظًا."],["فَاسْتَوَى عَلَى سُوقِهِ","قَوِيَ، وَاسْتَوَى قَائِمًا عَلَى سِيقَانِهِ."],["الزُّرَّاعَ","الزَّارِعِينَ الَّذِينَ زَرَعوهُ، وَهَذَا مَثَلٌ ضَرَبَهُ اللَّهُ لِأَصْحَابِ النَّبِيِّ ﷺ وَأَنَّهُمْ يَبْدُونُونَ قِلَّةً ضُعَفَاءَ، ثُمَّ يَكْثُرُونَ وَيَقْوَوْنَ."]],"1":[["فَتْحًا مُّبِينًا","هُوَ: صُلْحُ الْحُدَيْبِيَةِ عَامَ سِتٌّ مِنَ الْهِجْرَةِ."]],"2":[["صِرَاطًا مُّسْتَقِيمًا","طَرِيقًا، وَدِينًا لَا عَوْجَ فِيهِ."]],"3":[["عَزِيزًا","قَوِيًّا لَا ضَعْفَ فِيهِ."]],"4":[["السَّكِينَةَ","الطُّمَأْنِينَةَ، وَالثَّبَاتَ."]],"5":[["وَيُكَفِّرَ","يَمْحُوَ."]],"6":[["ظَنَّ السَّوْءِ","الظَّنُّ السَّيِّئُ؛ وَهُوَ: الظَّنُّ بِأَنْ لَنْ يَنْصُرَ اللَّهُ دِينَهُ."],["عَلَيْهِمْ دَائِرَةُ السَّوْءِ","دُعَاءٌ عَلَيْهِمْ بِأَنْ تَدُورَ عَلَيْهِمْ دَائِرَةُ الْعَذَابِ، وَكُلُّ مَا يَسُوءُ."],["مَصِيرًا","مَنْزِلًا يَصِيرُونَ إِلَيْهِ."]],"9":[["وَتُعَزِّرُوهُ","تَنْصُرُوا اللَّهَ."],["وَتُوَقِّرُوهُ","تُعَظِّمُوا اللَّهَ."],["بُكْرَةً وَأَصِيلًا","أَوَّلَ النَّهَارِ، وَآخِرَهُ."]],"10":[["نَكَثَ","نَقْضَ بَيْعَتُهُ."]],"11":[["الْمُخَلَّفُونَ","الَّذِينَ تَخَلَّفُوا عَنِ الْخُرُوجِ مَعَكَ إِلَى مَكَّةَ."],["الْأَعْرَابُ","الْبَدْوُ."]],"12":[["لَّن يَنقَلِبَ","لَنْ يَرْجِعَ."],["ظَنَّ السَّوْءِ","الظَّنُّ السَّيِّئُ؛ وَهُوَ: أَلَّا يَنْصُرَ اللَّهُ نَبِيَّهُ ﷺ."],["بُورًا","هَلْكَى لَا خَيْرَ فِيهِمْ."]],"13":[["أَعْتَدْنَا","أَعْدَدْنَا."]],"15":[["مَغَانِمُ","غَنَائِمَ خَيْبَرَ الَّتِي وَعَدَكُمُ اللَّهُ بِهَا."],["ذَرُونَا","اُتْرُكُونَا."]],"16":[["أُوْلِي بَأْسٍ","أَصْحَابِ شِدَّةٍ وَقُوَّةٍ فِي الْحَرْبِ."]],"17":[["حَرَجٌ","إِثْمٌ فِي تَرْكِ الْجِهَادِ."]],"18":[["يُبَايِعُونَكَ","بَيْعَةَ الرِّضْوَانِ بِالْحُدَيْبِيَةِ."],["السَّكِينَةَ","الطُّمَأْنِينَةَ، وَالثَّبَاتَ."],["فَتْحًا قَرِيبًا","فَتْحُ خَيْبَرَ."]],"21":[["أَحَاطَ اللَّهُ بِهَا","قَادِرٌ عَلَيْهَا قَدْ وَعَدَكُمْ بِهَا، وَسَيُنْجِزُ وَعْدَهُ."]],"22":[["لَوَلَّوُا الْأَدْبَرَ","لَانَهَزَمُوا، وَوَلَّوْكُمْ ظُهُورَهُمْ."]],"23":[["سُنَّةَ اللَّهِ","طَرِيقَتُهُ بِنَصْرِ جُنْدِهِ، وَهَزِيمَةِ أَعْدَائِهِ."]],"24":[["بِبَطْنِ مَكَّةَ","بِالْحُدَيْبِيَةِ قُرْبَ مَكَّةَ."],["أَظْفَرَكُمْ","أَقْدَرَكُمْ عَلَيْهِمْ؛ فَأَمْسَكْتُمْ بِهِمْ، وَكَانُوا ثَمَانِينَ رَجُلًا."]],"25":[["وَالْهَدْيَ","الْبُدْنَ الَّتِي سَاقَهَا رَسُولُ اللَّهِ ﷺ فِي عَامِ الْحُدَيْبِيَةِ؛ لِيُهْدِيَهَا فِي الْحَرَمِ."],["مَعْكُوفًا","مَحْبُوسًا."],["مَحِلَّهُ","الْمَكَانَ الَّذِي يَحِلُّ فِيهِ نَحْرُهُ؛ وَهُوَ الْحَرَمُ."],["رِجَالٌ مُّؤْمِنُونَ","مُسْتَضْعَفُونَ، مُسْتَخْفُونَ بِإِيمَانِهِمْ."],["تَطَؤُهُمْ","خَشْيَةَ أَنْ تَهْلَكُوهُمْ إِذَا حَارَبْتُمُ الْكُفَّارَ."],["مَعَرَّةٌ","إِثْمٌ، وَعَيْبٌ، وَغَرَامَةٌ."],["تَزَيَّلُواْ","تَمَيَّزَ هَؤُلَاءِ الْمُسْتَضْعَفُونَ عَنِ الْكُفَّارِ."]],"26":[["الْحَمِيَّةَ","الْأَنَفَةَ."],["سَكِينَتَهُ","الِاطْمِئْنَانَ وَالْوَقَارَ."],["كَلِمَةَ التَّقْوَى","هِيَ: لَا إِلَهَ إِلَّا اللَّهُ."]],"27":[["فَتْحًا قَرِيبًا","هُوَ: صُلْحُ الْحُدَيْبِيَةِ، وَفَتْحُ خَيْبَرَ."]],"28":[["بِالْهُدَى","بِالْبَيَانِ الْوَاضِحِ، وَالْعِلْمِ النَّافِعِ."],["لِيُظْهِرَهُ عَلَى الدِّينِ كُلِّهِ","لِيُعْلِيَهُ عَلَى الْمِلَلِ كُلِّهَا."]]}