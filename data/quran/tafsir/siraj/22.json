{"1":[["زَلْزَلَةَ السَّاعَةِ","أَهْوَالُ القِيَامَةِ، وَاضْطِرَابُ الأَرْضِ يَوْمَهَا."]],"2":[["تَذْهَلُ","تَغْفُلُ، وَتَنْشَغِلُ."],["مُرْضِعَةٍ","الَّتِي أَلْقَمَتْ وَلَدَهَا ثَدْيَهَا."]],"3":[["مَرِيدٍ","مُتَمَرِّدٍ."]],"4":[["تُولَاهُ","اتَّخَذَهُ وَلِيّاً وَتَبِعَهُ."]],"5":[["رَّيْبٍ","شَكٍّ."],["عَلَقَةٍ","دَمٍ أَحْمَرَ غَلِيظٍ تَعَلَّقَ فِي الرَّحِمِ."],["مُضْغَةٍ","قِطْعَةِ لَحْمٍ صَغِيرَةٍ قَدْرَ مَا يُمْضَغُ."],["مُخَلَّقَةٍ","تَامَّةِ الخَلْقِ."],["أَشُدَّكُمْ","وَقْتَ شَبَابِكُمْ، وَاكْتِمَالَ قُوَّتِكُمْ."],["أَرْذَلِ الْعُمُرِ","سِنِّ الهَرَمِ، وَضَعْفِ العَقْلِ."],["هَامِدَةً","يَابِسَةً مَيِّتَةً."],["اهْتَزَّتْ","تَحَرَّكَتْ بِالنَّبَاتِ."],["وَرَبَتْ","ارْتَفَعَتْ، وَزَادَتْ لِارْتِوَائِهَا."],["مِن كُلِّ زَوْجٍ بَهِيجٍ","مِنْ كُلِّ نَوْعٍ مِنْ أَنْوَاعِ النَّبَاتِ، حَسَنٍ يَسُرُّ النَّاظِرِينَ."]],"9":[["ثَانِيَ عِطْفِهِ","لَاوِياً عُنُقَهُ فِي تَكَبُّرٍ."]],"11":[["عَلَىٰ حَرْفٍ","عَلَى ضَعْفٍ، وَشَكٍّ، وَتَرَدُّدٍ."],["خَيْرٌ","صِحَّةٌ، وَسَعَةُ رِزْقٍ."],["فِتْنَةٌ","ابْتِلَاءٌ بِمَكْرُوهٍ وَشِدَّةٍ."]],"13":[["الْمَوْلَى","النَّاصِرُ."]],"15":[["بِسَبَبٍ إِلَى السَّمَاءِ","بِحَبْلٍ إِلَى سَقْفِ بَيْتِهِ، لَيُخَنِّقْ بِهِ نَفْسَهُ."],["ثُمَّ لِيَقْطَعْ","أَيْ: لِيَقْطَعَ ذَلِكَ الْحَبْلَ."]],"17":[["وَالصَّابِئِينَ","عَبَدَةُ الْمَلَائِكَةِ، أَوْ الْكَوَاكِبِ."],["وَالْمَجُوسَ","عَبَدَةُ النَّارِ."],["شَهِيدٌ","عَالِمٌ بِهِ عِلْمَ مُشَاهَدَةٍ."]],"19":[["خَصْمَانِ","فَرِيقَانِ مُخْتَلِفَانِ، وَهُمْ أَهْلُ إِيمَانٍ، وَأَهْلُ كُفْرَانٍ."],["الْحَمِيمُ","الْمَاءُ الْمُتَنَاهِي فِي حَرِّهِ."]],"20":[["يُصْهَرُ بِهِ","يُذَابُ بِهِ."]],"21":[["مَقَامِعُ","مَطَارِقُ."]],"22":[["مِنْ غَمٍّ","مِنْ شِدَّةِ غَمِّهِمْ، وَكَرْبِهِمْ."],["وَذُوقُوا","وَقِيلَ لَهُمْ: ذُوقُوا."]],"23":[["يُحَلَّوْنَ","يُزَيَّنُونَ."]],"24":[["صِرَاطِ الْحَمِيدِ","طَرِيقِ الْإِسْلَامِ المَحْمُودِ."]],"25":[["الْعَاكِفُ فِيهِ","المُقِيمُ فِيهِ."],["وَالْبَادِ","القَادِمُ إِلَيْهِ."],["يُرِدْ","يَهُمْ."]],"26":[["بَوَّأْنَا","هَيَّأْنَا، وَبَيَّنَّا."]],"27":[["وَأَذِّنْ","نَادِ وَأَعْلِمْ رَافِعًا صَوْتَكَ."],["رِجَالًا","يَمْشُونَ عَلَى أَقْدَامِهِمْ؛ جَمْعُ رَاجِلٍ."],["ضَامِرٍ","البَعِيرِ خَفِيفِ اللَّحْمِ مِنَ الْأَعْمَالِ لَا مِنَ الهُزَالِ."],["فَجِّ عَمِيقٍ","طَرِيقِ بَعِيدٍ."]],"28":[["أَيَّامٍ مَّعْلُومَاتٍ","هِيَ: عَشْرُ ذِي الحِجَّةِ، وَثَلَاثَةُ أَيَّامٍ بَعْدَهُ."],["الْبَائِسَ الْفَقِيرَ","الَّذِي اشْتَدَّ فَقْرُهُ."]],"29":[["لِيَقْضُوا تَفَثَهُمْ","لِيُكْمِلُوا حَجَّهُمْ بِإِحْلَالِهِمْ مِنْ إِحْرَامِهِمْ وَإِزَالَةِ وَسَخِ أَبْدَانِهِمْ."],["نُذُورَهُمْ","الحَجَّ، وَالعُمْرَةَ، وَالهَدَايَا."],["الْعَتِيقِ","القَدِيمِ الَّذِي أَعْتَقَهُ اللَّهُ، مِنْ تَسَلُّطِ الجَبَّارِينَ عَلَيْهِ."]],"30":[["حُرُمَاتِ اللَّهِ","شَعَائِرِ الدِّينِ، وَمَنَاسِكِ الحَجِّ."],["الرِّجْسَ مِنَ الْأَوْثَانِ","القَذَارَةَ الَّتِي هِيَ: الأَوْثَانُ."],["قَوْلَ الزُّورِ","الكَذِبَ وَالافْتِرَاءَ عَلَى اللَّهِ."]],"31":[["حُنَفَاءَ لِلَّهِ","مُسْتَقِيمِينَ عَلَى الإِخْلَاصِ مَائِلِينَ عَنِ الشِّرْكِ."],["سَحِيقٍ","بَعِيدٍ مُهْلِكٍ."]],"32":[["شَعَائِرِ اللَّهِ","مَا أَشْعَرْتُمْ بِهِ، وَأَعْلَمْتُمْ؛ مِنْ أَعْمَالِ الحَجِّ وَالدَّبَائِحِ الَّتِي تُنْحَرُ فِيهِ."]],"33":[["لَكُمْ فِيهَا مَنَافِعُ","يَحِلُّ الِانْتِفَاعُ بِهَا بِالرُّكُوبِ، وَشُرْبِ اللَّبَنِ."],["مَحِلُّهَا","وَقْتُ ذَبْحِهَا."],["الْبَيْتِ الْعَتِيقِ","الحَرَمِ."]],"34":[["مَنْسَكًا","نُسُكًا وَعِبَادَةً؛ بِذَبْحِ الْأَنْعَامِ تَقَرُّبًا لِلَّهِ."],["الْمُخْبِتِينَ","الخَاشِعِينَ المُتَوَاضِعِينَ."]],"35":[["وَجِلَتْ","خَافَتْ."]],"36":[["شَعَائِرِ اللَّهِ","أَعْلَامِ دِينِهِ."],["صَوَافَّ","قَائِمَاتٍ؛ قَدْ صُفَّتْ ثَلَاثُ مِنْ قَوَائِمِهَا، وَقُيِّدَتِ الرَّابِعَةُ."],["وَجَبَتْ","سَقَطَتْ عَلَى الْأَرْضِ بَعْدَ النَّحْرِ."],["الْقَانِعَ","الفَقِيرَ الَّذِي لَمْ يَسْأَلْ تَعَفُّفًا."],["وَالْمُعْتَرَ","الَّذِي يَسْأَلُ لِحَاجَتِهِ."]],"37":[["يَنَالَ اللَّهَ","يَصِلُ إِلَى اللَّهِ."]],"38":[["خَوَّانٍ","كَثِيرِ الخِيَانَةِ لِأَمَانَةِ رَبِّهِ."]],"40":[["صَوَامِعُ","مَعَابِدُ رُهْبَانِ النَّصَارَى."],["بِيَعٌ","كَنَائِسُ النَّصَارَى."],["صَلَوَاتٌ","مَعَابِدُ اليَهُودِ."],["مَسَاجِدُ","مَعَابِدُ المُسْلِمِينَ."]],"44":[["فَأَمْلَيْتُ لِلْكَافِرِينَ","فَأَمْهَلْتُ وَلَمْ أُعَاجِلْ بِالعُقُوبَةِ."],["نَكِيرِ","إِنْكَارِي عَلَيْهِمْ كُفْرَهُمْ بِالعَذَابِ وَالهَلَاكِ."]],"45":[["فَكَأَيِّن مِّن قَرْيَةٍ","فَكَثِيرٌ مِنَ القُرَى."],["خَاوِيَةٌ عَلَى عُرُوشِهَا","مُتَهَدِّمَةٌ قَدْ سَقَطَتْ حِيطَانُهَا عَلَى سُقُوفِهَا."],["وَقَصْرٍ مَّشِيدٍ","مَرْفُوعِ البُنْيَانِ مُزَخْرَفٍ قَدْ خَلَا مِنْ سَاكِنِيهِ."]],"48":[["أَمْلَيْتُ لَهَا","أَمْهَلْتُهَا، وَلَمْ أُعَاجِلْهَا بِالعُقُوبَةِ."]],"51":[["سَعَوْا فِي آيَاتِنَا","اجْتَهَدُوا فِي الكَيْدِ؛ لِإِبْطَالِ القُرْآنِ."],["مُعَاجِزِينَ","مُغَالِبِينَ ظَانِّينَ أَنَّهُمْ يُعْجِزُونَنَا."]],"52":[["تَمَنَّى","قَرَأَ الآيَاتِ المُنْزَلَةَ عَلَيْهِمْ."],["أَلْقَى الشَّيْطَانُ","وَضَعَ فِي قُلُوبِ أَوْلِيَائِهِ الوَسَاوِسَ، وَالشُّبَهَ صَدًّا عَنِ اتِّبَاعِ القِرَاءَةِ."],["فِي أُمْنِيَّتِهِ","فِي قِرَاءَتِهِ."],["فَيَنسَخُ","فَيُبْطِلُ، وَيُزِيلُ."],["يُحْكِمُ","يُثْبِتُ."]],"53":[["فِتْنَةٌ","اخْتِبَارًا لِلَّذِينَ فِي قُلُوبِهِمْ مَرَضٌ."],["شِقَاقٍ بَعِيدٍ","عَدَاوَةٍ شَدِيدَةٍ، وَخِلَافٍ بَعِيدٍ عَنِ الصَّوَابِ."]],"54":[["فَتُخْبِتَ","تَخْضَعَ، وَتَسْكُنَ."]],"55":[["مِرْيَةٍ","شَكٍّ."],["بَغْتَةً","فَجْأَةً."],["يَوْمٍ عَقِيمٍ","لَا خَيْرَ فِيهِ، وَلَا يَوْمَ بَعْدَهُ، وَهُوَ يَوْمُ القِيَامَةِ."]],"59":[["مُدْخَلًا","وَهُوَ الجَنَّةُ."]],"60":[["بَغَىٰ عَلَيْهِ","اعْتُدِيَ عَلَيْهِ."]],"61":[["يُولِجُ","يُدْخِلُ."]],"65":[["وَٱلْفُلْكِ","السُّفُنُ."]],"67":[["مَنسَكًا","شَرِيعَةً، وَعِبَادَةً."]],"70":[["فِي كِتٰبٍ","هُوَ اللَّوْحُ المَحْفُوظُ."]],"71":[["سُلْطَانًا","حُجَّةً، وَبُرْهَانًا."]],"72":[["ٱلْمُنكَرَ","الكَرَاهَةُ ظَاهِرَةٌ عَلَى وُجُوهِهِمْ."],["يَسُطُونَ","يَبْطِشُونَ."],["ٱلْمَصِيرُ","المَكَانُ الَّذِي يَصِيرُونَ إِلَيْهِ."]],"73":[["ٱلطَّالِبُ","المَعْبُودُ مِنْ دُونِ اللَّهِ الَّذِي أُخِذَ مِنْهُ شَيْءٌ."],["وَٱلْمَطْلُوبُ","الدُّبَابُ."]],"74":[["مَا قَدَرُواْ","مَا عَظَّمُوا."]],"75":[["يَصْطَفِي","يَخْتَارُ."]],"78":[["حَرَجٍ","ضِيقٍ، وَشِدَّةٍ."],["ٱجْتَبَٰكُمْ","اصْطَفَاكُمْ."],["مِلَّةَ أَبِيكُمْ","هَذِهِ المِلَّةُ السَّمْحَةُ مِلَّةُ أَبِيكُمْ."],["هُوَ سَمَّاكُمُ","اللَّهُ سَمَّاكُمُ المُسْلِمِينَ فِي الكُتُبِ السَّابِقَةِ."],["مَوْلٰيكُمْ","مَالِكُكُمْ، وَنَاصِرُكُمْ، وَمُتَوَلِّي أُمُورِكُمْ."]]}