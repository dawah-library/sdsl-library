{"6":[["لَهْوَ الْحَدِيثِ","مَا يُلْهِي عَنْ طَاعَةِ اللَّهِ؛ كَالْغِنَاءِ."],["هُزُوًا","سُخْرِيَةً."]],"7":[["وَقْرًا","صَمَمًا."]],"10":[["رَوَاسِيَ","جِبَالًا ثَابِتَةً."],["أَنْ تَمِيدَ","لِئَلَّا تَضْطَرِبَ وَتَتَحَرَّكَ."],["وَبَثَّ","نَشَرَ."],["زَوْجٍ كَرِيمٍ","صِنْفٍ بَهِيجٍ نَافِعٍ حَسَنٍ الْمَنْظَرِ."]],"12":[["الْحِكْمَةَ","الْفِقْهَ فِي الدِّينِ، وَالْإِصَابَةَ فِي الْقَوْلِ."]],"14":[["وَهْنًا","ضَعْفًا."],["وَفِصَالُهُ","فِطَامُهُ عَنِ الرَّضَاعَةِ."]],"15":[["سَبِيلَ","طَرِيقَ."],["أَنَابَ","رَجَعَ، وَتَابَ."]],"16":[["مِثْقَالُ","وَزْنٌ، وَمِقْدَارٌ."],["حَبَّةٍ مِنْ خَرْدَلٍ","حَبَّةٍ صَغِيرَةٍ مُتَنَاهِيَةٍ فِي الصِّغَرِ."],["يَأْتِ بِهَا اللَّهُ","يَأْتِ بِهَا يَوْمَ الْقِيَامَةِ، وَيُحَاسِبْ عَلَيْهَا."]],"17":[["مِنْ عَزْمِ الْأُمُورِ","مِنَ الْأُمُورِ الَّتِي يَنْبَغِي الْحِرْصُ عَلَيْهَا."]],"18":[["وَلَا تُصَعِّرْ خَدَّكَ","لَا تُمِلْ وَجْهَكَ كِبْرًا وَتَعَاظُمًا."],["مَرَحًا","مُخْتَالًا مُتَبَخْتِرًا."],["مُخْتَالٍ","مُتَكَبِّرٍ بِفِعْلِهِ."],["فَخُورٍ","مُتَكَبِّرٍ بِقَوْلِهِ."]],"19":[["وَاقْصِدْ","تَوَاضَعْ، وَكُنْ بَيْنَ الْمُسْرِعِ، وَالْمُبْطِئِ."],["وَاغْضُضْ","اخْفِضْ."],["أَنْكَرَ","أَقْبَحَ، وَأَبْغَضَ."]],"20":[["سَخَّرَ لَكُمْ","ذَلَّلَ لَكُمْ."],["وَأَسْبَغَ","عَمَّكُمْ بِنِعَمِهِ."]],"22":[["يُسْلِمْ وَجْهَهُ","يُخْلِصْ عِبَادَتَهُ وَقَصْدَهُ إِلَى اللَّهِ."],["اسْتَمْسَكَ","تَعَلَّقَ، وَاعْتَصَمَ."],["بِالْعُرْوَةِ الْوُثْقَى","أَوْثَقَ سَبَبٍ مُوصِلٍ إِلَى رِضْوَانِ اللَّهِ."],["عَاقِبَةُ","مَآلٌ، وَمَرْجِعٌ."]],"24":[["غَلِيظٍ","فَظِيعٍ ثَقِيلٍ."]],"29":[["وَيُولِجُ","يُدْخِلُ؛ بِأَنْ يَأْخُذَ مِنْ سَاعَاتِ اللَّيْلِ فَيَطُولُ النَّهَارُ، وَالْعَكْسِ."]],"31":[["الْفُلْكِ","السُّفُنِ."],["بِنِعْمَتِ اللَّهِ","بِأَمْرِ اللَّهِ وَرَحْمَتِهِ."]],"32":[["غَشِيَهُمْ","عَلَاهُمْ."],["كَالظُّلَلِ","كَالسَّحَابِ، أَوْ الْجِبَالِ الْمُظَلَّّةِ."],["مُقْتَصِدٍ","مُتَوَسِّطٍ لَمْ يَقُمْ بِشُكْرِ اللَّهِ عَلَى وَجْهِ الْكَمَالِ."],["خَتَّارٍ","غَدَّارٍ نَاقِضٍ لِلْعَهْدِ."],["كَفُورٍ","جَحُودٍ لِنِعَمِ اللَّهِ."]],"33":[["لَا يَجْزِي وَالِدٌ","لَا يُغْنِي فِيهِ وَالِدٌ."],["فَلَا تَغُرَّنَّكُمُ","فَلَا تَخْدَعَنَّكُمْ، وَتُلْهِيَنَّكُمْ."],["الْغَرُورُ","مَا يَغُرُّ وَيَخْدَعُ مِنْ شَيْطَانٍ وَغَيْرِهِ."]]}