{"1":[["لَا أُقْسِمُ","أَقْسِمُ، وَ(لَا): تَأْكِيدٌ لِلْقَسَمِ."]],"2":[["اللَّوَّامَةُ","النَّفْسُ الَّتِي تَلُومُ صَاحِبَهَا."]],"4":[["نُسَوِّي بَنَانَهُ","نَجْعَلُ أَصَابِعَ يَدَيْهِ وَرِجْلَيْهِ شَيْئًا مُسْتَوِيًا؛ كَخُفِّ الْبَعِيرِ، أَوْ نُعِيدُ خَلْقَهَا كَمَا كَانَتْ."]],"6":[["أَيَّانَ","مَتَى؟"]],"7":[["بَرِقَ الْبَصَرُ","تَحَيَّرَ الْبَصَرُ وَدُهِشَ لِأَهْوَالِ الْقِيَامَةِ."]],"11":[["لَا وَزَرَ","لَا مَلْجَأَ وَلَا مَنْجَى لَهُ مِنَ اللَّهِ."]],"12":[["الْمُسْتَقَرُّ","الْمَرْجِعُ، وَالْمَصِيرُ."]],"14":[["عَلَى نَفْسِهِ بَصِيرَةٌ","شَاهِدٌ تَنْطِقُ جَوَارِحُهُ بِعَمَلِهِ."]],"15":[["وَلَوْ أَلْقَى مَعَاذِيرَهُ","لَوْ جَاءَ بِكُلِّ مَعْذِرَةٍ يَعْتَذِرُ بِهَا، مَا قُبِلَتْ."]],"16":[["لِتَعْجَلَ بِهِ","لِتَسْتَعْجِلَ حِفْظَ مَا يُوحَى إِلَيْكَ."]],"17":[["جَمْعَهُ","فِي صَدْرِكَ."],["وَقُرْآنَهُ","قِرَاءَتَهُ بِلِسَانِكَ مَتَى شِئْتَ."]],"18":[["فَإِذَا قَرَأْنَاهُ","اسْتَمِعْ لِقِرَاءَتِهِ مِنْ جِبْرِيلَ، ثُمَّ اقْرَأْهُ كَمَا أَقْرَأَكَ."]],"19":[["بَيَانَهُ","تَفْسِيرَ مَا أَشْكَلَ عَلَيْكَ فَهْمُهُ."]],"22":[["نَاضِرَةٌ","مُشْرِقَةٌ، حَسَنَةٌ."]],"23":[["نَاظِرَةٌ","تَرَى رَبَّهَا فِي الْجَنَّةِ."]],"24":[["بَاسِرَةٌ","عَابِسَةٌ، كَالِحَةٌ."]],"25":[["فَاقِرَةٌ","مُصِيبَةٌ عَظِيمَةٌ تَقْصِمُ فَقَارَ الظَّهْرِ."]],"26":[["كَلَّا","حَقًّا."],["بَلَغَتِ التَّرَاقِيَ","وَصَلَتِ الرُّوحُ إِلَى أَعَالِي الصَّدْرِ."]],"27":[["مَنْ رَاقٍ","هَلْ مِنْ رَاقٍ يَرْقِيهِ، وَيَشْفِيهِ؟"]],"28":[["وَظَنَّ","أَيْقَنَ الْمُحْتَضَرُ."]],"29":[["وَالْتَفَّتِ السَّاقُ بِالسَّاقِ","اتَّصَلَتْ شِدَّةُ آخِرِ الدُّنْيَا بِشِدَّةِ أَوَّلِ الْآخِرَةِ، وَالْتَفَّتْ إِحْدَى سَاقَيْهِ بِالْأُخْرَى عِنْدَ الْمَوْتِ."]],"30":[["الْمَسَاقُ","سَوْقُ الْعِبَادِ لِلْجَزَاءِ."]],"32":[["وَتَوَلَّى","أَعْرَضَ عَنِ الْإِيمَانِ."]],"33":[["يَتَمَطَّى","يَتَبَخْتَرُ فِي مِشْيَتِهِ مُخْتَالًا."]],"34":[["أَوْلَى لَكَ فَأَوْلَى","كَلِمَةُ وَعِيدٍ، أَيْ: هَلَاكٌ لَكَ فَهَلَاكٌ."]],"36":[["سُدًى","هَمَلًا لَا يُؤْمَرُ، وَلَا يُحَاسَبُ."]],"37":[["يُمْنَى","يُصَبُّ فِي الرَّحِمِ."]],"38":[["عَلَقَةً","قِطْعَةً مِنْ دَمٍ جَامِدٍ."],["فَسَوَّى","عَدَّلَ خَلْقَهُ، وَأَعْضَاءَهُ."]]}