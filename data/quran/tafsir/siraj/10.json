{"3":[["اسْتَوَى عَلَى الْعَرْشِ","عَلَا عَلَى الْعَرْشِ عُلُوًّا يَلِيقُ بِجَلَالِهِ وَعَظَمَتِهِ."]],"4":[["بِالْقِسْطِ","بِالْعَدْلِ."]],"5":[["وَقَدَّرَهُ مَنَازِلَ","صَيَّرَ الْقَمَرَ ذَا مَنَازِلَ يَسِيرُ فِيهَا."]],"6":[["اخْتِلَافِ","تَعَاقُبٍ."]],"10":[["دَعْوَاهُمْ","دُعَاؤُهُمْ."]],"11":[["يَعْمَهُونَ","يَتَرَدَّدُونَ حَائِرِينَ."]],"12":[["لِجَنْبِهِ","مُضْطَجِعًا."],["مَرَّ","اسْتَمَرَّ عَلَى كُفْرِهِ."]],"13":[["الْقُرُونَ","الْأُمَمَ الْمُكَذِّبَةَ."]],"14":[["جَعَلْنَاكُمْ خَلَائِفَ","اسْتَخْلَفْنَاكُمْ مِنْ بَعْدِ إِهْلَاكِهِمْ."]],"15":[["تِلْقَاءِ نَفْسِي","مِنْ قَبْلِ نَفْسِي."]],"16":[["أَدْرَكُمْ","أَعْلَمَكُمْ."]],"22":[["الْفُلْكِ","السُّفُنِ."],["عَاصِفٌ","شَدِيدَةُ الْهُبُوبِ."]],"24":[["زُخْرُفَهَا","بَهْجَتَهَا وَنَضَارَتَهَا."],["حَصِيدًا","مَحْصُودَةً، مَقْطُوعَةً."],["لَمْ تَغْنَ بِالْأَمْسِ","لَمْ تَكُنْ قَائِمَةً بِالْأَمْسِ."]],"25":[["دَارِ السَّلَامِ","الْجَنَّةُ."]],"26":[["الْحُسْنَى","الْجَنَّةُ."],["وَزِيَادَةً","زَائِدَةً عَلَى الْجَنَّةِ وَهِيَ: النَّظَرُ إِلَى وَجْهِ اللَّهِ الْكَرِيمِ."]],"27":[["يَرْهَقُهُمْ","يَغْشَى."],["عَاصِمٍ","مَانِعٍ يَمْنَعُ عَذَابَ اللَّهِ."],["أُغْشِيَتْ","أُلْبِسْتُ."]],"28":[["مَكَانَكُمْ","الزَّمُوا مَكَانَكُمْ."]],"30":[["تَبْلُواْ","تُعَايِنُ، وَتَتَفَقَّدُ."]],"32":[["الْحَقُّ","اللَّهُ الَّذِي لَا رَيْبَ فِي رُبُوبِيَّتِهِ وَأُلُوهِيَّتِهِ."]],"34":[["فَأَنَّى تُؤْفَكُونَ","فَكَيْفَ تُصْرَفُونَ؟!"]],"35":[["لَا يَهْدِي","لَا يَهْتَدِي."]],"39":[["وَلَمَّا يَأْتِهِمْ تَأْوِيلُهُ","وَلَمْ يَأْتِهِمْ بَعْدُ حَقِيقَةُ مَا وُعِدُوا بِهِ فِي الْكِتَابِ."]],"43":[["يَنْظُرُ إِلَيْكَ","يُبْصِرُكَ، وَيُعَايِنُ أَدِلَّةَ نُبُوَّتِكَ الصَّادِقَةَ."]],"50":[["بَيَاتًا","لَيْلًا."]],"51":[["أَثُمَّ","أَبَعْدَمَا؟"]],"53":[["وَيَسْتَنْبِئُونَكَ","يَسْتَخْبِرُونَكَ."]],"54":[["بِالْقِسْطِ","بِالْعَدْلِ."]],"59":[["تَفْتَرُونَ","تَكْذِبُونَ."]],"61":[["شَأْنٍ","أَمْرٍ مِنْ أُمُورِكَ."],["تُفِيضُونَ","تَشْرَعُونَ فِيهِ، وَتَعْمَلُونَهُ."],["يَعْزُبُ","يَغِيبُ."],["مِثْقَالَ ذَرَّةٍ","زِنَةَ نَمْلَةٍ صَغِيرَةٍ."]],"68":[["سُبْحَانَهُ","تَنَزَّهَ، وَتَقَدَّسَ."],["سُلْطَانٍ","حُجَّةٍ، وَدَلِيلٍ."]],"71":[["فَأَجْمِعُواْ","اعْزِمُوا، وَأَعِدُّوا."],["غُمَّةً","مُسْتَتِيرًا."],["أَقْضُواْ إِلَيَّ","اقْضُوا عَلَيَّ بِالْعُقُوبَةِ."],["تُنظِرُونِ","تُمْهِلُونِ."]],"73":[["الْفُلْكِ","السَّفِينَةَ."],["خَلَائِفَ","يَخْلُفُونَ الْمُكَذِّبِينَ فِي الْأَرْضِ."]],"74":[["نَطْبَعُ","نَخْتِمُ."]],"78":[["الْكِبْرِيَاءُ","الْعَظَمَةُ، وَالسُّلْطَانُ."]],"82":[["وَيُحِقُّ","يُثْبِتُ وَيُعْلِي."]],"83":[["لَعَالٍ","لَجَبَّارٍ، مُسْتَكْبِرٍ."],["الْمُسْرِفِينَ","الْمُتَجَاوِزِينَ الْحَدَّ فِي الْكُفْرِ وَالْفَسَادِ."]],"84":[["مُسْلِمِينَ","مُذْعِنِينَ لَهُ بِالطَّاعَةِ."]],"85":[["لَا تَجْعَلْنَا فِتْنَةً لِلْقَوْمِ الظَّالِمِينَ","لَا تُنْصِرْهُمْ عَلَيْنَا، فَيَظُنُّوا أَنَّهُمْ عَلَى الْحَقِّ؛ فَيَفْتَتِنُوا، أَوْ يَفْتِنُونَا عَنِ الدِّينِ."]],"87":[["قِبْلَةً","مَسَاجِدَ تُصَلُّونَ فِيهَا عِنْدَ الْخَوْفِ."]],"88":[["اطْمِسْ عَلَى أَمْوَالِهِمْ","أَتْلِفْهَا."],["وَاشْدُدْ عَلَى قُلُوبِهِمْ","اخْتِمْ عَلَيْهَا حَتَّى لَا تُؤْمِنَ."]],"89":[["فَاسْتَقِيمَا","فَثُبْتَا عَلَى الدِّينِ، وَاسْتَمِرَّا عَلَى الدَّعْوَةِ."],["وَلَا تَتَّبِعَانِّ","لَا تَسْلُكَا."]],"90":[["وَجَاوَزْنَا","قَطَعْنَا."],["بَغْيًا وَعَدُوًّا","ظُلْمًا، وَعُدْوَانًا."]],"92":[["نُنْجِيكَ","نُخْرِجُكَ مِنَ الْبَحْرِ، وَنَجْعَلُكَ عَلَى مُرْتَفِعٍ مِنَ الْأَرْضِ."],["وَآيَةً","عِبْرَةً."]],"93":[["بَوَّأْنَا","أَنْزَلْنَا."],["مَبَوَّأَ صِدْقٍ","مَنْزِلًا صَالِحًا بِالشَّامِ وَمِصْرَ."]],"94":[["الْمُمْتَرِينَ","الشَّاكِّينَ."]],"96":[["حَقَّتْ","وَجَبَتْ."]],"98":[["فَلَوْلَا","فَهَلَّا."],["الْخِزْيُ","الذُّلُّ وَالْهَوَانُ."]],"100":[["الرِّجْسُ","العَذَابُ."]],"101":[["وَمَا تُغْنِي","لَا تَنْفَعُ."]],"105":[["وَأَقِمْ وَجْهَكَ لِلدِّينِ","أَقِمْ نَفْسَكَ عَلَى الإِسْلَامِ مُسْتَقِيمًا عَلَيْهِ."],["حَنِيفًا","مَائِلًا عَنِ الشِّرْكِ إِلَى التَّوْحِيدِ."]]}