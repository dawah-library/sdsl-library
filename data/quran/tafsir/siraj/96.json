{"2":[["عَلَقٍ","قِطْعَةُ دَمٍ غَلِيظٍ."]],"6":[["كَلَّا","حَقًّا."],["لَيَطْغَى","لَيَتَجَاوَزُ الحَدَّ فِي العِصْيَانِ، وَالكِبْرِ."]],"7":[["أَنْ رَآهُ اسْتَغْنَى","بِسَبَبِ أَنْ رَأَى نَفْسَهُ مُسْتَغْنِيًا بِمَالِهِ."]],"8":[["الرُّجْعَى","الرُّجُوعُ، وَالمَصِيرُ."]],"9":[["أَرَأَيْتَ","أَلَا تَعْجَبُ!!"]],"13":[["وَتَوَلَّى","أَعْرَضَ عَنِ الإِيمَانِ."]],"15":[["بِالنَّاصِيَةِ","بِمُقَدَّمِ رَأْسِهِ."]],"16":[["خَاطِئَةٍ","آثِمَةٍ."]],"17":[["فَلْيَدْعُ","فَلْيَحْضُرْ، وَلْيُنَادِ."],["نَادِيَهُ","أَهْلَ مَجْلِسِهِ مِنْ قَوْمِهِ، وَعَشِيرَتِهِ."]],"18":[["الزَّبَانِيَةَ","مَلَائِكَةَ العَذَابِ."]],"19":[["كَلَّا","لَيْسَ الأَمْرُ عَلَى مَا يَظُنُّ أَبُو جَهْلٍ."],["وَاسْجُدْ","اِقْرَبْ مِنْهُ بِالطَّاعَةِ."]]}