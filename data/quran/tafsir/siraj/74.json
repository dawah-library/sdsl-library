{"12":[["مَمْدُودًا","مَبْسُوطًا وَاسِعًا."]],"13":[["شُهُودًا","حُضُورًا مَعَهُ فِي مَكَّةَ لَا يَغِيبُونَ عَنْهُ."]],"14":[["وَمَهَّدْتُ لَهُ تَمْهِيدًا","يَسَّرْتُ لَهُ سُبُلَ العَيْشِ تَيْسِيرًا."]],"17":[["سَأُرْهِقُهُ صَعُودًا","سَأُكَلِّفُهُ عَذَابًا شَاقًّا لَا رَاحَةَ فِيهِ."]],"18":[["وَقَدَّرَ","هَيَّأَ مَا يَقُولُهُ فِي الطَّعْنِ فِي القُرْآنِ، وَمَنْ"]],"19":[["فَقُتِلَ","غُلِبَ وَقُهِرَ."]],"21":[["نَظَرَ","تَأَمَّلَ فِيمَا هَيَّأَ مِنَ الطَّعْنِ."]],"22":[["عَبَسَ","قَطَّبَ وَجْهَهُ."],["وَبَسَرَ","اشْتَدَّ فِي العُبُوسِ لَمَّا ضَاقَتْ عَلَيْهِ الحِيَلُ فِي"]],"23":[["أَدْبَرَ","رَجَعَ مُعْرِضًا عَنِ الحَقِّ."]],"24":[["يُؤْثَرُ","يُنْقَلُ عَنِ الأَوَّلِينَ."]],"26":[["سَأُصْلِيهِ سَقَرَ","سَأُدْخِلُهُ جَهَنَّمَ؛ كَيْ يَصْلَى حَرَّهَا."]],"28":[["لَا تُبْقِي","لَا تَتْرُكُ لَحْمًا."],["وَلَا تَذَرُ","لَا تَتْرُكُ عَظْمًا."]],"29":[["لَوَّاحَةً لِلْبَشَرِ","مُحْرِقَةٌ لِلْجُلُودِ، مُغَيِّرَةٌ لِلْبَشَرَةِ."]],"31":[["فِتْنَةً","اخْتِبَارًا لِلْكُفَّارِ."],["وَلَا يَرْتَابَ","لَا يَشُكَّ."],["مَرَضٌ","نِفَاقٌ."],["جُنُودُ رَبِّكَ","مَلَائِكَتُهُ."]],"35":[["إِنَّهَا لَإِحْدَى الْكُبَرِ","إِنَّ النَّارَ لَإِحْدَى الْعَظَائِمِ."]],"38":[["رَهِينَةٌ","مَحْبُوسَةٌ بِعَمَلِهَا."]],"42":[["مَا سَلَكَكُمْ","مَا أَدْخَلَكُمْ."]],"45":[["نَخُوضُ","نَتَحَدَّثُ بِالْبَاطِلِ."]],"47":[["الْيَقِينُ","الْمَوْتُ."]],"50":[["حُمُرٌ","حُمُرٌ وَحْشِيَّةٌ شَدِيدَةُ النِّفَارِ."]],"51":[["قَسْوَرَةٌ","أَسَدٌ كَاسِرٌ."]],"56":[["أَهْلَ التَّقْوَى","أَهْلٌ لِأَنْ يُتَّقَى، وَيُطَاعَ."]]}