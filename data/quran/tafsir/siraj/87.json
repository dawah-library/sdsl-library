{"1":[["سَبِّحِ اسْمَ رَبِّكَ","نَزِّهْ رَبَّكَ ذَاكِرًا اسْمَهُ بِلِسَانِكَ."],["الْأَعْلَى","الَّذِي لَهُ عُلُوُّ الذَّاتِ، وَعُلُوُّ الْقَدْرِ، وَعُلُوُّ الْقَهْرِ."]],"2":[["فَسَوَّى","أَتْقَنَ خَلْقَهُ، وَأَحْسَنَهُ."]],"3":[["فَهَدَى","يَسَّرَ لَهُ مَا يُنَاسِبُهُ."]],"4":[["الْمَرْعَى","الْكَلَأَ الْأَخْضَرَ."]],"5":[["غُثَاءً","هَشِيمًا جَافًّا."],["أَحْوَى","مُتَغَيِّرًا."]],"7":[["إِلَّا مَا شَاءَ اللَّهُ","إِلَّا مَا أَرَادَ اللَّهُ أَنْ يَنْسَخَ تِلَاوَتَهُ وَحُكْمَهُ، وَيُنْسِيَكَ إِيَّاهُ."]],"8":[["لِلْيُسْرَى","لِلطَّرِيقَةِ المُيَسَّرَةِ فِي شَرِيعَتِكَ، وَحَيَاتِكَ."]],"12":[["يَصْلَى النَّارَ","يَدْخُلُهَا، وَيُقَاسِي حَرَّهَا."]],"14":[["أَفْلَحَ","فَازَ، وَظَفِرَ بِالمَطْلُوبِ."],["تَزَكَّى","طَهَّرَ نَفْسَهُ مِنَ المَعَاصِي، وَحَلَّاهَا بِالطَّاعَةِ."]]}