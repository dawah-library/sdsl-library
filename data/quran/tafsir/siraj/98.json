{"1":[["مُنْفَكِّينَ","تَارِكِينَ كُفْرَهُمْ."],["الْبَيِّنَةُ","العَلَامَةُ الَّتِي وُعِدُوا بِهَا فِي الكُتُبِ السَّابِقَةِ."]],"2":[["رَسُولٌ مِنَ اللَّهِ","أَيْ: وَالبَيِّنَةُ رَسُولٌ مِنَ اللَّهِ."],["يَتْلُوا","يَقْرَأُ."]],"3":[["كُتُبٌ قَيِّمَةٌ","أَخْبَارٌ صَادِقَةٌ، وَأَوَامِرُ عَادِلَةٌ."]],"4":[["تَفَرَّقُوا","اخْتَلَفَ."],["أُوتُوا الْكِتَابَ","اليَهُودُ وَالنَّصَارَى."],["الْبَيِّنَةُ","مِنْ بَعْدِ مَا تَبَيَّنُوا أَنَّهُ نَبِيٌّ حَقًّا، تَفَرَّقُوا، وَكَانُوا مُجْتَمِعِينَ عَلَى صِحَّةِ نُبُوَّتِهِ قَبْلَ ذَلِكَ."]],"5":[["مُخْلِصِينَ","قَاصِدِينَ وَجْهَ اللَّهِ وَحْدَهُ."],["حُنَفَاءَ","مَائِلِينَ عَنِ الشِّرْكِ إِلَى الإِيمَانِ."],["الْقَيِّمَةُ","الِاسْتِقَامَةُ."]],"6":[["الْبَرِيَّةِ","الخَلِيقَةُ."]],"8":[["عَدْنٍ","إِقَامَةٍ، وَاسْتِقْرَارٍ."]]}