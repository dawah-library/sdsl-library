{"3":[["لَيْلَةٍ مُّبَٰرَكَةٍ","هِيَ: لَيْلَةُ القَدْرِ مِنْ شَهْرِ رَمَضَانَ."]],"4":[["يُفْرَقُ","يُقْضَى وَيُفْصَلُ مِنَ اللَّوْحِ المَحْفُوظِ إِلَى الكَتَبَةِ مِنَ المَلَائِكَةِ."],["أَمْرٍ حَكِيمٍ","أَمْرٍ مُحْكَمٍ؛ مِنَ الآجَالِ، وَالأَرْزَاقِ، فِي تِلْكَ السُّنَّةِ."]],"10":[["فَارْتَقِبْ","انْتَظِرْ هَؤُلَاءِ المُشْرِكِينَ."]],"11":[["يَغْشَى","يَعُمُّ."]],"13":[["أَنَّى لَهُمُ الذِّكْرَىٰ","كَيْفَ يَكُونُ لَهُمُ التَّذَكُّرُ وَالِاتِّعَاظُ؟!"],["رَّسُولٌ مُّبِينٌ","بَيِّنُ الرِّسَالَةِ؛ وَهُوَ نَبِيِّنَا مُحَمَّدٍ ﷺ."]],"14":[["تَوَلَّوْا","أَعْرَضُوا."],["مَّعْلُمُ","عَلَمَهُ بَشَرٌ، أَوْ شَيْطَانٌ."]],"16":[["ٱلْبَطْشَةَ ٱلْكُبْرَىٰ","العَذَابُ الأَكْبَرُ يَوْمَ القِيَامَةِ."]],"17":[["فَتَنَّا","اخْتَبَرْنَا وَابْتَلَيْنَا."]],"18":[["أَدُّوا إِلَىَّ","سَلِّمُوا لِي عِبَادَ اللَّهِ مِنْ بَنِي إِسْرَائِيلَ."]],"19":[["وَأَن لَّا تَعْلُوا","أَلَّا تَتَكَبَّرُوا."]],"20":[["أَن تَرْجُمُونِ","أَنْ تَقْتُلُونِي رَجْمًا بِالحِجَارَةِ."]],"24":[["رَهْوًا","سَاكِنًا غَيْرَ مُضْطَرِبٍ."]],"26":[["وَمَقَامٍ كَرِيمٍ","مَنَازِلَ جَمِيلَةٍ."]],"27":[["وَنَعْمَةٍ","عِيشَةً، وَتَنَعُّمًا."],["فَكِهِينَ","نَاعِمِينَ مُتْرَفِينَ."]],"29":[["مُنظَرِينَ","مُؤَخَّرِينَ عَنِ العُقُوبَةِ."]],"30":[["ٱلْعَذَابِ ٱلْمُهِينِ","المُذِلُّ؛ وَهُوَ قَتْلُ أَبْنَائِهِمْ، وَاسْتِخْدَامُ نِسَائِهِمْ."]],"31":[["عَالِيًا","مُتَكَبِّرًا جَبَّارًا."]],"32":[["ٱخْتَرْنٰهُمْ","اصْطَفَيْنَاهُمْ."],["عَلَى ٱلْعَٰلَمِينَ","عَالَمِي زَمَانِهِمْ."]],"35":[["بِمُنشَرِينَ","بَمْبَعُوثِينَ."]],"41":[["لَّا يُغْنِي مَوْلًى","لَا يَدْفَعُ صَاحِبٌ."]],"44":[["ٱلْأَثِيمِ","صَاحِبُ الآثَامِ الكَبِيرَةِ."]],"45":[["كَالْمُهْلِ","كَالْمَعْدِنِ الْمُذَابِ."]],"46":[["وَالْحَمِيمِ","الْمَاءِ الَّذِي بَلَغَ الْغَايَةَ فِي الْحَرَارَةِ."]],"47":[["فَاعْتِلُوهُ","جُرُّوهُ وَسُوقُوهُ بِعُنْفٍ."],["سَوَاءِ الْجَحِيمِ","وَسَطِ الْجَحِيمِ."]],"49":[["أَنْتَ الْعَزِيزُ الْكَرِيمُ","عَلَى وَجْهِ التَّهَكُّمِ، وَالتَّوْبِيخِ لَهُمْ."]],"50":[["تَمْتَرُونَ","تَشُكُّونَ."]],"51":[["مَقَامٍ أَمِينٍ","مَوْضِعٍ يُؤْمَنُ فِيهِ الْخَوْفُ، وَالْآفَاتُ، وَالْأَحْزَانُ."]],"53":[["سُندُسٍ","هُوَ: الرَّقِيقُ مِنَ الدِّيبَاجِ."],["وَإِسْتَبْرَقٍ","هُوَ: الْغَلِيظُ مِنَ الدِّيبَاجِ."]],"54":[["بِحُورٍ عِينٍ","نِسَاءِ الْجَنَّةِ الْحِسَانِ، الْوَاسِعَاتِ الْأَعْيُنِ."]],"55":[["يَدْعُونَ فِيهَا","يَطْلُبُونَ فِيهَا."]],"56":[["الْمَوْتَةَ الْأُولَى","الَّتِي ذَاقُوهَا فِي الدُّنْيَا."]],"59":[["فَارْتَقِبْ","انْتَظِرْ نَصْرَكَ، وَهَلَاكَهُمْ."],["مُرْتَقِبُونَ","مُنْتَظِرُونَ مَوْتَكَ، وَهَزِيمَتَكَ."]]}