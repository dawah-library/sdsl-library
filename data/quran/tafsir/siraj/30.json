{"2":[["غُلِبَتِ الرُّومُ","هُزِمَتْ فَارِسُ الرُّومِ."]],"3":[["أَدْنَى الْأَرْضِ","أَقْرَبُ أَرْضِ الشَّامِ إِلَى فَارِسَ."],["غَلَبِهِمْ","كَوْنِهِمْ مَغْلُوبِينَ."]],"4":[["بِضْعِ سِنِينَ","البِضْعُ: مُدَّةٌ لَا تَزِيدُ عَلَى عَشْرِ سَنَوَاتٍ، وَلَا تَنْقُصُ عَنْ ثَلَاثٍ."]],"8":[["وَأَجَلٍ مُّسَمًّى","وَقْتٍ مُقَدَّرٍ تَنْتَهِي إِلَيْهِ."]],"9":[["وَأَثَارُوا","حَرَثُوا وَزَرَعُوا."]],"10":[["السُّوأَىٰ","العُقُوبَةُ المُتَنَاهِيَةُ فِي السُّوءِ."]],"12":[["يُبْلِسُ","يَيْأَسُ مِنَ النَّجَاةِ مِنَ العَذَابِ."]],"15":[["يُحْبَرُونَ","يُكْرَمُونَ، وَيُنْعَمُونَ."]],"16":[["مُحْضَرُونَ","مُقِيمُونَ."]],"18":[["تُظْهِرُونَ","تَدْخُلُونَ وَقْتَ الظَّهِيرَةِ."]],"22":[["لِلْعَالِمِينَ","جَمْعُ عَالِمٍ، وَهُمْ ذَوُو العِلْمِ وَالبَصِيرَةِ."]],"23":[["وَابْتِغَاؤُكُم مِّنْ فَضْلِهِ","طَلَبُكُمْ لِلرِّزْقِ فِي النَّهَارِ."]],"24":[["خَوْفًا وَطَمَعًا","تَخَافُونَ مِنَ الصَّوَاعِقِ، وَتَطْمَعُونَ فِي الغَيْثِ."]],"26":[["قَانِتُونَ","مُطِيعُونَ مُنْقَادُونَ لِأَمْرِهِ."]],"27":[["وَلَهُ الْمَثَلُ الْأَعْلَىٰ","الوَصْفُ الأَعْلَى فِي كُلِّ مَا يُوصَفُ بِهِ."]],"28":[["فَأَنتُم فِيهِ سَوَاءٌ","مُتَسَاوُونَ."]],"30":[["حَنِيفًا","مَائِلًا إِلَى الدِّينِ، مُسْتَقِيمًا عَلَيْهِ."],["فِطْرَتَ اللَّهِ","الزَّمُوا دِينَ اللَّهِ، وَهُوَ الإِسْلَامُ."],["فَطَرَ النَّاسَ عَلَيْهَا","جَبَلَهُمْ وَطَبَعَهُمْ عَلَيْهَا."],["الْقَيِّمُ","المُسْتَقِيمُ المُوصِلُ إِلَى رِضَا اللَّهِ."]],"31":[["مُنِيبِينَ إِلَيْهِ","رَاجِعِينَ إِلَيْهِ بِالتَّوْبَةِ وَإِخْلَاصِ العَمَلِ لَهُ."]],"32":[["فَرَّقُوا دِينَهُمْ","بَدَّلُوا دِينَهُمْ وَغَيَّرُوهُ فَأَخَذُوا بَعْضًا وَتَرَكُوا بَعْضًا."],["شِيَعًا","فِرَقًا وَأَحْزَابًا."]],"35":[["سُلْطَانًا","بُرْهَانًا سَاطِعًا وَكِتَابًا قَاطِعًا."]],"36":[["رَحْمَةً","نِعْمَةً؛ مِنْ صِحَّةٍ، وَرَخَاءٍ."],["فَرِحُوا بِهَا","فَرَحَ بَطَرٍ، وَأَشَرٍ، لَا فَرَحَ شُكْرٍ."],["سَيِّئَةٌ","فَقْرٌ، وَمَرَضٌ."],["يَقْنَطُونَ","يَيْأَسُونَ مِنْ زَوَالِ البَلَاءِ."]],"37":[["يَبْسُطُ","يُوَسِّعُ."],["وَيَقْدِرُ","يُضَيِّقُ."]],"39":[["رِّبًا","قَرْضًا مِنَ المَالِ بِقَصْدِ الرِّبَا المُحَرَّمِ."],["لِيَرْبُوا","لِيَزِيدَ."],["الْمُضْعِفُونَ","اللَّذِينَ يُضَاعِفُ اللَّهُ لَهُمُ الحَسَنَاتِ."]],"41":[["الْفَسَادُ","كَالجَدْبِ، وَالأَمْرَاضِ، وَالأَوْبِئَةِ."]],"43":[["الْقَيِّمُ","المُسْتَقِيمُ."],["لَا مَرَدَّ لَهُ","لَا يَقْدِرُ أَحَدٌ عَلَى رَدِّهِ."],["يَصَدَّعُونَ","يَتَفَرَّقُ الخَلَائِقُ أَشْتَاتًا، ثُمَّ مَالُهُمْ إِلَى الجَنَّةِ، أَوْ النَّارِ."]],"44":[["يَمْهَدُونَ","يُهَيِّئُونَ مَنَازِلَهُمْ فِي الجَنَّةِ."]],"46":[["مُبَشِّرَاتٍ","تُبَشِّرُ بِالمَطَرِ."],["الْفُلْكِ","السُّفُنِ."],["بِأَمْرِهِ","بِإِرَادَةِ اللَّهِ، وَمَشِيئَتِهِ."]],"48":[["فَتُثِيرُ","تُحَرِّكُ، وَتَنْشُرُ."],["كِسَفًا","قِطَعًا مُتَفَرِّقَةً."],["الْوَدْقَ","المَطَرَ."],["مِنْ خِلَالِهِ","مِنْ بَيْنِ السَّحَابِ."]],"49":[["لَمُبْلِسِينَ","يَائِسِينَ مِنْ نُزُولِهِ."]],"50":[["رَحْمَتِ اللَّهِ","المَطَرِ."]],"51":[["مُصْفَرًّا","صَارَ أَصْفَرَ بَعْدَ خُضْرَتِهِ؛ مِنَ الفَسَادِ."]],"54":[["مِنْ ضَعْفٍ","مِنَ النُّطْفَةِ المَهِينَةِ."],["مِنْ بَعْدِ ضَعْفٍ قُوَّةً","بَعْدَ ضَعْفِ الطُّفُولَةِ قُوَّةُ الرُّجُولَةِ."],["وَشَيْبَةً","شَيْخُوخَةً، وَهَرَمًا."]],"55":[["غَيْرَ سَاعَةٍ","غَيْرَ فَتْرَةٍ قَصِيرَةٍ مِنَ الزَّمَنِ."],["يُؤْفَكُونَ","يُصْرَفُونَ عَنِ الحَقِّ."]],"57":[["مَعْذِرَتُهُمْ","مَا يُقَدِّمُونَهُ مِنْ أَعْذَارٍ."],["وَلَا هُمْ يُسْتَعْتَبُونَ","لَا يُطْلَبُ مِنْهُمْ إِرْضَاءُ اللَّهِ بِالطَّاعَةِ وَالتَّوْبَةِ."]],"59":[["يَطْبَعُ","يَخْتِمُ."]],"60":[["وَلَا يَسْتَخِفَّنَّكَ","لَا يَسْتَفزَّنَّكَ، وَلَا يَحْمِلَنَّكَ عَلَى الْخِفَّةِ، وَالطَّيْشِ."]]}