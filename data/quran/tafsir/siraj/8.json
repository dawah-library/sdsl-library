{"1":[["الْأَنْفَالِ","الْغَنَائِمُ."]],"2":[["وَجِلَتْ","فَزِعَتْ."]],"7":[["الطَّائِفَتَيْنِ","عِيرُ قُرَيْشٍ، وَمَا تَحْمِلُهُ مِنْ أَرْزَاقٍ، أَوْ النَّفِيرُ لِقِتَالِهِمْ."],["ذَاتَ الشَّوْكَةِ","صَاحِبَةَ السِّلَاحِ، وَالْقُوَّةِ."],["وَيَقْطَعَ","يَسْتَأْصِلَ."],["دَابِرَ الْكَافِرِينَ","آخِرَهُمْ، وَالْمُرَادُ: جَمِيعَهُمْ."]],"9":[["مُرْدِفِينَ","يُتْبِعُ بَعْضُهُمْ بَعْضًا."]],"11":[["يُغْشِيكُمُ","يُلْقِي النُّعَاسَ عَلَيْكُمْ؛ كَالْغِطَاءِ."],["أَمَنَةً","أَمَانًا."],["رِجْزَ الشَّيْطَانِ","وَسَاوِسُهُ وَتَخْوِيفَاتُهِ."],["وَلِيُرْبِطَ","لِيَشُدَّ."]],"12":[["بَنَانِ","طَرَفٍ، وَمَفْصِلٍ."]],"15":[["زَحْفاً","مُتَقَارِبِينَ مِنْكُمْ، مُجْتَمِعِينَ؛ كَأَنَّهُمْ لِكَثْرَتِهِمْ يَزْحَفُونَ."],["الْأَدْبَارَ","الظُّهُورَ."]],"16":[["مُتَحَرِّفاً لِقِتَالٍ","مُظْهِرًا الْفِرَارَ؛ خُدْعَةً، ثُمَّ يَكُرُّ."],["مُتَحَيِّزاً إِلَى فِئَةٍ","مُنْحَازًا إِلَى جَمَاعَةِ الْمُسْلِمِينَ، سَوَاءٌ كَانُوا سَرِيَّةً فَانْحَازُوا لِلْجَيْشِ أَوْ انْحَازُوا لِلْإِمَامِ الْأَعْظَمِ."],["بَاءَ","رَجَعَ."],["الْمَصِيرُ","الْمَرْجِعُ، وَالْمَالُ."]],"17":[["وَلِيُبْلِيَ الْمُؤْمِنِينَ","لِيُنْعِمَ عَلَيْهِمْ بِالنَّصْرِ وَالْأَجْرِ."]],"18":[["مُوهِنُ","مُضْعِفُ."]],"19":[["تَسْتَفْتِحُوا","تَطْلُبُوا - أَيُّهَا الْكُفَّارُ - مِنَ اللَّهِ أَنْ يُوقِعَ بَأْسَهُ بِالظَّالِمِينَ."],["فِئَتُكُمْ","جَمَاعَتُكُمْ."]],"22":[["الصُّمُ","الَّذِينَ سُدَّتْ آذَانُهُمْ عَنْ سَمَاعِ الْحَقِّ."],["الْبُكْمُ","الَّذِينَ خَرِسَتْ أَلْسِنَتُهُمْ عَنِ النُّطْقِ بِالْحَقِّ."]],"25":[["فِتْنَةً","مِحْنَةً."]],"26":[["يَتَخَطَّفُكُمْ","يَأْخُذُكُمُ الْكُفَّارُ بِسُرْعَةٍ."],["فَآوَاكُمْ","أَسْكَنَكُمُ الْمَدِينَةَ."]],"28":[["فِتْنَةٌ","اخْتِبَارٌ، وَابْتِلَاءٌ؛ أَتُطِيعُونَهُ، وَتَشْكُرُونَهُ، أَمْ تَنْشَغِلُونَ بِهَا عَنْهُ؟"]],"29":[["فُرْقَاناً","مَخْرَجًا، وَنَجَاةً، وَهِدَايَةً، وَنُورًا."],["وَيُكَفِّرَ","يَمْحُ."],["وَيَغْفِرَ","يَسْتُرْ فَلَا يُؤَاخِذْ."]],"31":[["أَسَاطِيرُ","أَكَاذِيبُ، وَحِكَايَاتٌ."]],"35":[["مُكَاءً","صَفِيرًا."],["وَتَصْدِيَةً","تَصْفِيقًا."]],"36":[["حَسْرَةٌ","نَدَامَةً."]],"37":[["فَيَرْكُمَهُ","فَيَجْعَلَهُ مُلْقًى بَعْضُهُ فَوْقَ بَعْضٍ."]],"38":[["سَلَفَ","سَبَقَ."]],"39":[["فِتْنَةٌ","شِرْكٌ، وَصَدٌّ عَنْ سَبِيلِ اللَّهِ."]],"41":[["وَذِي الْقُرْبَى","قَرَابَةَ رَسُولِ اللَّهِ ﷺ، وَهُمْ: بَنُو هَاشِمٍ، وَبَنُو الْمُطَّلِبِ، جَعَلَ الْخُمُسَ لَهُمْ مَكَانَ الصَّدَقَةِ؛ فَإِنَّهَا لَا تَحِلُّ لَهُمْ."],["وَابْنِ السَّبِيلِ","الْمُسَافِرُ، الْمُنْقَطِعُ."],["الْجَمْعَانِ","جَمْعُ الْمُؤْمِنِينَ، وَجَمْعُ الْكَافِرِينَ."]],"42":[["بِالْعُدْوَةِ الدُّنْيَا","بِجَانِبِ الْوَادِي الْأَقْرَبِ إِلَى الْمَدِينَةِ."],["بِالْعُدْوَةِ الْقُصْوَى","بِجَانِبِ الْوَادِي الْأَبْعَدِ."],["وَالرَّكْبُ","عِيرُ قُرَيْشٍ الَّتِي فِيهَا تِجَارَتُهُمْ."],["أَسْفَلَ مِنْكُمْ","قُرْبًا مِنْ سَاحِلِ الْبَحْرِ الْأَحْمَرِ."]],"43":[["لَفَشِلْتُمْ","لَجَبِنْتُمْ، وَتَرَدَّدْتُمْ."],["سَلَّمَ","وَقَاكُمُ مِنَ الْفَشَلِ، وَنَجَاكُمْ مِنْ عَاقِبَتِهِ."]],"46":[["فَتَفْشَلُواْ","تَضْعُفُوا، وَتَجْبُنُوا."]],"47":[["بَطَرًا","كِبْرًا."]],"48":[["جَارٌ لَّكُمْ","نَاصِرُكُمْ، وَمُجِيرُكُمْ."],["تَرَاءَتِ","تَقَابَلَتْ."],["نَكَصَ","رَجَعَ مُدْبِرًا."]],"52":[["كَدَأْبِ","كَعَادَةٍ، وَسُنَّةٍ."]],"57":[["تَثْقَفَنَّهُمُ","تَجِدَنَّهُمْ."],["فَشَرِّدْ بِهِم مَّنْ خَلْفَهُمْ","أَنْزِلْ بِهِمْ عَذَابًا يُخَوِّفُ مَنْ وَرَاءَهُمْ."]],"58":[["فَانبِذْ","فَاطْرَحْ عَهْدَهُمْ."],["عَلَى سَوَاءٍ","لِتَكُونُوا وَإِيَّاهُمْ مُسْتَوِينَ فِي الْعِلْمِ بِطَرْحِهِ."]],"59":[["سَبَقُواْ","فَاتُوا، وَنَجَوْا مِنْ عَذَابِ اللَّهِ."]],"61":[["جَنَحُواْ","مَالُوا."],["لِلسَّلْمِ","لِلْمُسَالَمَةِ وَتَرْكِ الْحَرْبِ."],["فَاجَنَحْ","مِلْ."]],"62":[["حَسْبُكَ","كَافِيكَ."]],"65":[["حَرِّضِ","حُثَّ."]],"67":[["يُثْخِنَ","يُبَالِغُ فِي الْقَتْلِ."]],"71":[["فَأَمْكَنَ مِنْهُمْ","أَقْدَرَكَ عَلَيْهِمْ."]],"72":[["وَآوَوْاْ","أَنْزَلُوا الْمُهَاجِرِينَ فِي دُورِهِمْ."]],"75":[["وَأُوْلُوا الْأَرْحَامِ","ذَوُو الْقَرَابَاتِ."]]}