{"k":"hikam","n":"حكم ومواعظ جامعة","items":[{"id":"darimi-1138","q":"ذنب أتاه، وليس عليه كفارة","w":"سعيد بن جبير","t":"حكم في الكفارة","k":["hikam"],"r":{"b":"darimi","p":1302,"l":"ج1 ص716","n":"1138"},"x":[]},{"id":"darimi-1197","q":"استأصلي الشعر لا تخلله نار قليل بقياها عليه","w":"حذيفة بن اليمان","t":"نصيحة لتقليل ضرر الشعر","k":["hikam"],"r":{"b":"darimi","p":1365,"l":"","n":"1197"},"x":[]},{"id":"darimi-1705","q":"كنا نخرج زكاة الفطر من رمضان صاعا من طعام، أو صاعا من تمر، أو صاعا من شعير، أو صاعا من زبيب، أو صاعا من أقط","w":"أبو سعيد الخدري","t":"زكاة الفطر عند أبي سعيد","k":["ibadat","hikam"],"r":{"b":"darimi","p":2104,"l":"ج2 ص1034","n":"1705"},"x":[]},{"id":"darimi-1723","q":"الصدقة على المسكين صدقة، وهي على ذي الرحم اثنتان صدقة وصلة","w":"سفيان بن عيينة","t":"الصدقة عند سفيان بن عيينة","k":["hikam","akhlaq"],"r":{"b":"darimi","p":2129,"l":"ج2 ص1045","n":"1723"},"x":[]},{"id":"darimi-1895","q":"إنما جعل الطواف بالبيت، ورمي الجمار، والسعي بين الصفا والمروة لإقامة ذكر الله","w":"عائشة أم المؤمنين","t":"الطواف عند عائشة","k":["ibadat","hikam"],"r":{"b":"darimi","p":2385,"l":"ج2 ص1174","n":"1895"},"x":[]},{"id":"darimi-1975","q":"رخص للحائض أن تنفر إذا أفاضت","w":"عبد الله بن عباس","t":"رخصة الحائض عند ابن عباس","k":["ilm","hikam"],"r":{"b":"darimi","p":2506,"l":"ج2 ص1230","n":"1975"},"x":[]},{"id":"darimi-2917","q":"إنما أنت رجل تقول برأيك، وأنا رجل أقول برأيي","w":"عكرمة مولى ابن عباس","t":"قيمة الرأي","k":["hikam"],"r":{"b":"darimi","p":4084,"l":"","n":"2917"},"x":[]},{"id":"darimi-2955","q":"إن الجد قد مضت سنته، وإن أبا بكر، جعل الجد أبا، ولكن الناس تخيروا","w":"الحسن البصري","t":"الجد والنسل","k":["hikam"],"r":{"b":"darimi","p":4132,"l":"","n":"2955"},"x":[]},{"id":"darimi-3168","q":"إذا استهل الصبي، ورث وصلي عليه","w":"جابر بن عبد الله","t":"الورث والصلاة للمواليد","k":["hikam"],"r":{"b":"darimi","p":4380,"l":"ج4 ص2005","n":"3168"},"x":[]},{"id":"darimi-3176","q":"إذا ابتاع المكاتبان أحدهما الآخر: هذا هذا من سيده، وهذا هذا من سيده، فالبيع للأول. ويقول: أهل المدينة: الولاء لسيد البائع. ويقولون: إنما ابتاع هذا ما على المكاتب، فالولاء للسيد","w":"قتادة بن دعامة","t":"قواعد بيع المكاتب","k":["hikam"],"r":{"b":"darimi","p":4389,"l":"ج4 ص2008","n":"3176"},"x":[]},{"id":"darimi-3220","q":"المؤمن لا يأكل في كل بطنه، ولا تزال وصيته تحت جنبه","w":"الحسن البصري","t":"فضيلة الوصية","k":["akhlaq","hikam"],"r":{"b":"darimi","p":4441,"l":"ج4 ص2027","n":"3220"},"x":[]},{"id":"darimi-3246","q":"الوصي أمين فيما أوصي إليه به","w":"إبراهيم النخعي","t":"أمانة الوصي","k":["hikam","ilm"],"r":{"b":"darimi","p":4474,"l":"ج4 ص2041","n":"3246"},"x":[]},{"id":"darimi-3254","q":"يحدث الرجل في وصيته ما شاء، وملاك الوصية آخرها","w":"عمر بن الخطاب","t":"الوصية وحرية التحديد","k":["hikam"],"r":{"b":"darimi","p":4484,"l":"ج4 ص2043","n":"3254"},"x":[]},{"id":"darimi-3286","q":"إذا أوصى الرجل إلى الرجل وهو غائب، فليقبل وصيته، وإن كان حاضرا، فهو بالخيار: إن شاء، قبل، وإن شاء، ترك","w":"الحسن البصري","t":"قبول الوصية للغائب","k":["hikam"],"r":{"b":"darimi","p":4526,"l":"ج4 ص2056","n":"3286"},"x":[]},{"id":"darimi-3288","q":"إذا أوصى الرجل إلى الرجل وهو غائب، فإذا قدم فإن شاء، قبل، فإذا قبل، لم يكن له أن يرده","w":"الحسن البصري","t":"الوصية للغائب","k":["hikam"],"r":{"b":"darimi","p":4528,"l":"ج4 ص2056","n":"3288"},"x":[]},{"id":"darimi-3289","q":"إذا أوصى الرجل إلى الرجل فعرضت عليه الوصية، وكان غائبا فقبل، لم يكن له أن يرجع","w":"الحسن البصري","t":"عرض الوصية للغائب","k":["hikam"],"r":{"b":"darimi","p":4529,"l":"ج4 ص2056","n":"3289"},"x":[]},{"id":"darimi-3290","q":"إذا أوصى الرجل لإنسان، وهو غائب، وكان ميتا، وهو لا يدري، فهي راجعة","w":"إبراهيم النخعي","t":"الوصية للميت","k":["hikam"],"r":{"b":"darimi","p":4531,"l":"ج4 ص2058","n":"3290"},"x":[]},{"id":"darimi-3291","q":"إذا أوصى لعبده ثلث ماله، ربع ماله، خمس ماله، فهو من ماله دخلته عتاقة","w":"الحسن البصري","t":"نصيب الوصية","k":["hikam"],"r":{"b":"darimi","p":4533,"l":"ج4 ص2058","n":"3291"},"x":[]},{"id":"darimi-3294","q":"إذا أوصى الرجل لآخر بمثل نصيب ابنه، فلا يتم له مثل نصيبه، حتى ينقص منه","w":"إبراهيم النخعي","t":"نصيب الوصية","k":["hikam"],"r":{"b":"darimi","p":4538,"l":"ج4 ص2059","n":"3294"},"x":[]},{"id":"darimi-3297","q":"لا يجوز، وإن كان أقل من الثلث","w":"إبراهيم النخعي","t":"حكم الوصية في الثلث","k":["hikam"],"r":{"b":"darimi","p":4541,"l":"ج4 ص2059","n":"3297"},"x":[]},{"id":"darimi-3319","q":"المعتقة عن دبر وولدها من الثلث","w":"الحسن البصري","t":"المعتقة والثلث","k":["hikam"],"r":{"b":"darimi","p":4572,"l":"ج4 ص2069","n":"3319"},"x":[]},{"id":"darimi-3335","q":"وصيته ليست بجائزة إلا ما ليس بذي بال","w":"محمد بن شهاب الزهري","t":"صلاحية الوصية","k":["hikam"],"r":{"b":"darimi","p":4591,"l":"ج4 ص2076","n":"3335"},"x":[{"b":"ibnabishayba-v06","p":219,"l":"ج6 ص221","n":""}]},{"id":"darimi-3450","q":"من قرأ سورة الكهف ليلة الجمعة، أضاء له من النور فيما بينه وبين البيت العتيق","w":"أبو سعيد الخدري","t":"فضل سورة الكهف ليلة الجمعة","k":["hikam"],"r":{"b":"darimi","p":4730,"l":"ج4 ص2142","n":"3450"},"x":[]},{"id":"darimi-3455","q":"فضلتا على كل سورة في القرآن بستين حسنة","w":"طاوس بن كيسان","t":"فضيلة كل سورة","k":["hikam"],"r":{"b":"darimi","p":4736,"l":"ج4 ص2144","n":"3455"},"x":[]},{"id":"ibnabishayba-v07-98","q":"طوبى لكل عبد نؤمة عرف الناس ولم يعرفه الناس وعرفه الله منه برضوان أولئك مصابيح الهدى يجلى عنهم كل فتنة مظلمة ويدخلهم الله في رحمته ليس أولئك بالمذاييع البذر ولا بالجفاة المرائين","w":"الحسن البصري","t":"طوبى للمتواضع","k":["hikam"],"r":{"b":"ibnabishayba-v07","p":98,"l":"ج7 ص100","n":""},"x":[]},{"id":"ibnabishayba-v07-119","q":"إن من الناس حامل داء وحامل شفاء ومفتاح خير ومفتاح شر","w":"سلمان الفارسي","t":"الناس حامل داء","k":["hikam"],"r":{"b":"ibnabishayba-v07","p":119,"l":"ج7 ص121","n":""},"x":[]},{"id":"ibnabishayba-v07-120","q":"إن الله يستحي أن يبسط إليه عبد يديه يسأله بهما خيرا فيردهما خائبتين","w":"سلمان الفارسي","t":"الله يستحي أن","k":["hikam"],"r":{"b":"ibnabishayba-v07","p":120,"l":"ج7 ص122","n":""},"x":[]},{"id":"darimi-190","q":"كانوا يتكرهون، وكانوا يستحبون","w":"إبراهيم النخعي","t":"تغير الأهواء","k":["hikam"],"r":{"b":"darimi","p":214,"l":"","n":"190"},"x":[]},{"id":"darimi-195","q":"أول من قاس إبليس، وما عبدت الشمس والقمر إلا بالمقاييس","w":"محمد بن سيرين","t":"قياس الشيطان","k":["hikam"],"r":{"b":"darimi","p":220,"l":"ج1 ص278","n":"195"},"x":[]},{"id":"darimi-403","q":"يا بني عليك بالحكمة، فإن الخير في الحكمة كله: وتشرف الصغير على الكبير، والعبد على الحر، وتزيد السيد سؤددا، وتجلس الفقير مجالس الملوك","w":"وهب بن منبه","t":"الحكمة الاجتماعية","k":["hikam"],"r":{"b":"darimi","p":447,"l":"ج1 ص385","n":"403"},"x":[]},{"id":"darimi-499","q":"ما كتبت سوداء في بيضاء، ولا استعدت حديثا من إنسان","w":"عامر الشعبي","t":"نهي عن الكذب","k":["hikam"],"r":{"b":"darimi","p":548,"l":"","n":"499"},"x":[{"b":"jamibayan","p":297,"l":"","n":"368"}]},{"id":"darimi-552","q":"إن خفق النعال خلف الرجال، قل ما يلبث الحمقى","w":"الحسن البصري","t":"تحذير من الحمقى","k":["hikam"],"r":{"b":"darimi","p":603,"l":"","n":"552"},"x":[]},{"id":"darimi-565","q":"ما لكم لا تسألوني أفلستم؟","w":"عكرمة مولى ابن عباس","t":"دعوة للسؤال","k":["hikam"],"r":{"b":"darimi","p":617,"l":"","n":"565"},"x":[{"b":"siyar-v05","p":14,"l":"ج5 ص18","n":""}]},{"id":"darimi-574","q":"علم لا يقال به، ككنز لا ينفق منه","w":"سلمان الفارسي","t":"قيمة العلم","k":["ilm","hikam"],"r":{"b":"darimi","p":626,"l":"","n":"574"},"x":[{"b":"jamibayan","p":605,"l":"","n":"779"}]},{"id":"darimi-577","q":"يتبع الرجل بعد موته ثلاث خلال: صدقة تجري بعده، وصلاة ولده عليه، وعلم أفشاه يعمل به بعده","w":"إبراهيم النخعي","t":"ثلاثة بعد الموت","k":["targhib","hikam"],"r":{"b":"darimi","p":629,"l":"","n":"577"},"x":[]},{"id":"darimi-598","q":"ما حمل العلم في مثل جراب حلم","w":"طاوس بن كيسان","t":"حمل العلم","k":["ilm","hikam"],"r":{"b":"darimi","p":651,"l":"","n":"598"},"x":[{"b":"ibnabishayba-v05","p":236,"l":"ج5 ص238","n":""},{"b":"shuabiman-v06","p":356,"l":"ج6 ص361","n":""}]},{"id":"darimi-600","q":"إن الحكمة تسكن القلب الوادع الساكن","w":"وهب بن منبه","t":"حكمة القلب","k":["hikam","qulub"],"r":{"b":"darimi","p":653,"l":"","n":"600"},"x":[]}]}