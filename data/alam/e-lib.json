{"lib.a1":{"n":"الشيخ محمد إسماعيل المقدم","s":"lib","t":"a","a":"a1","x":"طبيب ومؤسس «المدرسة السلفية» بالإسكندرية سنة 1977م، وُلد بالإسكندرية سنة 1952م، ومن أبرز من تتلمذ عليهم قادة الدعوة السلفية.","tj":1},"lib.a2":{"n":"الشيخ ياسر برهامي","s":"lib","t":"a","a":"a2","x":"طبيب أطفال وداعية، وُلد بكفر الدوار سنة 1958م، من مشايخ المدرسة السلفية بالإسكندرية، والمشرف العام على موقع «صوت السلف»، وأول كتبه «فضل الغني الحميد».","tj":1},"lib.a3":{"n":"الشيخ أحمد حطيبة","s":"lib","t":"a","a":"a3","x":"طبيب أسنان وداعية، وُلد بالإسكندرية سنة 1958م، من مؤسسي الدعوة السلفية بالإسكندرية، وإمام مسجد نور الإسلام، وله شروح فقهية وتفسيرية مطولة.","tj":1},"lib.a4":{"n":"الشيخ أحمد فريد","s":"lib","t":"a","a":"a4","x":"طبيب وداعية، وُلد بمنيا القمح سنة 1952م، من شيوخ الدعوة السلفية وعضو مجلس أمنائها، وأشهر كتبه «البحر الرائق في الزهد والرقائق».","tj":1},"lib.a5":{"n":"الشيخ سعيد عبدالعظيم","s":"lib","t":"a","a":"a5","x":"طبيب وداعية، وُلد بالإسكندرية سنة 1952م، من المؤسسين الأوائل للمدرسة السلفية بالإسكندرية، وخطيب مسجد الفتح بمصطفى كامل.","tj":1},"lib.a6":{"n":"الشيخ عبدالمنعم الشحات","s":"lib","t":"a","a":"a6","x":"مهندس وداعية، وُلد بالإسكندرية سنة 1970م، المتحدث الرسمي باسم الدعوة السلفية منذ 2011م، ومن أبرز منظّريها.","tj":1},"lib.a7":{"n":"الشيخ السيد حسين العفاني","s":"lib","t":"a","a":"a7","x":"طبيب وواعظ، من بلدة عفان ببني سويف، تتلمذ على الشيخ محمد إسماعيل المقدم، وله مؤلفات كثيرة في الرقائق وتراجم السلف أشهرها «صلاح الأمة في علو الهمة».","tj":1},"lib.a8":{"n":"صوت السلف","s":"lib","t":"a","a":"a8","x":"الموقع الرسمي للدعوة السلفية."},"lib.a9":{"n":"الدعوة السلفية","s":"lib","t":"a","a":"a9"},"lib.a10":{"n":"حزب النور","s":"lib","t":"a","a":"a10"},"lib.a11":{"n":"الشيخ سعيد محمود","s":"lib","t":"a","a":"a11"},"lib.a12":{"n":"الشيخ علاء بكر","s":"lib","t":"a","a":"a12"},"lib.ta1":{"n":"الإمام النووي","s":"lib","t":"a","a":"ta1","d":"ت 676هـ"},"lib.ta2":{"n":"شيخ الإسلام ابن تيمية","s":"lib","t":"a","a":"ta2","d":"ت 728هـ"},"lib.ta3":{"n":"الحافظ ابن حجر العسقلاني","s":"lib"