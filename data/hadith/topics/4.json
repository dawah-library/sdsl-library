 وذكرنا, وأنثانا, اللهم من أحييته منا فأحيه على الإسلام, ومن توفيته منا فتوفه على الإيما","bulugh","كتاب الجنائز",["bulugh-412","bulugh-413","bulugh-414","bulugh-415","bulugh-416","bulugh-417","bulugh-418","bulugh-419","bulugh-420","bulugh-421"]],["زيارة القبور","bulugh","كتاب الجنائز",["bulugh-422","bulugh-423","bulugh-424","bulugh-425","bulugh-426","bulugh-427","bulugh-428","bulugh-429"]],[": «السلام على أهل الديار من المؤمنين والمسلمين, وإنا إن شاء الله بكم للاحقون, أسأل الله لنا ولكم الع","bulugh","كتاب الجنائز",["bulugh-430"]],[": «السلام عليكم يا أهل القبور, يغفر الله لنا ولكم, أنتم سلفنا ونحن بالأثر».","bulugh","كتاب الجنائز",["bulugh-431","bulugh-432"]]],"books":{"abudawud":"سنن أبي داود","bukhari":"صحيح البخاري","darimi":"سنن الدارمي","ibnmajah":"سنن ابن ماجه","muslim":"صحيح مسلم","muwatta":"موطأ مالك","nasai":"سنن النسائي","tirmidhi":"جامع الترمذي","arbain":"الأربعون النووية","riyad":"رياض الصالحين","bulugh":"بلوغ المرام"}}