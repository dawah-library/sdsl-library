{
  "functions": {
    "api/ask.js": {
      "maxDuration": 60
    },
    "api/import.js": {
      "maxDuration": 30
    },
    "api/page.js": {
      "includeFiles": "data/**",
      "maxDuration": 15
    },
    "api/sitemap.js": {
      "includeFiles": "data/**",
      "maxDuration": 15
    },
    "api/gh.js": {
      "maxDuration": 60
    },
    "api/remind.js": {
      "maxDuration": 60
    },
    "api/translate.js": {
      "includeFiles": "data/{catalog.json,books/**}",
      "maxDuration": 60
    },
    "api/mpost.js": {
      "includeFiles": "data/{catalog.json,books/**}",
      "maxDuration": 20
    },
    "api/pages.js": {
      "maxDuration": 10
    },
    "api/r2put.js": {
      "maxDuration": 20
    },
    "api/notify.js": {
      "maxDuration": 15
    },
    "api/tglink.js": {
      "maxDuration": 15
    }
  },
  "headers": [
    {
      "source": "/((?!setup-db\\.html).*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net/npm/@supabase/ https://cdnjs.cloudflare.com/ajax/libs/pdf.js/; worker-src 'self' blob: https://cdnjs.cloudflare.com/ajax/libs/pdf.js/; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' data: blob: https://github.com https://*.githubusercontent.com; connect-src 'self' https://nqxkkdexpodjjwfdkxoq.supabase.co wss://nqxkkdexpodjjwfdkxoq.supabase.co https://raw.githubusercontent.com https://api.github.com https://api.mymemory.translated.net https://api.pwnedpasswords.com https://*.r2.cloudflarestorage.com https://cdnjs.cloudflare.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; manifest-src 'self'; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(assets|vendor)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=2592000"
        }
      ]
    },
    {
      "source": "/(favicon\\.ico|manifest\\.webmanifest|404\\.html)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/:file([^/]+\\.(?:js|css))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60, must-revalidate"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/sitemap?robots=1"
    },
    {
      "source": "/:first(book|library|articles|fatawa|bayanat|posts|post|author|authors|furqan|tafrighat|about|dawah|history|contact|search|qabasat|favs|admin|ask|ai|tarajim|tarjama|account|topics|topic)",
      "destination": "/api/page?__p=/:first"
    },
    {
      "source": "/:first(book|library|articles|fatawa|bayanat|posts|post|author|authors|furqan|tafrighat|about|dawah|history|contact|search|qabasat|favs|admin|ask|ai|tarajim|tarjama|account|topics|topic)/:rest*",
      "destination": "/api/page?__p=/:first/:rest*"
    },
    {
      "source": "/:x((?:.*\\.(?:php|asp|aspx|jsp|cgi|env|ini|bak|sql)|wp-.*|\\.git.*|\\.env.*|cgi-bin.*|xmlrpc.*))",
      "destination": "/404.html"
    },
    {
      "source": "/:path*",
      "destination": "/api/page?__p=/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "sdsl-library.vercel.app"
        }
      ],
      "destination": "https://dawahlibrary.org/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.dawahlibrary.org"
        }
      ],
      "destination": "https://dawahlibrary.org/:path*",
      "permanent": true
    },
    {
      "source": "/author/w73",
      "destination": "/author/w53",
      "permanent": true
    },
    {
      "source": "/book/umda/:rest*",
      "destination": "/book/umdafiqh/1",
      "permanent": false
    }
  ],
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ':(exclude)data/audio' ':(exclude)data/tashkeel' ':(exclude)data/switches.json' ':(exclude)data/admin-log.json'"
}
